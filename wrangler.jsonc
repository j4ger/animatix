{
  "$schema": "./web/deploy/node_modules/wrangler/config-schema.json",
  "name": "animatix-candidate-preview",
  "account_id": "65bc5958d8a01d7a1d9b7c326b244406",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "main": "web/deploy/static-worker.js",
  "no_bundle": true
}
