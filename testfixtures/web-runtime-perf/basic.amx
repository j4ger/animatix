// Stable browser performance fixture: text and filled geometry at 1280x720.
config { resolution: (1280, 720), duration: 2.0 }

title: Text, text: "Animatix Web Runtime", font_size: 46, color: "#f2f4f8",
  anchor: scene.center, offset: (0, -170), opacity: 1
caption: Text, text: "GPU playback · 你好 · 123", font_size: 28, color: "#9bb0c8",
  anchor: scene.center, offset: (0, -105), opacity: 1
panel: Rect, size: (520, 270), color: "#26364a", at: (640, 390), opacity: 1
orb: Ellipse, size: (180, 180), color: "#55c6a9", at: (640, 390), opacity: 1

#1.0s
shift orb [by: (220, 0), 700ms, ease: ease-in-out]
