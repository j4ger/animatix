// Probe: can a Callout retarget a named actor through assignment?
// The sorting visualizer wants one "key" callout that follows each key actor.

config { colorscheme: "editorial-dark", resolution: (640, 360) }

box1: Rect, size: (100, 100), color: accent.primary, at: (200, 180)
box2: Rect, size: (100, 100), color: accent.success, at: (440, 180)

note: Callout {
  from: (100, 60),
  target: box1,
  place: bottom,
  standoff: 8,
  label: "key",
  label_at: (0, -16),
  color: accent.warning
}

#0s
fade-in box1 [200ms]
fade-in box2 [200ms]
fade-in note [200ms]

#1s
note.target = box2 [300ms]
