// Derived region of interest: a Filter with NO authored `bounds:` — the
// region is derived from the content bounds recorded during the sub-scene
// evaluation, padded by the chain's worst-case support (blur radius 8 +
// chroma offset 6).
config { resolution: (640, 360) }

#0s
backdrop: Rect, size: (640, 360), color: (0.05, 0.07, 0.1, 1), at: (320, 180)

fx: Filter, at: (320, 180) {
  soft: Blur, radius: 8
  chroma: ChromaticAberration, offset: 6
  card: Rect, size: (220, 140), color: (0.9, 0.55, 0.2, 1), at: (-120, -50)
  badge: Text, text: "ROI", font_size: 28, color: (1, 1, 1, 1), at: (150, 60)
}
