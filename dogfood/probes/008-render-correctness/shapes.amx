// render-correctness probe — shapes (breadth pass)
// Each shape at a known `at:` position on the default black background,
// all revealed via fade-in; render at t=1.0 to view the result.
config { resolution: (1280, 720) }

#0s
rect:    Rect,    at: (200, 180), size: (130, 90),  color: (0.9, 0.2, 0.2, 1), stroke: (1,1,1,1), stroke_width: 3
ellipse: Ellipse, at: (460, 180), size: (130, 90),  color: (0.2, 0.6, 0.9, 1)
line:    Line,    at: (720, 180), from: (-70, 0), to: (70, 0), stroke: (1, 0.85, 0.2, 1), stroke_width: 6
arrow:   Arrow,   at: (980, 180), from: (-70, 40), to: (70, -40), stroke: (0.4, 0.9, 0.4, 1), stroke_width: 5, head_size: 16

polygon: Polygon, at: (200, 480), points: {(0,-60),(55,0),(0,60),(-55,0)}, color: (0.9, 0.7, 0.1, 1)
path:    Path,    at: (460, 480), commands: {move_to(-60,40), line_to(0,-50), line_to(60,40), close()}, color: (0.75, 0.3, 0.9, 1)
line2:   Line,    at: (720, 480), from: (0,-60), to: (0,60), stroke: (0.95, 0.35, 0.55, 1), stroke_width: 6
polygon2:Polygon, at: (980, 480), points: {(0,-50),(50,0),(0,50),(-50,0)}, color: (0.3, 0.85, 0.55, 1)

#0s
stagger [70ms] {
  fade-in rect [220ms]
  fade-in ellipse [220ms]
  fade-in line [220ms]
  fade-in arrow [220ms]
  fade-in polygon [220ms]
  fade-in path [220ms]
  fade-in line2 [220ms]
  fade-in polygon2 [220ms]
}
