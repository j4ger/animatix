// Typst/Math surface showcase — verify the actual rendered effect after the fixes.
config { resolution: (1280, 720) }

#0s
t1: Text,  at: (320, 120), text: "Text (literal): *no* markup", font_size: 32, color: (1, 1, 1, 1)
t2: Typst, at: (320, 260), font_family: "DejaVu Sans", content: "Typst: *bold* _italic_", font_size: 36, color: (1, 1, 1, 1)
t3: Typst, at: (320, 400), font_family: "DejaVu Sans", content: "weight 700", font_size: 36, font_weight: 700, color: (1, 1, 1, 1)
m1: Math,  at: (900, 260), text: "x^2 + y^2", font_size: 40, color: (0.7, 0.9, 1, 1)
m2: Typst, at: (900, 400), content: "$sqrt(x) + 1$", font_size: 40, color: (0.8, 0.7, 1, 1)

#0s
stagger [60ms] { fade-in t1 [120ms] fade-in t2 [120ms] fade-in t3 [120ms] fade-in m1 [120ms] fade-in m2 [120ms] }
