// Sorting Visualizer — insertion sort as a timeline function.
//
// The sort runs at build time inside `fn insertion_sort`. The function tracks
// `order` — which original bar occupies each slot — so every `swap` targets
// the bars *currently* at the two slots being exchanged. Swapping value
// positions instead would silently mis-target after the first move. `let`
// shadowing carries `order` forward and `[step: ...]` advances the build-time
// clock so each swap lands on its own keyframe.
//
// The body expands into a scoped block, so function-local `let` bindings
// never leak into the scene.

import "../../../examples/lib/tokens.amx" as tokens

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

// Timeline function: precomputed insertion sort over `bars.bar__N` tracks.
// `values` is the initial array; `order[k]` is the original bar index at slot
// `k`, so `values[order[k]]` is the value shown in slot `k`.
fn insertion_sort(bars, values: List<Num>) {
  let order = {0, 1, 2, 3}
  for key in {1, 2, 3} [step: 1200ms] {
    key_note.target = bars.bar[order[key]] [300ms]
    for j in {0, 1, 2} [step: 300ms] {
      if j < key && values[order[key - j]] < values[order[key - j - 1]] {
        swap bars.bar[order[key - j]], bars.bar[order[key - j - 1]] [300ms]
        let order = list_swap(order, key - j, key - j - 1)
      }
    }
  }
}

pub component Bars(values: List<Num>, colors: List<Color>, at: Vec2 = (640, 440), gap: Num = 28, align: Str = "end") {
  row: Row, at: at, gap: gap, align: align {
    for v, i in values {
      bar[i]: Rect, size: (110, v * 42), color: colors[i]
    }
  }
}

// ── Scene 1: Title ──────────────────────────────────────────────────────────

# Title
config { colorscheme: "editorial-dark", dynamic_layout: true, duration: 2.5 }

title: Text, text: "Insertion Sort", font_size: 56,
  color: text.primary, anchor: scene.center, offset: (0, -60)

subtitle: Text, text: "4  ·  1  ·  3  ·  2  ->  1  ·  2  ·  3  ·  4",
  font_size: 22, color: text.secondary, anchor: scene.center, offset: (0, 10)

hint: Text, text: "The sort runs in a timeline function; the loop emits each swap", font_size: 18,
  color: text.muted, anchor: scene.center, offset: (0, 70)

#0s
fade-in title [700ms, ease: ease-out]
fade-in subtitle [600ms, delay: 200ms]
fade-in hint [500ms, delay: 350ms]

#2.2s
play Steps [fade, 400ms]

// ── Scene 2: Steps ──────────────────────────────────────────────────────────

# Steps
config { colorscheme: "editorial-dark", dynamic_layout: true, duration: 4.5 }

step_title: Text, text: "Insert 1, then 3, then 2", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 56)

bars: Bars, values: {4, 1, 3, 2}, colors: {tokens.info, tokens.warning, tokens.info, tokens.info}

key_note: Callout {
  from: (180, 170),
  target: bars.bar[1],
  place: top,
  standoff: 10,
  label: "key",
  label_at: (0, -20),
  color: tokens.warning
}

step_caption: Text, text: "Each key slides left while it is smaller than its neighbor.",
  font_size: 18, color: text.secondary, anchor: scene.bottom, offset: (0, -60)

#0s
fade-in step_title [500ms]
fade-in bars [500ms]
fade-in key_note [400ms, delay: 200ms]
fade-in step_caption [400ms, delay: 300ms]

insertion_sort(bars, {4, 1, 3, 2})

#4s
play Result [fade, 400ms]

// ── Scene 3: Result ─────────────────────────────────────────────────────────

# Result
config { colorscheme: "editorial-dark", dynamic_layout: true, duration: 4 }

result_title: Text, text: "Sorted", font_size: 48,
  color: text.primary, anchor: scene.top, offset: (0, 72)

result_bars: Bars, values: {1, 2, 3, 4}, colors: {tokens.success, tokens.success, tokens.success, tokens.success}

result_note: Text, text: "Every swap was emitted by `insertion_sort` — one timeline function, no hand-unrolled keyframes.",
  font_size: 18, color: text.secondary, anchor: scene.bottom, offset: (0, -60)

#0s
fade-in result_title [500ms]
fade-in result_bars [600ms, ease: ease-out]
fade-in result_note [500ms, delay: 250ms]
