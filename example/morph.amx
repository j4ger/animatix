// Morphing Demo! Watch the individual curves shift intelligently.
#0s
t1: Text { text: "hi", font_size: 150, color: (1.0, 1.0, 1.0, 1.0), at: (640, 360) }

#2s
// By re-declaring `t1` at 2s with modifiers, it smoothly morphs from "hi" to "hello".
// The 'h' translates, the 'i' splits and morphs into 'e', and the 'l', 'l', 'o' bloom out of the void.
t1: Text { text: "hello", font_size: 150, color: (0.2, 1.0, 0.5, 1.0), at: (640, 360) } [2s, ease: ease-in-out]

#5s
