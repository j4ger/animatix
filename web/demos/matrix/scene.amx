import "../lib/theme.amx"
// matrix.amx — "A matrix is a machine" — a 2×2 matrix animated as three
// transformations of the plane: shear, rotation, and the collapse/flip that
// happens as the determinant crosses zero.
//
// Everything on the plane is driven by one `always` block per scene: the grid
// lines, the two basis vectors, and the four matrix chips are all plain
// functions of t. No keyframed geometry anywhere — change the matrix
// formulas and the whole figure follows.

config { colorscheme: "ink", resolution: (1280, 720) }

// ── Scene 1: Shear — area preserved, the grid leans ─────────────────────────

# Shear
config { colorscheme: "ink", duration: 8 }

shear_title: Text, text: "A matrix is a machine", font_size: 38,
  color: text.primary, anchor: scene.top, offset: (0, 52)
shear_sub: Text, text: "M = [[1, k], [0, 1]] — a shear. Every point slides; no area changes.",
  font_size: 17, color: text.secondary, anchor: scene.top, offset: (0, 104)

// The four matrix entries, live.
a_t: Text, text: "1.0", font_size: 26, color: text.secondary, at: (196, 170)
b_t: Text, text: "0.0", font_size: 26, color: text.secondary, at: (276, 170)
c_t: Text, text: "0.0", font_size: 26, color: accent.primary, at: (196, 226)
d_t: Text, text: "1.0", font_size: 26, color: text.secondary, at: (276, 226)
m_brace: Line, from: (170, 152), to: (170, 248), stroke_width: 2, color: text.muted
det_t: Text, text: "det = 1.0", font_size: 19, color: accent.success, at: (170, 282)

// The grid: five vertical and five horizontal lines, both ends driven.
for x, i in {-2, -1, 0, 1, 2} {
  vl[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
  hl[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
}

i_hat: Line, from: (760, 400), to: (870, 400), stroke: accent.primary, stroke_width: 3.5
j_hat: Line, from: (760, 400), to: (760, 510), stroke: accent.success, stroke_width: 3.5
i_t: Text, text: "i", font_size: 19, color: accent.primary, at: (886, 386)
j_t: Text, text: "j", font_size: 19, color: accent.success, at: (748, 524)

shear_cap: Text, text: "the unit square leans into a parallelogram — same base, same height", opacity: 0.0,
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in shear_cap [300ms, delay: 600ms, ease: expo-out]
stagger [60ms] {
  fade-in vl__0 [300ms, ease: expo-out]
  fade-in vl__1 [300ms, ease: expo-out]
  fade-in vl__2 [300ms, ease: expo-out]
  fade-in vl__3 [300ms, ease: expo-out]
  fade-in vl__4 [300ms, ease: expo-out]
  fade-in hl__0 [300ms, ease: expo-out]
  fade-in hl__1 [300ms, ease: expo-out]
  fade-in hl__2 [300ms, ease: expo-out]
  fade-in hl__3 [300ms, ease: expo-out]
  fade-in hl__4 [300ms, ease: expo-out]
}
fade-in i_hat [300ms, delay: 350ms, ease: expo-out]
fade-in i_t [300ms, delay: 400ms, ease: expo-out]
fade-in j_t [300ms, delay: 450ms, ease: expo-out]
fade-in m_brace [260ms, delay: 100ms, ease: expo-out]
fade-in j_hat [300ms, delay: 450ms, ease: expo-out]
stagger [90ms] {
  fade-in a_t [260ms, ease: expo-out]
  fade-in b_t [260ms, ease: expo-out]
  fade-in c_t [260ms, ease: expo-out]
  fade-in d_t [260ms, ease: expo-out]
  fade-in det_t [260ms, ease: expo-out]
}
fade-in shear_title [500ms, ease: expo-out]
fade-in shear_sub [400ms, delay: 150ms, ease: expo-out]

always {
  // Smoothstep shear: k rises 0 → 1 between t = 2.5 and t = 6.
  let u = clamp((t - 2.5) / 3.5, 0, 1)
  let k = u * u * (3 - 2 * u)
  let a = 1.0
  let b = 0.0
  let c = k
  let d = 1.0
  let cx = 760
  let cy = 400
  let s = 110

  // The machine applied to the basis vectors.
  i_hat.to = (cx + s * a, cy + s * c)
  j_hat.to = (cx + s * b, cy + s * d)

  // Vertical grid lines: x = -2 … 2, y sweeps -2.4 … 2.4.
  vl__0.from = (cx + s * (a * -2 + b * -2.4), cy + s * (c * -2 + d * -2.4))
  vl__0.to = (cx + s * (a * -2 + b * 2.4), cy + s * (c * -2 + d * 2.4))
  vl__1.from = (cx + s * (a * -1 + b * -2.4), cy + s * (c * -1 + d * -2.4))
  vl__1.to = (cx + s * (a * -1 + b * 2.4), cy + s * (c * -1 + d * 2.4))
  vl__2.from = (cx, cy + s * (c * 0 + d * -2.4))
  vl__2.to = (cx, cy + s * (c * 0 + d * 2.4))
  vl__3.from = (cx + s * (a * 1 + b * -2.4), cy + s * (c * 1 + d * -2.4))
  vl__3.to = (cx + s * (a * 1 + b * 2.4), cy + s * (c * 1 + d * 2.4))
  vl__4.from = (cx + s * (a * 2 + b * -2.4), cy + s * (c * 2 + d * -2.4))
  vl__4.to = (cx + s * (a * 2 + b * 2.4), cy + s * (c * 2 + d * 2.4))

  // Horizontal grid lines: y = -2 … 2, x sweeps -2.4 … 2.4.
  hl__0.from = (cx + s * (a * -2.4 + b * -2), cy + s * (c * -2.4 + d * -2))
  hl__0.to = (cx + s * (a * 2.4 + b * -2), cy + s * (c * 2.4 + d * -2))
  hl__1.from = (cx + s * (a * -2.4 + b * -1), cy + s * (c * -2.4 + d * -1))
  hl__1.to = (cx + s * (a * 2.4 + b * -1), cy + s * (c * 2.4 + d * -1))
  hl__2.from = (cx + s * (a * -2.4 + b * 0), cy + s * (c * -2.4 + d * 0))
  hl__2.to = (cx + s * (a * 2.4 + b * 0), cy + s * (c * 2.4 + d * 0))
  hl__3.from = (cx + s * (a * -2.4 + b * 1), cy + s * (c * -2.4 + d * 1))
  hl__3.to = (cx + s * (a * 2.4 + b * 1), cy + s * (c * 2.4 + d * 1))
  hl__4.from = (cx + s * (a * -2.4 + b * 2), cy + s * (c * -2.4 + d * 2))
  hl__4.to = (cx + s * (a * 2.4 + b * 2), cy + s * (c * 2.4 + d * 2))

  a_t.text = format("{:.1}", a)
  b_t.text = format("{:.1}", b)
  c_t.text = format("{:.1}", c)
  d_t.text = format("{:.1}", d)
  det_t.text = format("det = {:.1}", a * d - b * c)
}

play Rotation [wipe-left, 500ms]

// ── Scene 2: Rotation — columns are where the hats land ─────────────────────

# Rotation
config { colorscheme: "ink", duration: 8 }

rot_title: Text, text: "Rotation: read it off the columns", font_size: 38,
  color: text.primary, anchor: scene.top, offset: (0, 52)
rot_sub: Text, text: "column 1 is where i lands; column 2 is where j lands",
  font_size: 17, color: text.secondary, anchor: scene.top, offset: (0, 104)

a2_t: Text, text: "1.0", font_size: 26, color: accent.primary, at: (196, 170)
b2_t: Text, text: "0.0", font_size: 26, color: accent.success, at: (276, 170)
c2_t: Text, text: "0.0", font_size: 26, color: accent.primary, at: (196, 226)
d2_t: Text, text: "1.0", font_size: 26, color: accent.success, at: (276, 226)
m2_brace: Line, from: (170, 152), to: (170, 248), stroke_width: 2, color: text.muted
det2_t: Text, text: "det = 1.0", font_size: 19, color: accent.success, at: (170, 282)

for x, i in {-2, -1, 0, 1, 2} {
  rv[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
  rh[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
}
ri_hat: Line, from: (760, 400), to: (870, 400), stroke: accent.primary, stroke_width: 3.5
rj_hat: Line, from: (760, 400), to: (760, 510), stroke: accent.success, stroke_width: 3.5

rot_cap: Text, text: "a quarter turn, tracked the whole way by the numbers", opacity: 0.0,
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in rot_cap [300ms, delay: 600ms, ease: expo-out]
fade-in rv__0 [260ms, ease: expo-out]
fade-in rv__1 [260ms, ease: expo-out]
fade-in rv__2 [260ms, ease: expo-out]
fade-in rv__3 [260ms, ease: expo-out]
fade-in rv__4 [260ms, ease: expo-out]
fade-in rh__0 [260ms, ease: expo-out]
fade-in rh__1 [260ms, ease: expo-out]
fade-in rh__2 [260ms, ease: expo-out]
fade-in rh__3 [260ms, ease: expo-out]
fade-in rh__4 [260ms, ease: expo-out]
fade-in ri_hat [300ms, ease: expo-out]
fade-in m2_brace [260ms, ease: expo-out]
fade-in rj_hat [300ms, ease: expo-out]
fade-in a2_t [240ms, ease: expo-out]
fade-in b2_t [240ms, ease: expo-out]
fade-in c2_t [240ms, ease: expo-out]
fade-in d2_t [240ms, ease: expo-out]
fade-in det2_t [240ms, ease: expo-out]
fade-in rot_title [500ms, ease: expo-out, delay: 550ms]
fade-in rot_sub [400ms, delay: 650ms, ease: expo-out]

always {
  // A quarter turn between t = 2.5 and t = 6.5.
  let v = clamp((t - 2.5) / 4.0, 0, 1)
  let th = v * v * (3 - 2 * v) * (pi / 2)
  let a = cos(th)
  let b = -sin(th)
  let c = sin(th)
  let d = cos(th)
  let cx = 760
  let cy = 400
  let s = 110

  ri_hat.to = (cx + s * a, cy + s * c)
  rj_hat.to = (cx + s * b, cy + s * d)

  rv__0.from = (cx + s * (a * -2 + b * -2.4), cy + s * (c * -2 + d * -2.4))
  rv__0.to = (cx + s * (a * -2 + b * 2.4), cy + s * (c * -2 + d * 2.4))
  rv__1.from = (cx + s * (a * -1 + b * -2.4), cy + s * (c * -1 + d * -2.4))
  rv__1.to = (cx + s * (a * -1 + b * 2.4), cy + s * (c * -1 + d * 2.4))
  rv__2.from = (cx, cy + s * (c * 0 + d * -2.4))
  rv__2.to = (cx, cy + s * (c * 0 + d * 2.4))
  rv__3.from = (cx + s * (a * 1 + b * -2.4), cy + s * (c * 1 + d * -2.4))
  rv__3.to = (cx + s * (a * 1 + b * 2.4), cy + s * (c * 1 + d * 2.4))
  rv__4.from = (cx + s * (a * 2 + b * -2.4), cy + s * (c * 2 + d * -2.4))
  rv__4.to = (cx + s * (a * 2 + b * 2.4), cy + s * (c * 2 + d * 2.4))

  rh__0.from = (cx + s * (a * -2.4 + b * -2), cy + s * (c * -2.4 + d * -2))
  rh__0.to = (cx + s * (a * 2.4 + b * -2), cy + s * (c * 2.4 + d * -2))
  rh__1.from = (cx + s * (a * -2.4 + b * -1), cy + s * (c * -2.4 + d * -1))
  rh__1.to = (cx + s * (a * 2.4 + b * -1), cy + s * (c * 2.4 + d * -1))
  rh__2.from = (cx + s * (a * -2.4 + b * 0), cy + s * (c * -2.4 + d * 0))
  rh__2.to = (cx + s * (a * 2.4 + b * 0), cy + s * (c * 2.4 + d * 0))
  rh__3.from = (cx + s * (a * -2.4 + b * 1), cy + s * (c * -2.4 + d * 1))
  rh__3.to = (cx + s * (a * 2.4 + b * 1), cy + s * (c * 2.4 + d * 1))
  rh__4.from = (cx + s * (a * -2.4 + b * 2), cy + s * (c * -2.4 + d * 2))
  rh__4.to = (cx + s * (a * 2.4 + b * 2), cy + s * (c * 2.4 + d * 2))

  a2_t.text = format("{:.1}", a)
  b2_t.text = format("{:.1}", b)
  c2_t.text = format("{:.1}", c)
  d2_t.text = format("{:.1}", d)
  det2_t.text = format("det = {:.1}", a * d - b * c)
}

play Collapse [wipe-left, 500ms]

// ── Scene 3: Collapse and flip — the determinant crosses zero ───────────────

# Collapse
config { colorscheme: "ink", duration: 10 }

col_title: Text, text: "When det crosses zero, the plane folds", font_size: 38,
  color: text.primary, anchor: scene.top, offset: (0, 52)
col_sub: Text, text: "d shrinks through 0 — the grid flattens onto a line, then comes out flipped",
  font_size: 17, color: text.secondary, anchor: scene.top, offset: (0, 104)

a3_t: Text, text: "1.0", font_size: 26, color: text.secondary, at: (196, 170)
b3_t: Text, text: "0.0", font_size: 26, color: text.secondary, at: (276, 170)
c3_t: Text, text: "0.0", font_size: 26, color: text.secondary, at: (196, 226)
d3_t: Text, text: "1.0", font_size: 26, color: accent.primary, at: (276, 226)
m3_brace: Line, from: (170, 152), to: (170, 248), stroke_width: 2, color: text.muted
det3_t: Text, text: "det = 1.0", font_size: 19, color: accent.success, at: (170, 282)

for x, i in {-2, -1, 0, 1, 2} {
  cv[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
  ch[i]: Line, from: (760, 400), to: (760, 400), stroke: stroke.default, stroke_width: 1.5
}
ci_hat: Line, from: (760, 400), to: (870, 400), stroke: accent.primary, stroke_width: 3.5
cj_hat: Line, from: (760, 400), to: (760, 510), stroke: accent.success, stroke_width: 3.5

col_cap: Text, text: "negative determinant = the plane came out mirror-flipped", opacity: 0.0,
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in col_cap [300ms, delay: 600ms, ease: expo-out]
fade-in cv__0 [260ms, ease: expo-out]
fade-in cv__1 [260ms, ease: expo-out]
fade-in cv__2 [260ms, ease: expo-out]
fade-in cv__3 [260ms, ease: expo-out]
fade-in cv__4 [260ms, ease: expo-out]
fade-in ch__0 [260ms, ease: expo-out]
fade-in ch__1 [260ms, ease: expo-out]
fade-in ch__2 [260ms, ease: expo-out]
fade-in ch__3 [260ms, ease: expo-out]
fade-in ch__4 [260ms, ease: expo-out]
fade-in ci_hat [300ms, ease: expo-out]
fade-in m3_brace [260ms, ease: expo-out]
fade-in cj_hat [300ms, ease: expo-out]
fade-in a3_t [240ms, ease: expo-out]
fade-in b3_t [240ms, ease: expo-out]
fade-in c3_t [240ms, ease: expo-out]
fade-in d3_t [240ms, ease: expo-out]
fade-in col_title [500ms, ease: expo-out, delay: 550ms]
fade-in col_sub [400ms, delay: 650ms, ease: expo-out]
fade-in det3_t [240ms, delay: 300ms, ease: expo-out]

// det crosses zero exactly here — the readout turns red with the flip.
#5.0s
det3_t.color = accent.danger [300ms]

always {
  // d sweeps 1 → -1 between t = 2.5 and t = 7.5, crossing zero at t = 5.
  let w = clamp((t - 2.5) / 5.0, 0, 1)
  let dd = 1.0 - 2.0 * w
  let a = 1.0
  let b = 0.0
  let c = 0.0
  let d = dd
  let cx = 760
  let cy = 400
  let s = 110

  ci_hat.to = (cx + s * a, cy + s * c)
  cj_hat.to = (cx + s * b, cy + s * d)

  cv__0.from = (cx + s * (a * -2 + b * -2.4), cy + s * (c * -2 + d * -2.4))
  cv__0.to = (cx + s * (a * -2 + b * 2.4), cy + s * (c * -2 + d * 2.4))
  cv__1.from = (cx + s * (a * -1 + b * -2.4), cy + s * (c * -1 + d * -2.4))
  cv__1.to = (cx + s * (a * -1 + b * 2.4), cy + s * (c * -1 + d * 2.4))
  cv__2.from = (cx, cy + s * (c * 0 + d * -2.4))
  cv__2.to = (cx, cy + s * (c * 0 + d * 2.4))
  cv__3.from = (cx + s * (a * 1 + b * -2.4), cy + s * (c * 1 + d * -2.4))
  cv__3.to = (cx + s * (a * 1 + b * 2.4), cy + s * (c * 1 + d * 2.4))
  cv__4.from = (cx + s * (a * 2 + b * -2.4), cy + s * (c * 2 + d * -2.4))
  cv__4.to = (cx + s * (a * 2 + b * 2.4), cy + s * (c * 2 + d * 2.4))

  ch__0.from = (cx + s * (a * -2.4 + b * -2), cy + s * (c * -2.4 + d * -2))
  ch__0.to = (cx + s * (a * 2.4 + b * -2), cy + s * (c * 2.4 + d * -2))
  ch__1.from = (cx + s * (a * -2.4 + b * -1), cy + s * (c * -2.4 + d * -1))
  ch__1.to = (cx + s * (a * 2.4 + b * -1), cy + s * (c * 2.4 + d * -1))
  ch__2.from = (cx + s * (a * -2.4 + b * 0), cy + s * (c * -2.4 + d * 0))
  ch__2.to = (cx + s * (a * 2.4 + b * 0), cy + s * (c * 2.4 + d * 0))
  ch__3.from = (cx + s * (a * -2.4 + b * 1), cy + s * (c * -2.4 + d * 1))
  ch__3.to = (cx + s * (a * 2.4 + b * 1), cy + s * (c * 2.4 + d * 1))
  ch__4.from = (cx + s * (a * -2.4 + b * 2), cy + s * (c * -2.4 + d * 2))
  ch__4.to = (cx + s * (a * 2.4 + b * 2), cy + s * (c * 2.4 + d * 2))

  a3_t.text = format("{:.1}", a)
  b3_t.text = format("{:.1}", b)
  c3_t.text = format("{:.1}", c)
  d3_t.text = format("{:.1}", d)
  det3_t.text = format("det = {:.1}", a * d - b * c)
  // the color flips via a keyframed assignment at t = 5.0, when det crosses zero
}

// Outro: quiet plate before the loop wrap.
#9.0s
stagger [30ms] {
  fade-out col_cap [280ms, ease: ease-in]
  fade-out det3_t [280ms, ease: ease-in]
  fade-out cj_hat [280ms, ease: ease-in]
  fade-out ci_hat [280ms, ease: ease-in]
  fade-out cv__4 [280ms, ease: ease-in]
  fade-out cv__3 [280ms, ease: ease-in]
  fade-out cv__2 [280ms, ease: ease-in]
  fade-out cv__1 [280ms, ease: ease-in]
  fade-out cv__0 [280ms, ease: ease-in]
  fade-out ch__4 [280ms, ease: ease-in]
  fade-out ch__3 [280ms, ease: ease-in]
  fade-out ch__2 [280ms, ease: ease-in]
  fade-out ch__1 [280ms, ease: ease-in]
  fade-out ch__0 [280ms, ease: ease-in]
  fade-out d3_t [280ms, ease: ease-in]
  fade-out c3_t [280ms, ease: ease-in]
  fade-out b3_t [280ms, ease: ease-in]
  fade-out a3_t [280ms, ease: ease-in]
  fade-out m3_brace [280ms, ease: ease-in]
  fade-out col_sub [280ms, ease: ease-in]
  fade-out col_title [280ms, ease: ease-in]
}
