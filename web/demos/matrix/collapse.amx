// house-style: Act I identity machine; Act II determinant collapse through zero; Act III bloom + camera push, rests on the mirrored plane with det = −1.0.
//
// collapse.amx — "the plane folds through zero".
//
// The last act pushes the determinant through zero. Only d moves: it falls
// from 1 to −1, so every horizontal grid line is scaled toward the x-axis,
// the unit square flattens onto a line at det = 0, and then the plane comes
// out on the other side mirror-flipped. The determinant readout turns red at
// the crossing and stays there: negative det is orientation reversed, not a
// magnitude.
//
// `collapse` is the deck slider: it deepens the flip (the final d is
// −1 − collapse) so `--set collapse=0.5` lands on a more strongly mirrored
// plane. The declared readouts carry that same formula at build time.
//
// Type floors (DESIGN §1.5): head 48, captions 24, readout values 28, labels
// 16 — nothing renders below 16 px.

import "../lib/theme.amx"
import "../lib/stage.amx"

config { colorscheme: "moss", resolution: (1280, 720), duration: 10.0 }

// The slider target: how far past −1 the flip goes.
let collapse = 0.0

// Plane geometry. The plane is a Mask at (916, 420) whose children live in
// plane-local coordinates, so the collapsing grid cannot leak past the plate.
let cx = 0
let cy = 0
let s = 90

// The resting d (and therefore the resting determinant) is declared on every
// readout: frame-time `.text` writes do not render offline, so the storyboard
// must be told the final/total value up front.
let d_end = -1.0 - collapse

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.35

head_kicker: Text, text: "FIG 03 · COLLAPSE · DET CROSSES ZERO", font_size: 18,
  font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 44), opacity: 1
head_title: Text, text: "The plane folds through zero", font_size: 48, font_weight: "bold",
  color: text.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 96), opacity: 1
head_rule: Rect, size: (96, 4), color: accent.primary,
  anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "Act I · The identity machine, again: a square with area exactly one.", tag: "collapse.amx"
cap2: Caption, text: "Act II · d falls: the plane squashes toward the x-axis, det shrinking to zero.", tag: "collapse.amx", opacity: 0
cap3: Caption, text: "Act III · Past zero the plane comes out mirrored — negative area, det = −1.0.", tag: "collapse.amx", opacity: 0

// ── the machine panel ───────────────────────────────────────────────
panel: Rect, size: (520, 420), corner_radius: 18, color: surface.secondary,
  stroke: stroke.default, stroke_width: 1.2, at: (356, 380), opacity: 0.9

panel_title: Text, text: "MATRIX M · COLLAPSE", font_size: 18, font_family: "mono", color: text.secondary,
  text_anchor: "left", anchor: scene.top_left, offset: (112, 180), opacity: 1

a_chip: Readout, label: "COL 1 · ROW 1", value: format("{:.1}", 1.0), at: (232, 252)
b_chip: Readout, label: "COL 2 · ROW 1", value: format("{:.1}", 0.0), at: (480, 252)
c_chip: Readout, label: "COL 1 · ROW 2", value: format("{:.1}", 0.0), at: (232, 344)
d_chip: Readout, label: "COL 2 · ROW 2", value: format("{:.1}", d_end), at: (480, 344)

det_chip: Readout, label: "DETERMINANT", value: format("{:.1}", d_end), at: (232, 470)
det_note: Text, text: "signed area = det M", font_size: 20, color: text.muted,
  text_anchor: "left", anchor: scene.top_left, offset: (372, 450), opacity: 1
flip_note: Text, text: "orientation flips", font_size: 20, color: accent.danger,
  text_anchor: "left", anchor: scene.top_left, offset: (372, 486), opacity: 0

formula: Text, text: "M = [[1, 0], [0, d]]", font_size: 20, font_family: "mono",
  color: text.secondary, text_anchor: "left", anchor: scene.top_left, offset: (112, 546), opacity: 1

// ── the plane ───────────────────────────────────────────────────────
plane: Mask, size: (600, 480), at: (916, 420), opacity: 1 {
  clip_shape: Rect, size: (600, 480), opacity: 1

  grid_card: Rect, size: (600, 480), corner_radius: 18, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2, opacity: 0.72

  bloom: Ellipse, size: (700, 540), blend: "screen", opacity: 0,
    fill_gradient: radial((0.5, 0.5), 0.70, {(0%, accent.primary * 0.32), (55%, accent.primary * 0.10), (100%, (0, 0, 0, 0))})

  // Seven vertical and seven horizontal grid lines. The verticals never move;
  // the horizontals are scaled by d in `always`, so the whole field collapses
  // toward y = 0 and re-emerges flipped.
  for gx, i in {-3, -2, -1, 0, 1, 2, 3} {
    gv[i]: Line, from: (cx + s * gx, cy - s * 2.4), to: (cx + s * gx, cy + s * 2.4),
      stroke: stroke.default, stroke_width: 1.3, opacity: 0.75
  }

  for gy, i in {-2.4, -1.6, -0.8, 0, 0.8, 1.6, 2.4} {
    gh[i]: Line, from: (cx - s * 3.2, cy - s * gy), to: (cx + s * 3.2, cy - s * gy),
      stroke: stroke.default, stroke_width: 1.3, opacity: 0.75
  }

  x_axis: Line, from: (cx - s * 3.2, cy), to: (cx + s * 3.2, cy),
    stroke: text.muted, stroke_width: 1.8, opacity: 0.9
  y_axis: Line, from: (cx, cy - s * 2.4), to: (cx, cy + s * 2.4),
    stroke: text.muted, stroke_width: 1.8, opacity: 0.9

  // The singular line: the whole plane's shadow at det = 0.
  fold_line: Line, from: (cx - s * 3.2, cy), to: (cx + s * 3.2, cy),
    stroke: accent.danger, stroke_width: 3, opacity: 0

  origin_dot: Ellipse, size: (10, 10), color: accent.primary, at: (cx, cy), opacity: 1
  x_lab: Text, text: "x", font_size: 18, color: text.muted, at: (cx + s * 3.2 - 12, cy + 16), opacity: 1
  y_lab: Text, text: "y", font_size: 18, color: text.muted, at: (cx + 14, cy - s * 2.4 + 6), opacity: 1

  // The unit square: (0,0), (1,0), (1,d), (0,d). Its signed area is d.
  sq_bottom: Line, from: (cx, cy), to: (cx + s, cy), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_top: Line, from: (cx, cy - s), to: (cx + s, cy - s), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_left: Line, from: (cx, cy), to: (cx, cy - s), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_right: Line, from: (cx + s, cy), to: (cx + s, cy - s), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95

  // i stays put; j is the moving column and the moving determinant.
  i_hat: Arrow, from: (cx, cy), to: (cx + s, cy), head_size: 12,
    stroke: accent.primary, stroke_width: 4, opacity: 1
  j_hat: Arrow, from: (cx, cy), to: (cx, cy - s), head_size: 12,
    stroke: accent.info, stroke_width: 4, opacity: 1
  i_t: Text, text: "i", font_size: 22, color: accent.primary, at: (cx + s + 20, cy - 14), opacity: 1
  j_t: Text, text: "j", font_size: 22, color: accent.info, at: (cx + 16, cy - s - 14), opacity: 1
}

#0.2s
fade-in sq_bottom [360ms, ease: expo-out]
fade-in sq_top [360ms, delay: 60ms, ease: expo-out]
fade-in sq_left [360ms, delay: 120ms, ease: expo-out]
fade-in sq_right [360ms, delay: 180ms, ease: expo-out]

#1.0s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]

always {
  // Smoothstep collapse, 0.5s → 5.8s. d runs from 1 to d_end, crossing zero
  // at the smoothstep midpoint (t ≈ 3.15s), where the readout turns red.
  let u = clamp((t - 0.5) / 5.3, 0, 1)
  let sw = u * u * (3 - 2 * u)
  let dd = 1.0 + (d_end - 1.0) * sw
  let a = 1.0
  let b = 0.0
  let c = 0.0
  let d = dd

  // Vertical grid lines: x = gx, y = ±2.4 scaled by d.
  for gx, i in {-3, -2, -1, 0, 1, 2, 3} {
    gv[i].from = (cx + s * gx, cy - s * 2.4 * d)
    gv[i].to = (cx + s * gx, cy + s * 2.4 * d)
  }

  // Horizontal grid lines: y = gy scaled by d, x sweeps -3.2 … 3.2.
  for gy, i in {-2.4, -1.6, -0.8, 0, 0.8, 1.6, 2.4} {
    gh[i].from = (cx - s * 3.2, cy - s * d * gy)
    gh[i].to = (cx + s * 3.2, cy - s * d * gy)
  }

  y_axis.from = (cx, cy - s * 2.4 * d)
  y_axis.to = (cx, cy + s * 2.4 * d)
  y_lab.at = (cx + 14, cy - s * 2.4 * d + 6)

  // The unit square in matrix coordinates: (0,0), (1,0), (1,d), (0,d).
  sq_bottom.from = (cx, cy)
  sq_bottom.to = (cx + s * a, cy - s * c)
  sq_top.from = (cx, cy - s * d)
  sq_top.to = (cx + s, cy - s * d)
  sq_left.from = (cx, cy)
  sq_left.to = (cx, cy - s * d)
  sq_right.from = (cx + s, cy)
  sq_right.to = (cx + s, cy - s * d)

  i_hat.to = (cx + s * a, cy - s * c)
  j_hat.to = (cx + s * b, cy - s * d)
  j_t.at = (cx + 16, cy - s * d - 14)

  a_chip.value_text.text = format("{:.1}", a)
  b_chip.value_text.text = format("{:.1}", b)
  c_chip.value_text.text = format("{:.1}", c)
  d_chip.value_text.text = format("{:.1}", d)
  det_chip.value_text.text = format("{:.1}", a * d - b * c)
}

// ── the crossing ────────────────────────────────────────────────────
// d passes zero at t ≈ 3.15s: the readout flips red, j turns, and the
// singular line lights along the x-axis.
#3.15s
det_chip.value_text.color = accent.danger [250ms]
j_hat.stroke = accent.danger [250ms]
j_t.color = accent.danger [250ms]
fold_line.opacity = 0.85 [400ms, ease: expo-out]
fade-in flip_note [300ms, delay: 150ms, ease: expo-out]

// ── Act III · payoff ────────────────────────────────────────────────
// The bloom sweeps behind the mirrored plane while the camera pushes and
// settles back, so the resting frame is the reflected grid, the flipped unit
// square, both basis vectors and det = −1.0 held on the lit stage.
#6.9s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
bloom.opacity = 0.45 [700ms, ease: expo-out]
camera.zoom = 1.06 [1.2s, ease: ease-in-out]

#8.2s
bloom.opacity = 0.20 [800ms, ease: ease-in-out]
camera.zoom = 1.0 [1.0s, ease: ease-in-out]

// ── Rest ────────────────────────────────────────────────────────────
// The mirrored grid, the flipped square, both basis vectors, the red
// determinant and the singular line hold; nothing erases.
