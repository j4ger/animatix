// house-style: Act I identity machine; Act II area-preserving shear; Act III bloom + camera push, rests on the sheared grid with det = 1.0.
//
// shear.amx — "the grid leans, the area holds".
//
// A 2×2 matrix is a machine that moves every point of the plane at once. This
// figure starts on the identity (the machine at rest), then lets a single
// off-diagonal entry k climb while the other three stay put. Every vertical
// grid line leans by exactly ky, every horizontal line stays where it was, and
// the highlighted unit square deforms into a parallelogram with the same base
// and the same height — det = 1.0 the whole way.
//
// `shear` is the deck slider: `--set shear=0.6` pre-shears the whole figure and
// the `always` block layers the authored sweep on top, so the grid bends live
// without re-choreographing anything.
//
// The grid is computed at build time from `shear`; `always` re-derives it each
// frame from the same matrix, so the declared geometry and the live animation
// cannot drift apart.

import "../lib/theme.amx"
import "../lib/stage.amx"

config { colorscheme: "moss", resolution: (1280, 720), duration: 8.0 }

// The slider target: the extra shear carried by the whole animation.
let shear = 0.0

// Plane geometry. The plane is a Mask at (916, 420) whose children live in
// plane-local coordinates, so cx/cy are the local origin and the grid can be
// clipped to the plate instead of leaking past its rounded edge when sheared.
let cx = 0
let cy = 0
let s = 90

// Baseline shear used by the build-time declaration (the frame-0 machine).
let k0 = shear

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.35

head_kicker: Text, text: "FIG 01 · SHEAR · AREA PRESERVED", font_size: 18,
  font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 44), opacity: 1
head_title: Text, text: "The grid leans; the area holds", font_size: 48, font_weight: "bold",
  color: text.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 96), opacity: 1
head_rule: Rect, size: (96, 4), color: accent.primary,
  anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "Act I · The identity machine: grid, basis vectors, and a matrix at rest.", tag: "shear.amx"
cap2: Caption, text: "Act II · k climbs: every point slides by ky while horizontal lines stay put.", tag: "shear.amx", opacity: 0
cap3: Caption, text: "Act III · det = 1.0 throughout — same base, same height, same area.", tag: "shear.amx", opacity: 0

// ── the machine panel ───────────────────────────────────────────────
// Four live entries in their matrix positions plus the determinant. The
// values are declared at their resting formulas and rewritten every frame in
// `always` so the readouts track the animation in playback.
panel: Rect, size: (520, 420), corner_radius: 18, color: surface.secondary,
  stroke: stroke.default, stroke_width: 1.2, at: (356, 380), opacity: 0.9

panel_title: Text, text: "MATRIX M", font_size: 18, font_family: "mono", color: text.secondary,
  text_anchor: "left", anchor: scene.top_left, offset: (112, 180), opacity: 1

a_chip: Readout, label: "COL 1 · ROW 1", value: format("{:.1}", 1.0), at: (232, 252)
b_chip: Readout, label: "COL 2 · ROW 1", value: format("{:.1}", 1.0 + shear), at: (480, 252)
c_chip: Readout, label: "COL 1 · ROW 2", value: format("{:.1}", 0.0), at: (232, 344)
d_chip: Readout, label: "COL 2 · ROW 2", value: format("{:.1}", 1.0), at: (480, 344)

det_chip: Readout, label: "DETERMINANT", value: format("{:.1}", 1.0), at: (232, 470)
det_note: Text, text: "area scale = |det M|", font_size: 20, color: text.muted,
  text_anchor: "left", anchor: scene.top_left, offset: (372, 458), opacity: 1

formula: Text, text: "M = [[1, k], [0, 1]]", font_size: 20, font_family: "mono",
  color: text.secondary, text_anchor: "left", anchor: scene.top_left, offset: (112, 546), opacity: 1

// ── the plane ───────────────────────────────────────────────────────
// A Mask owns the whole plane: the sheared grid would otherwise sweep past
// the plate's right edge (a vertical at x=3 reaches x=5.4 once k=1). The
// clip shape is the plate itself; every child below lives in its local frame.
plane: Mask, size: (600, 480), at: (916, 420), opacity: 1 {
  clip_shape: Rect, size: (600, 480), opacity: 1

  grid_card: Rect, size: (600, 480), corner_radius: 18, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2, opacity: 0.72

  // Screen-blended radial wash behind the grid: the payoff flare and the
  // resting after-glow (DESIGN §1.8 allows one light system over the floor;
  // it lives inside the plate, not over it).
  bloom: Ellipse, size: (700, 540), blend: "screen", opacity: 0,
    fill_gradient: radial((0.5, 0.5), 0.70, {(0%, accent.primary * 0.32), (55%, accent.primary * 0.10), (100%, (0, 0, 0, 0))})

  // Seven vertical and seven horizontal grid lines. Declared from the
  // param baseline; the whole field is re-derived each frame in `always`.
  for gx, i in {-3, -2, -1, 0, 1, 2, 3} {
    gv[i]: Line, from: (cx + s * (gx - 2.4 * k0), cy + s * 2.4),
      to: (cx + s * (gx + 2.4 * k0), cy - s * 2.4),
      stroke: stroke.default, stroke_width: 1.3, opacity: 0.75
  }

  for gy, i in {-2.4, -1.6, -0.8, 0, 0.8, 1.6, 2.4} {
    gh[i]: Line, from: (cx + s * (-3.2 + k0 * gy), cy - s * gy),
      to: (cx + s * (3.2 + k0 * gy), cy - s * gy),
      stroke: stroke.default, stroke_width: 1.3, opacity: 0.75
  }

  x_axis: Line, from: (cx - s * 3.2, cy), to: (cx + s * 3.2, cy),
    stroke: text.muted, stroke_width: 1.8, opacity: 0.9
  y_axis: Line, from: (cx - s * 2.4 * k0, cy + s * 2.4), to: (cx + s * 2.4 * k0, cy - s * 2.4),
    stroke: text.muted, stroke_width: 1.8, opacity: 0.9

  origin_dot: Ellipse, size: (10, 10), color: accent.primary, at: (cx, cy), opacity: 1
  x_lab: Text, text: "x", font_size: 18, color: text.muted, at: (cx + s * 3.2 - 12, cy + 16), opacity: 1
  y_lab: Text, text: "y", font_size: 18, color: text.muted, at: (cx + s * 2.4 * k0 + 14, cy - s * 2.4 + 6), opacity: 1

  // The unit square, tracked as four edges: the parallelogram whose area the
  // determinant measures.
  sq_bottom: Line, from: (cx, cy), to: (cx + s, cy), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_top: Line, from: (cx + s * k0, cy - s), to: (cx + s * (1 + k0), cy - s),
    stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_left: Line, from: (cx, cy), to: (cx + s * k0, cy - s), stroke: accent.warning, stroke_width: 2.4, opacity: 0.95
  sq_right: Line, from: (cx + s, cy), to: (cx + s * (1 + k0), cy - s),
    stroke: accent.warning, stroke_width: 2.4, opacity: 0.95

  // The two basis vectors — the columns of M, which is the whole lesson.
  i_hat: Arrow, from: (cx, cy), to: (cx + s, cy), head_size: 12,
    stroke: accent.primary, stroke_width: 4, opacity: 1
  j_hat: Arrow, from: (cx, cy), to: (cx + s * k0, cy - s), head_size: 12,
    stroke: accent.info, stroke_width: 4, opacity: 1
  i_t: Text, text: "i", font_size: 22, color: accent.primary, at: (cx + s + 20, cy - 14), opacity: 1
  j_t: Text, text: "j", font_size: 22, color: accent.info, at: (cx + s * k0 + 16, cy - s - 16), opacity: 1
}

#0.2s
fade-in sq_bottom [360ms, ease: expo-out]
fade-in sq_top [360ms, delay: 60ms, ease: expo-out]
fade-in sq_left [360ms, delay: 120ms, ease: expo-out]
fade-in sq_right [360ms, delay: 180ms, ease: expo-out]

#1.0s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]

always {
  // Smoothstep sweep, 0.35s → 5.15s. `shear` is the build-time baseline: the
  // frame-time value is baseline + sweep, so a --set rebuild bends the whole
  // animation without breaking its shape.
  let u = clamp((t - 0.35) / 4.8, 0, 1)
  let k = shear + u * u * (3 - 2 * u)
  let a = 1.0
  let b = k
  let c = 0.0
  let d = 1.0

  // Vertical grid lines: x = gx, y sweeps -2.4 … 2.4.
  for gx, i in {-3, -2, -1, 0, 1, 2, 3} {
    gv[i].from = (cx + s * (gx - 2.4 * k), cy + s * 2.4)
    gv[i].to = (cx + s * (gx + 2.4 * k), cy - s * 2.4)
  }

  // Horizontal grid lines: y = gy, x sweeps -3.2 … 3.2.
  for gy, i in {-2.4, -1.6, -0.8, 0, 0.8, 1.6, 2.4} {
    gh[i].from = (cx + s * (-3.2 + k * gy), cy - s * gy)
    gh[i].to = (cx + s * (3.2 + k * gy), cy - s * gy)
  }

  // The y-axis is the grid line x = 0; it shears with every other vertical.
  y_axis.from = (cx - s * 2.4 * k, cy + s * 2.4)
  y_axis.to = (cx + s * 2.4 * k, cy - s * 2.4)
  y_lab.at = (cx + s * 2.4 * k + 14, cy - s * 2.4 + 6)

  // The unit square in matrix coordinates: (0,0), (1,0), (1,1), (0,1).
  sq_bottom.from = (cx + s * (a * 0 + b * 0), cy - s * (c * 0 + d * 0))
  sq_bottom.to = (cx + s * (a * 1 + b * 0), cy - s * (c * 1 + d * 0))
  sq_top.from = (cx + s * (a * 0 + b * 1), cy - s * (c * 0 + d * 1))
  sq_top.to = (cx + s * (a * 1 + b * 1), cy - s * (c * 1 + d * 1))
  sq_left.from = (cx, cy)
  sq_left.to = (cx + s * (a * 0 + b * 1), cy - s * (c * 0 + d * 1))
  sq_right.from = (cx + s * a, cy - s * c)
  sq_right.to = (cx + s * (a + b), cy - s * (c + d))

  // Basis vectors and their labels.
  i_hat.to = (cx + s * a, cy - s * c)
  j_hat.to = (cx + s * b, cy - s * d)
  i_t.at = (cx + s * a + 20, cy - s * c - 14)
  j_t.at = (cx + s * b + 16, cy - s * d - 16)

  // Live matrix entries and determinant. The declared strings are the resting
  // values; these writes are what the player shows.
  a_chip.value_text.text = format("{:.1}", a)
  b_chip.value_text.text = format("{:.1}", b)
  c_chip.value_text.text = format("{:.1}", c)
  d_chip.value_text.text = format("{:.1}", d)
  det_chip.value_text.text = format("{:.1}", a * d - b * c)
}

// ── Act III · payoff ────────────────────────────────────────────────
// The bloom sweeps up behind the plane while the camera pushes a touch and
// settles back, so the resting frame is the full sheared grid with the
// parallelogram, both basis vectors and det = 1.0 held on the lit stage.
#5.8s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
bloom.opacity = 0.42 [700ms, ease: expo-out]
camera.zoom = 1.06 [1.2s, ease: ease-in-out]

#7.0s
bloom.opacity = 0.18 [800ms, ease: ease-in-out]
camera.zoom = 1.0 [1.0s, ease: ease-in-out]

// ── Rest ────────────────────────────────────────────────────────────
// The sheared grid, the parallelogram, both basis vectors and the matrix
// chips hold; nothing erases.
