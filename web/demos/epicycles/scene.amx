import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config {
  colorscheme: "ink",
  resolution: (1280, 720),
  dynamic_layout: true,
}

// Fourier series of a square wave: y(x) = (4/pi) * sum over odd k of sin(k x)/k
// Epicycle radii (screen px, base 110): r_k = 110 * 4 / (pi * k) for odd k.
// The pen/wave phase is locked: theta does TWO turns over a scene span, the
// wave x advances at the same rate (12.566 = 4pi), and both map +sin to +y,
// so the tie-line is exactly horizontal — the "pen height = wave height"
// claim the scenes teach.
//
// The Equation-Fragments bug is dodged — see the Hero scene's eq_row.

// ── Scene 1: Goal — the finished square wave draws itself ───────────────────

# Goal
config { colorscheme: "ink", dynamic_layout: true, duration: 6.5 }

goal_title: Text, text: "Drawing a Square Wave with Circles", font_size: 44,
  font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)

goal_graph: Graph, at: (640, 400), size: (900, 380),
  x_domain: (0, 12.566), y_domain: (-2, 2) {
  goal_wave: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * (sin(x) + sin(3 * x) / 3 + sin(5 * x) / 5 + sin(7 * x) / 7),
    color: accent.primary, stroke_width: 3, stroke_progress: 0
}

goal_hint: Text, text: "the destination — a square wave built from circles",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -44)

#0.1s
fade-in goal_title [600ms, ease: expo-out]
fade-in goal_graph [600ms, ease: expo-out]

#1.2s
fade-in goal_wave [400ms, ease: expo-out]

#1.5s
goal_wave.stroke_progress = 1.0 [3s, ease: ease-in-out]

#5.2s
fade-in goal_hint [500ms, ease: expo-out]

// Clear the title slot before the crossfade: both acts title at
// `scene.top, offset: (0, 52)`, so a `fade` between them superimposes the two
// headings into an unreadable smear.
#5.6s
fade-out goal_title [350ms, ease: ease-in]
fade-out goal_hint [300ms, ease: ease-in]

#6s
play OneCircle [fade, 500ms]

// ── Scene 2: One Circle — constant rotation traces a sine ───────────────────

# OneCircle
config { colorscheme: "ink", dynamic_layout: true, duration: 15 }

one_title: Text, text: "1. One circle, one sine", font_size: 36, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 52)

one_circle: Ellipse, size: (280, 280), stroke: accent.info,
  fill_opacity: 0, stroke_width: 2, at: (280, 400)

pen: Ellipse, size: (18, 18), color: accent.primary, at: (420, 400)

one_graph: Graph, at: (830, 400), size: (760, 440),
  x_domain: (0, 12.566), y_domain: (-2, 2) {
  sine: PlotCurve, kind: "parametric",
    func: (s) => (s, (4 / pi) * sin(s)),
    t_domain: (0, 12.566),
    color: accent.primary, stroke_width: 3, stroke_progress: 0
}

wave_dot: Ellipse, size: (14, 14), color: accent.primary, at: (830, 400)

// The tie-line is driven from the always block below (an actor-center read
// here would freeze it at its build-time stub).
link: Line, from: (420, 400), to: (830, 400),
  stroke: accent.primary, stroke_width: 1.5, opacity: 0.45

one_hint: Text, text: "the pen rides the rim — height over time is a sine",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -44)

#0.05s
fade-in one_title [500ms, ease: expo-out]
fade-in one_circle [500ms, ease: expo-out]
fade-in pen [400ms, delay: 200ms, ease: expo-out]
fade-in one_graph [500ms, delay: 300ms, ease: expo-out]
fade-in wave_dot [400ms, delay: 400ms, ease: expo-out]
fade-in link [400ms, delay: 400ms, ease: expo-out]

#1s
sine.stroke_progress = 1.0 [12s, ease: linear]

always {
  // two turns while the wave advances the full x_domain (4pi = 12.566)
  let th = 4 * pi * clamp(t - 1.0, 0.0, 12.0) / 12.0
  let px = 12.566 * clamp(t - 1.0, 0.0, 12.0) / 12.0
  pen.at = (280 + 140 * cos(th), 400 - 140 * sin(th))
  let wy = (4 / pi) * sin(px)
  // Graph maps x_domain (0, 12.566) / y_domain (-2, 2) onto the 760x440 box
  // at (830, 400): screen = (450 + 60.5 x, 400 + 110 y) — same +y sense as
  // the pen, so the tie-line stays horizontal.
  wave_dot.at = (450 + 60.5 * px, 400 - 110 * wy)
  link.from = (280 + 140 * cos(th), 400 - 140 * sin(th))
  link.to = (450 + 60.5 * px, 400 - 110 * wy)
}

#13.8s
fade-in one_hint [400ms, ease: expo-out]

#14s
fade-out one_title [350ms, ease: ease-in]
fade-out one_hint [300ms, ease: ease-in]

#14.4s
play Hero [wipe-left, 500ms]

// ── Scene 3: Hero — circles stack up, the wave grows into a square ──────────

# Hero
config { colorscheme: "ink", dynamic_layout: true, duration: 22 }

hero_title: Text, text: "2. Stack the odd harmonics", font_size: 36, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 52)

c1: Ellipse, size: (280, 280), stroke: accent.info,
  fill_opacity: 0, stroke_width: 2, at: (280, 400)
c2: Ellipse, size: (94, 94), stroke: accent.success,
  fill_opacity: 0, stroke_width: 2, at: (420, 400)
c3: Ellipse, size: (56, 56), stroke: accent.primary,
  fill_opacity: 0, stroke_width: 2, at: (466, 400), opacity: 0
c4: Ellipse, size: (40, 40), stroke: accent.danger,
  fill_opacity: 0, stroke_width: 2, at: (494, 400), opacity: 0

tip: Ellipse, size: (14, 14), color: accent.primary, at: (420, 400)

hero_graph: Graph, at: (830, 400), size: (760, 440),
  x_domain: (0, 12.566), y_domain: (-2, 2) {
  hero_wave: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * sin(x),
    color: accent.primary, stroke_width: 3, stroke_progress: 0
}

wave_tip: Ellipse, size: (12, 12), color: accent.primary, at: (830, 400)

hero_link: Line, from: (420, 400), to: (830, 400),
  stroke: accent.primary, stroke_width: 1.5, opacity: 0.45

// The harmonic terms are a Row of separate Text actors so each one can be
// highlighted on its own beat. (Equation Fragments are dodged deliberately:
// a leading "+" renders as "1." — docs/roadmap.md.)
eq_row: Row, anchor: scene.bottom, offset: (0, -64), gap: 12, align: "center" {
  eq_y: Text, text: "y(x) = sin x", font_size: 26, color: text.secondary
  eq_3: Text, text: "+ sin 3x/3", font_size: 26, color: text.secondary
  eq_5: Text, text: "+ sin 5x/5", font_size: 26, color: text.secondary
  eq_7: Text, text: "+ sin 7x/7", font_size: 26, color: text.secondary
}

#0.05s
fade-in hero_title [500ms, ease: expo-out]
fade-in c1 [500ms, ease: expo-out]
fade-in c2 [500ms, ease: expo-out]
fade-in tip [400ms, delay: 200ms, ease: expo-out]
fade-in hero_graph [500ms, delay: 300ms, ease: expo-out]
fade-in wave_tip [400ms, delay: 500ms, ease: expo-out]
fade-in hero_link [400ms, delay: 500ms, ease: expo-out]
fade-in eq_row [500ms, delay: 500ms, ease: expo-out]

#1s
hero_wave.stroke_progress = 1.0 [20s, ease: linear]

// Epicycle chain: every center is an analytic function of t. The graph maps
// +y UP so every sin term subtracts from screen y — tip height == wave-dot
// height, tie-line horizontal and on the curve. w3/w5/w7 ramp each harmonic
// in on its reveal beat so the tip never leaves the visible chain.
always {
  // two turns over the 20s span; the wave x advances at the same rate
  let th = 4 * pi * clamp(t - 1.0, 0.0, 20.0) / 20.0
  let w3 = clamp((t - 4.0) / 1.5, 0.0, 1.0)
  let w5 = clamp((t - 9.0) / 1.5, 0.0, 1.0)
  let w7 = clamp((t - 14.0) / 1.5, 0.0, 1.0)
  let r1 = 140
  let r3 = 140 / 3
  let r5 = 140 / 5
  let r7 = 140 / 7
  let c2x = 280 + r1 * cos(th)
  let c2y = 400 - r1 * sin(th)
  c2.at = (c2x, c2y)
  let c3x = c2x + w3 * r3 * cos(3 * th)
  let c3y = c2y - w3 * r3 * sin(3 * th)
  c3.at = (c3x, c3y)
  let c4x = c3x + w5 * r5 * cos(5 * th)
  let c4y = c3y - w5 * r5 * sin(5 * th)
  c4.at = (c4x, c4y)
  let tipx = c4x + w7 * r7 * cos(7 * th)
  let tipy = c4y - w7 * r7 * sin(7 * th)
  tip.at = (tipx, tipy)
  let x_now = 12.566 * clamp(t - 1.0, 0.0, 20.0) / 20.0
  let wy = (4 / pi) * (sin(x_now) + w3 * sin(3 * x_now) / 3 + w5 * sin(5 * x_now) / 5 + w7 * sin(7 * x_now) / 7)
  // Same linear mapping as the OneCircle scene (hero_graph geometry).
  let dotx = 450 + 60.5 * x_now
  let doty = 400 - 110 * wy
  wave_tip.at = (dotx, doty)
  hero_link.from = (tipx, tipy)
  hero_link.to = (dotx, doty)
}

// The wave grows: function transitions add harmonic after harmonic. The
// eq-term highlight is the one-beat drama voice (coral), then it returns.
#4s
hero_wave.func = (x) => (4 / pi) * (sin(x) + sin(3 * x) / 3) [1.5s]
fade-in c3 [400ms, ease: expo-out]
eq_3.color = accent.warning [400ms]

#5.5s
eq_3.color = text.secondary [400ms]

#9s
hero_wave.func = (x) => (4 / pi) * (sin(x) + sin(3 * x) / 3 + sin(5 * x) / 5) [1.5s]
fade-in c4 [400ms, ease: expo-out]
eq_5.color = accent.warning [400ms]

#10.5s
eq_5.color = text.secondary [400ms]

#14s
hero_wave.func = (x) => (4 / pi) * (sin(x) + sin(3 * x) / 3 + sin(5 * x) / 5 + sin(7 * x) / 7) [1.5s]
eq_7.color = accent.warning [400ms]

#15.5s
eq_7.color = text.secondary [400ms]

#21.1s
fade-out hero_title [350ms, ease: ease-in]

#21.5s
play Spectrum [wipe-left, 500ms]

// ── Scene 4: Spectrum — 1/k amplitude decay ─────────────────────────────────

# Spectrum
config { colorscheme: "ink", dynamic_layout: true, duration: 4 }

spec_title: Text, text: "3. Only odd harmonics, shrinking as 1/k", font_size: 36,
  font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)

spec_eq: Text, text: "a(k) = 4 / (pi k)   for odd k,   0   otherwise",
  font_size: 24, color: accent.primary, anchor: scene.center, offset: (0, -215)

// Amber bars with the 7th harmonic as the one-beat coral accent (it is the
// term the Hero scene just landed).
spectrum: BarChart,
  data: {("k=1", 140), ("k=3", 47), ("k=5", 28), ("k=7", 20)},
  size: (760, 360),
  bar_colors: {accent.primary, accent.primary, accent.primary, accent.warning},
  show_axis: true,
  show_labels: true,
  at: (640, 400)

spec_note: Text, text: "1/k decay", font_size: 20,
  color: accent.primary, anchor: scene.center, offset: (-430, -120)

#0.05s
fade-in spec_title [500ms, ease: expo-out]
fade-in spec_eq [500ms, delay: 200ms, ease: expo-out]

#1.2s
fade-in spectrum [800ms, ease: expo-out]
fade-in spec_note [500ms, delay: 500ms, ease: expo-out]

#3.5s
play ComplexPlane [fade, 500ms]

// ── Scene 5: Complex Plane — e^{i theta} ────────────────────────────────────

# ComplexPlane
config { colorscheme: "ink", dynamic_layout: true, duration: 12 }

cp_title: Text, text: "4. Why circles? Complex exponentials", font_size: 36,
  font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)

grid: NumberPlane, x_domain: (-1.6, 1.6), y_domain: (-1.2, 1.2),
  size: (640, 480), at: (420, 400),
  x_range: (-1, 1, 1), y_range: (-1, 1, 1),
  color: surface.secondary, stroke_width: 1.0

unit_circle: Ellipse, size: (400, 400), stroke: accent.info,
  fill_opacity: 0, stroke_width: 2, at: (420, 400)

vector: Line, from: (420, 400), to: (620, 400),
  stroke: accent.primary, stroke_width: 3

vec_tip: Ellipse, size: (14, 14), color: accent.primary, at: (620, 400)

cp_eq: Text, text: "e^(i theta) = cos(theta) + i sin(theta)", font_size: 26,
  color: accent.primary, anchor: scene.center, offset: (330, -60)

cp_note: Text, text: "each circle is one term e^(i k theta) with radius a_k",
  font_size: 20, color: text.secondary, anchor: scene.center, offset: (330, 20)

endnote: Text, text: "sum enough circles and even a square wave is just rotation",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -48)

always {
  let th = 2 * pi * clamp(t - 0.8, 0.0, 10.0) / 10.0
  vector.to = (420 + 200 * cos(th), 400 - 200 * sin(th))
  vec_tip.at = (420 + 200 * cos(th), 400 - 200 * sin(th))
}

#0.05s
fade-in cp_title [500ms, ease: expo-out]
fade-in grid [600ms, ease: expo-out]
fade-in unit_circle [600ms, ease: expo-out]

#1s
fade-in vector [400ms, ease: expo-out]
fade-in vec_tip [400ms, ease: expo-out]

#2s
fade-in cp_eq [600ms, ease: expo-out]
fade-in cp_note [500ms, delay: 300ms, ease: expo-out]

#4s
fade-in endnote [600ms, ease: expo-out]

// Outro: quiet plate before the document loops.
#11.2s
stagger [60ms] {
  fade-out endnote [300ms, ease: ease-in]
  fade-out cp_note [300ms, ease: ease-in]
  fade-out cp_eq [300ms, ease: ease-in]
  fade-out vec_tip [300ms, ease: ease-in]
  fade-out vector [300ms, ease: ease-in]
  fade-out unit_circle [300ms, ease: ease-in]
  fade-out grid [300ms, ease: ease-in]
  fade-out cp_title [300ms, ease: ease-in]
}
