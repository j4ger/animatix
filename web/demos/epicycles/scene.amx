// scene.amx — the plate: the whole walkthrough in one playthrough.
//
// GENERATED — do not edit. This file is derived from the five act files by
// `scripts/epicycles-plate.py`; edit an act and re-run it. `--check` fails when
// this file no longer matches its sources, so the two cannot drift apart
// quietly.
//
// Why a generated file and not a thin plate: a `play` statement only lives
// inside a scene body, so an imported act that stays chain-free for its own
// embed on the page can never be told what comes next from the outside.
// (examples/gallery/brand_reel/main.amx gets away with a thin plate only
// because none of its scenes is also embedded standalone.)
//
// Two things worth knowing about the schedule:
//
//   * A `play` fires when its scene's `duration` elapses, minus the transition.
//     The `#Xs` stamp in front of a `play` is parsed but dropped by the
//     composition builder, so the durations above are the schedule.
//   * Every join is a wipe, and each act's headings clear themselves just
//     before it. All five acts title at `scene.top, offset: (0, 52)`; a `fade`
//     would superimpose two of them into an unreadable third.

import "../../demos/lib/theme.amx"
import "fourier.amx" as geo

config {
  colorscheme: "ink",
  resolution: (1280, 720),
  dynamic_layout: true,
}

// ── act: Goal  (source: goal.amx) ────────────────────────────────────────────

# Goal
config { colorscheme: "ink", dynamic_layout: true, duration: 6.8 }

goal_title: Text, text: "Drawing a Square Wave with Circles", font_size: 42,
  font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)

goal_graph: Graph, at: (640, geo.cy), size: (1000, 2 * geo.y_hi * pi * geo.R / 4),
  x_domain: (0, geo.span), y_domain: (geo.y_lo, geo.y_hi), tick_labels: "y" {
  hi: PlotCurve, kind: "cartesian", func: (x) => 1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
  lo: PlotCurve, kind: "cartesian", func: (x) => -1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
  goal_wave: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * (sin(x) + sin(3 * x) / 3 + sin(5 * x) / 5 + sin(7 * x) / 7),
    color: accent.primary, stroke_width: 3.5, stroke_progress: 0
}

goal_axis: Text, text: "x — two full turns", font_size: 17, color: text.muted,
  anchor: scene.center, offset: (0, 238)

goal_hint: Text, text: "four sine waves added — frequencies 1, 3, 5, 7, amplitudes 1/k",
  font_size: 20, color: text.secondary, anchor: scene.bottom, offset: (0, -44)

#0.15s
fade-in goal_title [550ms, ease: expo-out]
fade-in goal_graph [550ms, ease: expo-out]

#0.9s
fade-in hi, lo [400ms, ease: expo-out]

#1.4s
fade-in goal_wave [300ms, ease: expo-out]
goal_wave.stroke_progress = 1.0 [3.2s, ease: ease-in-out]

#5s
fade-in goal_hint, goal_axis [500ms, ease: expo-out]

// Plate only: the next act titles at the same anchor.
#5.95s
fade-out goal_title [350ms, ease: ease-in]
fade-out goal_axis [350ms, ease: ease-in]
fade-out goal_hint [350ms, ease: ease-in]


play OneCircle [wipe-left, 500ms]

// ── act: OneCircle  (source: onecircle.amx) ──────────────────────────────────

# OneCircle
config { colorscheme: "ink", dynamic_layout: true, duration: 12.4 }

// The pen's angle, published by the always block and read by the plot closure,
// so the wave is the pen's own history rather than a second copy of the clock.
let th_now = 0.0

one_title: Text, text: "One circle, one sine", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 52)

one_circle: Ellipse, size: (2 * geo.R, 2 * geo.R), stroke: accent.info,
  fill_opacity: 0, stroke_width: 2, at: (geo.pivot_x, geo.cy)

// The radius the pen sits on. Without it the circle is a decoration and the
// pen is a dot that happens to be near it.
one_spoke: Line, from: (geo.pivot_x, geo.cy), to: (geo.pivot_x + geo.R, geo.cy),
  stroke: accent.info, stroke_width: 2, opacity: 0.55

one_hub: Ellipse, size: (9, 9), color: accent.info, at: (geo.pivot_x, geo.cy)

pen: Ellipse, size: (18, 18), color: accent.primary, at: (geo.pivot_x + geo.R, geo.cy)

one_graph: Graph, at: (geo.graph_cx, geo.cy), size: (geo.graph_w, 2 * geo.y_hi * pi * geo.R / 4),
  x_domain: (0, geo.span), y_domain: (geo.y_lo, geo.y_hi), tick_labels: "y" {
  hi: PlotCurve, kind: "cartesian", func: (x) => 1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
  lo: PlotCurve, kind: "cartesian", func: (x) => -1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
  sine: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * sin(th_now - x),
    color: accent.primary, stroke_width: 3.5
}

// Pinned to the plot's left edge, where the wave's newest sample lives.
wave_dot: Ellipse, size: (14, 14), color: accent.primary,
  at: (geo.graph_cx - geo.graph_w / 2, geo.cy)

// The projection line: thin and dim so it reads as a guide, not as a second
// curve competing with the sine for the eye. (`Line` has no `dash_pattern` —
// only stroke paths do — so weight and opacity carry the distinction.)
link: Line, from: (geo.pivot_x + geo.R, geo.cy), to: (geo.graph_cx - geo.graph_w / 2, geo.cy),
  stroke: accent.secondary, stroke_width: 1.25, opacity: 0.26

one_axis: Text, text: "the pen's history — newest under the ball", font_size: 17,
  color: text.muted, anchor: scene.center, offset: (230, 238)

one_hint: Text, text: "the pen's height and the curve's height are the same number",
  font_size: 20, color: text.secondary, anchor: scene.bottom, offset: (0, -44)

#0.15s
fade-in one_title [550ms, ease: expo-out]
stagger [90ms] {
  fade-in one_circle [500ms, ease: expo-out]
  fade-in one_spoke [400ms, ease: expo-out]
  fade-in one_hub [300ms, ease: expo-out]
}
fade-in one_graph [550ms, delay: 200ms, ease: expo-out]

#0.95s
stagger [90ms] {
  fade-in pen [400ms, ease: expo-out]
  fade-in wave_dot [400ms, ease: expo-out]
  fade-in link [400ms, ease: expo-out]
}

#1.4s
fade-in hi, lo [400ms, ease: expo-out]
fade-in sine [300ms, ease: expo-out]

always {
  let u = clamp((t - 1.4) / 9.2, 0.0, 1.0)
  th_now = geo.span * u
  let px = geo.pivot_x + geo.R * cos(th_now)
  let py = geo.cy - geo.R * sin(th_now)
  pen.at = (px, py)
  one_spoke.to = (px, py)
  // The wave's newest sample, at the plot's left edge, is the pen's own height.
  // (Bound to names because a path-call like `one_graph.map(…)` rejects binary
  // operators in its argument list — see docs/roadmap.md.)
  let dx = 0.0
  let wy = (4 / pi) * sin(th_now)
  let dp = one_graph.map(dx, wy)
  wave_dot.at = dp
  link.from = (px, py)
  link.to = dp
}

#10.8s
fade-in one_hint, one_axis [500ms, ease: expo-out]

// Plate only: the next act titles at the same anchor.
#11.55s
fade-out one_title [350ms, ease: ease-in]
fade-out one_hint [350ms, ease: ease-in]


play Hero [wipe-left, 500ms]

// ── act: Hero  (source: hero.amx) ────────────────────────────────────────────

# Hero
config { colorscheme: "ink", dynamic_layout: true, duration: 19.4 }

// Harmonic identity: one hue per odd k, reused by the chain, the equation row
// and the spectrum in §04 so the reader can track k=5 across three figures.
let cols = {accent.info, accent.success, accent.primary, accent.danger}

// The pen's angle, published by the always block and read by the plot closure,
// so the wave is the chain's own history rather than a second copy of the clock.
let th_now = 0.0

let g3 = 0.0
let g5 = 0.0
let g7 = 0.0

hero_title: Text, text: "Stack the odd harmonics", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 52)

hero_hub: Ellipse, size: (9, 9), color: text.muted, at: (geo.pivot_x, geo.cy)

for k, i in {1, 3, 5, 7} {
  ring[i]: Ellipse, size: (2 * geo.R / k, 2 * geo.R / k), stroke: cols[i],
    fill_opacity: 0, stroke_width: 2, at: (geo.pivot_x, geo.cy)  // scaled per frame, see always
  arm[i]: Line, from: (geo.pivot_x, geo.cy), to: (geo.pivot_x, geo.cy),
    stroke: cols[i], stroke_width: 1.5, opacity: 0.5
}

tip: Ellipse, size: (16, 16), color: accent.primary, at: (geo.pivot_x + geo.R, geo.cy)

hero_graph: Graph, at: (geo.graph_cx, geo.cy), size: (geo.graph_w, 2 * geo.y_hi * pi * geo.R / 4),
  x_domain: (0, geo.span), y_domain: (geo.y_lo, geo.y_hi), tick_labels: "y" {
    hi: PlotCurve, kind: "cartesian", func: (x) => 1,
      stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
    lo: PlotCurve, kind: "cartesian", func: (x) => -1,
      stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}
    hero_wave: PlotCurve, kind: "cartesian",
      func: (x) => (4 / pi) * (sin(th_now - x) + g3 * sin(3 * (th_now - x)) / 3 + g5 * sin(5 * (th_now - x)) / 5 + g7 * sin(7 * (th_now - x)) / 7),
      color: accent.primary, stroke_width: 3.5
}

// Pinned to the plot's left edge, where the wave's newest sample lives.
wave_dot: Ellipse, size: (14, 14), color: accent.primary,
  at: (geo.graph_cx - geo.graph_w / 2, geo.cy)

hero_link: Line, from: (geo.pivot_x + geo.R, geo.cy), to: (geo.graph_cx - geo.graph_w / 2, geo.cy),
  stroke: accent.secondary, stroke_width: 1.25, opacity: 0.26

// Each term carries its harmonic's hue and appears on the beat its circle is
// added. An opacity-0 child still holds its layout slot, so the row is spaced
// for the finished equation from the start and never jumps as it fills out.
eq_row: Row, anchor: scene.bottom, offset: (0, -64), gap: 12, align: "center" {
  eq_1: Text, text: "y(x) = sin x", font_size: 25, color: accent.info
  for k, i in {3, 5, 7} {
    eqt[i]: Text, text: format("+ sin {:.0}x/{:.0}", k, k), font_size: 25,
      color: cols[i + 1], opacity: 0
  }
}

hero_hint: Text, text: "each circle is one term — and the tip draws the sum",
  font_size: 20, color: text.secondary, anchor: scene.bottom, offset: (0, -104)

#0.15s
fade-in hero_title [550ms, ease: expo-out]
fade-in hero_graph [550ms, ease: expo-out]
fade-in ring__0, arm__0, hero_hub [450ms, ease: expo-out]

#0.95s
stagger [80ms] {
  fade-in tip [400ms, ease: expo-out]
  fade-in wave_dot [400ms, ease: expo-out]
  fade-in hero_link [400ms, ease: expo-out]
  fade-in eq_1 [400ms, ease: expo-out]
}

#1.4s
fade-in hi, lo [400ms, ease: expo-out]
fade-in hero_wave [300ms, ease: expo-out]

// The beats here and the `g*` ramps in the always block are the same three
// numbers on purpose; a new harmonic means one line in each place, not four.
#4s
fade-in ring__1, arm__1, eqt__0 [450ms, ease: expo-out]

#9s
fade-in ring__2, arm__2, eqt__1 [450ms, ease: expo-out]

#14s
fade-in ring__3, arm__3, eqt__2 [450ms, ease: expo-out]

always {
  let s3 = clamp((t - 4.0) / 1.5, 0.0, 1.0)
  let s5 = clamp((t - 9.0) / 1.5, 0.0, 1.0)
  let s7 = clamp((t - 14.0) / 1.5, 0.0, 1.0)
  // Smoothstep, not the raw ramp. A linear clamp has a velocity kink at both
  // ends, and the wave morphs at exactly that rate, so each gate started and
  // stopped its reshape with a visible twitch.
  g3 = s3 * s3 * (3 - 2 * s3)
  g5 = s5 * s5 * (3 - 2 * s5)
  g7 = s7 * s7 * (3 - 2 * s7)

  let u = clamp((t - 1.4) / 16.0, 0.0, 1.0)
  th_now = geo.span * u
  let th = th_now
  let wts = {1.0, g3, g5, g7}
  let rad = {geo.R, geo.R / 3, geo.R / 5, geo.R / 7}

  // Walk the chain: circle i is centred where harmonic i-1's vector ended, and
  // its own weighted radius reaches the next centre. `sum` is the same partial
  // sum the plotted function evaluates at x = th.
  let cx = geo.pivot_x
  let cy = geo.cy
  let sum = 0.0
  for k, i in {1, 3, 5, 7} {
    ring[i].at = (cx, cy)
    arm[i].from = (cx, cy)
    let reach = wts[i] * rad[i]
    let nx = cx + reach * cos(k * th)
    let ny = cy - reach * sin(k * th)
    arm[i].to = (nx, ny)
    // The circle is scaled to its own weight, so its rim passes through the
    // joint the arm reaches: radius (R/k)·wts[i] = reach, exactly. Declaring a
    // constant radius while the arm ramped up from zero left the joint sitting
    // at a fraction of the way to a full-size circle for the whole 1.5s.
    // A multiplier says "this circle, shrunk by its weight" without restating
    // the radius the declaration above already carries.
    ring[i].scale = wts[i]
    let sum = sum + wts[i] * sin(k * th) / k
    let cx = nx
    let cy = ny
  }
  tip.at = (cx, cy)

  // Bound to names because a path-call (`hero_graph.map(…)`) rejects binary
  // operators in its argument list — see docs/roadmap.md.
  let dx = 0.0
  let dy = (4 / pi) * sum
  let dp = hero_graph.map(dx, dy)
  wave_dot.at = dp
  hero_link.from = (cx, cy)
  hero_link.to = dp
}

#18s
fade-in hero_hint [500ms, ease: expo-out]

// Plate only: the next act titles at the same anchor.
#18.55s
fade-out hero_title [350ms, ease: ease-in]
fade-out hero_hint [350ms, ease: ease-in]
fade-out eq_row [350ms, ease: ease-in]


play Spectrum [wipe-left, 500ms]

// ── act: Spectrum  (source: spectrum.amx) ────────────────────────────────────

# Spectrum
config { colorscheme: "ink", dynamic_layout: true, duration: 8.6 }

spec_title: Text, text: "Only odd harmonics, shrinking as 1/k", font_size: 38,
  font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)

spec_eq: Text, text: "a(k) = 1/k for odd k, 0 for even k", font_size: 24,
  color: text.secondary, anchor: scene.top, offset: (0, 104)

// One hue per harmonic, in k order, matching the chain and the equation row in
// §03. Spelled out because `bar_colors` wants a literal colour list — a `let`
// path falls back to `auto` rather than resolving.
spec_bars: BarChart,
  data: {(1, 1.0), (2, 0), (3, 0.3333), (4, 0), (5, 0.2), (6, 0), (7, 0.1429), (8, 0)},
  size: (880, 360),
  bar_width: 62,
  max_value: 1.05,
  bar_colors: {accent.info, surface.secondary, accent.success, surface.secondary,
    accent.primary, surface.secondary, accent.danger, surface.secondary},
  show_axis: true,
  show_labels: true,
  at: (640, 386)

spec_note: Text, text: "the empty columns are the even harmonics a square wave cancels",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -44)

#0.15s
fade-in spec_title [550ms, ease: expo-out]
fade-in spec_eq [450ms, delay: 120ms, ease: expo-out]

#1.1s
fade-in spec_bars [800ms, ease: expo-out]

#3.6s
