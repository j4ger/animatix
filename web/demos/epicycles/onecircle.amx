// house-style: one-circle act; three acts, payoff is a screen-blend bloom of the traced sine.
//
// §02 a sine is rotation seen from the side. A pen rides the rim of a turning
// circle; its height over time traces a sine. Nothing is precomputed and
// nothing is keyframed: one `always` block reads the clock, and the pen, the
// spoke and the trace are all analytic functions of t.
//
// The wave is a *scrolling history*, not a trimmed stroke: the plotted function
// is sin(θ_now − x), so the newest sample sits at the plot's left edge under
// the pen and the paper moves right. That choice is load-bearing. The earlier
// version drew the sine with `stroke_progress` and parked a ball on its leading
// edge, and the two could never agree — the trim overshoots by one segment of
// the plot's adaptive tessellation (~1% of the domain), which on a steep part
// of the descent poked ~20px of ink out from under the ball. Here the marker
// sits at a fixed x with nothing to chase: the window is always full, so the
// pen-to-wave relation is continuously visible instead of living on an edge.
//
// The tie-line stays horizontal because the plot box is authored
// `2 * y_hi * pi * R / 4` tall (see fourier.amx), which pins both columns to
// one y-scale. The rest frame stops the clock at 94% of the sweep instead of a
// full 4π, so the held frame keeps the spoke and pen off-axis — a circle with a
// visible radius, not a dot on a hub.

import "../../demos/lib/theme.amx"
import "../../demos/lib/stage.amx"
import "fourier.amx" as geo

config { resolution: (1280, 720) }

# OneCircle
config { colorscheme: "orchid", dynamic_layout: true, duration: 9.6 }

// Plot frame geometry, derived from the shared R/cy so the tie-line invariant
// (fourier.amx) holds for every act that draws this box.
let plot_h = 2 * geo.y_hi * pi * geo.R / 4
let plot_l = geo.graph_cx - geo.graph_w / 2
let plot_t = geo.cy - plot_h / 2

// The pen's angle, published by the always block and read by the plot closure,
// so the wave is the pen's own history rather than a second copy of the clock.
let th_now = 0.0

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.2

// Kept as `one_title` because the generated plate clears each act's heading
// before its wipe; the label is part of that contract.
one_title: ActHead, kicker: "FIG 02 · ONE CIRCLE, ONE SINE",
  title: "A circle seen from the side", sub: "the pen's shadow writes the curve"

cap1: Caption, text: "Act I · A pen rides the rim; the circle turns once.", tag: "onecircle.amx"
cap2: Caption, text: "Act II · Project the pen's height and the curve writes itself.", tag: "onecircle.amx", opacity: 0
cap3: Caption, text: "Act III · One full turn, one full wave — the same number in two places.", tag: "onecircle.amx", opacity: 0

// ── the turning circle ──────────────────────────────────────────────
one_circle: Ellipse, size: (2 * geo.R, 2 * geo.R), stroke: accent.info,
  fill_opacity: 0, stroke_width: 2, at: (geo.pivot_x, geo.cy), opacity: 1

// The radius the pen sits on. Without it the circle is a decoration and the
// pen is a dot that happens to be near it.
one_spoke: Line, from: (geo.pivot_x, geo.cy), to: (geo.pivot_x + geo.R, geo.cy),
  stroke: accent.info, stroke_width: 2, opacity: 0.6

one_hub: Ellipse, size: (9, 9), color: accent.info, at: (geo.pivot_x, geo.cy), opacity: 1
pen: Ellipse, size: (18, 18), color: accent.primary, at: (geo.pivot_x + geo.R, geo.cy), opacity: 1

// ── the plot ────────────────────────────────────────────────────────
one_graph: Graph, at: (geo.graph_cx, geo.cy), size: (geo.graph_w, plot_h),
  x_domain: (0, geo.span), y_domain: (geo.y_lo, geo.y_hi),
  grid: "false", ticks: "false", tick_labels: "false", opacity: 1 {
  hi: PlotCurve, kind: "cartesian", func: (x) => 1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}, opacity: 1
  lo: PlotCurve, kind: "cartesian", func: (x) => -1,
    stroke: stroke.default, stroke_width: 1.5, dash_pattern: {9, 7}, opacity: 1
  sine: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * sin(th_now - x),
    color: accent.primary, stroke_width: 3.5, opacity: 1
  sine_glow: PlotCurve, kind: "cartesian",
    func: (x) => (4 / pi) * sin(th_now - x),
    color: accent.primary, stroke_width: 14, blend: "screen", opacity: 0
}

// Pinned to the plot's left edge, where the wave's newest sample lives.
wave_dot: Ellipse, size: (14, 14), color: accent.primary,
  at: (plot_l, geo.cy), opacity: 1

// The projection line: thin and dim so it reads as a guide, not as a second
// curve competing with the sine for the eye. (`Line` has no `dash_pattern` —
// only stroke paths do — so weight and opacity carry the distinction.)
link: Line, from: (geo.pivot_x + geo.R, geo.cy), to: (plot_l, geo.cy),
  stroke: accent.secondary, stroke_width: 1.25, opacity: 0.26

// Hand-drawn y labels: Graph's own tick labels compile at 10 px, below the
// house-style floor. Graph still draws its axis and arrow; only the numbers are
// ours, at a readable 16 px.
ylab_p1: Text, text: "+1", font_size: 16, font_family: "mono", color: text.muted,
  text_anchor: "right", at: (plot_l - 14, geo.cy - pi * geo.R / 4), opacity: 0.9
ylab_0: Text, text: "0", font_size: 16, font_family: "mono", color: text.muted,
  text_anchor: "right", at: (plot_l - 14, geo.cy), opacity: 0.9
ylab_m1: Text, text: "-1", font_size: 16, font_family: "mono", color: text.muted,
  text_anchor: "right", at: (plot_l - 14, geo.cy + pi * geo.R / 4), opacity: 0.9

one_axis: Text, text: "θ — the pen's history, newest under the ball", font_size: 16,
  color: text.muted, text_anchor: "left", at: (plot_l, plot_t - 26), opacity: 0.9

// ── the editorial column ────────────────────────────────────────────
one_formula: Text, text: "h = sin θ", font_size: 26, color: accent.primary,
  text_anchor: "center", at: (geo.pivot_x, geo.cy + geo.R + 42), opacity: 0
one_hint: Text, text: "the pen's height and the curve's height are the same number",
  font_size: 18, color: text.secondary, text_align: "left", text_anchor: "left",
  text_max_width: 380, anchor: scene.top_left, offset: (96, 600), opacity: 0

// ── the numbers ─────────────────────────────────────────────────────
chip_h: Readout, label: "HARMONICS", value: "1", at: (620, 613), opacity: 0
chip_f: Readout, label: "FREQUENCY", value: "1×", at: (880, 613), opacity: 0
chip_a: Readout, label: "AMPLITUDE", value: "1.00", at: (1140, 613), opacity: 0

// ── Act I · the hook ────────────────────────────────────────────────
#0.15s
pulse one_circle [600ms, intensity: 0.04]

// ── Act II · the mechanism ──────────────────────────────────────────
#2.2s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]

#4.6s
fade-in one_formula [420ms, ease: expo-out]
fade-in one_hint [420ms, delay: 120ms, ease: expo-out]
stagger [110ms] {
  fade-in chip_h [380ms, ease: expo-out]
  fade-in chip_f [380ms, ease: expo-out]
  fade-in chip_a [380ms, ease: expo-out]
}

// ── Act III · the payoff ────────────────────────────────────────────
// The traced sine gets its screen-blend bloom and the camera pushes a touch
// and settles, leaving one full turn and one full wave as the rest frame.
#6.8s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
sine_glow.opacity = 0.30 [700ms, ease: expo-out]
camera.zoom = 1.04 [1.2s, ease: ease-in-out]

#7.9s
sine_glow.opacity = 0.16 [700ms, ease: ease-in-out]
camera.zoom = 1.0 [1.0s, ease: ease-in-out]

// ── Rest ────────────────────────────────────────────────────────────
// The circle, its spoke and pen, the completed wave and its readouts hold.
// The clock stops at 94% of the sweep so the rest frame keeps the radius
// visible rather than parking the spoke on the x-axis.

always {
  let u = clamp((t - 0.15) / 8.2, 0.0, 0.94)
  th_now = geo.span * u
  let px = geo.pivot_x + geo.R * cos(th_now)
  let py = geo.cy - geo.R * sin(th_now)
  pen.at = (px, py)
  one_spoke.to = (px, py)
  // The wave's newest sample, at the plot's left edge, is the pen's own height.
  // (Bound to names because a path-call like `one_graph.map(…)` rejects binary
  // operators in its argument list — see docs/roadmap.md.)
  let dx = 0.0
  let wy = (4 / pi) * sin(th_now)
  let dp = one_graph.map(dx, wy)
  wave_dot.at = dp
  link.from = (px, py)
  link.to = dp
}
