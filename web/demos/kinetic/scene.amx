// Kinetic Typography & Glass Studio — An interactive motion design showcase.
// Showcases:
//   - Split-text reveal-in with baseline masking
//   - Linear text gradient brush
//   - 2.5D perspective tilt and analytical soft shadows
//   - Frosted Glass backdrop blur with sharp foreground typography

import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.0 }

// ── Background Canvas & Atmosphere ─────────────────────────────────────────
bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
ambient_l: Ellipse, size: (720, 720), at: (280, 240),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b94228"), (50%, "#f5b9420c"), (100%, "#f5b94200")}),
  blend: "screen"
ambient_r: Ellipse, size: (760, 760), at: (1000, 460),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#fb718526"), (50%, "#c084fc0e"), (100%, "#c084fc00")}),
  blend: "screen"

// ── Header Typography with Gradient & Mask ────────────────────────────────
header: Col, anchor: scene.top, offset: (0, 46), gap: 8, align: "center" {
  badge: Chip, label: "KINETIC DESIGN LAB", width: 160, height: 26, color: surface.primary, text_color: accent.primary
  headline: Text,
    text: "Fluid Typography & Spatial Depth",
    font_size: 38,
    font_weight: "bold",
    fill_gradient: linear(90, {"#f5b942", "#fb7185", "#c084fc"}),
    text_align: "center"
  subline: Text,
    text: "Split-text baseline emergence, 2.5D perspective tilt, and real-time frosted glass",
    font_size: 15,
    color: text.secondary,
    text_align: "center"
}

// ── Backdrop Geometry Plate (Provides texture for Glass blur) ──────────────
plate: Group, at: (640, 410) {
  for (dx, h, dy, col), i in {
    (-280, 260, 20, accent.primary),
    (-180, 340, -20, accent.warning),
    (-80, 200, 50, accent.info),
    (20, 300, 0, accent.primary),
    (120, 360, -30, accent.warning),
    (220, 240, 30, accent.info)
  } {
    bars[i]: Rect, size: (52, h), at: (dx, dy), color: col, corner_radius: 10, opacity: 0.50
  }
}

// ── Floating 2.5D Glass Card with Shadow & Tilt ─────────────────────────────
glass_card: Glass, at: (640, 410), size: (620, 280), corner_radius: 20 {
  frost: Blur, radius: 24
  surface: Rect, size: (620, 280), corner_radius: 20,
    color: "#ffffff16", stroke: "#ffffff55", stroke_width: 1.5,
    shadow: (0, 28, 56, 0), shadow_color: (0, 0, 0, 0.55)
  content: Col, size: (560, 220), gap: 12, align: "center" {
    card_kicker: Text, text: "SPATIAL MOTION SCOPE", font_size: 12, font_weight: 600, color: accent.primary
    card_title: Text, text: "Tactile Digital Physics", font_size: 30, font_weight: "bold", color: text.primary
    card_desc: Text,
      text: "Every layer projects into 2.5D coordinate space with real-time perspective distortion, spring-driven momentum, and zero rasterization artifacts.",
      font_size: 14, color: text.secondary, text_align: "center", text_max_width: 500
    card_hud: Row, gap: 16, align: "center" {
      pill_blur: Chip, label: "24px Gaussian Frost", width: 165, height: 28, color: surface.secondary, text_color: text.primary
      pill_fps: Chip, label: "60 FPS WebGPU", width: 145, height: 28, color: surface.secondary, text_color: accent.success
    }
  }
}

// ── Timeline Choreography ──────────────────────────────────────────────────
#0.0s
fade-in ambient_l [500ms]
fade-in ambient_r [500ms]
fade-in header [400ms]
fade-in plate [400ms]
fade-in glass_card [400ms]

#0.3s
reveal-in headline [by: word, offset_y: 22, 700ms, ease: ease-out]

#1.2s
glass_card.rotate_y = 0.18 [1.6s, ease: ease-in-out]
glass_card.rotate_x = -0.10 [1.6s, ease: ease-in-out]

#3.6s
glass_card.rotate_y = -0.12 [1.8s, ease: ease-in-out]
glass_card.rotate_x = 0.08 [1.8s, ease: ease-in-out]

#6.0s
glass_card.rotate_y = 0.0 [1.2s, ease: ease-out]
glass_card.rotate_x = 0.0 [1.2s, ease: ease-out]
