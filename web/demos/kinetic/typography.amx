// Split-Text Baseline Masks & Gradients — Scene 1 of Kinetic Studio
import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"
import "../../demos/lib/ambience.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Ambience, tint: accent.primary

h_kicker: Text, text: "KINETIC STUDIO", font_size: 11, font_weight: 600, color: accent.primary,
  anchor: scene.top, offset: (0, 36)
h_title: Text, text: "Split-Text Kinetic Typography", font_size: 32, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 68)
h_sub: Text, text: "Word-by-word reveal animations with baseline clipping and linear gradient fill",
  font_size: 14, color: text.secondary, anchor: scene.top, offset: (0, 98)

stage_box: Rect, size: (920, 280), color: surface.primary, corner_radius: 16,
  stroke: stroke.default, stroke_width: 1, at: (640, 380)

quote: Col, at: (640, 380), gap: 18, align: "center" {
  l1: Text, text: "Motion is meaning, not decoration.", font_size: 34, font_weight: "bold",
    fill_gradient: linear(90, {"#f5b942", "#fb7185"}), text_align: "center"
  l2: Text, text: "Choreographed with declarative precision across time and space.", font_size: 20, color: text.secondary, text_align: "center"
  author: Text, text: "— ANIMATIX KINETIC MANIFESTO", font_size: 12, font_weight: 600, color: text.muted, letter_spacing: 3
}

#0.0s
fade-in h_kicker [400ms, ease: expo-out]
fade-in h_title [500ms, delay: 50ms, ease: expo-out]
fade-in h_sub [500ms, delay: 100ms, ease: expo-out]
fade-in stage_box [400ms]
fade-in quote [400ms]

#0.4s
reveal-in l1 [by: word, offset_y: 24, 700ms, ease: ease-out]

#1.2s
reveal-in l2 [by: word, offset_y: 18, 700ms, ease: ease-out]
