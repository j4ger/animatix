// Split-Text Baseline Masks & Gradients — Scene 1 of Kinetic Studio
import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
ambient: Ellipse, size: (800, 500), color: (0.96, 0.72, 0.26, 0.16), at: (640, 360), opacity: 0.8

stage_box: Rect, size: (920, 280), color: surface.primary, corner_radius: 16, stroke: stroke.default, stroke_width: 1, at: (640, 360)

quote: Col, at: (640, 360), gap: 18, align: "center" {
  l1: Text, text: "Motion is meaning, not decoration.", font_size: 34, font_weight: "bold",
    fill_gradient: linear(90, {"#f5b942", "#fb7185"}), text_align: "center"
  l2: Text, text: "Choreographed with declarative precision across time and space.", font_size: 21, color: text.secondary, text_align: "center"
  author: Text, text: "— ANIMATIX KINETIC MANIFESTO", font_size: 13, font_weight: 600, color: text.muted, letter_spacing: 3
}

#0.0s
fade-in stage_box [400ms]
fade-in quote [400ms]

#0.4s
reveal-in l1 [by: word, offset_y: 24, 700ms, ease: ease-out]

#1.2s
reveal-in l2 [by: word, offset_y: 18, 700ms, ease: ease-out]

always {
  ambient.at = (640 + 35 * sin(t * 1.2), 360 + 20 * cos(t * 0.9))
  ambient.opacity = 0.5 + 0.3 * sin(t * 1.5)
}
