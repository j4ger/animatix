// 2.5D Perspective Projection & Frosted Glass — Scene 2 of Kinetic Studio
import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"
import "../../demos/lib/ambience.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Ambience, tint: accent.info

h_kicker: Text, text: "KINETIC STUDIO", font_size: 11, font_weight: 600, color: accent.info,
  anchor: scene.top, offset: (0, 36)
h_title: Text, text: "Frosted Glass & 2.5D Projection", font_size: 32, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 68)
h_sub: Text, text: "Dynamic pitch and yaw transforms with real-time GPU backdrop blur",
  font_size: 14, color: text.secondary, anchor: scene.top, offset: (0, 98)

pattern: Group, at: (640, 380) {
  for (dx, h, dy, col), i in {
    (-220, 260, 10, accent.primary),
    (-110, 320, -20, accent.warning),
    (0, 240, 30, accent.info),
    (110, 300, -10, accent.primary),
    (220, 210, 20, accent.warning)
  } {
    bars[i]: Rect, size: (48, h), at: (dx, dy), color: col, corner_radius: 8, opacity: 0.38
  }
}

glass: Glass, at: (640, 380), size: (580, 280), corner_radius: 20 {
  frost: Blur, radius: 24
  surface: Rect, size: (580, 280), corner_radius: 20, color: "#ffffff14", stroke: "#ffffff40", stroke_width: 1.5,
    shadow: (0, 20, 40, 0), shadow_color: (0, 0, 0, 0.4)
  body: Col, size: (520, 220), gap: 12, align: "center" {
    tag: Text, text: "GPU BACKDROP SHADER", font_size: 13, font_weight: 600, color: accent.primary
    lbl: Text, text: "Perspective Projection", font_size: 34, font_weight: "bold", color: text.primary
    desc: Text, text: "Pitch and yaw transforms simulate physical material elevation above background layers.", font_size: 15, color: text.secondary, text_align: "center", text_max_width: 480
  }
}

#0.0s
fade-in h_kicker [400ms, ease: expo-out]
fade-in h_title [500ms, delay: 50ms, ease: expo-out]
fade-in h_sub [500ms, delay: 100ms, ease: expo-out]
fade-in pattern [400ms]
fade-in glass [400ms]

#1.0s
glass.rotate_y = 0.22 [1.8s, ease: ease-in-out]
glass.rotate_x = -0.12 [1.8s, ease: ease-in-out]

#3.5s
glass.rotate_y = -0.15 [1.6s, ease: ease-in-out]
glass.rotate_x = 0.08 [1.6s, ease: ease-in-out]

#5.2s
glass.rotate_y = 0.0 [800ms, ease: ease-out]
glass.rotate_x = 0.0 [800ms, ease: ease-out]
