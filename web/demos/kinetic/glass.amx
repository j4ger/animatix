// 2.5D Perspective Projection & Frosted Glass — Scene 2 of Kinetic Studio
import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
ambient: Ellipse, size: (600, 600), color: (0.54, 0.71, 0.97, 0.12), at: (640, 360), opacity: 0.8

header: Col, anchor: scene.top, offset: (0, 60), gap: 8, align: "center" {
  badge: Chip, label: "02 · 2.5D PERSPECTIVE & GLASS", width: 230, height: 26, color: surface.primary, text_color: accent.primary
  title: Text, text: "2.5D Spatial Perspective & Backdrop Blur", font_size: 38, font_weight: "bold", color: text.primary
  subtitle: Text, text: "Three-dimensional angular tilt with real-time GPU texture sampling", font_size: 15, color: text.secondary
}

pattern: Group, at: (640, 400) {
  for (dx, h, dy, col), i in {
    (-200, 220, 10, accent.primary),
    (-100, 280, -20, accent.warning),
    (0, 200, 30, accent.info),
    (100, 260, -10, accent.primary),
    (200, 180, 20, accent.warning)
  } {
    bars[i]: Rect, size: (44, h), at: (dx, dy), color: col, corner_radius: 8, opacity: 0.35
  }
}

glass: Glass, at: (640, 400), size: (540, 260), corner_radius: 20 {
  frost: Blur, radius: 24
  surface: Rect, size: (540, 260), corner_radius: 20, color: "#ffffff14", stroke: "#ffffff40", stroke_width: 1.5,
    shadow: (0, 20, 40, 0), shadow_color: (0, 0, 0, 0.4)
  body: Col, size: (480, 200), gap: 10, align: "center" {
    tag: Text, text: "GPU BACKDROP SHADER", font_size: 12, font_weight: 600, color: accent.primary
    lbl: Text, text: "Perspective Projection", font_size: 32, font_weight: "bold", color: text.primary
    desc: Text, text: "Pitch and yaw transforms simulate physical material elevation above background layers.", font_size: 14, color: text.secondary, text_align: "center", text_max_width: 440
  }
}

#0.0s
fade-in header [400ms]
fade-in pattern [400ms]
fade-in glass [400ms]

#1.0s
glass.rotate_y = 0.22 [1.8s, ease: ease-in-out]
glass.rotate_x = -0.12 [1.8s, ease: ease-in-out]

#3.5s
glass.rotate_y = -0.15 [1.6s, ease: ease-in-out]
glass.rotate_x = 0.08 [1.6s, ease: ease-in-out]

#5.2s
glass.rotate_y = 0.0 [800ms, ease: ease-out]
glass.rotate_x = 0.0 [800ms, ease: ease-out]
