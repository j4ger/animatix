// Morph Lab: Generative Vector Kinetics
// Showcases declarative shape morphing across topological strategies:
//   - match: vertex-index correspondence
//   - path_arc: circular trajectory hinting
//   - stretch: proportional length remapping

import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"
import "../../demos/lib/ambience.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.5 }

// Ambient dynamic lighting
bg: Ambience, tint: accent.primary

// Architecture Header
h_kicker: Text, text: "MORPH LAB", font_size: 11, font_weight: 600, color: accent.primary,
  anchor: scene.top, offset: (0, 36)
h_title: Text, text: "Generative Vector Kinetics", font_size: 32, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 68)
h_sub: Text, text: "Continuous topological interpolation across vertex correspondence, arc curvature, and length remapping",
  font_size: 14, color: text.secondary, anchor: scene.top, offset: (0, 98)

// Stage pedestals / glass frames
pod_l: Rect, size: (300, 360), at: (260, 390), corner_radius: 16,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
pod_c: Rect, size: (300, 360), at: (640, 390), corner_radius: 16,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
pod_r: Rect, size: (300, 360), at: (1020, 390), corner_radius: 16,
  color: surface.primary, stroke: stroke.default, stroke_width: 1

// Pedestal Headers
lbl_l: Text, text: "VERTEX CORRESPONDENCE", font_size: 11, font_weight: 600, color: text.muted, at: (260, 240)
lbl_c: Text, text: "ARC CURVATURE TRAJECTORY", font_size: 11, font_weight: 600, color: text.muted, at: (640, 240)
lbl_r: Text, text: "PROPORTIONAL REMAPPING", font_size: 11, font_weight: 600, color: text.muted, at: (1020, 240)

// Strategy badges
tag_l: Chip, label: "strategy: match", width: 140, height: 28, color: surface.secondary, text_color: accent.warning, at: (260, 530)
tag_c: Chip, label: "path_arc: 0.35", width: 140, height: 28, color: surface.secondary, text_color: accent.info, at: (640, 530)
tag_r: Chip, label: "stretch: true", width: 140, height: 28, color: surface.secondary, text_color: accent.success, at: (1020, 530)

// The Three Morphing Actors
shape_a: Path,
  commands: {move_to(-65, -15), curve_to(-20, -65, 45, -60, 65, -10), curve_to(80, 45, 15, 70, -30, 50), curve_to(-70, 35, -85, 20, -65, -15)},
  color: accent.primary, at: (260, 385)

shape_b: Polygon,
  points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)},
  color: accent.info, at: (640, 385)

shape_c: Ellipse, size: (120, 120), color: accent.success, at: (1020, 385)

caption: Text, text: "Animatix synthesizes intermediate cubic Bezier control points in real-time at 60 FPS",
  font_size: 13, color: text.muted, anchor: scene.bottom, offset: (0, -24)

#0.0s
fade-in h_kicker [400ms, ease: expo-out]
fade-in h_title [500ms, delay: 50ms, ease: expo-out]
fade-in h_sub [500ms, delay: 100ms, ease: expo-out]
fade-in pod_l [400ms]
fade-in pod_c [400ms]
fade-in pod_r [400ms]
fade-in lbl_l [400ms]
fade-in lbl_c [400ms]
fade-in lbl_r [400ms]
fade-in tag_l [400ms]
fade-in tag_c [400ms]
fade-in tag_r [400ms]
fade-in shape_a [500ms]
fade-in shape_b [500ms]
fade-in shape_c [500ms]
fade-in caption [500ms]

// Wave 1: Morph to new geometries
#1.6s
shape_a: Polygon, points: {(0, -65), (65, 0), (0, 65), (-65, 0)}, color: accent.warning, at: (260, 385) [1.1s, strategy: match]
shape_b: Polygon, points: {(0, -60), (35, -35), (60, 0), (35, 35), (0, 60), (-35, 35), (-60, 0), (-35, -35)}, color: accent.primary, at: (640, 385) [1.1s, path_arc: 0.35]
shape_c: Rect, size: (110, 110), corner_radius: 20, color: accent.info, at: (1020, 385) [1.1s, stretch: true]

// Wave 2: Morph to circular and acute forms
#3.8s
shape_a: Ellipse, size: (130, 130), color: accent.primary, at: (260, 385) [1.2s, strategy: match]
shape_b: Ellipse, size: (130, 130), color: accent.success, at: (640, 385) [1.2s, path_arc: 0.35]
shape_c: Polygon, points: {(0, -65), (55, 45), (-55, 45)}, color: accent.warning, at: (1020, 385) [1.2s, stretch: true]

// Wave 3: Harmonic convergence — all three become luminous 10-point stars
#6.0s
shape_a: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.primary, at: (260, 385) [1.2s, strategy: match]
shape_b: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.info, at: (640, 385) [1.2s, path_arc: 0.35]
shape_c: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.success, at: (1020, 385) [1.2s, stretch: true]

// Closing settle: pulse
#7.4s
pulse shape_a [600ms, intensity: 1.15]
pulse shape_b [600ms, intensity: 1.15]
pulse shape_c [600ms, intensity: 1.15]
