// Morph Lab: Generative Vector Kinetics
// Showcases declarative shape morphing across topological strategies:
//   - match: vertex-index correspondence
//   - path_arc: circular trajectory hinting
//   - stretch: proportional length remapping

import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.5 }

// Ambient lighting & stage
bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
wash_l: Ellipse, size: (720, 720), at: (320, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b94220"), (50%, "#f5b94208"), (100%, "#f5b94200")}),
  blend: "screen"
wash_c: Ellipse, size: (680, 680), at: (640, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#38bdf81c"), (50%, "#38bdf806"), (100%, "#38bdf800")}),
  blend: "screen"
wash_r: Ellipse, size: (720, 720), at: (960, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#34d3991e"), (50%, "#34d39906"), (100%, "#34d39900")}),
  blend: "screen"

// Header
header: Col, anchor: scene.top, offset: (0, 78), gap: 8, align: "center" {
  badge: Chip, label: "TOPOLOGICAL SYNTHESIS", width: 190, height: 26, color: surface.primary, text_color: accent.primary
  title: Text, text: "Generative Shape Morphing", font_size: 36, font_weight: "bold",
    fill_gradient: linear(90, {"#f5b942", "#38bdf8", "#34d399"}), text_align: "center"
  sub: Text, text: "Continuous vector interpolation across three mathematical transformation strategies", font_size: 15, color: text.secondary
}

// Stage pedestals / glass frames
pod_l: Rect, size: (270, 290), at: (320, 400), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1
pod_c: Rect, size: (270, 290), at: (640, 400), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1
pod_r: Rect, size: (270, 290), at: (960, 400), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1

// Strategy tags
tag_l: Text, text: "strategy: match", font_size: 13, font_weight: 600, color: accent.primary, at: (320, 510)
tag_c: Text, text: "path_arc: 0.35", font_size: 13, font_weight: 600, color: accent.info, at: (640, 510)
tag_r: Text, text: "stretch: true", font_size: 13, font_weight: 600, color: accent.success, at: (960, 510)

// The Three Morphing Actors
shape_a: Path,
  commands: {move_to(-65, -15), curve_to(-20, -65, 45, -60, 65, -10), curve_to(80, 45, 15, 70, -30, 50), curve_to(-70, 35, -85, 20, -65, -15)},
  color: accent.primary, at: (320, 380)

shape_b: Polygon,
  points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)},
  color: accent.info, at: (640, 380)

shape_c: Ellipse, size: (120, 120), color: accent.success, at: (960, 380)

#0.0s
fade-in wash_l [500ms]
fade-in wash_c [500ms]
fade-in wash_r [500ms]
fade-in header [400ms]
fade-in pod_l [400ms]
fade-in pod_c [400ms]
fade-in pod_r [400ms]
fade-in tag_l [400ms]
fade-in tag_c [400ms]
fade-in tag_r [400ms]
fade-in shape_a [500ms]
fade-in shape_b [500ms]
fade-in shape_c [500ms]

// Wave 1: Morph to new geometries
#1.6s
shape_a: Polygon, points: {(0, -65), (65, 0), (0, 65), (-65, 0)}, color: accent.warning, at: (320, 380) [1.1s, strategy: match]
shape_b: Polygon, points: {(0, -60), (35, -35), (60, 0), (35, 35), (0, 60), (-35, 35), (-60, 0), (-35, -35)}, color: accent.primary, at: (640, 380) [1.1s, path_arc: 0.35]
shape_c: Rect, size: (110, 110), corner_radius: 20, color: accent.info, at: (960, 380) [1.1s, stretch: true]

// Wave 2: Morph to circular and acute forms
#3.8s
shape_a: Ellipse, size: (130, 130), color: accent.primary, at: (320, 380) [1.2s, strategy: match]
shape_b: Ellipse, size: (130, 130), color: accent.success, at: (640, 380) [1.2s, path_arc: 0.35]
shape_c: Polygon, points: {(0, -65), (55, 45), (-55, 45)}, color: accent.warning, at: (960, 380) [1.2s, stretch: true]

// Wave 3: Harmonic convergence — all three become luminous 10-point stars
#6.0s
shape_a: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.primary, at: (320, 380) [1.2s, strategy: match]
shape_b: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.info, at: (640, 380) [1.2s, path_arc: 0.35]
shape_c: Polygon, points: {(0, -60), (15, -20), (55, -20), (22, 8), (35, 50), (0, 25), (-35, 50), (-22, 8), (-55, -20), (-15, -20)}, color: accent.success, at: (960, 380) [1.2s, stretch: true]

// Closing settle: pulse
#7.4s
pulse shape_a [600ms, intensity: 1.15]
pulse shape_b [600ms, intensity: 1.15]
pulse shape_c [600ms, intensity: 1.15]
