import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
bg_glow: Ellipse, size: (600, 350), color: (0.09, 0.12, 0.18, 0.4), at: (640, 360), opacity: 0.5

header: Col, anchor: scene.top, offset: (0, 60), gap: 6, align: "center" {
  badge: Chip, label: "01 · EDGE INGRESS", width: 140, height: 26, color: surface.primary, text_color: accent.primary
  title: Text, text: "Client Edge & Line-Rate TLS Termination", font_size: 32, font_weight: "bold", color: text.primary
  subtitle: Text, text: "Stateless proxies terminate HTTP/2 and HTTP/3 before stripping credentials", font_size: 15, color: text.secondary
}

client_box: CardNode, title: "Public Internet", eyebrow: "CLIENTS", sub: "Global Anycast DNS", at: (320, 380), width: 220, height: 100
envoy_box: CardNode, title: "Envoy Edge", eyebrow: "PROXY POOL", sub: "mTLS · Rate Limit · WAF", at: (680, 380), width: 230, height: 100, focal: true
internal_box: CardNode, title: "Internal Mesh", eyebrow: "VPC TRANSIT", sub: "WireGuard Overlay", at: (1020, 380), width: 200, height: 100

wire1: Connector, from: client_box.east, to: envoy_box.west, routing: "straight", arrow: true, stroke: accent.primary, stroke_width: 2.5
wire2: Connector, from: envoy_box.east, to: internal_box.west, routing: "straight", arrow: true, stroke: accent.success, stroke_width: 2.0

stat_panel: Rect, size: (780, 48), color: surface.primary, corner_radius: 8, stroke: stroke.default, anchor: scene.bottom, offset: (0, -40)
stat_row: Row, anchor: scene.bottom, offset: (0, -43), gap: 40, align: "center" {
  c_label: Text, text: "ACTIVE TLS SESSIONS:", font_size: 11, font_weight: 600, color: text.muted
  c_val: Counter, value: 12000, color: accent.primary, suffix: " conns"
  s_label: Text, text: "HANDSHAKE DURATION:", font_size: 11, font_weight: 600, color: text.muted
  s_val: Text, text: "0.42 ms (0-RTT)", font_size: 13, font_weight: 600, color: accent.success
}

#0.0s
fade-in header [400ms]
fade-in client_box [400ms]
fade-in envoy_box [400ms]
fade-in internal_box [400ms]
fade-in stat_panel [400ms]
fade-in stat_row [400ms]

#0.6s
stagger [150ms] {
  draw-in wire1 [500ms, ease: ease-out]
  draw-in wire2 [500ms, ease: ease-out]
}

#1.4s
c_val.value = 84500 [2.5s, ease: ease-out]
