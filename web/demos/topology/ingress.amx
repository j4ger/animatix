// house-style: Act I lights the edge, Act II turns it into a moving proxy pool, Act III pays off with a camera push into the pool and a bloom sweep along the ingress rail; rest is the whole edge fabric with packets still crossing.
//
// 01 · Edge ingress — "Every event enters at the edge."
//
// The old plate was a static box diagram: three cards, four connectors, a
// telemetry strip that changed once and then froze. This one is an event
// fabric. Packets are analytic functions of t and ride the two trunk rails
// (frame-time `always` positions), the rails themselves are dashed and march,
// a health scan sweeps the live Envoy replicas, and the throughput readout
// counts continuously. The `replicas` slider changes the drawn proxy fan-out.
//
// House-style §1: StageFloor, ActHead, panels and rows carry authored opacity,
// so frame 0 is a lit, titled stage. House-style §5: no text below 16 px —
// node labels are 18, readout values 28, captions 24.

import "../lib/theme.amx"
import "../lib/stage.amx"

config { colorscheme: "tide", resolution: (1280, 720), duration: 9.0 }

// Slider target: `--set replicas=N` redraws the proxy fan-out (2..4 edge pods).
let replicas = 3

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.15

head: ActHead, kicker: "FIG 01 · EDGE INGRESS", title: "Every event enters at the edge",
  sub: "anycast DNS → Envoy proxy pool → internal transit mesh"

cap1: Caption, text: "Act I · Clients tap in; the first packets cross the edge.", tag: "ingress.amx"
cap2: Caption, text: "Act II · The proxy pool fans out, scanning replicas while TLS sessions climb.", tag: "ingress.amx", opacity: 0
cap3: Caption, text: "Act III · The camera pushes into the pool and the ingress rail blooms.", tag: "ingress.amx", opacity: 0

// ── the three zones ─────────────────────────────────────────────────
// Dashed boundaries are the architecture, not the subject: they stay quiet so
// the packets and the live rows carry the eye.
edge_box: Rect, size: (260, 220), at: (185, 400), corner_radius: 14,
  color: (0.043, 0.055, 0.082, 0.45), stroke: stroke.default, stroke_width: 1.4,
  dash_pattern: {7, 7}, opacity: 1
proxy_box: Rect, size: (340, 270), at: (645, 400), corner_radius: 14,
  color: (0.043, 0.055, 0.082, 0.45), stroke: stroke.default, stroke_width: 1.4,
  dash_pattern: {7, 7}, opacity: 1
mesh_box: Rect, size: (260, 220), at: (1095, 400), corner_radius: 14,
  color: (0.043, 0.055, 0.082, 0.45), stroke: stroke.default, stroke_width: 1.4,
  dash_pattern: {7, 7}, opacity: 1

zone_edge: Text, text: "CLIENT EDGE", font_size: 18, font_weight: 600, color: text.secondary, at: (185, 312), opacity: 1
zone_proxy: Text, text: "ENVOY PROXY POOL", font_size: 18, font_weight: 600, color: accent.primary, at: (645, 288), opacity: 1
zone_mesh: Text, text: "TRANSIT MESH", font_size: 18, font_weight: 600, color: text.secondary, at: (1095, 312), opacity: 1

// ── client rows ─────────────────────────────────────────────────────
for i in {0, 1, 2} {
  client_row[i]: Rect, size: (224, 40), corner_radius: 9, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2, at: (185, 352 + i * 56), opacity: 1
  client_text[i]: Text, text: if i == 0 { "web · storefront" } else { if i == 1 { "mobile · app" } else { "partner · api" } },
    font_size: 18, color: text.primary, at: (185, 352 + i * 56), opacity: 1
}

// ── the live proxy pool (replicas drives the drawn fan-out) ─────────
for i in {0, 1, 2, 3, 4, 5} {
  proxy_slot[i]: Rect, size: (304, 30), corner_radius: 9,
    color: if i < replicas { surface.primary } else { surface.secondary },
    stroke: if i < replicas { accent.primary } else { stroke.default },
    stroke_width: 1.4, at: (645, 318 + i * 34),
    opacity: if i < replicas { 1 } else { 0.18 }
  proxy_text[i]: Text, text: format("envoy-0{:.0} · TLS", i + 1), font_size: 18,
    color: if i < replicas { text.primary } else { text.muted },
    at: (645, 318 + i * 34),
    opacity: if i < replicas { 1 } else { 0.02 }
}

// A health scan rides the active replicas; `always` places it on the slot that
// is currently being probed.
scan_bar: Rect, size: (288, 2), corner_radius: 1, color: accent.primary, at: (645, 372), opacity: 0
proxy_policy: Text, text: "mTLS · rate limit · WAF", font_size: 16, color: text.muted, at: (645, 524), opacity: 0

// ── transit rows ───────────────────────────────────────────────────
for i in {0, 1, 2} {
  mesh_row[i]: Rect, size: (224, 40), corner_radius: 9, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2, at: (1095, 352 + i * 56), opacity: 0
  mesh_text[i]: Text, text: if i == 0 { "api.v1 · sessions" } else { if i == 1 { "events.v1 · bus" } else { "billing.v1 · ledger" } },
    font_size: 18, color: text.primary, at: (1095, 352 + i * 56), opacity: 0
}

// ── the ingress rails ──────────────────────────────────────────────
// Dashed so the marching dash is visible; the wide screen-blended copies are
// the Act III bloom sweep along the same geometry.
trunk_in: Path, commands: {move_to(315, 400), line_to(475, 400)},
  stroke: accent.primary, stroke_width: 3, fill_opacity: 0.0, dash_pattern: {12, 10}, opacity: 0.95
trunk_out: Path, commands: {move_to(815, 400), line_to(965, 400)},
  stroke: accent.info, stroke_width: 3, fill_opacity: 0.0, dash_pattern: {12, 10}, opacity: 0

bloom_in: Path, commands: {move_to(315, 400), line_to(475, 400)},
  stroke: accent.primary, stroke_width: 18, fill_opacity: 0.0, blend: "screen",
  dash_pattern: {34, 54}, opacity: 0
bloom_out: Path, commands: {move_to(815, 400), line_to(965, 400)},
  stroke: accent.info, stroke_width: 16, fill_opacity: 0.0, blend: "screen",
  dash_pattern: {30, 60}, opacity: 0

// ── packet chips ───────────────────────────────────────────────────
// Eight chips, four per rail. Their phase offsets keep a steady stream rather
// than a convoy; at the resting frame they are still moving (house-style §2).
for c in {0, 1, 2, 3} {
  chip_in[c]: Rect, size: (18, 8), corner_radius: 4, color: accent.primary, at: (315, 400), opacity: 1
  chip_out[c]: Rect, size: (16, 8), corner_radius: 4, color: accent.info, at: (815, 400), opacity: 1
}

// ── readouts ───────────────────────────────────────────────────────
tput: Readout, label: "INGRESS THROUGHPUT", value: "184.5k msg/s", at: (305, 600), opacity: 1
rtt: Readout, label: "TLS HANDSHAKE", value: "0.4 ms", at: (645, 600), opacity: 1
reps: Readout, label: "EDGE REPLICAS", value: format("×{:.0}", replicas), at: (985, 600), opacity: 1

// ── live motion ────────────────────────────────────────────────────
// Positions, opacities and the scan are frame-time; text readouts are declared
// at their final values above and rewritten here for live counting only (the
// storyboard shows the declared string, by design).
always {
  for c in {0, 1, 2, 3} {
    let p = fract(t / 1.8 + c * 0.25)
    chip_in[c].at = (315 + 160 * p, 400)
    chip_in[c].opacity = clamp((0.96 - p) / 0.08, 0, 1)

    let q = fract(t / 1.55 + c * 0.25 + 0.35)
    chip_out[c].at = (815 + 150 * q, 400)
    chip_out[c].opacity = clamp((t - 2.3) / 0.3, 0, 1) * clamp((0.96 - q) / 0.08, 0, 1)
  }

  trunk_in.dash_offset = (t * 30) % 22
  trunk_out.dash_offset = (t * 34) % 22
  bloom_in.dash_offset = (t * 58) % 88
  bloom_out.dash_offset = (t * 66) % 90

  let slot = floor(fract(t * 0.45) * replicas)
  scan_bar.at = (645, 318 + slot * 34 + 13)
  scan_bar.opacity = if t > 0.9 { 0.55 } else { 0 }

  tput.value_text.text = format("{:.1}k msg/s", 184.5 + 4.2 * sin(t * 2.1) + 0.9 * sin(t * 7.3))
  rtt.value_text.text = format("{:.2} ms", 0.4 + 0.04 * sin(t * 2.7))
}

// ── Act I · the hook ───────────────────────────────────────────────
// The stage, both rails, the live readouts and the packet stream are already
// composed at frame 0 — there is no dead plate to wait out.

// ── Act II · the mechanism ─────────────────────────────────────────
#1.8s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 180ms, ease: expo-out]
fade-in proxy_policy [340ms, ease: expo-out]
pulse scan_bar [900ms, intensity: 0.04]

// The mechanism extends rightward: the transit mesh and its rail arrive once the
// proxy pool is established, so the diagram grows instead of just sitting there.
#2.2s
fade-in trunk_out [360ms, ease: expo-out]
stagger [90ms] {
  fade-in mesh_row__0 [340ms, ease: expo-out]
  fade-in mesh_row__1 [340ms, ease: expo-out]
  fade-in mesh_row__2 [340ms, ease: expo-out]
  fade-in mesh_text__0 [300ms, ease: expo-out]
  fade-in mesh_text__1 [300ms, ease: expo-out]
  fade-in mesh_text__2 [300ms, ease: expo-out]
}

// ── Act III · the payoff ───────────────────────────────────────────
#6.9s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 180ms, ease: expo-out]
camera.zoom = 1.07 [1.2s, ease: ease-in-out]
camera.at = (0, 0) [1.2s, ease: ease-in-out]
bloom_in.opacity = 0.42 [520ms, ease: expo-out]
bloom_out.opacity = 0.30 [520ms, delay: 120ms, ease: expo-out]

#8.0s
camera.zoom = 1.0 [1.0s, ease: ease-in-out]
bloom_in.opacity = 0.12 [900ms, ease: ease-in-out]
bloom_out.opacity = 0.08 [900ms, ease: ease-in-out]

// ── Rest ───────────────────────────────────────────────────────────
// The whole edge fabric holds — three zones, live proxy rows and readouts, with
// packets still crossing both rails at the held frame.
