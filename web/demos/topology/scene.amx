// The Distributed Event Fabric — An interactive architecture explainer.
// Showcases:
//   - Smart orthogonal Connector routing with fillet radiuses and directional arrowheads
//   - Structured CardNode and BoundaryBox system primitives
//   - Rolling Odometer Counter for live throughput telemetry
//   - Layout-first hierarchy with ink theme palette

import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"
import "../../demos/lib/ambience.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.0 }

// ── Background Ambience ───────────────────────────────────────────────────
bg: Ambience, tint: accent.primary, seed: 333

// ── Architecture Header ────────────────────────────────────────────────────
h_kicker: Text, text: "ARCHITECTURE REFERENCE", font_size: 11, font_weight: 600,
  color: accent.primary, anchor: scene.top, offset: (0, 36)
h_title: Text, text: "Distributed Event Fabric", font_size: 32, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 68)
h_sub: Text, text: "Partitioned event log with Raft consensus, 3x replication and tiered cold storage",
  font_size: 14, color: text.secondary, anchor: scene.top, offset: (0, 98)

// ── Architecture Boundaries ────────────────────────────────────────────────
vpc_edge: Rect, size: (290, 330), at: (230, 375), corner_radius: 12,
  stroke: stroke.default, stroke_width: 1.5, color: (0.08, 0.11, 0.16, 0.4), dash_pattern: {6, 6}
lbl_edge: Text, text: "EDGE INGRESS LAYER", font_size: 11, font_weight: 600,
  color: text.secondary, at: (230, 226)

vpc_core: Rect, size: (680, 330), at: (760, 375), corner_radius: 12,
  stroke: stroke.default, stroke_width: 1.5, color: (0.08, 0.11, 0.16, 0.4), dash_pattern: {6, 6}
lbl_core: Text, text: "EVENT STREAMING & CONSENSUS FABRIC", font_size: 11, font_weight: 600,
  color: text.secondary, at: (760, 226)

// ── Service Node Cards ─────────────────────────────────────────────────────
gateway: CardNode, title: "Envoy Gateway", eyebrow: "INGRESS", sub: "TLS Termination · Auth",
  at: (230, 375), width: 220, height: 95
stream: CardNode, title: "Event Log", eyebrow: "KAFKA / REDPANDA", sub: "Partitioned Buffer (3x Rep)",
  at: (560, 375), width: 230, height: 95, focal: true
raft: CardNode, title: "Raft Workers", eyebrow: "CONSENSUS", sub: "Leader Election · FSM",
  at: (880, 305), width: 210, height: 90
lake: CardNode, title: "Storage Lake", eyebrow: "PERSISTENCE", sub: "LSM Tree · Columnar",
  at: (880, 445), width: 210, height: 90

// ── Smart Connectors ───────────────────────────────────────────────────────
conn_ing: Connector,
  from: gateway.east,
  to: stream.west,
  routing: "straight",
  arrow: true,
  stroke: accent.primary,
  stroke_width: 2.5

conn_raft: Connector,
  from: stream.east,
  to: raft.west,
  routing: "elbow",
  corner_radius: 12,
  arrow: true,
  stroke: accent.primary,
  stroke_width: 2.0

conn_lake: Connector,
  from: stream.east,
  to: lake.west,
  routing: "elbow",
  corner_radius: 12,
  arrow: true,
  stroke: accent.info,
  stroke_width: 2.0

conn_sync: Connector,
  from: raft.south,
  to: lake.north,
  routing: "straight",
  arrow: true,
  stroke: accent.success,
  stroke_width: 1.5

// ── Telemetry HUD Strip ────────────────────────────────────────────────────
hud_panel: Rect, size: (1160, 52), color: surface.primary, corner_radius: 10,
  stroke: stroke.default, stroke_width: 1, anchor: scene.bottom, offset: (0, -28)

hud: Row, anchor: scene.bottom, offset: (0, -32), gap: 60, align: "center" {
  kpi_tps: Row, gap: 12, align: "center" {
    lbl_tps: Text, text: "INGRESS THROUGHPUT:", font_size: 11, font_weight: 600, color: text.muted
    val_tps: Text, text: "4,200 req/s", font_size: 14, font_weight: 600, color: accent.primary
  }
  kpi_lat: Row, gap: 10, align: "center" {
    lbl_lat: Text, text: "P99 LATENCY:", font_size: 11, font_weight: 600, color: text.muted
    val_lat: Text, text: "1.24 ms", font_size: 14, font_weight: 600, color: accent.success
  }
  kpi_health: Row, gap: 8, align: "center" {
    dot_health: Ellipse, size: (8, 8), color: accent.success
    val_health: Text, text: "ALL 12 PARTITIONS REPLICATED", font_size: 11, font_weight: 600, color: text.secondary
  }
}

// ── Timeline Choreography ──────────────────────────────────────────────────
#0.0s
fade-in h_kicker [400ms, ease: expo-out]
fade-in h_title [500ms, delay: 50ms, ease: expo-out]
fade-in h_sub [500ms, delay: 100ms, ease: expo-out]
fade-in vpc_edge [400ms]
fade-in lbl_edge [400ms]
fade-in vpc_core [400ms]
fade-in lbl_core [400ms]
fade-in hud_panel [400ms]
fade-in hud [400ms]

#0.3s
stagger [100ms] {
  fade-in gateway [400ms, ease: ease-out]
  fade-in stream [400ms, ease: ease-out]
  fade-in raft [400ms, ease: ease-out]
  fade-in lake [400ms, ease: ease-out]
}

#0.8s
stagger [100ms] {
  draw-in conn_ing [500ms, ease: ease-out]
  draw-in conn_raft [500ms, ease: ease-out]
  draw-in conn_lake [500ms, ease: ease-out]
  draw-in conn_sync [400ms, ease: ease-out]
}

#1.8s
val_tps.text = "184,500 req/s" [2.8s, ease: ease-out]
val_lat.text = "0.82 ms" [1.2s]

#5.0s
// Rest composition holds clean steady state until loop reset
