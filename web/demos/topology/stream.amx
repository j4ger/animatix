import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
bg_glow: Ellipse, size: (800, 480), color: (0.09, 0.12, 0.18, 0.5), at: (640, 350), opacity: 0.6

producer: CardNode, title: "Event Producer", eyebrow: "SOURCE", sub: "JSON & Protobuf Streams", at: (260, 350), width: 220, height: 105
part0: CardNode, title: "Partition #0", eyebrow: "BROKER A", sub: "Leader (AZ-1a)", at: (640, 220), width: 220, height: 86, focal: true
part1: CardNode, title: "Partition #1", eyebrow: "BROKER B", sub: "Leader (AZ-1b)", at: (640, 350), width: 220, height: 86, focal: true
part2: CardNode, title: "Partition #2", eyebrow: "BROKER C", sub: "Leader (AZ-1c)", at: (640, 480), width: 220, height: 86, focal: true
consumer: CardNode, title: "Consumer Group", eyebrow: "SINK", sub: "Real-time Flink & Analytics", at: (1020, 350), width: 220, height: 105

c_p0: Connector, from: producer.east, to: part0.west, routing: "elbow", corner_radius: 12, arrow: true, stroke: accent.primary, stroke_width: 2.0
c_p1: Connector, from: producer.east, to: part1.west, routing: "straight", arrow: true, stroke: accent.primary, stroke_width: 2.0
c_p2: Connector, from: producer.east, to: part2.west, routing: "elbow", corner_radius: 12, arrow: true, stroke: accent.primary, stroke_width: 2.0

c_c0: Connector, from: part0.east, to: consumer.west, routing: "elbow", corner_radius: 12, arrow: true, stroke: accent.info, stroke_width: 2.0
c_c1: Connector, from: part1.east, to: consumer.west, routing: "straight", arrow: true, stroke: accent.info, stroke_width: 2.0
c_c2: Connector, from: part2.east, to: consumer.west, routing: "elbow", corner_radius: 12, arrow: true, stroke: accent.info, stroke_width: 2.0

stat_panel: Rect, size: (860, 52), color: surface.primary, corner_radius: 10, stroke: stroke.default, anchor: scene.bottom, offset: (0, -48)
stat_row: Row, anchor: scene.bottom, offset: (0, -51), gap: 40, align: "center" {
  m_label: Text, text: "EVENT WRITE RATE:", font_size: 11, font_weight: 600, color: text.muted
  m_val: Text, text: "48,000 msg/sec", font_size: 13, font_weight: 600, color: accent.primary
  lag_label: Text, text: "CONSUMER GROUP LAG:", font_size: 11, font_weight: 600, color: text.muted
  lag_val: Text, text: "0 records (Real-time)", font_size: 13, font_weight: 600, color: accent.success
}

#0.0s
fade-in producer [400ms]
fade-in part0 [400ms]
fade-in part1 [400ms]
fade-in part2 [400ms]
fade-in consumer [400ms]
fade-in stat_panel [400ms]
fade-in stat_row [400ms]

#0.5s
stagger [80ms] {
  draw-in c_p0 [400ms, ease: ease-out]
  draw-in c_p1 [400ms, ease: ease-out]
  draw-in c_p2 [400ms, ease: ease-out]
}
#+0.2s
stagger [80ms] {
  draw-in c_c0 [400ms, ease: ease-out]
  draw-in c_c1 [400ms, ease: ease-out]
  draw-in c_c2 [400ms, ease: ease-out]
}

#1.2s
m_val.text = "124,000 msg/sec" [2.8s, ease: ease-out]

always {
  bg_glow.at = (640 + 35 * cos(t * 1.1), 350 + 25 * sin(t * 0.9))
  bg_glow.opacity = 0.45 + 0.25 * sin(t * 1.4)
}
