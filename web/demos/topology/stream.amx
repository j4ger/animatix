import "../../demos/lib/theme.amx"
import "../../demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360), opacity: 1
bg_glow: Ellipse, size: (700, 400), color: (0.09, 0.12, 0.18, 0.4), at: (640, 360), opacity: 0.5

header: Col, anchor: scene.top, offset: (0, 60), gap: 6, align: "center" {
  badge: Chip, label: "02 · PARTITIONED EVENT STREAM", width: 230, height: 26, color: surface.primary, text_color: accent.primary
  title: Text, text: "Partitioned Commit Log & High-Fanout Ordering", font_size: 32, font_weight: "bold", color: text.primary
  subtitle: Text, text: "Records append to immutable partitions replicated across availability zones", font_size: 15, color: text.secondary
}

producer: CardNode, title: "Event Producer", eyebrow: "SOURCE", sub: "JSON & Protobuf Streams", at: (260, 380), width: 210, height: 95
part0: CardNode, title: "Partition #0", eyebrow: "BROKER A", sub: "Leader (AZ-1a)", at: (640, 260), width: 210, height: 80, focal: true
part1: CardNode, title: "Partition #1", eyebrow: "BROKER B", sub: "Leader (AZ-1b)", at: (640, 380), width: 210, height: 80, focal: true
part2: CardNode, title: "Partition #2", eyebrow: "BROKER C", sub: "Leader (AZ-1c)", at: (640, 500), width: 210, height: 80, focal: true
consumer: CardNode, title: "Consumer Group", eyebrow: "SINK", sub: "Real-time Flink & Analytics", at: (1020, 380), width: 210, height: 95

c_p0: Connector, from: producer.east, to: part0.west, routing: "elbow", corner_radius: 10, arrow: true, stroke: accent.primary, stroke_width: 2.0
c_p1: Connector, from: producer.east, to: part1.west, routing: "straight", arrow: true, stroke: accent.primary, stroke_width: 2.0
c_p2: Connector, from: producer.east, to: part2.west, routing: "elbow", corner_radius: 10, arrow: true, stroke: accent.primary, stroke_width: 2.0

c_c0: Connector, from: part0.east, to: consumer.west, routing: "elbow", corner_radius: 10, arrow: true, stroke: accent.info, stroke_width: 2.0
c_c1: Connector, from: part1.east, to: consumer.west, routing: "straight", arrow: true, stroke: accent.info, stroke_width: 2.0
c_c2: Connector, from: part2.east, to: consumer.west, routing: "elbow", corner_radius: 10, arrow: true, stroke: accent.info, stroke_width: 2.0

stat_panel: Rect, size: (840, 48), color: surface.primary, corner_radius: 8, stroke: stroke.default, anchor: scene.bottom, offset: (0, -40)
stat_row: Row, anchor: scene.bottom, offset: (0, -43), gap: 40, align: "center" {
  m_label: Text, text: "EVENT WRITE RATE:", font_size: 11, font_weight: 600, color: text.muted
  m_val: Text, text: "48,000 msg/sec", font_size: 13, font_weight: 600, color: accent.primary
  lag_label: Text, text: "CONSUMER GROUP LAG:", font_size: 11, font_weight: 600, color: text.muted
  lag_val: Text, text: "0 records (Real-time)", font_size: 13, font_weight: 600, color: accent.success
}

#0.0s
fade-in header [400ms]
fade-in producer [400ms]
fade-in part0 [400ms]
fade-in part1 [400ms]
fade-in part2 [400ms]
fade-in consumer [400ms]
fade-in stat_panel [400ms]
fade-in stat_row [400ms]

#0.6s
stagger [80ms] {
  draw-in c_p0 [400ms, ease: ease-out]
  draw-in c_p1 [400ms, ease: ease-out]
  draw-in c_p2 [400ms, ease: ease-out]
}
#+0.2s
stagger [80ms] {
  draw-in c_c0 [400ms, ease: ease-out]
  draw-in c_c1 [400ms, ease: ease-out]
  draw-in c_c2 [400ms, ease: ease-out]
}

#1.2s
m_val.text = "240,000 msg/sec" [3s, ease: ease-out]
