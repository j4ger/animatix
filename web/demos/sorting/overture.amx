import "../../demos/lib/theme.amx"
import "../../demos/lib/ambience.amx"
import "../../demos/lib/ui.amx"
config { resolution: (1280, 720) }

# Overture
config { colorscheme: "ink", dynamic_layout: true, duration: 6 }

bg: Ambience, tint: accent.primary, seed: 101

hero: TitleCard,
  title: "Sorting Theatre",
  kicker: "ALGORITHMIC STAGE · INSERTION SORT",
  sub: "Eight bars directed entirely by a single build-time timeline algorithm",
  at: (640, 180)

// The baseline floor for the bars
floor: Path,
  commands: {move_to(180, 570), line_to(1100, 570)},
  stroke: stroke.default, stroke_width: 1.5, fill_opacity: 0.0,
  dash_pattern: {8, 6}

// Silhouette ghost bars in background showing the initial unsorted arrangement
for v, i in {42, 17, 93, 5, 68, 31, 76, 12} {
  ghost[i]: Rect, size: (84, v * 1.5), corner_radius: 8,
    stroke: stroke.default, stroke_width: 1.2, fill_opacity: 0.05, color: accent.primary,
    at: (260 + i * 108, 570 - (v * 0.75))
}

#0s
fade-in floor [500ms, ease: expo-out]
fade-in hero [800ms, ease: expo-out]
stagger [50ms] {
  fade-in ghost__0 [400ms, ease: expo-out]
  fade-in ghost__1 [400ms, ease: expo-out]
  fade-in ghost__2 [400ms, ease: expo-out]
  fade-in ghost__3 [400ms, ease: expo-out]
  fade-in ghost__4 [400ms, ease: expo-out]
  fade-in ghost__5 [400ms, ease: expo-out]
  fade-in ghost__6 [400ms, ease: expo-out]
  fade-in ghost__7 [400ms, ease: expo-out]
}
