// house-style: hash collision; three acts, payoff is a camera push on the resolved chain with a bloom sweep.
//
// Figure 05b · Two keys, one bucket. The same instrument as the insertion
// figure: bucket rack on top, arithmetic columns below, counters at right.
// Here the rack already holds a resident (dog), and owl arrives with the same
// remainder. The figure's job is to make "collision" visible rather than
// asserted: owl hovers at the bucket mouth, the resident is highlighted, the
// second key settles one slot lower, and a chain connector draws between them.
//
// `modulus` is the deck slider (2..12). The collision pair is chosen so the
// default 8 puts dog (26) and owl (50) both in bucket 2; other settings may
// separate them, and the chain then hides itself because the two remainders no
// longer agree.
//
// Type floors (DESIGN §1.5): title 48 (compact head), kicker 18, captions 24,
// readout values 28, bucket indices 22, key chips 18, arithmetic 22-26 —
// nothing here renders below 16 px.
import "../../../examples/lib/theme.amx"

import "../../../examples/lib/stage.amx"

config { colorscheme: "tide", resolution: (1280, 720), duration: 7 }

let modulus = 8

let dog_bucket = 26 % modulus

let owl_bucket = 50 % modulus

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.25, grid: 1.2

head_kicker: Text, text: "FIG 05 · HASH TABLE / ACT II — COLLISION", font_size: 18, font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (96, 44), opacity: 1

head_title: Text, text: "Two keys, one bucket", font_size: 48, font_weight: "bold", color: text.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (96, 96), opacity: 1

head_rule: Rect, size: (96, 4), color: accent.primary, anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: format("Act I · dog hashes to bucket {:.0} and sits there alone.", dog_bucket), tag: "collision.amx"

cap2: Caption, text: "Act II · owl hashes to the same bucket — the slot is taken.", tag: "collision.amx", opacity: 0

cap3: Caption, text: "Act III · Two keys, one bucket: the chain is the collision.", tag: "collision.amx", opacity: 0

// ── the rack ────────────────────────────────────────────────────────
let arr_x = 96

let arr_w = 884

let bucket_w = min(180, arr_w / modulus - 10)

arr_head: Text, text: format("BUCKET ARRAY · MODULO {:.0}", modulus), font_size: 16, font_family: "mono", color: text.muted, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (96, 166), opacity: 1

for i in range(0, 12) {
  rack[i]: Rect, size: (bucket_w, 300), corner_radius: 12, fill_gradient: linear(90, {(0%, accent.primary * 0.16), (55%, surface.primary), (100%, surface.secondary)}), stroke: stroke.default, stroke_width: 1.4, at: (arr_x + ((i + 0.5) * arr_w) / modulus, 360), opacity: if i < modulus { 1 } else { 0 }
  div0[i]: Line, from: ((0 - bucket_w / 2) + 6, 0), to: (bucket_w / 2 - 6, 0), stroke: stroke.default, stroke_width: 1, at: (arr_x + ((i + 0.5) * arr_w) / modulus, 310), opacity: if i < modulus { 0.6 } else { 0 }
  div1[i]: Line, from: ((0 - bucket_w / 2) + 6, 0), to: (bucket_w / 2 - 6, 0), stroke: stroke.default, stroke_width: 1, at: (arr_x + ((i + 0.5) * arr_w) / modulus, 410), opacity: if i < modulus { 0.6 } else { 0 }
  idx[i]: Text, text: format("{:.0}", i), font_size: 22, font_weight: "bold", color: accent.primary, at: (arr_x + ((i + 0.5) * arr_w) / modulus, 204), opacity: if i < modulus { 1 } else { 0 }
}

// ── the arithmetic bank ─────────────────────────────────────────────
arith_panel: Rect, size: (884, 125), at: (538, 582), corner_radius: 14, color: surface.primary, stroke: stroke.default, stroke_width: 1.2, opacity: 1

arith_head: Text, text: "HASH ARITHMETIC", font_size: 16, font_family: "mono", color: text.muted, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (112, 526), opacity: 1

arith_rule: Rect, size: (850, 1), color: stroke.default, anchor: scene.top_left, offset: (112, 548), opacity: 0.6

// Dog is the resident: its working is already lit at t=0.
ar_dog_key: Text, text: format("dog → bucket {:.0}", dog_bucket), font_size: 22, font_weight: "bold", color: accent.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (120, 558), opacity: 1

ar_dog_sum: Text, text: "4 + 15 + 7 = 26", font_size: 22, font_family: "mono", color: text.secondary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (120, 586), opacity: 1

ar_dog_mod: Text, text: format("26 % {:.0} = {:.0}", modulus, dog_bucket), font_size: 26, font_family: "mono", font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (120, 614), opacity: 1

ar_owl_key: Text, text: format("owl → bucket {:.0}", owl_bucket), font_size: 22, font_weight: "bold", color: accent.warning, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (420, 558), opacity: 0

ar_owl_sum: Text, text: "15 + 23 + 12 = 50", font_size: 22, font_family: "mono", color: text.secondary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (420, 586), opacity: 0

ar_owl_mod: Text, text: format("50 % {:.0} = {:.0}", modulus, owl_bucket), font_size: 26, font_family: "mono", font_weight: 600, color: accent.warning, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (420, 614), opacity: 0

// The third column names the mechanism rather than repeating a sum.
ar_st_key: Text, text: "SEPARATE CHAINING", font_size: 22, font_weight: "bold", color: accent.warning, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (720, 558), opacity: 0

ar_st_sum: Text, text: "a collision keeps both keys", font_size: 22, font_family: "mono", color: text.secondary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (720, 586), opacity: 0

ar_st_mod: Text, text: format("chain length {:.0}", if 26 % modulus == 50 % modulus { 2 } else { 1 }), font_size: 26, font_family: "mono", font_weight: 600, color: accent.warning, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (720, 614), opacity: 0

// ── live counters ───────────────────────────────────────────────────
chip_bucket: Readout, label: "BUCKET", value: "2", at: (1110, 250)

chip_probes: Readout, label: "PROBES", value: "1", at: (1110, 360)

chip_chain: Readout, label: "CHAIN", value: "2", at: (1110, 470)

// ── key chips and the chain ─────────────────────────────────────────
pub component KeyChip(label: Str, width: Num = 96, fill: Color = accent.primary, ink: Color = scene.background) {
  root: Stack, size: (width, 42) {
  bg: Rect, size: (width, 42), corner_radius: 9, color: fill, opacity: 1
  label_text: Text, text: label, font_size: 18, font_weight: 600, color: ink, opacity: 1
    }
}

chip_dog: KeyChip, label: "dog", width: min(150, bucket_w - 12), fill: accent.primary, at: (arr_x + ((dog_bucket + 0.5) * arr_w) / modulus, 260), opacity: 1

chip_owl: KeyChip, label: "owl", width: min(150, bucket_w - 12), fill: accent.warning, at: (630, 556), opacity: 0

// The chain connector: from the resident's foot to the collider's crown. Its
// opacity is a build-time fact — when the slider separates the two remainders
// the line simply is not there; `draw-in` below traces it from zero progress.
chain: Line, from: (0, -29), to: (0, 29), stroke: accent.warning, stroke_width: 2.5, stroke_progress: 0, opacity: if 26 % modulus == 50 % modulus { 1 } else { 0 }, at: (arr_x + ((dog_bucket + 0.5) * arr_w) / modulus, 310)

// Payoff bloom, centred on the chain and swept up it while the camera pushes.
bloom: Ellipse, size: (400, 400), blend: "screen", opacity: 0, at: (arr_x + ((dog_bucket + 0.5) * arr_w) / modulus, 420), fill_gradient: radial((0.5, 0.5), 0.62, {(0%, accent.warning * 0.5), (42%, accent.warning * 0.16), (100%, (0, 0, 0, 0))})

// ── Act I · the resident ────────────────────────────────────────────
// The lit rack, dog in bucket 2, its working in column one. Owl's working is
// the first motion, 400 ms in — no dead plate.
#0.4s
  fade_in(target: ar_owl_key, duration: 0.24s, ease: expo_out)
  fade_in(target: ar_owl_sum, duration: 0.24s, delay: 0.09s, ease: expo_out)
  fade_in(target: ar_owl_mod, duration: 0.26s, delay: 0.17s, ease: expo_out)
  fade_in(target: chip_owl, duration: 0.24s, delay: 0.32s, ease: expo_out)

// ── Act II · the collision ──────────────────────────────────────────
// Owl crosses straight to the second slot of bucket 2. The resident highlights
// as it lands: the slot above is taken, so the newcomer settles one level down.
#1.1s
  chip_owl.at = (arr_x + ((owl_bucket + 0.5) * arr_w) / modulus, if 26 % modulus == 50 % modulus { 360 } else { 260 }) [0.7s, ease: ease_in_out]

#1.8s
  pulse(target: chip_dog, duration: 0.32s, intensity: 0.07)
  fade_out(target: cap1, duration: 0.24s, ease: ease_in)
  fade_in(target: cap2, duration: 0.28s, delay: 0.2s, ease: expo_out)

#2.2s
  draw_in(target: chain, duration: 0.38s, ease: expo_out)
  fade_in(target: ar_st_key, duration: 0.26s, ease: expo_out)
  fade_in(target: ar_st_sum, duration: 0.26s, delay: 0.12s, ease: expo_out)
  fade_in(target: ar_st_mod, duration: 0.26s, delay: 0.22s, ease: expo_out)
  pulse(target: chip_owl, duration: 0.42s, intensity: 0.06)

// ── Act III · the resolved chain ────────────────────────────────────
#3s
  fade_out(target: cap2, duration: 0.24s, ease: ease_in)
  fade_in(target: cap3, duration: 0.28s, delay: 0.2s, ease: expo_out)
  camera.zoom = 1.06 [1.1s, ease: ease_in_out]
  bloom.opacity = 0.75 [0.5s, ease: expo_out]

#3.6s
  bloom.at = (arr_x + ((dog_bucket + 0.5) * arr_w) / modulus, 250) [1.1s, ease: ease_in_out]

#4.4s
  bloom.opacity = 0.1 [0.8s, ease: ease_in_out]
  camera.zoom = 1 [1s, ease: ease_in_out]

// ── Rest ────────────────────────────────────────────────────────────
// Dog and owl hold their two-slot chain in bucket 2, both workings and the
// mechanism column are lit, and the counters read the chain length. Nothing
// is erased.
#6s
  always {
      chip_bucket.value_text.text = format("{:.0}", 50 % modulus)
      chip_probes.value_text.text = "1"
      chip_chain.value_text.text = format("{:.0}", if 26 % modulus == 50 % modulus { 2 } else { 1 })
    }
