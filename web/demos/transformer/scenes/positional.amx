// Positional Encoding — injecting word order with waves.
// Each position gets a unique fingerprint from sinusoids of many frequencies.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

title: Text, text: "2 · Positional Encoding", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 55)

sub: Text, text: "sin/cos waves of growing wavelength stamp every position with a unique address",
  font_size: 18, color: text.secondary, anchor: scene.top, offset: (0, 105)

// The classic multi-frequency picture: value vs position for a few channels
main: Graph, x_domain: (0, 32), y_domain: (-1.15, 1.15), size: (860, 420), at: (560, 380) {
  fast: PlotCurve, kind: "cartesian", func: (x) => sin(x / 1.0), color: accent.primary, stroke_width: 2.5
  mid: PlotCurve, kind: "cartesian", func: (x) => sin(x / 2.5) * 0.72, color: accent.success, stroke_width: 2.5
  slow: PlotCurve, kind: "cartesian", func: (x) => sin(x / 6.0) * 0.45, color: accent.warning, stroke_width: 2.5
  slowest: PlotCurve, kind: "cartesian", func: (x) => sin(x / 14.0) * 0.22, color: accent.danger, stroke_width: 2.5
}

legend_fast: Rect, size: (16, 4), color: accent.primary, at: (160, 620)
legend_fast_t: Text, text: "wavelength 2π", font_size: 14, color: text.secondary, at: (255, 620)
legend_mid: Rect, size: (16, 4), color: accent.success, at: (400, 620)
legend_mid_t: Text, text: "5π", font_size: 14, color: text.secondary, at: (428, 620)
legend_slow: Rect, size: (16, 4), color: accent.warning, at: (470, 620)
legend_slow_t: Text, text: "12π", font_size: 14, color: text.secondary, at: (498, 620)

// The takeaway: position 0 vs position 1 get different vectors
note: Text, text: "same word at a different position ⇒ a different input vector",
  font_size: 17, color: text.primary, anchor: scene.bottom, offset: (0, -55)

#0.4s
fade-in title [600ms, ease: ease-out]
fade-in sub [500ms, delay: 150ms]

#1.0s
fade-in main [400ms, ease: ease-out]
draw-in fast [900ms, ease: ease-out]

#1.7s
draw-in mid [900ms, ease: ease-out]

#2.4s
draw-in slow [900ms, ease: ease-out]

#3.1s
draw-in slowest [900ms, ease: ease-out]

#4.2s
fade-in legend_fast [300ms]
stagger [120ms] {
  fade-in legend_fast_t [300ms]
  fade-in legend_mid [300ms]
  fade-in legend_mid_t [300ms]
  fade-in legend_slow [300ms]
  fade-in legend_slow_t [300ms]
}

#5.2s
fade-in note [500ms]
