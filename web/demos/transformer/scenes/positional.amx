// house-style: harmonic hook, period-doubling matrix, vector fusion payoff.
// 02 · Positional encoding — harmonic sinusoidal spectrum injected into token order.
//
// The question this figure answers: attention is order-blind, so where does
// sequence order come from? Three acts:
//   I.   Eight token positions line up over an empty spectral grid.
//   II.  The grid fills with sinusoids at doubling wavelengths — fine rows
//        oscillate quickly, coarse rows slowly.
//   III. A cursor scans the columns, extracting one position's fingerprint, and
//        the vector fusion identity adds it element-wise to the token embeddings.
//
// House-style §1: StageFloor + compact head + caption carry frame 0.
// House-style §5: title 48, row labels 18, formulas 22, captions 24.

import "../../lib/theme.amx"
import "../../lib/stage.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.4 }

let wavelength = 24
let cells = (0, 32)

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.25

head_eyebrow: Text, text: "FIG 02 · HARMONIC POSITIONAL SPECTRUM", font_size: 18,
  font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 44), opacity: 0
head_title: Text, text: "Injecting the arrow of time", font_size: 48, font_weight: "bold",
  color: text.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 96), opacity: 1
head_rule: Rect, size: (96, 4), color: accent.primary,
  anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "Attention is order-blind; sequence order must be injected.",
  tag: "positional.amx", opacity: 1
cap2: Caption, text: "Sinusoidal harmonics double wavelength across rows.",
  tag: "positional.amx", opacity: 0
cap3: Caption, text: "Vectors fuse (x_i = e_i + p_i) to freeze word order.",
  tag: "positional.amx", opacity: 0

// The formula epigraph sits top-right, clear of the left-anchored head.
formula_chip: Stack, at: (1000, 78), size: (380, 50), opacity: 0 {
  f_bg: Rect, size: (380, 50), corner_radius: 12, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  f_txt: Text, text: "PE = sin(pos / 10000^(2i/d))", font_size: 22, font_weight: 600, color: accent.info
}

// ── Token positions above the matrix ────────────────────────────────
token_chips: Row, at: (540, 182), gap: 8, align: "center" {
  tc0: LabeledBox, label: "The", width: 84, height: 36, text_size: 16, corner: 8
  tc1: LabeledBox, label: "animal", width: 84, height: 36, text_size: 16, corner: 8
  tc2: LabeledBox, label: "didn't", width: 84, height: 36, text_size: 16, corner: 8
  tc3: LabeledBox, label: "cross", width: 84, height: 36, text_size: 16, corner: 8
  tc4: LabeledBox, label: "the", width: 84, height: 36, text_size: 16, corner: 8
  tc5: LabeledBox, label: "street", width: 84, height: 36, text_size: 16, corner: 8
  tc6: LabeledBox, label: "because", width: 84, height: 36, text_size: 16, corner: 8
  tc7: LabeledBox, label: "it", width: 84, height: 36, text_size: 16, corner: 8
}

// ── The spectral matrix: 8 positions × 4 wavelengths ────────────────
matrix: Grid, cols: 8, gap: 10, at: (540, 387) {
  for i in cells {
    c[i]: Rect, size: (84, 76), corner_radius: 10, color: accent.info, opacity: 0
  }
}

// Row wavelengths: each row halves the previous one's frequency.
lab0: Text, text: format("λ = {:.0}", wavelength / 8), font_size: 18, color: text.secondary,
  text_anchor: "right", at: (162, 258), opacity: 0
lab1: Text, text: format("λ = {:.0}", wavelength / 4), font_size: 18, color: text.secondary,
  text_anchor: "right", at: (162, 344), opacity: 0
lab2: Text, text: format("λ = {:.0}", wavelength / 2), font_size: 18, color: text.secondary,
  text_anchor: "right", at: (162, 430), opacity: 0
lab3: Text, text: format("λ = {:.0}", wavelength), font_size: 18, color: text.secondary,
  text_anchor: "right", at: (162, 516), opacity: 0

// Position axis below the matrix.
axis_row: Row, at: (540, 575), gap: 8, align: "center" {
  c0: Stack, size: (84, 20) { p0: Text, text: "pos 0", font_size: 16, color: text.secondary }
  c1: Stack, size: (84, 20) { p1: Text, text: "pos 1", font_size: 16, color: text.secondary }
  c2: Stack, size: (84, 20) { p2: Text, text: "pos 2", font_size: 16, color: text.secondary }
  c3: Stack, size: (84, 20) { p3: Text, text: "pos 3", font_size: 16, color: text.secondary }
  c4: Stack, size: (84, 20) { p4: Text, text: "pos 4", font_size: 16, color: text.secondary }
  c5: Stack, size: (84, 20) { p5: Text, text: "pos 5", font_size: 16, color: text.secondary }
  c6: Stack, size: (84, 20) { p6: Text, text: "pos 6", font_size: 16, color: text.secondary }
  c7: Stack, size: (84, 20) { p7: Text, text: "pos 7", font_size: 16, color: text.secondary }
}

// ── Right rail: amplitude legend and the fusion identity ────────────
// Explicitly placed (not a Col): the legend has to sit exactly under the
// MAX WAVELENGTH chip, and a nested Col's measured content box drifted up
// into it in the first pass.
key_cap: Text, text: "Harmonic amplitude", font_size: 18, color: text.secondary,
  text_anchor: "center", at: (1090, 392), opacity: 0
key_lo: Rect, size: (28, 28), corner_radius: 6, color: accent.info, at: (1040, 430), opacity: 0
key_mid: Rect, size: (28, 28), corner_radius: 6, color: accent.info, at: (1090, 430), opacity: 0
key_hi: Rect, size: (28, 28), corner_radius: 6, color: accent.info, at: (1140, 430), opacity: 0
key_lo_t: Text, text: "-1.0", font_size: 16, color: text.muted, text_anchor: "center", at: (1040, 462), opacity: 0
key_zero: Text, text: "0.0", font_size: 16, color: text.muted, text_anchor: "center", at: (1090, 462), opacity: 0
key_hi_t: Text, text: "+1.0", font_size: 16, color: text.muted, text_anchor: "center", at: (1140, 462), opacity: 0

fusion_card: Stack, at: (1090, 540), size: (240, 118), opacity: 0 {
  f_card_bg: Rect, size: (240, 118), corner_radius: 16, color: surface.primary,
    stroke: accent.info, stroke_width: 1.6
  f_card_col: Col, gap: 6, align: "center" {
    f_c_title: Text, text: "Vector Fusion", font_size: 18, color: text.primary
    f_c_eq: Text, text: "x_i = e_i + p_i", font_size: 24, color: accent.info
    f_c_sub: Text, text: "element-wise addition", font_size: 16, color: text.muted
  }
}

// Column scanning cursor: one position's fingerprint, ringed, with a
// screen-blend glow that travels with it (the Act III bloom).
cursor_stack: Stack, at: (218, 387), size: (94, 356), opacity: 0 {
  cursor_glow: Rect, size: (94, 356), corner_radius: 12, color: accent.info,
    blend: "screen", opacity: 0
  cursor: Rect, size: (94, 356), corner_radius: 12, color: accent.primary,
    fill_opacity: 0, stroke: accent.primary, stroke_width: 2.5
}

// ── Timeline Choreography ───────────────────────────────────────────
// Act I — the hook: positions arrive over an empty spectral field.
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in formula_chip [320ms, ease: expo-out]
stagger [55ms] {
  fade-in tc0 [260ms, ease: expo-out]
  fade-in tc1 [260ms, ease: expo-out]
  fade-in tc2 [260ms, ease: expo-out]
  fade-in tc3 [260ms, ease: expo-out]
  fade-in tc4 [260ms, ease: expo-out]
  fade-in tc5 [260ms, ease: expo-out]
  fade-in tc6 [260ms, ease: expo-out]
  fade-in tc7 [260ms, ease: expo-out]
}

// Act II — the mechanism: the harmonic field resolves row by row.
#0.80s
for i in cells [step: 22ms] {
  c[i].opacity = clamp(0.55 + 0.42 * sin((i - floor(i / 8) * 8) * 0.9 * (24 / wavelength) / (floor(i / 8) + 1)), 0.12, 0.96) [300ms]
}

#1.80s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]
stagger [60ms] {
  fade-in lab0 [260ms, ease: expo-out]
  fade-in lab1 [260ms, ease: expo-out]
  fade-in lab2 [260ms, ease: expo-out]
  fade-in lab3 [260ms, ease: expo-out]
}
stagger [30ms] {
  fade-in p0 [220ms, ease: expo-out]
  fade-in p1 [220ms, ease: expo-out]
  fade-in p2 [220ms, ease: expo-out]
  fade-in p3 [220ms, ease: expo-out]
  fade-in p4 [220ms, ease: expo-out]
  fade-in p5 [220ms, ease: expo-out]
  fade-in p6 [220ms, ease: expo-out]
  fade-in p7 [220ms, ease: expo-out]
}

#2.60s
fade-in key_cap [280ms, ease: expo-out]
stagger [50ms] {
  key_lo.opacity = 0.22 [260ms]
  key_mid.opacity = 0.61 [260ms]
  key_hi.opacity = 1.00 [260ms]
}
stagger [50ms] {
  fade-in key_lo_t [240ms, ease: expo-out]
  fade-in key_zero [240ms, ease: expo-out]
  fade-in key_hi_t [240ms, ease: expo-out]
}
fade-in fusion_card [340ms, delay: 180ms, ease: expo-out]

// Act III — the cursor re-reads one column, then the camera pushes in on the
// full spectrum and the fusion card pulses once.
#3.50s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
fade-in cursor_stack [220ms, ease: expo-out]
cursor_glow.opacity = 0.26 [300ms]
sequence {
  shift cursor_stack [by: (92, 0), 160ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor_stack [by: (92, 0), 160ms, delay: 100ms, ease: expo-out]
}
pulse fusion_card [600ms, intensity: 0.04, delay: 1800ms]
fade-out cursor_stack [300ms, delay: 1900ms, ease: ease-in]

// Payoff: focus on the full spectrum and settle.
#5.50s
pulse fusion_card [700ms, intensity: 0.05, delay: 200ms]

// ── Rest ────────────────────────────────────────────────────────────
#7.20s
// Eight positions, four harmonic rows, the legend and the fusion identity all
// stand. The cursor has done its pass; nothing else erases.
