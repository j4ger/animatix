// 02 · Positional encoding.
//
// The figure is the encoding matrix rather than a plot: rows are dimensions,
// columns are positions, and each row halves the frequency of the one above it.
// It makes the same point as the classic wave plot while avoiding Graph, whose
// tick labels sit on the y = 0 rule and get crossed by the curves.
//
// One hue, shade = value: dark is negative, mid is zero, bright is positive.
// An earlier attempt encoded sign with a second hue and magnitude with opacity,
// which failed — every sinusoid shares one amplitude, so all four rows came out
// equally bright and the doubling of the period was invisible. Now the rows read
// as stripes of width 1, 2, 4 and 8.
//
// Periods are 3, 6, 12, 24 columns — a schematic, not the real constants. In a
// real 512-wide vector the earliest dimensions turn so slowly that over eight
// positions they look identical, so reproducing them exactly would show
// nothing. What is faithful is the mechanism: one sine per dimension, with the
// wavelength growing geometrically.
//
// Gating rule (probe-verified): an authored non-zero `opacity` is visible from
// frame 0 no matter which entrance follows. Every value-carrying cell is
// therefore authored `opacity: 0.0` (the seed) and settles on its value via a
// keyframe assignment at its beat — the cells fade in as a sweep, one per 30ms.
//
// Grid: 1280×720. 8 columns × 4 rows of 74px cells, pitch 84. Column x values
// are 296 + 84i; row y values are 225 + 84r.

import "../../lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.1 }

// ── phase narration (top-left; one label per beat) ──────────────────
phase1: Text, text: "1 · every position gets a fingerprint", font_size: 15, color: text.muted,
  text_max_width: 360, text_align: "left", anchor: scene.top_left, offset: (150, 96)
phase2: Text, text: "2 · the wavelength doubles every row", font_size: 15, color: text.muted,
  text_max_width: 360, text_align: "left", anchor: scene.top_left, offset: (150, 96)
phase3: Text, text: "3 · one column = one position", font_size: 15, color: text.muted,
  text_max_width: 300, text_align: "left", anchor: scene.top_left, offset: (150, 96)

matrix: Grid, cols: 8, gap: 10, at: (590, 351) {
  // ── period 3: a stripe every column ─────────────────────────────────
  c00: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c01: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c02: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c03: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c04: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c05: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c06: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c07: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0

  // ── period 6: stripes two columns wide ──────────────────────────────
  c10: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c11: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c12: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c13: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c14: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c15: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c16: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c17: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0

  // ── period 12: one hump across the whole row ────────────────────────
  c20: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c21: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c22: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c23: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c24: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c25: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c26: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c27: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0

  // ── period 24: never turns over on this page ────────────────────────
  c30: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c31: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c32: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c33: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c34: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c35: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c36: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
  c37: Rect, size: (74, 74), corner_radius: 10, color: accent.primary, opacity: 0.0
}

// ── row labels: the period doubles each row ────────────────────────
row_labels: Col, at: (171, 351), gap: 10, align: "end" {
  r0: Stack, size: (120, 74) {
    lab0: Text, text: "period 3", font_size: 15, color: text.secondary, text_align: "right"
  }
  r1: Stack, size: (120, 74) {
    lab1: Text, text: "period 6", font_size: 15, color: text.secondary, text_align: "right"
  }
  r2: Stack, size: (120, 74) {
    lab2: Text, text: "period 12", font_size: 15, color: text.secondary, text_align: "right"
  }
  r3: Stack, size: (120, 74) {
    lab3: Text, text: "period 24", font_size: 15, color: text.secondary, text_align: "right"
  }
}

// ── column axis ─────────────────────────────────────────────────────
axis_row: Row, at: (590, 544), gap: 10, align: "center" {
  c0: Stack, size: (74, 20) { p0: Text, text: "0", font_size: 15, color: text.secondary }
  c1: Stack, size: (74, 20) { p1: Text, text: "1", font_size: 15, color: text.secondary }
  c2: Stack, size: (74, 20) { p2: Text, text: "2", font_size: 15, color: text.secondary }
  c3: Stack, size: (74, 20) { p3: Text, text: "3", font_size: 15, color: text.secondary }
  c4: Stack, size: (74, 20) { p4: Text, text: "4", font_size: 15, color: text.secondary }
  c5: Stack, size: (74, 20) { p5: Text, text: "5", font_size: 15, color: text.secondary }
  c6: Stack, size: (74, 20) { p6: Text, text: "6", font_size: 15, color: text.secondary }
  c7: Stack, size: (74, 20) { p7: Text, text: "7", font_size: 15, color: text.secondary }
}
axis: Text, text: "position", font_size: 15, color: text.muted, at: (590, 578)

// ── the signed scale, stated once ──────────────────────────────────
legend: Col, at: (1016, 300), gap: 14, align: "center" {
  key_cap: Text, text: "shade = value", font_size: 15, color: text.muted
  key_swatches: Row, gap: 8, align: "center" {
    key_lo: Rect, size: (20, 20), corner_radius: 5, color: accent.primary, opacity: 0.0
    key_mid: Rect, size: (20, 20), corner_radius: 5, color: accent.primary, opacity: 0.0
    key_hi: Rect, size: (20, 20), corner_radius: 5, color: accent.primary, opacity: 0.0
  }
  key_labels: Row, gap: 12, align: "center" {
    key_lo_t: Text, text: "-1", font_size: 14, color: text.muted
    key_zero: Text, text: "0", font_size: 14, color: text.muted
    key_hi_t: Text, text: "+1", font_size: 14, color: text.muted
  }
}

// Column cursor: reads one position's whole fingerprint at a time.
cursor: Rect, size: (92, 344), corner_radius: 12, color: accent.warning,
  fill_opacity: 0.0, stroke: accent.warning, stroke_width: 2.5, opacity: 0.0, at: (296, 351)

// ── timeline ────────────────────────────────────────────────────────
#0.10s
fade-in phase1 [300ms, ease: expo-out]
stagger [30ms] {
  c00.opacity = 0.61 [280ms]
  c01.opacity = 0.95 [280ms]
  c02.opacity = 0.27 [280ms]
  c03.opacity = 0.61 [280ms]
  c04.opacity = 0.95 [280ms]
  c05.opacity = 0.27 [280ms]
  c06.opacity = 0.61 [280ms]
  c07.opacity = 0.95 [280ms]
  c10.opacity = 0.61 [280ms]
  c11.opacity = 0.95 [280ms]
  c12.opacity = 0.95 [280ms]
  c13.opacity = 0.61 [280ms]
  c14.opacity = 0.27 [280ms]
  c15.opacity = 0.27 [280ms]
  c16.opacity = 0.61 [280ms]
  c17.opacity = 0.95 [280ms]
  c20.opacity = 0.61 [280ms]
  c21.opacity = 0.81 [280ms]
  c22.opacity = 0.95 [280ms]
  c23.opacity = 1.00 [280ms]
  c24.opacity = 0.95 [280ms]
  c25.opacity = 0.81 [280ms]
  c26.opacity = 0.61 [280ms]
  c27.opacity = 0.42 [280ms]
  c30.opacity = 0.61 [280ms]
  c31.opacity = 0.71 [280ms]
  c32.opacity = 0.81 [280ms]
  c33.opacity = 0.89 [280ms]
  c34.opacity = 0.95 [280ms]
  c35.opacity = 0.99 [280ms]
  c36.opacity = 1.00 [280ms]
  c37.opacity = 0.99 [280ms]
}

#1.35s
fade-out phase1 [260ms, ease: ease-in]
fade-in phase2 [280ms, delay: 260ms, ease: expo-out]
stagger [70ms] {
  fade-in lab0 [280ms, ease: expo-out]
  fade-in lab1 [280ms, ease: expo-out]
  fade-in lab2 [280ms, ease: expo-out]
  fade-in lab3 [280ms, ease: expo-out]
}

#1.70s
stagger [40ms] {
  fade-in p0 [240ms, ease: expo-out]
  fade-in p1 [240ms, ease: expo-out]
  fade-in p2 [240ms, ease: expo-out]
  fade-in p3 [240ms, ease: expo-out]
  fade-in p4 [240ms, ease: expo-out]
  fade-in p5 [240ms, ease: expo-out]
  fade-in p6 [240ms, ease: expo-out]
  fade-in p7 [240ms, ease: expo-out]
}
fade-in axis [300ms, delay: 320ms, ease: expo-out]

#2.30s
fade-in key_cap [320ms, ease: expo-out]
stagger [60ms] {
  key_lo.opacity = 0.22 [280ms]
  key_mid.opacity = 0.61 [280ms]
  key_hi.opacity = 1.00 [280ms]
}
stagger [60ms] {
  fade-in key_lo_t [260ms, ease: expo-out]
  fade-in key_zero [260ms, ease: expo-out]
  fade-in key_hi_t [260ms, ease: expo-out]
}

// Walk the cursor across the columns: one position's fingerprint at a time.
#3.00s
fade-out phase2 [260ms, ease: ease-in]
fade-in phase3 [280ms, ease: expo-out]
fade-in cursor [220ms, ease: expo-out]
sequence {
  shift cursor [by: (84, 0), 150ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
  shift cursor [by: (84, 0), 150ms, delay: 90ms, ease: expo-out]
}
fade-out cursor [300ms, delay: 2000ms, ease: ease-in]

// Outro: the matrix Grid fades as a container; quiet plate before the wrap.
// The stagger is deliberately near-simultaneous: at 40ms the 23 items spread
// ~0.9s, so the grid had vanished while the row/column labels were still
// fully lit — a half-empty stage for the last beat of the loop.
#5.90s
// The loop's rest frame is this composition, not an empty plate: the embed
// holds the finished frame for `hold` seconds and dissolves it into the next
// cycle itself, so erasing the figure here would only blank the screen during
// the rest. The outro therefore clears the narration line and leaves the
// diagram standing.
fade-out phase3 [260ms, ease: ease-in]
