// 02 · Positional encoding — harmonic sinusoidal spectrum injected into token order.
//
// Unifies with the global example sentence:
//   Col 0: The | Col 1: animal | Col 2: didn't | Col 3: cross
//   Col 4: the | Col 5: street | Col 6: because | Col 7: it
//
// Pipeline:
//   1. Harmonic Basis: Distinct frequency sinusoids across feature dimensions.
//   2. Period Doubling: Lower rows double the wavelength (periods 3 → 6 → 12 → 24).
//   3. Coordinate Fusion: Position vector adds element-wise to token embedding:
//      x_i = Embed(t_i) + PE(i)

import "../../lib/theme.amx"
import "../../lib/ambience.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.4 }

bg: Ambience, tint: accent.info, base_opacity: 0.14, seed: 20

// ── Header / Narration (top-left) ───────────────────────────────────
head_eyebrow: Text, text: "FIG 02 // HARMONIC POSITIONAL SPECTRUM", font_size: 13,
  color: accent.info, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 48)

phase1: Text, text: "1 · Sinusoidal spectrum generates unique temporal fingerprint", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase2: Text, text: "2 · Geometric period doubling: fine -> coarse temporal resolution", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase3: Text, text: "3 · Element-wise vector addition fuses order into token embedding", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)

formula_chip: Stack, at: (1080, 68) {
  f_bg: Rect, size: (260, 40), corner_radius: 10, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  f_txt: Text, text: "PE(pos, 2i) = sin(pos / 10000^{2i/d})", font_size: 13, color: text.secondary
}

// ── Token Chips Row (Directly above column axis) ────────────────────
token_chips: Row, at: (560, 150), gap: 10, align: "center" {
  tc0: LabeledBox, label: "The", width: 74, height: 38, text_size: 13, corner: 8
  tc1: LabeledBox, label: "animal", width: 74, height: 38, text_size: 13, corner: 8
  tc2: LabeledBox, label: "didn't", width: 74, height: 38, text_size: 13, corner: 8
  tc3: LabeledBox, label: "cross", width: 74, height: 38, text_size: 13, corner: 8
  tc4: LabeledBox, label: "the", width: 74, height: 38, text_size: 13, corner: 8
  tc5: LabeledBox, label: "street", width: 74, height: 38, text_size: 13, corner: 8
  tc6: LabeledBox, label: "because", width: 74, height: 38, text_size: 13, corner: 8
  tc7: LabeledBox, label: "it", width: 74, height: 38, text_size: 13, corner: 8
}

// ── Positional Matrix: 8 columns × 4 rows of 74px cells ─────────────
matrix: Grid, cols: 8, gap: 10, at: (560, 360) {
  // Period 3 (Fine resolution)
  c00: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c01: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c02: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c03: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c04: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c05: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c06: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c07: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0

  // Period 6
  c10: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c11: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c12: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c13: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c14: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c15: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c16: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c17: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0

  // Period 12
  c20: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c21: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c22: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c23: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c24: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c25: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c26: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c27: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0

  // Period 24 (Coarse resolution)
  c30: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c31: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c32: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c33: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c34: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c35: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c36: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
  c37: Rect, size: (74, 74), corner_radius: 10, color: accent.info, opacity: 0.0
}

// Row frequency labels on left
row_labels: Col, at: (150, 360), gap: 10, align: "end" {
  r0: Stack, size: (120, 74) { lab0: Text, text: "λ = 3 (dim 0)", font_size: 14, color: text.secondary, text_align: "right" }
  r1: Stack, size: (120, 74) { lab1: Text, text: "λ = 6 (dim 2)", font_size: 14, color: text.secondary, text_align: "right" }
  r2: Stack, size: (120, 74) { lab2: Text, text: "λ = 12 (dim 4)", font_size: 14, color: text.secondary, text_align: "right" }
  r3: Stack, size: (120, 74) { lab3: Text, text: "λ = 24 (dim 6)", font_size: 14, color: text.secondary, text_align: "right" }
}

// Column position indices below
axis_row: Row, at: (560, 552), gap: 10, align: "center" {
  c0: Stack, size: (74, 20) { p0: Text, text: "pos 0", font_size: 13, color: text.secondary }
  c1: Stack, size: (74, 20) { p1: Text, text: "pos 1", font_size: 13, color: text.secondary }
  c2: Stack, size: (74, 20) { p2: Text, text: "pos 2", font_size: 13, color: text.secondary }
  c3: Stack, size: (74, 20) { p3: Text, text: "pos 3", font_size: 13, color: text.secondary }
  c4: Stack, size: (74, 20) { p4: Text, text: "pos 4", font_size: 13, color: text.secondary }
  c5: Stack, size: (74, 20) { p5: Text, text: "pos 5", font_size: 13, color: text.secondary }
  c6: Stack, size: (74, 20) { p6: Text, text: "pos 6", font_size: 13, color: text.secondary }
  c7: Stack, size: (74, 20) { p7: Text, text: "pos 7", font_size: 13, color: text.secondary }
}

// ── Right Sidebar: Legend & Fusion Card ─────────────────────────────
legend: Col, at: (1070, 260), gap: 12, align: "center" {
  key_cap: Text, text: "Harmonic Amplitude Scale", font_size: 13, color: text.muted
  key_swatches: Row, gap: 8, align: "center" {
    key_lo: Rect, size: (24, 24), corner_radius: 6, color: accent.info, opacity: 0.0
    key_mid: Rect, size: (24, 24), corner_radius: 6, color: accent.info, opacity: 0.0
    key_hi: Rect, size: (24, 24), corner_radius: 6, color: accent.info, opacity: 0.0
  }
  key_labels: Row, gap: 14, align: "center" {
    key_lo_t: Text, text: "-1.0", font_size: 12, color: text.muted
    key_zero: Text, text: "0.0", font_size: 12, color: text.muted
    key_hi_t: Text, text: "+1.0", font_size: 12, color: text.muted
  }
}

fusion_card: Stack, at: (1070, 440) {
  f_card_bg: Rect, size: (220, 110), corner_radius: 14, color: surface.primary,
    stroke: accent.info, stroke_width: 1.5
  f_card_col: Col, gap: 6, align: "center" {
    f_c_title: Text, text: "Vector Fusion", font_size: 15, color: text.primary
    f_c_eq: Text, text: "x_i = e_i + p_i", font_size: 18, color: accent.info
    f_c_sub: Text, text: "Element-wise addition", font_size: 12, color: text.muted
  }
}

// Column scanning cursor: highlights one position's fingerprint
cursor: Rect, size: (92, 344), corner_radius: 12, color: accent.primary,
  fill_opacity: 0.0, stroke: accent.primary, stroke_width: 2.5, opacity: 0.0, at: (266, 360)

// ── Timeline Choreography ───────────────────────────────────────────
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in phase1 [300ms, ease: expo-out]
fade-in formula_chip [320ms, ease: expo-out]
stagger [60ms] {
  fade-in tc0 [280ms, ease: expo-out]
  fade-in tc1 [280ms, ease: expo-out]
  fade-in tc2 [280ms, ease: expo-out]
  fade-in tc3 [280ms, ease: expo-out]
  fade-in tc4 [280ms, ease: expo-out]
  fade-in tc5 [280ms, ease: expo-out]
  fade-in tc6 [280ms, ease: expo-out]
  fade-in tc7 [280ms, ease: expo-out]
}

#0.80s
stagger [25ms] {
  c00.opacity = 0.61 [260ms]
  c01.opacity = 0.95 [260ms]
  c02.opacity = 0.27 [260ms]
  c03.opacity = 0.61 [260ms]
  c04.opacity = 0.95 [260ms]
  c05.opacity = 0.27 [260ms]
  c06.opacity = 0.61 [260ms]
  c07.opacity = 0.95 [260ms]
  c10.opacity = 0.61 [260ms]
  c11.opacity = 0.95 [260ms]
  c12.opacity = 0.95 [260ms]
  c13.opacity = 0.61 [260ms]
  c14.opacity = 0.27 [260ms]
  c15.opacity = 0.27 [260ms]
  c16.opacity = 0.61 [260ms]
  c17.opacity = 0.95 [260ms]
  c20.opacity = 0.61 [260ms]
  c21.opacity = 0.81 [260ms]
  c22.opacity = 0.95 [260ms]
  c23.opacity = 1.00 [260ms]
  c24.opacity = 0.95 [260ms]
  c25.opacity = 0.81 [260ms]
  c26.opacity = 0.61 [260ms]
  c27.opacity = 0.42 [260ms]
  c30.opacity = 0.61 [260ms]
  c31.opacity = 0.71 [260ms]
  c32.opacity = 0.81 [260ms]
  c33.opacity = 0.89 [260ms]
  c34.opacity = 0.95 [260ms]
  c35.opacity = 0.99 [260ms]
  c36.opacity = 1.00 [260ms]
  c37.opacity = 0.99 [260ms]
}

#1.80s
fade-out phase1 [240ms, ease: ease-in]
fade-in phase2 [280ms, delay: 240ms, ease: expo-out]
stagger [60ms] {
  fade-in lab0 [260ms, ease: expo-out]
  fade-in lab1 [260ms, ease: expo-out]
  fade-in lab2 [260ms, ease: expo-out]
  fade-in lab3 [260ms, ease: expo-out]
}
stagger [35ms] {
  fade-in p0 [220ms, ease: expo-out]
  fade-in p1 [220ms, ease: expo-out]
  fade-in p2 [220ms, ease: expo-out]
  fade-in p3 [220ms, ease: expo-out]
  fade-in p4 [220ms, ease: expo-out]
  fade-in p5 [220ms, ease: expo-out]
  fade-in p6 [220ms, ease: expo-out]
  fade-in p7 [220ms, ease: expo-out]
}

#2.60s
fade-in key_cap [280ms, ease: expo-out]
stagger [50ms] {
  key_lo.opacity = 0.22 [260ms]
  key_mid.opacity = 0.61 [260ms]
  key_hi.opacity = 1.00 [260ms]
}
stagger [50ms] {
  fade-in key_lo_t [240ms, ease: expo-out]
  fade-in key_zero [240ms, ease: expo-out]
  fade-in key_hi_t [240ms, ease: expo-out]
}
fade-in fusion_card [340ms, delay: 180ms, ease: expo-out]

#3.50s
fade-out phase2 [240ms, ease: ease-in]
fade-in phase3 [280ms, delay: 240ms, ease: expo-out]
fade-in cursor [220ms, ease: expo-out]
sequence {
  shift cursor [by: (84, 0), 160ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
  shift cursor [by: (84, 0), 160ms, delay: 100ms, ease: expo-out]
}
pulse fusion_card [600ms, intensity: 0.04, delay: 1800ms]
fade-out cursor [300ms, delay: 1900ms, ease: ease-in]

// ── Outro Rest Frame ────────────────────────────────────────────────
#7.00s
// Complete harmonic matrix and fusion indicators stand held for looping.
