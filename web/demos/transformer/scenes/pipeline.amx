// house-style: layer-stack climb, hierarchical abstraction, logit un-embedding payoff.
// 06 · The deep layer stack & vocabulary logit projection.
//
// The walkthrough's deep synthesis figure. Three acts:
//   I.   Tokens enter the base of the stack; the depth ruler measures the computational budget.
//   II.  The stack climbs bottom-up — Block 01 surface syntax, Block 06 entity
//        relations, Block 12 abstract intent — each with an evolving representation strip.
//   III. The LM head un-embeds the final state into 50,257 logits; the probability panel
//        ranks candidates and "street" wins. The camera pushes in and settles into rest.
//
// House-style §1: StageFloor + compact head + caption are opaque at t=0.
// House-style §5: title 48, block titles 18, sublabels 16, captions 24.
import "../../../../examples/lib/theme.amx"

import "../../../../examples/lib/stage.amx"

import "../../../../examples/lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.2 }

let stages = 12

let stage_span = (0, stages)

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.35

head_eyebrow: Text, text: "FIG 06 · DEEP LAYER STACK & LOGIT PROJECTION", font_size: 18, font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (96, 44), opacity: 0

head_title: Text, text: format("{:.0} layers to a word", stages), font_size: 48, font_weight: "bold", color: text.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (96, 96), opacity: 1

head_rule: Rect, size: (96, 4), color: accent.primary, anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "Token embeddings enter the base of the deep stack.", tag: "pipeline.amx", opacity: 1

cap2: Caption, text: format("{:.0} layers refine grammar into relational intent.", stages), tag: "pipeline.amx", opacity: 0

cap3: Caption, text: "LM head projects 50,257 logits: “street” wins.", tag: "pipeline.amx", opacity: 0

// ── Act I: input tokens on the baseline ─────────────────────────────
in_row: Row, at: (480, 600), gap: 16, align: "center" {
in1: LabeledBox, label: "The", width: 110, height: 48, text_size: 18, corner: 10
in2: LabeledBox, label: "animal", width: 110, height: 48, text_size: 18, corner: 10
in3: LabeledBox, label: "didn't", width: 110, height: 48, text_size: 18, corner: 10
in4: LabeledBox, label: "cross", width: 110, height: 48, text_size: 18, corner: 10
in5: LabeledBox, label: "the", width: 110, height: 48, text_size: 18, corner: 10
}

// A generated depth ruler: its tick count is the `stages` slider.
depth_label: Text, text: "DEPTH", font_size: 16, color: text.muted, text_align: "left", text_anchor: "left", at: (96, 240), opacity: 1

for s in stage_span {
  depth_tick[s]: Rect, size: (8, 2), corner_radius: 1, color: accent.primary, opacity: 0.42, at: (100, 604 - s * (320 / stages))
}

// ── Act II: the tower ───────────────────────────────────────────────
b1: Rect, size: (590, 80), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1.5, opacity: 0, at: (480, 500)

b2: Rect, size: (590, 80), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1.5, opacity: 0, at: (480, 390)

b3: Rect, size: (590, 80), corner_radius: 16, color: surface.primary, stroke: accent.primary, stroke_width: 1.8, opacity: 0, at: (480, 280)

s1_strip: Row, at: (730, 500), gap: 4, align: "center" {
s1_0: Rect, size: (18, 18), corner_radius: 4, color: accent.primary, opacity: 0
s1_1: Rect, size: (18, 18), corner_radius: 4, color: accent.primary, opacity: 0
s1_2: Rect, size: (18, 18), corner_radius: 4, color: accent.primary, opacity: 0
s1_3: Rect, size: (18, 18), corner_radius: 4, color: accent.primary, opacity: 0
}

s2_strip: Row, at: (730, 390), gap: 4, align: "center" {
s2_0: Rect, size: (18, 18), corner_radius: 4, color: accent.success, opacity: 0
s2_1: Rect, size: (18, 18), corner_radius: 4, color: accent.success, opacity: 0
s2_2: Rect, size: (18, 18), corner_radius: 4, color: accent.success, opacity: 0
s2_3: Rect, size: (18, 18), corner_radius: 4, color: accent.success, opacity: 0
}

s3_strip: Row, at: (730, 280), gap: 4, align: "center" {
s3_0: Rect, size: (18, 18), corner_radius: 4, color: accent.danger, opacity: 0
s3_1: Rect, size: (18, 18), corner_radius: 4, color: accent.danger, opacity: 0
s3_2: Rect, size: (18, 18), corner_radius: 4, color: accent.danger, opacity: 0
s3_3: Rect, size: (18, 18), corner_radius: 4, color: accent.danger, opacity: 0
}

// Climbing pulse dot: one token's signal rising through the stack.
climb_dot: Ellipse, size: (16, 16), color: accent.primary, opacity: 0, at: (480, 566)

// ── Timeline Choreography ───────────────────────────────────────────
// Act I — the sentence lands and the depth ruler lights.
#0.1s
  fade_in(target: head_eyebrow, duration: 0.26s, ease: expo_out)
  stack_badge: Stack, at: (1000, 78), size: (380, 50), opacity: 0 {
  s_bg: Rect, size: (380, 50), corner_radius: 12, color: surface.primary, stroke: stroke.default, stroke_width: 1.2
  s_txt: Text, text: format("N = {:.0} LAYERS · 124M PARAMETERS", stages), font_size: 18, color: text.secondary
    }
  fade_in(target: stack_badge, duration: 0.32s, ease: expo_out)
  stagger [0.06s] {
      fade_in(target: in1, duration: 0.3s, ease: expo_out)
      fade_in(target: in2, duration: 0.3s, ease: expo_out)
      fade_in(target: in3, duration: 0.3s, ease: expo_out)
      fade_in(target: in4, duration: 0.3s, ease: expo_out)
      fade_in(target: in5, duration: 0.3s, ease: expo_out)
    }

// Act II — the stack climbs: each block lands on the one below.
#1s
  up1: Arrow, from: (480, 570), to: (480, 546), head_size: 10, stroke_width: 2, stroke: text.muted, opacity: 0
  fade_in(target: up1, duration: 0.26s, ease: expo_out)
  up1.opacity = 0.7[0.24s]
  fade_out(target: cap1, duration: 0.24s, ease: ease_in)
  fade_in(target: cap2, duration: 0.28s, delay: 0.2s, ease: expo_out)
  b1.opacity = 0.9[0.38s]
  b1_t: Text, text: "Block 01 · Surface syntax & part-of-speech", font_size: 18, color: text.primary, text_anchor: "center", at: (480, 500), opacity: 0
  fade_in(target: b1_t, duration: 0.26s, delay: 0.14s, ease: expo_out)
  stagger [0.04s] {
      s1_0.opacity = 0.4[0.26s]
      s1_1.opacity = 0.85[0.26s]
      s1_2.opacity = 0.5[0.26s]
      s1_3.opacity = 0.7[0.26s]
    }

#1.8s
  up2: Arrow, from: (480, 456), to: (480, 436), head_size: 10, stroke_width: 2, stroke: text.muted, opacity: 0
  fade_in(target: up2, duration: 0.26s, ease: expo_out)
  up2.opacity = 0.7[0.24s]
  b2.opacity = 0.9[0.38s]
  b2_t: Text, text: "Block 06 · Entity relations & coreference", font_size: 18, color: text.primary, text_anchor: "center", at: (480, 390), opacity: 0
  fade_in(target: b2_t, duration: 0.24s, delay: 0.14s, ease: expo_out)
  stagger [0.04s] {
      s2_0.opacity = 0.7[0.26s]
      s2_1.opacity = 0.4[0.26s]
      s2_2.opacity = 0.9[0.26s]
      s2_3.opacity = 0.6[0.26s]
    }

#2.6s
  up3: Arrow, from: (480, 346), to: (480, 326), head_size: 10, stroke_width: 2, stroke: text.muted, opacity: 0
  fade_in(target: up3, duration: 0.26s, ease: expo_out)
  up3.opacity = 0.7[0.24s]
  b3.opacity = 0.95[0.38s]
  b3_t: Text, text: "Block 12 · Abstract intent & semantic prediction", font_size: 18, color: accent.primary, text_anchor: "center", at: (480, 280), opacity: 0
  fade_in(target: b3_t, duration: 0.24s, delay: 0.14s, ease: expo_out)
  stagger [0.04s] {
      s3_0.opacity = 0.9[0.26s]
      s3_1.opacity = 0.6[0.26s]
      s3_2.opacity = 0.4[0.26s]
      s3_3.opacity = 0.95[0.26s]
    }

// Act III — the LM head and the logit ranking.
#3.4s
  fade_out(target: cap2, duration: 0.24s, ease: ease_in)
  fade_in(target: cap3, duration: 0.28s, delay: 0.2s, ease: expo_out)
  up_top: Arrow, from: (480, 236), to: (480, 216), head_size: 10, stroke_width: 2, stroke: accent.primary, opacity: 0
  fade_in(target: up_top, duration: 0.26s, ease: expo_out)
  up_top.opacity = 0.8[0.24s]
  lm_box: Rect, size: (590, 46), corner_radius: 12, color: surface.primary, stroke: accent.primary, stroke_width: 2, opacity: 0, at: (480, 190)
  lm_txt: Text, text: "Language Model Head · Linear(768 > 50,257) + Softmax", font_size: 18, color: text.primary, text_anchor: "center", at: (480, 190), opacity: 0
  lm_box.opacity = 0.95[0.32s]
  fade_in(target: lm_txt, duration: 0.28s, delay: 0.16s, ease: expo_out)

#4.1s
  prob_panel: Stack, at: (1080, 480), size: (260, 300), opacity: 0 {
  p_bg: Rect, size: (260, 300), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1.4
    }
  p_title: Text, text: "Next-token probabilities", font_size: 18, color: text.primary, text_anchor: "center", at: (1080, 360), opacity: 0
  pw0: Text, text: "“street”", font_size: 16, color: accent.primary, text_anchor: "left", at: (980, 402), opacity: 0
  pb0: Rect, size: (100, 16), corner_radius: 4, color: accent.primary, at: (1090, 402), opacity: 0
  pv0: Text, text: "0.41", font_size: 16, color: accent.primary, text_anchor: "right", at: (1180, 402), opacity: 0
  pw1: Text, text: "“road”", font_size: 16, color: text.secondary, text_anchor: "left", at: (980, 438), opacity: 0
  pb1: Rect, size: (54, 16), corner_radius: 4, color: text.secondary, at: (1090, 438), opacity: 0
  pv1: Text, text: "0.22", font_size: 16, color: text.secondary, text_anchor: "right", at: (1180, 438), opacity: 0
  pw2: Text, text: "“bridge”", font_size: 16, color: text.secondary, text_anchor: "left", at: (980, 474), opacity: 0
  pb2: Rect, size: (28, 16), corner_radius: 4, color: text.secondary, at: (1090, 474), opacity: 0
  pv2: Text, text: "0.12", font_size: 16, color: text.secondary, text_anchor: "right", at: (1180, 474), opacity: 0
  pw3: Text, text: "“path”", font_size: 16, color: text.secondary, text_anchor: "left", at: (980, 510), opacity: 0
  pb3: Rect, size: (12, 16), corner_radius: 4, color: text.secondary, at: (1090, 510), opacity: 0
  pv3: Text, text: "0.05", font_size: 16, color: text.secondary, text_anchor: "right", at: (1180, 510), opacity: 0
  p_verdict: Text, text: "Predicted: “street”", font_size: 16, color: accent.primary, text_anchor: "center", at: (1080, 560), opacity: 0
  fade_in(target: prob_panel, duration: 0.38s, ease: expo_out)
  stagger [0.06s] {
      fade_in(target: p_title, duration: 0.26s, ease: expo_out)
      fade_in(target: pw0, duration: 0.24s, ease: expo_out)
      fade_in(target: pv0, duration: 0.24s, ease: expo_out)
      fade_in(target: pw1, duration: 0.24s, ease: expo_out)
      fade_in(target: pv1, duration: 0.24s, ease: expo_out)
      fade_in(target: pw2, duration: 0.24s, ease: expo_out)
      fade_in(target: pv2, duration: 0.24s, ease: expo_out)
      fade_in(target: pw3, duration: 0.24s, ease: expo_out)
      fade_in(target: pv3, duration: 0.24s, ease: expo_out)
      fade_in(target: p_verdict, duration: 0.26s, ease: expo_out)
    }
  stagger [0.07s] {
      pb0.opacity = 1[0.28s]
      pb1.opacity = 0.5[0.28s]
      pb2.opacity = 0.35[0.28s]
      pb3.opacity = 0.2[0.28s]
    }

// The token signal climbs the finished tower as the ranking settles.
#4.8s
  fade_in(target: climb_dot, duration: 0.22s, ease: expo_out)
  shift(target: climb_dot, by: (0, -370), duration: 1.6s, ease: ease_in_out)
  fade_out(target: climb_dot, duration: 0.26s, delay: 1.48s, ease: ease_in)

// Payoff: winning prediction settles for the resting frame.
#6.4s
  pulse(target: pb0, duration: 0.6s, intensity: 0.05, delay: 0.2s)

// ── Rest ────────────────────────────────────────────────────────────
#8.1s
// Inputs, three blocks with their strips, the LM head and the probability
// panel all stand. Nothing erases; the stack rests on its tokens.
