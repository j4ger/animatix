// 04 · Multi-head attention.
//
// Each head gets its own 3×3 attention pattern — rows are queries, columns are
// keys, intensity is the weight. The original showed two chips joined by a line
// and left the actual claim ("each head specialises") to the caption. Three
// patterns side by side let the reader *see* the specialisation.
//
// The output bar is three segments, one per head, each centred exactly under the
// head that produced it and painted that head's colour. In the original the
// segments were shifted 52px left of their bar, left a 70px hole at the right
// end, and used a fourth colour that belonged to no head — so its caption
// ("their colors merge in the output mix") was not actually visible.
//
// Grid: 1280×720. Head centres x = 290, 640, 990; panels 320 wide, cells 64 with
// a 12px gap, rows at y = 239, 315, 391, output segments at y = 530.

import "../../lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.2 }

// ── phase narration (top-left; one label per beat) ──────────────────
phase1: Text, text: "1 · several heads in parallel", font_size: 15, color: text.muted,
  text_max_width: 320, text_align: "left", at: (150, 96)
phase2: Text, text: "2 · each head finds its own structure", font_size: 15, color: text.muted,
  text_max_width: 380, text_align: "left", at: (150, 96)
phase3: Text, text: "3 · concat, then mix", font_size: 15, color: text.muted,
  text_max_width: 280, text_align: "left", at: (150, 96)

// ── panels ──────────────────────────────────────────────────────────
panel_a: Rect, size: (320, 300), corner_radius: 18, color: surface.primary, opacity: 0.0, at: (290, 290)
panel_b: Rect, size: (320, 300), corner_radius: 18, color: surface.primary, opacity: 0.0, at: (640, 290)
panel_c: Rect, size: (320, 300), corner_radius: 18, color: surface.primary, opacity: 0.0, at: (990, 290)

title_a: Text, text: "who did what", font_size: 16, color: accent.primary, at: (290, 172)
title_b: Text, text: "did what to whom", font_size: 16, color: accent.success, at: (640, 172)
title_c: Text, text: "next token only", font_size: 16, color: accent.warning, at: (990, 172)

head1_grid: Grid, cols: 3, gap: 12, at: (290, 315) {
  // ── head 1: subject → verb ──────────────────────────────────────────
  h1_00: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_01: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_02: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_10: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_11: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_12: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_20: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_21: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0
  h1_22: Rect, size: (64, 64), corner_radius: 8, color: accent.primary, opacity: 0.0

}
head2_grid: Grid, cols: 3, gap: 12, at: (640, 315) {
  // ── head 2: verb → object ───────────────────────────────────────────
  h2_00: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_01: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_02: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_10: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_11: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_12: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_20: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_21: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0
  h2_22: Rect, size: (64, 64), corner_radius: 8, color: accent.success, opacity: 0.0

}
head3_grid: Grid, cols: 3, gap: 12, at: (990, 315) {
  // ── head 3: neighbours ──────────────────────────────────────────────
  h3_00: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_01: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_02: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_10: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_11: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_12: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_20: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_21: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0
  h3_22: Rect, size: (64, 64), corner_radius: 8, color: accent.warning, opacity: 0.0

}
// ── each head's output drops into its own segment ───────────────────
drop_a: Arrow, from: (290, 452), to: (290, 496), head_size: 12,
  stroke_width: 2, color: accent.primary, opacity: 0.0
drop_b: Arrow, from: (640, 452), to: (640, 496), head_size: 12,
  stroke_width: 2, color: accent.success, opacity: 0.0
drop_c: Arrow, from: (990, 452), to: (990, 496), head_size: 12,
  stroke_width: 2, color: accent.warning, opacity: 0.0

segs: Row, at: (640, 530), gap: 4 {
  seg_a: Rect, size: (346, 56), corner_radius: 10, color: accent.primary, opacity: 0.0
  seg_b: Rect, size: (346, 56), corner_radius: 10, color: accent.success, opacity: 0.0
  seg_c: Rect, size: (346, 56), corner_radius: 10, color: accent.warning, opacity: 0.0
}

mix_label: Text, text: "concat, then a linear mix", font_size: 16, color: text.muted, at: (640, 606)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
fade-in phase1 [300ms]
stagger [130ms] {
  panel_a.opacity = 0.55 [400ms]
  panel_b.opacity = 0.55 [400ms]
  panel_c.opacity = 0.55 [400ms]
}

#0.50s
stagger [130ms] {
  fade-in title_a [300ms]
  fade-in title_b [300ms]
  fade-in title_c [300ms]
}

// Head by head, so each pattern can be compared with the one before it.
#0.95s
fade-out phase1 [260ms]
fade-in phase2 [280ms]
stagger [45ms] {
  h1_00.opacity = 0.95 [300ms]
  h1_01.opacity = 0.45 [300ms]
  h1_02.opacity = 0.20 [300ms]
  h1_10.opacity = 0.85 [300ms]
  h1_11.opacity = 0.30 [300ms]
  h1_12.opacity = 0.25 [300ms]
  h1_20.opacity = 0.30 [300ms]
  h1_21.opacity = 0.90 [300ms]
  h1_22.opacity = 0.35 [300ms]
}

// Each head's strongest link pulses just before the next head builds —
// "this one locked in", by which time its cells have all landed.
#1.80s
pulse h1_00 [560ms, intensity: 1.05]

#1.85s
stagger [45ms] {
  h2_00.opacity = 0.25 [300ms]
  h2_01.opacity = 0.40 [300ms]
  h2_02.opacity = 0.30 [300ms]
  h2_10.opacity = 0.35 [300ms]
  h2_11.opacity = 0.25 [300ms]
  h2_12.opacity = 0.95 [300ms]
  h2_20.opacity = 0.20 [300ms]
  h2_21.opacity = 0.60 [300ms]
  h2_22.opacity = 0.45 [300ms]
}

#2.70s
pulse h2_12 [560ms, intensity: 1.05]

#2.75s
stagger [45ms] {
  h3_00.opacity = 0.60 [300ms]
  h3_01.opacity = 0.90 [300ms]
  h3_02.opacity = 0.25 [300ms]
  h3_10.opacity = 0.90 [300ms]
  h3_11.opacity = 0.55 [300ms]
  h3_12.opacity = 0.85 [300ms]
  h3_20.opacity = 0.30 [300ms]
  h3_21.opacity = 0.95 [300ms]
  h3_22.opacity = 0.60 [300ms]
}

#3.60s
fade-out phase2 [260ms]
fade-in phase3 [280ms]
pulse h3_21 [560ms, intensity: 1.05]

#3.70s
stagger [130ms] {
  draw-in drop_a [320ms, ease: ease-out]
  draw-in drop_b [320ms, ease: ease-out]
  draw-in drop_c [320ms, ease: ease-out]
}
stagger [130ms] {
  drop_a.opacity = 0.7 [320ms]
  drop_b.opacity = 0.7 [320ms]
  drop_c.opacity = 0.7 [320ms]
}

#4.10s
stagger [130ms] {
  seg_a.opacity = 0.85 [380ms]
  seg_b.opacity = 0.85 [380ms]
  seg_c.opacity = 0.85 [380ms]
}

#4.80s
fade-in mix_label [400ms]
