// 01 · From text to tokens — chips become vectors, and every entry of a vector
// is one learned number. Cell intensity *is* the value, so a single hue carries
// all the information; nothing varies decoratively.
//
// The figure narrates its own phases with the numbered label at the top left,
// and it opens with the whole sentence on one bar that then splits into the
// three chips — tokenization as a visible step rather than an assumption.
//
// Structure: the repetitive parts are layout containers (Row/Col/Stack), so the
// only authored coordinates are the three column anchors — no hand-computed
// pitch. Chip+label pairs are Stacks inside the chip Row; each embedding
// column is a Col of cells.
//
// Gating rule (probe-verified): an authored non-zero `opacity` is visible from
// frame 0 no matter which entrance follows — wipe/draw only animate the fill
// and stroke channels. Every dimmed actor here is therefore authored
// `opacity: 0.0` (the seed) and settles on its value through a keyframe
// `X.opacity = v [dur]` assignment at its beat.

import "../../lib/theme.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.8 }

// ── phase narration (top-left; one label per beat) ──────────────────
phase1: Text, text: "1 · the text", font_size: 15, color: text.muted,
  text_max_width: 240, text_align: "left", at: (150, 96)
phase2: Text, text: "2 · split into tokens", font_size: 15, color: text.muted,
  text_max_width: 240, text_align: "left", at: (150, 96)
phase3: Text, text: "3 · each token becomes numbers", font_size: 15, color: text.muted,
  text_max_width: 300, text_align: "left", at: (150, 96)

// ── the sentence, before any splitting ──────────────────────────────
bar_stack: Stack, at: (660, 98) {
  bar: Rect, size: (520, 56), corner_radius: 14, color: surface.primary
  bar_t: Text, text: "The cat sat", font_size: 26, color: text.primary
}

// ── token chips — the shared LabeledBox component, one actor each ───
chip_the: LabeledBox, label: "the", width: 200, height: 64, text_size: 26, at: (300, 172)
chip_cat: LabeledBox, label: "cat", width: 200, height: 64, text_size: 26, at: (580, 172)
chip_sat: LabeledBox, label: "sat", width: 200, height: 64, text_size: 26, at: (860, 172)

link_the: Line, from: (300, 208), to: (300, 244), stroke_width: 2, color: text.muted, opacity: 0.0
link_cat: Line, from: (580, 208), to: (580, 244), stroke_width: 2, color: text.muted, opacity: 0.0
link_sat: Line, from: (860, 208), to: (860, 244), stroke_width: 2, color: text.muted, opacity: 0.0

// ── one embedding vector per token: five entries, intensity = value ──
the_col: Col, at: (300, 394), gap: 10 {
  the_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  the_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  the_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  the_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  the_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
}
cat_col: Col, at: (580, 394), gap: 10 {
  cat_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  cat_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  cat_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  cat_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  cat_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
}
sat_col: Col, at: (860, 394), gap: 10 {
  sat_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  sat_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  sat_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  sat_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
  sat_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.0
}

// The vector continues past five entries. Drawn as dots, not "⋮" (U+22EE):
// the fast-path face has no glyph for it and renders tofu.
the_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (291, 573)
the_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (300, 573)
the_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (309, 573)
cat_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (571, 573)
cat_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (580, 573)
cat_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (589, 573)
sat_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (851, 573)
sat_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (860, 573)
sat_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.0, at: (869, 573)

// ── the bracket that names the vector's length ──────────────────────
brace_top: Line, from: (972, 249), to: (996, 249), stroke_width: 2.5, color: accent.primary
brace_mid: Line, from: (996, 249), to: (996, 539), stroke_width: 2.5, color: accent.primary
brace_bot: Line, from: (996, 539), to: (972, 539), stroke_width: 2.5, color: accent.primary

brace_label: Text, text: "d_model = 512", font_size: 20, color: accent.primary,
  text_max_width: 180, text_align: "left", at: (1112, 394)

// Closing beat: one bright rule walks down the entries, so the matrix reads as
// many rows of numbers rather than as five stacked blocks.
scan: Rect, size: (790, 3), corner_radius: 2, color: accent.primary, opacity: 0.0, at: (580, 249)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
fade-in phase1 [300ms, ease: expo-out]

#0.40s
fade-in bar [420ms, ease: expo-out]

#0.75s
fade-in bar_t [320ms, ease: expo-out]

// The sentence splits: the bar dissolves as the chips take its place.
#1.30s
fade-out phase1 [260ms, ease: ease-in]
fade-in phase2 [260ms, delay: 200ms, ease: expo-out]
stagger [130ms] {
  fade-in chip_the [380ms, ease: expo-out]
  fade-in chip_cat [380ms, ease: expo-out]
  fade-in chip_sat [380ms, ease: expo-out]
}

#1.65s
fade-out bar [340ms, ease: ease-in]
fade-out bar_t [260ms, ease: ease-in]

#2.45s
stagger [120ms] {
  link_the.opacity = 0.5 [260ms]
  link_cat.opacity = 0.5 [260ms]
  link_sat.opacity = 0.5 [260ms]
}

#2.85s
fade-out phase2 [260ms, ease: ease-in]
fade-in phase3 [300ms, delay: 200ms, ease: expo-out]
stagger [45ms] {
  the_v0.opacity = 0.95 [300ms]
  the_v1.opacity = 0.52 [300ms]
  the_v2.opacity = 0.78 [300ms]
  the_v3.opacity = 0.42 [300ms]
  the_v4.opacity = 0.62 [300ms]
  cat_v0.opacity = 0.44 [300ms]
  cat_v1.opacity = 0.88 [300ms]
  cat_v2.opacity = 0.42 [300ms]
  cat_v3.opacity = 0.72 [300ms]
  cat_v4.opacity = 0.50 [300ms]
  sat_v0.opacity = 0.70 [300ms]
  sat_v1.opacity = 0.40 [300ms]
  sat_v2.opacity = 0.84 [300ms]
  sat_v3.opacity = 0.48 [300ms]
  sat_v4.opacity = 0.66 [300ms]
}

#4.15s
stagger [60ms] {
  the_d0.opacity = 0.75 [240ms]
  the_d1.opacity = 0.48 [240ms]
  the_d2.opacity = 0.26 [240ms]
  cat_d0.opacity = 0.75 [240ms]
  cat_d1.opacity = 0.48 [240ms]
  cat_d2.opacity = 0.26 [240ms]
  sat_d0.opacity = 0.75 [240ms]
  sat_d1.opacity = 0.48 [240ms]
  sat_d2.opacity = 0.26 [240ms]
}

#4.55s
draw-in brace_top [280ms, ease: expo-out]
draw-in brace_mid [340ms, ease: expo-out, delay: 160ms]
draw-in brace_bot [280ms, ease: expo-out, delay: 460ms]

#4.85s
fade-in brace_label [400ms, ease: expo-out]

#5.35s
fade-in scan [260ms, ease: expo-out]
shift scan [by: (0, 290), 1500ms, ease: ease-in-out]
fade-out scan [300ms, delay: 1400ms, ease: ease-in]

// Outro: quiet the plate before the wrap (reverse order).
#7.10s
stagger [10ms] {
  fade-out brace_label [260ms, ease: ease-in]
  fade-out brace_top [260ms, ease: ease-in]
  fade-out brace_mid [260ms, ease: ease-in]
  fade-out brace_bot [260ms, ease: ease-in]
  fade-out phase3 [260ms, ease: ease-in]
  fade-out sat_d0 [260ms, ease: ease-in]
  fade-out sat_d1 [260ms, ease: ease-in]
  fade-out sat_d2 [260ms, ease: ease-in]
  fade-out cat_d0 [260ms, ease: ease-in]
  fade-out cat_d1 [260ms, ease: ease-in]
  fade-out cat_d2 [260ms, ease: ease-in]
  fade-out the_d0 [260ms, ease: ease-in]
  fade-out the_d1 [260ms, ease: ease-in]
  fade-out the_d2 [260ms, ease: ease-in]
  fade-out sat_v0 [260ms, ease: ease-in]
  fade-out sat_v1 [260ms, ease: ease-in]
  fade-out sat_v2 [260ms, ease: ease-in]
  fade-out sat_v3 [260ms, ease: ease-in]
  fade-out sat_v4 [260ms, ease: ease-in]
  fade-out cat_v0 [260ms, ease: ease-in]
  fade-out cat_v1 [260ms, ease: ease-in]
  fade-out cat_v2 [260ms, ease: ease-in]
  fade-out cat_v3 [260ms, ease: ease-in]
  fade-out cat_v4 [260ms, ease: ease-in]
  fade-out the_v0 [260ms, ease: ease-in]
  fade-out the_v1 [260ms, ease: ease-in]
  fade-out the_v2 [260ms, ease: ease-in]
  fade-out the_v3 [260ms, ease: ease-in]
  fade-out the_v4 [260ms, ease: ease-in]
  fade-out link_the [260ms, ease: ease-in]
  fade-out link_cat [260ms, ease: ease-in]
  fade-out link_sat [260ms, ease: ease-in]
  fade-out chip_the [260ms, ease: ease-in]
  fade-out chip_cat [260ms, ease: ease-in]
  fade-out chip_sat [260ms, ease: ease-in]
}
