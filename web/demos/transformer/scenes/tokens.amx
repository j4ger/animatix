// house-style: sentence hook, BPE/ID fracture, coordinate extrusion with camera push.
// 01 · From text to tokens — sub-word fracture & vector extrusion.
//
// The walkthrough's opening figure, cut in three acts:
//   I.   Natural text arrives as a raw character string — unbroken and continuous.
//   II.  Byte-Pair Encoding fractures it into tokens, each mapping to an integer vocabulary ID.
//   III. The embedding table W_e extrudes every ID into a 768-dim coordinate row;
//        the camera pushes into the vector block and settles into the resting frame.
//
// House-style §1: StageFloor + compact head + caption are authored-opaque, so
// frame 0 is a composed stage. House-style §5: nothing below 16 px.

import "../../lib/theme.amx"
import "../../lib/stage.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.8 }

// Slider target: `--set seq=7` rewrites every token-count label (range 3-8).
let seq = 5
// 5 columns × 5 sampled cells stand in for 768 dimensions.
let cells = (0, 25)

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.35

head_eyebrow: Text, text: "FIG 01 · SUB-WORD FRACTURE & EMBEDDING", font_size: 18,
  font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 44), opacity: 0
head_title: Text, text: "Text is not the input", font_size: 48, font_weight: "bold",
  color: text.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 96), opacity: 1
head_rule: Rect, size: (96, 4), color: accent.primary,
  anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "Natural text arrives as unbroken character strings.",
  tag: "tokens.amx", opacity: 1
cap2: Caption, text: "BPE fractures text into discrete tokens and integer IDs.",
  tag: "tokens.amx", opacity: 0
cap3: Caption, text: "Table W_e extrudes each ID into a 768-dim vector.",
  tag: "tokens.amx", opacity: 0

seq_chip: Readout, label: "TOKENS", value: format("{:.0}", seq), at: (1090, 238)
dim_chip: Readout, label: "D_MODEL", value: "768", at: (1090, 334)

// ── Act I: the sentence bar ─────────────────────────────────────────
bar_stack: Stack, at: (520, 238), size: (860, 62) {
  bar: Rect, size: (860, 62), corner_radius: 14, color: surface.primary,
    stroke: accent.primary * 0.45, stroke_width: 1.5
  bar_t: Text, text: "“The animal didn't cross the”", font_size: 26, font_weight: 600, color: text.primary
}

// ── Act II: token chips and vocabulary IDs ──────────────────────────
chip_row: Row, at: (520, 252), gap: 16, align: "center" {
  chip_the: LabeledBox, label: "The", width: 150, height: 56, text_size: 20, stroke: stroke.default, stroke_width: 1.2
  chip_animal: LabeledBox, label: "animal", width: 150, height: 56, text_size: 20, stroke: stroke.default, stroke_width: 1.2
  chip_didnt: LabeledBox, label: "didn't", width: 150, height: 56, text_size: 20, stroke: stroke.default, stroke_width: 1.2
  chip_cross: LabeledBox, label: "cross", width: 150, height: 56, text_size: 20, stroke: stroke.default, stroke_width: 1.2
  chip_the2: LabeledBox, label: "the", width: 150, height: 56, text_size: 20, stroke: stroke.default, stroke_width: 1.2
}

id_label: Text, text: "VOCABULARY IDS · 50,257-TOKEN CODEBOOK", font_size: 16, font_weight: 600, color: text.muted,
  text_align: "left", text_anchor: "left", at: (96, 188), opacity: 0

id_row: Row, at: (520, 310), gap: 16, align: "center" {
  id_box_the: Stack, size: (150, 24) { id_the: Text, text: "ID 464", font_size: 16, font_weight: 600, color: accent.primary }
  id_box_ani: Stack, size: (150, 24) { id_ani: Text, text: "ID 8,432", font_size: 16, font_weight: 600, color: accent.primary }
  id_box_did: Stack, size: (150, 24) { id_did: Text, text: "ID 1,544", font_size: 16, font_weight: 600, color: accent.primary }
  id_box_cro: Stack, size: (150, 24) { id_cro: Text, text: "ID 3,278", font_size: 16, font_weight: 600, color: accent.primary }
  id_box_the2: Stack, size: (150, 24) { id_the2: Text, text: "ID 262", font_size: 16, font_weight: 600, color: accent.primary }
}

link_the: Arrow, from: (192, 272), to: (192, 294), head_size: 8, stroke_width: 2,
  stroke: accent.primary, opacity: 0
link_ani: Arrow, from: (358, 272), to: (358, 294), head_size: 8, stroke_width: 2,
  stroke: accent.primary, opacity: 0
link_did: Arrow, from: (524, 272), to: (524, 294), head_size: 8, stroke_width: 2,
  stroke: accent.primary, opacity: 0
link_cro: Arrow, from: (690, 272), to: (690, 294), head_size: 8, stroke_width: 2,
  stroke: accent.primary, opacity: 0
link_the2: Arrow, from: (856, 272), to: (856, 294), head_size: 8, stroke_width: 2,
  stroke: accent.primary, opacity: 0

// ── Act III: the extruded embedding block ───────────────────────────
emb_label: Text, text: "EMBEDDING ROWS (W_e) · 768 FLOAT32 COORDINATES", font_size: 16, font_weight: 600, color: text.muted,
  text_align: "left", text_anchor: "left", at: (96, 334), opacity: 0

emb: Grid, cols: 5, gap: 14, at: (520, 488) {
  for i in cells {
    v[i]: Rect, size: (150, 40), corner_radius: 8, color: accent.primary, opacity: 0
  }
}

dim_card: Stack, at: (1080, 500), size: (200, 92), opacity: 0 {
  dim_bg: Rect, size: (200, 92), corner_radius: 14, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.4
  dim_col: Col, gap: 4, align: "center" {
    dim_t1: Text, text: "d_model = 768", font_size: 20, font_weight: 600, color: accent.primary
    dim_t2: Text, text: "Float32 coordinates", font_size: 16, color: text.muted
  }
}

brace_glow: Rect, size: (10, 264), corner_radius: 5, color: accent.primary,
  blend: "screen", at: (960, 486), opacity: 0

// ── Timeline Choreography ───────────────────────────────────────────
always {
  seq_chip.value_text.text = format("{:.0}", clamp(floor((t - 1.1) / 0.36) + 1, 1, seq))
}

// Act I — sentence arrives with lit stage
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in bar [380ms, ease: expo-out]
fade-in bar_t [240ms, delay: 120ms, ease: expo-out]

// Act II — BPE fracture into chips, then integer vocabulary IDs
#1.10s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]
fade-out bar [260ms, ease: ease-in]
fade-out bar_t [220ms, delay: 40ms, ease: ease-in]
stagger [90ms] {
  fade-in chip_the [360ms, ease: expo-out]
  fade-in chip_animal [360ms, ease: expo-out]
  fade-in chip_didnt [360ms, ease: expo-out]
  fade-in chip_cross [360ms, ease: expo-out]
  fade-in chip_the2 [360ms, ease: expo-out]
}

#2.10s
fade-in id_label [260ms, ease: expo-out]
stagger [70ms] {
  fade-in id_the [260ms, ease: expo-out]
  fade-in id_ani [260ms, ease: expo-out]
  fade-in id_did [260ms, ease: expo-out]
  fade-in id_cro [260ms, ease: expo-out]
  fade-in id_the2 [260ms, ease: expo-out]
}
stagger [70ms] {
  draw-in link_the [280ms, ease: expo-out]
  link_the.opacity = 0.7 [260ms]
  draw-in link_ani [280ms, ease: expo-out]
  link_ani.opacity = 0.7 [260ms]
  draw-in link_did [280ms, ease: expo-out]
  link_did.opacity = 0.7 [260ms]
  draw-in link_cro [280ms, ease: expo-out]
  link_cro.opacity = 0.7 [260ms]
  draw-in link_the2 [280ms, ease: expo-out]
  link_the2.opacity = 0.7 [260ms]
}

// Act III — Extrusion into continuous 768-dim coordinates
#3.00s
fade-in emb_label [280ms, ease: expo-out]
for i in cells [step: 36ms] {
  v[i].opacity = clamp(0.25 + 0.07 * (i - floor(i / 11) * 11), 0.22, 0.90) [280ms]
}

#4.40s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
brace_top: Rect, size: (26, 3), corner_radius: 1, color: accent.primary, at: (947, 358), opacity: 0
brace_mid: Rect, size: (3, 256), corner_radius: 1, color: accent.primary, at: (960, 486), opacity: 0
brace_bot: Rect, size: (26, 3), corner_radius: 1, color: accent.primary, at: (947, 614), opacity: 0
draw-in brace_top [260ms, ease: expo-out]
draw-in brace_mid [340ms, delay: 140ms, ease: expo-out]
draw-in brace_bot [260ms, delay: 420ms, ease: expo-out]

#4.55s
fade-in dim_card [380ms, delay: 180ms, ease: expo-out]
fade-in brace_glow [460ms, ease: expo-out]
brace_glow.opacity = 0.34 [520ms]

#5.20s
camera.zoom = 1.045 [1.2s, ease: ease-in-out]

#6.60s
brace_glow.opacity = 0.10 [900ms, ease: ease-in-out]
camera.zoom = 1.0 [1.2s, ease: ease-in-out]

// ── Rest ────────────────────────────────────────────────────────────
#7.40s
// Complete fracture map: sentence, chips, IDs, extrusion block, bracket and
// dimension card all stand in the final resting frame.
