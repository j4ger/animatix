// 01 · From text to tokens — chips become vectors, and every entry of a vector
// is one learned number. Cell intensity *is* the value, so a single hue carries
// all the information; nothing varies decoratively.
//
// Grid: 1280×720, safe area x[64, 1216] y[64, 656]. Three columns at pitch 280
// centred on the diagram, diagram and its bracket label centred as one figure.
// No title, subtitle or takeaway line — the page owns the prose.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6.0 }

// ── token chips ─────────────────────────────────────────────────────
chip_the: Rect, size: (200, 64), corner_radius: 14, color: surface.primary, at: (300, 172)
chip_the_t: Text, text: "the", font_size: 26, color: text.primary, at: (300, 172)
chip_cat: Rect, size: (200, 64), corner_radius: 14, color: surface.primary, at: (580, 172)
chip_cat_t: Text, text: "cat", font_size: 26, color: text.primary, at: (580, 172)
chip_sat: Rect, size: (200, 64), corner_radius: 14, color: surface.primary, at: (860, 172)
chip_sat_t: Text, text: "sat", font_size: 26, color: text.primary, at: (860, 172)

link_the: Line, from: (300, 208), to: (300, 244), stroke_width: 2, color: text.muted, opacity: 0.5
link_cat: Line, from: (580, 208), to: (580, 244), stroke_width: 2, color: text.muted, opacity: 0.5
link_sat: Line, from: (860, 208), to: (860, 244), stroke_width: 2, color: text.muted, opacity: 0.5

// ── one embedding vector per token: five entries, intensity = value ──
the_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.95, at: (300, 274)
the_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.52, at: (300, 334)
the_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.78, at: (300, 394)
the_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.38, at: (300, 454)
the_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.62, at: (300, 514)

cat_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.44, at: (580, 274)
cat_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.88, at: (580, 334)
cat_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.34, at: (580, 394)
cat_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.72, at: (580, 454)
cat_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.50, at: (580, 514)

sat_v0: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.70, at: (860, 274)
sat_v1: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.40, at: (860, 334)
sat_v2: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.84, at: (860, 394)
sat_v3: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.48, at: (860, 454)
sat_v4: Rect, size: (200, 50), corner_radius: 9, color: accent.primary, opacity: 0.66, at: (860, 514)

// The vector continues past five entries. Drawn as dots, not "⋮" (U+22EE):
// the fast-path face has no glyph for it and renders tofu.
the_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.75, at: (291, 573)
the_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.48, at: (300, 573)
the_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.26, at: (309, 573)
cat_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.75, at: (571, 573)
cat_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.48, at: (580, 573)
cat_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.26, at: (589, 573)
sat_d0: Ellipse, size: (7, 7), color: text.muted, opacity: 0.75, at: (851, 573)
sat_d1: Ellipse, size: (7, 7), color: text.muted, opacity: 0.48, at: (860, 573)
sat_d2: Ellipse, size: (7, 7), color: text.muted, opacity: 0.26, at: (869, 573)

// ── the bracket that names the vector's length ──────────────────────
brace_top: Line, from: (972, 249), to: (996, 249), stroke_width: 2.5, color: accent.primary
brace_mid: Line, from: (996, 249), to: (996, 539), stroke_width: 2.5, color: accent.primary
brace_bot: Line, from: (996, 539), to: (972, 539), stroke_width: 2.5, color: accent.primary

brace_label: Text, text: "d_model = 512", font_size: 20, color: accent.primary,
  text_max_width: 180, text_align: "left", at: (1112, 394)

// Closing beat: one bright rule walks down the entries, so the matrix reads as
// many rows of numbers rather than as five stacked blocks.
scan: Rect, size: (790, 3), corner_radius: 2, color: accent.warning, opacity: 0.0, at: (580, 249)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
stagger [120ms] {
  wipe-in chip_the [380ms]
  wipe-in chip_cat [380ms]
  wipe-in chip_sat [380ms]
}

#0.55s
stagger [120ms] {
  fade-in chip_the_t [280ms]
  fade-in chip_cat_t [280ms]
  fade-in chip_sat_t [280ms]
}

#0.80s
stagger [120ms] {
  draw-in link_the [260ms]
  draw-in link_cat [260ms]
  draw-in link_sat [260ms]
}

#1.25s
stagger [45ms] {
  wipe-in the_v0 [300ms]
  wipe-in the_v1 [300ms]
  wipe-in the_v2 [300ms]
  wipe-in the_v3 [300ms]
  wipe-in the_v4 [300ms]
  wipe-in cat_v0 [300ms]
  wipe-in cat_v1 [300ms]
  wipe-in cat_v2 [300ms]
  wipe-in cat_v3 [300ms]
  wipe-in cat_v4 [300ms]
  wipe-in sat_v0 [300ms]
  wipe-in sat_v1 [300ms]
  wipe-in sat_v2 [300ms]
  wipe-in sat_v3 [300ms]
  wipe-in sat_v4 [300ms]
}

#2.55s
stagger [60ms] {
  wipe-in the_d0 [240ms]
  wipe-in the_d1 [240ms]
  wipe-in the_d2 [240ms]
  wipe-in cat_d0 [240ms]
  wipe-in cat_d1 [240ms]
  wipe-in cat_d2 [240ms]
  wipe-in sat_d0 [240ms]
  wipe-in sat_d1 [240ms]
  wipe-in sat_d2 [240ms]
}

#2.95s
draw-in brace_top [280ms, ease: ease-out]
draw-in brace_mid [340ms, ease: ease-out, delay: 160ms]
draw-in brace_bot [280ms, ease: ease-out, delay: 460ms]

#3.25s
fade-in brace_label [400ms]

#4.05s
fade-in scan [260ms]
shift scan [by: (0, 290), 1500ms, ease: ease-in-out]
fade-out scan [300ms, delay: 1400ms]
