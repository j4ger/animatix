// 00 · The whole architecture, one unified blueprint.
//
// The article opens with this master figure. It reads bottom-up, following data flow:
//   1. Discrete token chips along the bottom baseline.
//   2. Token embeddings + positional encodings plate.
//   3. Transformer block × N with self-attention, FFN, and residual skip arcs.
//   4. LM Head un-embeds hidden states into vocabulary logits.
//   5. Autoregressive loopback: winning token ("street") appends back to input sequence.

import "../../lib/theme.amx"
import "../../lib/ambience.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 9.0 }

bg: Ambience, tint: accent.primary, base_opacity: 0.14, seed: 70

// ── Header / Narration (top-left) ───────────────────────────────────
head_eyebrow: Text, text: "FIG 00 // FULL ARCHITECTURE BLUEPRINT", font_size: 13,
  color: accent.primary, text_align: "left", anchor: scene.top_left, offset: (80, 48)

phase1: Text, text: "1 · Discrete sub-word tokens enter along the input baseline", font_size: 18, color: text.primary,
  text_max_width: 520, text_align: "left", anchor: scene.top_left, offset: (80, 74)
phase2: Text, text: "2 · Coordinate injection: Token embeddings + positional encodings", font_size: 18, color: text.primary,
  text_max_width: 520, text_align: "left", anchor: scene.top_left, offset: (80, 74)
phase3: Text, text: "3 · Repeated Transformer Block × N: Multi-Head Attention & FFN", font_size: 18, color: text.primary,
  text_max_width: 520, text_align: "left", anchor: scene.top_left, offset: (80, 74)
phase4: Text, text: "4 · LM Head un-embeds hidden state into vocabulary logits", font_size: 18, color: text.primary,
  text_max_width: 520, text_align: "left", anchor: scene.top_left, offset: (80, 74)
phase5: Text, text: "5 · Autoregressive feedback: predicted token appends to input sequence", font_size: 18, color: text.primary,
  text_max_width: 520, text_align: "left", anchor: scene.top_left, offset: (80, 74)

blueprint_badge: Stack, at: (1110, 48) {
  b_bg: Rect, size: (260, 36), corner_radius: 10, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  b_txt: Text, text: "Autoregressive Loop · GPT-2 Small", font_size: 13, color: text.secondary
}

// ── Level 1: Input Sequence Baseline (y = 592) ──────────────────────
in_row: Row, at: (560, 592), gap: 16, align: "center" {
  in1: LabeledBox, label: "The", width: 110, height: 54, text_size: 16, corner: 12
  in2: LabeledBox, label: "animal", width: 110, height: 54, text_size: 16, corner: 12
  in3: LabeledBox, label: "didn't", width: 110, height: 54, text_size: 16, corner: 12
  in4: LabeledBox, label: "cross", width: 110, height: 54, text_size: 16, corner: 12
  in5: LabeledBox, label: "the", width: 110, height: 54, text_size: 16, corner: 12
}

// The generated token "street" appended seamlessly next to "the"
street: LabeledBox, label: "street", width: 116, height: 54, text_size: 16, corner: 12,
  fill: surface.primary, stroke: accent.primary, stroke_width: 2.2, at: (938, 592)

// ── Connectors on Vertical Spine ────────────────────────────────────
up1: Arrow, from: (560, 556), to: (560, 542), head_size: 8, stroke_width: 2, stroke: text.muted, opacity: 0.0
up2: Arrow, from: (560, 491), to: (560, 473), head_size: 8, stroke_width: 2, stroke: text.muted, opacity: 0.0
up3: Arrow, from: (560, 190), to: (560, 154), head_size: 8, stroke_width: 2, stroke: text.muted, opacity: 0.0

// Smooth autoregressive feedback arc: from LM prediction back to input
loopback: Path, commands: {
  move_to(1060, 164), quad_to(1160, 380, 938, 556)
}, color: accent.primary, stroke: accent.primary, stroke_width: 2.5, opacity: 0.0, fill_opacity: 0.0

loop_arrow: Arrow, from: (944, 544), to: (938, 560), head_size: 12, stroke_width: 2.5,
  stroke: accent.primary, opacity: 0.0

// ── Level 2: Embedding + Position Plate (y = 516) ───────────────────
plate_stack: Stack, at: (560, 516) {
  plate: Rect, size: (680, 48), corner_radius: 12, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.4
  plate_t: Text, text: "Token Embeddings + Positional Encodings (768 Float32)", font_size: 15,
    color: text.primary
}
tag_e: Text, text: "01 · 02", font_size: 13, color: accent.primary, at: (938, 516)

// ── Level 3: Transformer Block × N (y = 330) ────────────────────────
blk: Rect, size: (720, 280), corner_radius: 18, color: surface.primary,
  stroke: stroke.default, stroke_width: 1.5, opacity: 0.0, at: (560, 330)
blk_title: Text, text: "Transformer Block × N (Depth = 12)", font_size: 17, color: text.primary, at: (560, 174)
tag_blk: Text, text: "06", font_size: 13, color: accent.primary, at: (760, 174)

rail: Rect, size: (660, 6), corner_radius: 3, color: stroke.default, opacity: 0.0, at: (560, 330)
rail_lab: Text, text: "residual stream", font_size: 12, color: text.muted, at: (280, 386)

// Skip connections inside the block
skip1: Path, commands: {
  move_to(270, 330), quad_to(430, 110, 590, 330)
}, color: accent.primary, stroke: accent.primary, stroke_width: 2, opacity: 0.0, fill_opacity: 0.0
skip2: Path, commands: {
  move_to(590, 330), quad_to(740, 110, 850, 330)
}, color: accent.success, stroke: accent.success, stroke_width: 2, opacity: 0.0, fill_opacity: 0.0

ln1_stack: Stack, at: (290, 330) {
  ln1: Ellipse, size: (58, 58), color: surface.primary, stroke: accent.warning, stroke_width: 2.2
  ln1_t: Text, text: "LN", font_size: 14, color: text.primary
}
ln2_stack: Stack, at: (590, 330) {
  ln2: Ellipse, size: (58, 58), color: surface.primary, stroke: accent.warning, stroke_width: 2.2
  ln2_t: Text, text: "LN", font_size: 14, color: text.primary
}

attn_stack: Stack, at: (440, 330) {
  attn: Rect, size: (180, 116), corner_radius: 14, color: surface.primary,
    stroke: accent.info, stroke_width: 1.8
  attn_content: Col, gap: 6, align: "center" {
    attn_t: Text, text: "Self-Attention", font_size: 16, color: text.primary
    attn_s: Text, text: "tokens communicate", font_size: 12, color: accent.info
  }
}
tag_attn: Text, text: "03 · 04", font_size: 13, color: accent.primary, at: (440, 250)

ffn_stack: Stack, at: (720, 330) {
  ffn: Rect, size: (180, 116), corner_radius: 14, color: surface.primary,
    stroke: accent.success, stroke_width: 1.8
  ffn_content: Col, gap: 6, align: "center" {
    ffn_t: Text, text: "Feed-Forward", font_size: 16, color: text.primary
    ffn_s: Text, text: "factual memory", font_size: 12, color: accent.success
  }
}
tag_ffn: Text, text: "05", font_size: 13, color: accent.primary, at: (720, 250)

// ── Level 4: LM Head & Probability Distribution (y = 128) ───────────
lmh_stack: Stack, at: (560, 128) {
  lmh: Rect, size: (420, 48), corner_radius: 12, color: surface.primary,
    stroke: accent.primary, stroke_width: 1.8
  lmh_t: Text, text: "LM Head: Linear + Softmax (50,257 Logits)", font_size: 15, color: text.primary
}

prob_cap: Text, text: "Next Token Probabilities", font_size: 13, color: text.muted, at: (1060, 80)

pw0: Text, text: "street", font_size: 13, color: accent.primary, at: (968, 104)
pw1: Text, text: "road", font_size: 13, color: text.secondary, at: (968, 130)
pw2: Text, text: "grass", font_size: 13, color: text.secondary, at: (968, 156)

pb0: Rect, size: (140, 16), corner_radius: 4, color: accent.primary, at: (1062, 104)
pb1: Rect, size: (76, 16), corner_radius: 4, color: text.secondary, opacity: 0.0, at: (1030, 130)
pb2: Rect, size: (20, 16), corner_radius: 4, color: text.secondary, opacity: 0.0, at: (1002, 156)

pv0: Text, text: "0.41", font_size: 13, color: accent.primary, at: (1160, 104)
pv1: Text, text: "0.22", font_size: 13, color: text.secondary, at: (1160, 130)
pv2: Text, text: "0.05", font_size: 13, color: text.secondary, at: (1160, 156)

// ── Timeline Choreography ───────────────────────────────────────────
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in phase1 [300ms, ease: expo-out]
fade-in blueprint_badge [320ms, ease: expo-out]
stagger [90ms] {
  fade-in in1 [340ms, ease: expo-out]
  fade-in in2 [340ms, ease: expo-out]
  fade-in in3 [340ms, ease: expo-out]
  fade-in in4 [340ms, ease: expo-out]
  fade-in in5 [340ms, ease: expo-out]
}

#1.25s
fade-out phase1 [240ms, ease: ease-in]
fade-in phase2 [280ms, delay: 240ms, ease: expo-out]
draw-in up1 [260ms, ease: expo-out]
up1.opacity = 0.65 [240ms]
wipe-in plate [400ms, ease: expo-out]
fade-in plate_t [300ms, delay: 180ms, ease: expo-out]
fade-in tag_e [280ms, delay: 320ms, ease: expo-out]

#2.25s
fade-out phase2 [240ms, ease: ease-in]
fade-in phase3 [280ms, delay: 240ms, ease: expo-out]
draw-in up2 [260ms, ease: expo-out]
up2.opacity = 0.65 [240ms]
wipe-in blk [460ms, ease: expo-out]
blk.opacity = 0.95 [420ms]
fade-in blk_title [320ms, delay: 200ms, ease: expo-out]
fade-in tag_blk [280ms, delay: 380ms, ease: expo-out]

// Block internals in execution order
#2.95s
draw-in rail [560ms, ease: expo-out]
rail.opacity = 0.50 [500ms]
fade-in rail_lab [320ms, delay: 360ms, ease: expo-out]
wipe-in ln1 [340ms, ease: expo-out]
fade-in ln1_t [220ms, delay: 160ms, ease: expo-out]

#3.35s
wipe-in attn [400ms, ease: expo-out]
fade-in attn_t [260ms, delay: 180ms, ease: expo-out]
fade-in attn_s [240ms, delay: 300ms, ease: expo-out]
fade-in tag_attn [260ms, delay: 280ms, ease: expo-out]

#3.90s
draw-in skip1 [480ms, ease: expo-out]
skip1.opacity = 0.65 [440ms]

#4.30s
wipe-in ln2 [340ms, ease: expo-out]
fade-in ln2_t [220ms, delay: 160ms, ease: expo-out]

#4.65s
wipe-in ffn [400ms, ease: expo-out]
fade-in ffn_t [260ms, delay: 180ms, ease: expo-out]
fade-in ffn_s [240ms, delay: 300ms, ease: expo-out]
fade-in tag_ffn [260ms, delay: 280ms, ease: expo-out]

#5.20s
draw-in skip2 [480ms, ease: expo-out]
skip2.opacity = 0.65 [440ms]

#5.65s
fade-out phase3 [240ms, ease: ease-in]
fade-in phase4 [280ms, delay: 240ms, ease: expo-out]
draw-in up3 [260ms, ease: expo-out]
up3.opacity = 0.65 [240ms]
wipe-in lmh [400ms, ease: expo-out]
fade-in lmh_t [300ms, delay: 180ms, ease: expo-out]

#6.25s
fade-in prob_cap [260ms, ease: expo-out]
stagger [110ms] {
  wipe-in pb0 [300ms, ease: expo-out]
  pb1.opacity = 0.45 [300ms]
  pb2.opacity = 0.45 [300ms]
}
stagger [110ms] {
  fade-in pw0 [240ms, ease: expo-out]
  fade-in pw1 [240ms, ease: expo-out]
  fade-in pw2 [240ms, ease: expo-out]
}
stagger [110ms] {
  fade-in pv0 [220ms, ease: expo-out]
  fade-in pv1 [220ms, ease: expo-out]
  fade-in pv2 [220ms, ease: expo-out]
}

// Autoregressive feedback loop: winning token "street" flows back
#7.00s
fade-out phase4 [240ms, ease: ease-in]
fade-in phase5 [280ms, delay: 240ms, ease: expo-out]
draw-in loopback [650ms, ease: expo-out]
loopback.opacity = 0.95 [600ms]
draw-in loop_arrow [300ms, delay: 500ms, ease: expo-out]
loop_arrow.opacity = 0.95 [260ms, delay: 500ms]
fade-in street [340ms, delay: 350ms, ease: expo-out]
pulse street [600ms, intensity: 0.05, delay: 700ms]

// ── Outro Rest Frame ────────────────────────────────────────────────
#8.40s
// Complete blueprint, block internals, and autoregressive loop stand held.
