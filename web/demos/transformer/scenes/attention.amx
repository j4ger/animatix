// 03 · Self-attention.
//
// Two accents, each with exactly one job: accent.warning is "the token doing
// the looking" (its ring, its tag, its own weight bar and number), and
// accent.primary is "how much attention" (every bar, arrow and value). The
// original spent five hues on decoration and put one colour-swapped bar in the
// middle, so the reader had to guess which colours meant something.
//
// A drawn arrow marks the reading direction, which plain lines did not. Bar
// height and the printed value encode the same number twice on purpose: the
// small weights are unreadable as bars alone, so the numbers are the honest
// fallback. The formula is written in ASCII: "ᵀ" (U+1D40) and "ₖ" (U+2096)
// have no glyph in the fast-path face and rendered as tofu.
//
// Grid: 1280×720. Chips 150×56 at pitch 180, centres x = 280 + 180i. Bars sit
// on one baseline at y = 560.

import "../../lib/theme.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.9 }

// ── phase narration (top-left; one label per beat) ──────────────────
phase1: Text, text: "1 · “it” looks back", font_size: 15, color: text.muted,
  text_max_width: 300, text_align: "left", at: (150, 96)
phase2: Text, text: "2 · score every token", font_size: 15, color: text.muted,
  text_max_width: 300, text_align: "left", at: (150, 96)
phase3: Text, text: "3 · softmax normalizes", font_size: 15, color: text.muted,
  text_max_width: 300, text_align: "left", at: (150, 96)

// ── the tokens — the shared LabeledBox component ────────────────────
tok1: LabeledBox, label: "The", width: 150, height: 56, text_size: 22, at: (280, 180)
tok2: LabeledBox, label: "animal", width: 150, height: 56, text_size: 22, at: (460, 180)
tok3: LabeledBox, label: "didn't", width: 150, height: 56, text_size: 22, at: (640, 180)
tok4: LabeledBox, label: "cross", width: 150, height: 56, text_size: 22, at: (820, 180)
tok5: LabeledBox, label: "it", width: 150, height: 56, text_size: 22, at: (1000, 180)

// Query ring: outer radius = chip radius + band, so the band is even all round.
halo: Rect, size: (172, 78), corner_radius: 25, color: accent.warning,
  fill_opacity: 0.0, stroke: accent.warning, stroke_width: 2.5, at: (1000, 180)
query_tag: Text, text: "query", font_size: 14, color: accent.warning, at: (1000, 122)

// ── which token "it" reads ──────────────────────────────────────────
// One arm, not a fan. A fan from one query to five keys has to traverse the row,
// and Line/Arrow/Path paint above Rect whatever the declaration order, so the
// arms to the far tokens drew straight across the 0.62 bar. Measured with a
// probe scene: with the arrow declared first and again declared last, it painted
// over the rect both times. The winning weight is the one arm worth drawing;
// the thin rule carries the direction of reading for the rest.
// Both accents are authored `opacity: 0.0` — an authored non-zero opacity is
// visible from frame 0 whatever entrance follows — and settle via assignment.
a_animal: Arrow, from: (965, 224), to: (460, 312), head_size: 16, stroke: accent.primary,
  stroke_width: 7, opacity: 0.0
scan: Arrow, from: (975, 272), to: (760, 272), head_size: 12, stroke: accent.primary,
  stroke_width: 2, opacity: 0.0
scan_label: Text, text: "attends to", font_size: 15, color: text.muted,
  text_max_width: 160, text_align: "left", at: (330, 326)

// ── weights: one baseline at y = 560; every bar bottom is center_y + h/2
// on that line. (A bottom-aligned Row was tried and reverted: align "end"
// plants children on the CONTAINER bottom edge — center plus half the
// tallest child — which is the same constant, one step removed.) ──────
// Authored zero, then lifted at its beat: a non-zero authored opacity would
// put this rule on an otherwise empty plate from frame 0 (draw-in only trims
// the stroke, it does not gate visibility).
base: Line, from: (205, 560), to: (1075, 560), stroke_width: 2, color: text.muted, opacity: 0.0

bar_the: Rect, size: (56, 19), corner_radius: 5, color: accent.primary, at: (280, 550)
bar_animal: Rect, size: (56, 240), corner_radius: 5, color: accent.primary, at: (460, 440)
bar_didnt: Rect, size: (56, 15), corner_radius: 5, color: accent.primary, at: (640, 552)
bar_cross: Rect, size: (56, 8), corner_radius: 5, color: accent.primary, at: (820, 556)
bar_self: Rect, size: (56, 104), corner_radius: 5, color: accent.warning, at: (1000, 508)

w_the: Text, text: "0.05", font_size: 15, color: text.secondary, at: (280, 592)
w_animal: Text, text: "0.62", font_size: 15, color: text.primary, at: (460, 592)
w_didnt: Text, text: "0.04", font_size: 15, color: text.secondary, at: (640, 592)
w_cross: Text, text: "0.02", font_size: 15, color: text.secondary, at: (820, 592)
w_self: Text, text: "0.27", font_size: 15, color: accent.warning, at: (1000, 592)

// ── annotation ──────────────────────────────────────────────────────
scale_label: Text, text: "weight", font_size: 15, color: text.muted,
  text_max_width: 120, text_align: "left", at: (265, 636)
formula: Text, text: "softmax(Q K^T / sqrt(d_k))", font_size: 16, color: text.muted, at: (700, 636)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
fade-in phase1 [300ms, ease: expo-out]
stagger [100ms] {
  fade-in tok1 [360ms, ease: expo-out]
  fade-in tok2 [360ms, ease: expo-out]
  fade-in tok3 [360ms, ease: expo-out]
  fade-in tok4 [360ms, ease: expo-out]
  fade-in tok5 [360ms, ease: expo-out]
}

#1.00s
fade-in halo [420ms, ease: expo-out]
fade-in query_tag [320ms, delay: 220ms, ease: expo-out]

#1.40s
base.opacity = 0.35 [420ms]
draw-in base [420ms, ease: expo-out]

#1.70s
fade-out phase1 [260ms, ease: ease-in]
fade-in phase2 [280ms, delay: 260ms, ease: expo-out]
stagger [90ms] {
  fade-in bar_the [380ms, ease: expo-out]
  fade-in bar_animal [380ms, ease: expo-out]
  fade-in bar_didnt [380ms, ease: expo-out]
  fade-in bar_cross [380ms, ease: expo-out]
  fade-in bar_self [380ms, ease: expo-out]
}

#2.45s
fade-out phase2 [260ms, ease: ease-in]
fade-in phase3 [280ms, delay: 260ms, ease: expo-out]
stagger [70ms] {
  fade-in w_the [240ms, ease: expo-out]
  fade-in w_animal [240ms, ease: expo-out]
  fade-in w_didnt [240ms, ease: expo-out]
  fade-in w_cross [240ms, ease: expo-out]
  fade-in w_self [240ms, ease: expo-out]
}

// The direction of reading first, then the one weight that matters.
#3.05s
draw-in scan [520ms, ease: expo-out]
scan.opacity = 0.55 [420ms]
fade-in scan_label [320ms, delay: 260ms, ease: expo-out]

#3.55s
draw-in a_animal [700ms, ease: expo-out]
a_animal.opacity = 0.95 [560ms]

#4.40s
fade-in scale_label [380ms, ease: expo-out]
fade-in formula [380ms, delay: 140ms, ease: expo-out]

#5.00s
pulse bar_animal [700ms, intensity: 0.04]
pulse w_animal [700ms, intensity: 0.04]

// Outro: quiet the plate before the wrap (reverse order).
#6.75s
// The loop's rest frame is this composition, not an empty plate: the embed
// holds the finished frame for `hold` seconds and dissolves it into the next
// cycle itself, so erasing the figure here would only blank the screen during
// the rest. The outro therefore clears the narration line and leaves the
// diagram standing.
fade-out phase3 [260ms, ease: ease-in]
