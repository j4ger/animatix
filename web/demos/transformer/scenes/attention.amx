// 03 · Scaled dot-product self-attention with explicit Q, K, V mechanism.
//
// Explains the fundamental question: Why and how does the model resolve "it" to "animal"?
//
// Pipeline:
//   1. Query emitted: Token "it" casts Query vector Q_it probing all prior tokens.
//   2. Key matching: Each token projects its Key vector K_i; dot-product Q · Kᵀ measures affinity.
//   3. Softmax weights: Raw scores scale by 1/√d_k and normalize into probability weights (Σ = 1.0).
//   4. Value aggregation: Values V_i are weighted by attention weights to synthesize the output z_it.
//      The resulting vector for "it" now carries the rich semantic features of "animal".

import "../../lib/theme.amx"
import "../../lib/ambience.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.4 }

bg: Ambience, tint: accent.primary, base_opacity: 0.14, seed: 30

// ── header / narration (top-left) ───────────────────────────────────
head_eyebrow: Text, text: "FIG 03 // SCALED DOT-PRODUCT ATTENTION", font_size: 13,
  color: accent.primary, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 48)

phase1: Text, text: "1 · “it” projects Query probing prior Keys", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase2: Text, text: "2 · Affinities scored: Q * K^T / sqrt(d_k)", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase3: Text, text: "3 · Softmax normalizes into probability weights", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase4: Text, text: "4 · Values weighted & pooled: “it” absorbs “animal”", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)

formula_chip: Stack, at: (1080, 68) {
  f_bg: Rect, size: (260, 40), corner_radius: 10, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  f_txt: Text, text: "Attention(Q, K, V) = softmax(QK^T / sqrt(d_k))V", font_size: 13, color: text.secondary
}

// ── Level 1: Input Tokens (y = 150) ─────────────────────────────────
tok_row: Row, at: (640, 150), gap: 24, align: "center" {
  tok1: LabeledBox, label: "The", width: 140, height: 50, text_size: 20
  tok2: LabeledBox, label: "animal", width: 140, height: 50, text_size: 20
  tok3: LabeledBox, label: "didn't", width: 140, height: 50, text_size: 20
  tok4: LabeledBox, label: "cross", width: 140, height: 50, text_size: 20
  tok5: LabeledBox, label: "it", width: 140, height: 50, text_size: 20,
    fill: surface.primary, stroke: accent.warning, stroke_width: 2.2
}

q_badge: Text, text: "QUERY TOKEN", font_size: 11, color: accent.warning, at: (968, 110)

// ── Level 2: Key & Query Vectors (y = 222) ──────────────────────────
k_label: Text, text: "Key vectors (K):", font_size: 13, color: text.muted,
  text_align: "right", at: (190, 222)

k_row: Row, at: (640, 222), gap: 24, align: "center" {
  k1: LabeledBox, label: "K1 (det)", width: 140, height: 36, text_size: 14,
    fill: surface.secondary, text_color: accent.info, corner: 8, stroke: stroke.default
  k2: LabeledBox, label: "K2 (noun: subject)", width: 140, height: 36, text_size: 14,
    fill: surface.secondary, text_color: accent.info, corner: 8, stroke: stroke.default
  k3: LabeledBox, label: "K3 (negation)", width: 140, height: 36, text_size: 14,
    fill: surface.secondary, text_color: accent.info, corner: 8, stroke: stroke.default
  k4: LabeledBox, label: "K4 (verb)", width: 140, height: 36, text_size: 14,
    fill: surface.secondary, text_color: accent.info, corner: 8, stroke: stroke.default
  k5: LabeledBox, label: "K5 (pronoun)", width: 140, height: 36, text_size: 14,
    fill: surface.secondary, text_color: accent.warning, corner: 8, stroke: accent.warning
}

// ── Level 3: Attention Weight Bars (y = 390 baseline) ───────────────
score_guide: Text, text: "Attention weights: softmax(Q5 * K^T / sqrt(d_k)):", font_size: 13,
  color: text.muted, text_align: "left", at: (180, 290)

base_rule: Line, from: (240, 440), to: (1040, 440), stroke_width: 1.5,
  color: stroke.default, opacity: 0.0

bars_row: Row, at: (640, 360), size: (800, 160), gap: 110, align: "end" {
  b1: Rect, size: (54, 18), corner_radius: 5, color: accent.primary, opacity: 0.0
  b2: Rect, size: (54, 150), corner_radius: 5, color: accent.primary, opacity: 0.0
  b3: Rect, size: (54, 14), corner_radius: 5, color: accent.primary, opacity: 0.0
  b4: Rect, size: (54, 10), corner_radius: 5, color: accent.primary, opacity: 0.0
  b5: Rect, size: (54, 76), corner_radius: 5, color: accent.warning, opacity: 0.0
}

// Winning highlight beacon on "animal"
winner_ring: Rect, size: (72, 168), corner_radius: 10, color: accent.primary,
  fill_opacity: 0.0, stroke: accent.primary, stroke_width: 2.2, at: (475, 365)
winner_tag: Text, text: "WINNER 62%", font_size: 12, color: accent.primary, at: (475, 268)

// Dynamic spotlight connector from Q5 down to K2 & bar2
beam_q_k: Arrow, from: (968, 244), to: (475, 282), head_size: 14,
  stroke: accent.primary, stroke_width: 4.5, opacity: 0.0

weights_row: Row, at: (640, 466), gap: 24, align: "center" {
  w1_box: Stack, size: (140, 24) { w1: Text, text: "0.05", font_size: 15, color: text.secondary }
  w2_box: Stack, size: (140, 24) { w2: Text, text: "0.62", font_size: 16, color: accent.primary }
  w3_box: Stack, size: (140, 24) { w3: Text, text: "0.04", font_size: 15, color: text.secondary }
  w4_box: Stack, size: (140, 24) { w4: Text, text: "0.02", font_size: 15, color: text.secondary }
  w5_box: Stack, size: (140, 24) { w5: Text, text: "0.27", font_size: 15, color: accent.warning }
}

// ── Level 4: Value Gathering & Output Representation (y = 570 - 640) ─
v_stream_line: Arrow, from: (475, 484), to: (640, 560), head_size: 12,
  stroke: accent.primary, stroke_width: 3.0, opacity: 0.0
v5_stream_line: Arrow, from: (968, 484), to: (690, 560), head_size: 10,
  stroke: accent.warning, stroke_width: 2.0, opacity: 0.0

out_card: Stack, at: (640, 608) {
  out_bg: Rect, size: (720, 64), corner_radius: 14, color: surface.primary,
    stroke: accent.primary, stroke_width: 1.8
  out_col: Col, gap: 4, align: "center" {
    out_t1: Text, text: "Output Context Vector z_it = 0.62·V(animal) + 0.27·V(it) + ...",
      font_size: 16, color: text.primary
    out_t2: Text, text: "Antecedent resolved: pronoun “it” now embeds entity “animal”",
      font_size: 13, color: accent.primary
  }
}

// ── Timeline Choreography ───────────────────────────────────────────
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in phase1 [300ms, ease: expo-out]
fade-in formula_chip [340ms, ease: expo-out]
stagger [80ms] {
  fade-in tok1 [320ms, ease: expo-out]
  fade-in tok2 [320ms, ease: expo-out]
  fade-in tok3 [320ms, ease: expo-out]
  fade-in tok4 [320ms, ease: expo-out]
  fade-in tok5 [320ms, ease: expo-out]
}
fade-in q_badge [300ms, delay: 240ms, ease: expo-out]

#1.20s
fade-in k_label [280ms, ease: expo-out]
stagger [70ms] {
  fade-in k1 [300ms, ease: expo-out]
  fade-in k2 [300ms, ease: expo-out]
  fade-in k3 [300ms, ease: expo-out]
  fade-in k4 [300ms, ease: expo-out]
  fade-in k5 [300ms, ease: expo-out]
}

#2.10s
fade-out phase1 [240ms, ease: ease-in]
fade-in phase2 [280ms, delay: 240ms, ease: expo-out]
fade-in score_guide [300ms, ease: expo-out]
draw-in base_rule [400ms, ease: expo-out]
base_rule.opacity = 0.45 [360ms]
draw-in beam_q_k [540ms, ease: expo-out]
beam_q_k.opacity = 0.95 [480ms]

#3.10s
fade-out phase2 [240ms, ease: ease-in]
fade-in phase3 [280ms, delay: 240ms, ease: expo-out]
stagger [90ms] {
  b1.opacity = 0.45 [320ms]
  b2.opacity = 1.00 [360ms]
  b3.opacity = 0.45 [320ms]
  b4.opacity = 0.45 [320ms]
  b5.opacity = 0.85 [320ms]
}
stagger [70ms] {
  fade-in w1 [260ms, ease: expo-out]
  fade-in w2 [280ms, ease: expo-out]
  fade-in w3 [260ms, ease: expo-out]
  fade-in w4 [260ms, ease: expo-out]
  fade-in w5 [260ms, ease: expo-out]
}
fade-in winner_ring [360ms, delay: 200ms, ease: expo-out]
fade-in winner_tag [300ms, delay: 300ms, ease: expo-out]
pulse b2 [600ms, intensity: 0.05, delay: 350ms]

#4.60s
fade-out phase3 [240ms, ease: ease-in]
fade-in phase4 [280ms, delay: 240ms, ease: expo-out]
draw-in v_stream_line [500ms, ease: expo-out]
v_stream_line.opacity = 0.95 [450ms]
draw-in v5_stream_line [450ms, ease: expo-out, delay: 100ms]
v5_stream_line.opacity = 0.70 [400ms, delay: 100ms]

#5.40s
wipe-in out_card [460ms, ease: expo-out]
fade-in out_t1 [300ms, delay: 160ms, ease: expo-out]
fade-in out_t2 [300ms, delay: 280ms, ease: expo-out]
pulse out_card [650ms, intensity: 0.03, delay: 400ms]

// ── Outro Rest Frame ────────────────────────────────────────────────
// Holds the complete explanatory diagram with all indicators and context intact.
#7.80s
// Rest composition remains complete and stable for web holding loop.
