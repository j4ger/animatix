// 03 · Self-attention.
//
// Two accents, each with exactly one job: accent.warning is "the token doing
// the looking" (its ring, its tag, its own weight bar and number), and
// accent.primary is "how much attention" (every bar, arrow and value). The
// original spent five hues on decoration and put one colour-swapped bar in the
// middle, so the reader had to guess which colours meant something.
//
// A drawn arrow marks the reading direction, which plain lines did not. Bar
// height and the printed value encode the same number twice on purpose: the
// small weights are unreadable as bars alone, so the numbers are the honest
// fallback. The formula is written in ASCII: "ᵀ" (U+1D40) and "ₖ" (U+2096)
// have no glyph in the fast-path face and rendered as tofu.
//
// Grid: 1280×720. Chips 150×56 at pitch 180, centres x = 280 + 180i. Bars sit
// on one baseline at y = 560.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7.2 }

// ── the tokens ──────────────────────────────────────────────────────
tok1: Rect, size: (150, 56), corner_radius: 14, color: surface.primary, at: (280, 180)
tok1_t: Text, text: "The", font_size: 22, color: text.primary, at: (280, 180)
tok2: Rect, size: (150, 56), corner_radius: 14, color: surface.primary, at: (460, 180)
tok2_t: Text, text: "animal", font_size: 22, color: text.primary, at: (460, 180)
tok3: Rect, size: (150, 56), corner_radius: 14, color: surface.primary, at: (640, 180)
tok3_t: Text, text: "didn't", font_size: 22, color: text.primary, at: (640, 180)
tok4: Rect, size: (150, 56), corner_radius: 14, color: surface.primary, at: (820, 180)
tok4_t: Text, text: "cross", font_size: 22, color: text.primary, at: (820, 180)
tok5: Rect, size: (150, 56), corner_radius: 14, color: surface.primary, at: (1000, 180)
tok5_t: Text, text: "it", font_size: 22, color: text.primary, at: (1000, 180)

// Query ring: outer radius = chip radius + band, so the band is even all round.
halo: Rect, size: (172, 78), corner_radius: 25, color: accent.warning,
  fill_opacity: 0.0, stroke: accent.warning, stroke_width: 2.5, at: (1000, 180)
query_tag: Text, text: "query", font_size: 14, color: accent.warning, at: (1000, 122)

// ── which token "it" reads ──────────────────────────────────────────
// One arm, not a fan. A fan from one query to five keys has to traverse the row,
// and Line/Arrow/Path paint above Rect whatever the declaration order, so the
// arms to the far tokens drew straight across the 0.62 bar. Measured with a
// probe scene: with the arrow declared first and again declared last, it painted
// over the rect both times. The winning weight is the one arm worth drawing;
// the thin rule carries the direction of reading for the rest.
a_animal: Arrow, from: (965, 224), to: (460, 312), head_size: 16,
  stroke_width: 7, color: accent.primary, opacity: 0.95
scan: Arrow, from: (975, 296), to: (250, 296), head_size: 12,
  stroke_width: 2, color: accent.primary, opacity: 0.55
scan_label: Text, text: "attends to", font_size: 15, color: text.muted,
  text_max_width: 160, text_align: "left", at: (330, 326)

// ── weights: one baseline, bars grow from it ────────────────────────
base: Line, from: (205, 560), to: (1075, 560), stroke_width: 2, color: text.muted, opacity: 0.35

bar_the: Rect, size: (56, 19), corner_radius: 5, color: accent.primary, at: (280, 550)
bar_animal: Rect, size: (56, 240), corner_radius: 5, color: accent.primary, at: (460, 440)
bar_didnt: Rect, size: (56, 15), corner_radius: 5, color: accent.primary, at: (640, 552)
bar_cross: Rect, size: (56, 8), corner_radius: 5, color: accent.primary, at: (820, 556)
bar_self: Rect, size: (56, 104), corner_radius: 5, color: accent.warning, at: (1000, 508)

w_the: Text, text: "0.05", font_size: 15, color: text.secondary, at: (280, 592)
w_animal: Text, text: "0.62", font_size: 15, color: text.primary, at: (460, 592)
w_didnt: Text, text: "0.04", font_size: 15, color: text.secondary, at: (640, 592)
w_cross: Text, text: "0.02", font_size: 15, color: text.secondary, at: (820, 592)
w_self: Text, text: "0.27", font_size: 15, color: accent.warning, at: (1000, 592)

// ── annotation ──────────────────────────────────────────────────────
scale_label: Text, text: "weight", font_size: 15, color: text.muted,
  text_max_width: 120, text_align: "left", at: (265, 636)
formula: Text, text: "softmax(Q K^T / sqrt(d_k))", font_size: 16, color: text.muted, at: (700, 636)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
stagger [100ms] {
  wipe-in tok1 [360ms]
  wipe-in tok2 [360ms]
  wipe-in tok3 [360ms]
  wipe-in tok4 [360ms]
  wipe-in tok5 [360ms]
}

#0.65s
stagger [100ms] {
  fade-in tok1_t [280ms]
  fade-in tok2_t [280ms]
  fade-in tok3_t [280ms]
  fade-in tok4_t [280ms]
  fade-in tok5_t [280ms]
}

#1.00s
fade-in halo [420ms, ease: ease-out]
fade-in query_tag [320ms, delay: 220ms]

#1.40s
draw-in base [420ms, ease: ease-out]

#1.70s
stagger [90ms] {
  wipe-in bar_the [380ms]
  wipe-in bar_animal [380ms]
  wipe-in bar_didnt [380ms]
  wipe-in bar_cross [380ms]
  wipe-in bar_self [380ms]
}

#2.45s
stagger [70ms] {
  fade-in w_the [240ms]
  fade-in w_animal [240ms]
  fade-in w_didnt [240ms]
  fade-in w_cross [240ms]
  fade-in w_self [240ms]
}

// The direction of reading first, then the one weight that matters.
#3.05s
draw-in scan [520ms, ease: ease-out]
fade-in scan_label [320ms, delay: 260ms]

#3.55s
draw-in a_animal [700ms, ease: ease-out]

#4.40s
fade-in scale_label [380ms]
fade-in formula [380ms, delay: 140ms]

#5.00s
pulse bar_animal [700ms, intensity: 1.08]
