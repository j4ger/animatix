// house-style: residual-highway hook, dual-sublayer mechanism, delta injection payoff.
// 05 · Feed-forward network & residual highway.
//
// The residual stream is the central spine of the transformer block. Three acts:
//   I.   An unbroken highway draws across the whole stage: identity signal survives deep layers.
//   II.  Attention and the 4× expansion feed-forward branch off it; each sublayer computes an additive delta.
//   III. The deltas sum back into the stream, the camera pushes in on the residual principle before settling.
//
// House-style §1: StageFloor + compact head + caption are opaque at t=0.
// House-style §5: title 48, node titles 20, sublabels 16, formula 22, captions 24.

import "../../lib/theme.amx"
import "../../lib/stage.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.2 }

let expansion = 4
let exp_span = (0, expansion)

// ── the stage ───────────────────────────────────────────────────────
floor: StageFloor, glow: 1.3

head_eyebrow: Text, text: "FIG 05 · FEED-FORWARD NETWORK & RESIDUAL HIGHWAY", font_size: 18,
  font_weight: 600, color: accent.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 44), opacity: 0
head_title: Text, text: "The signal keeps its way", font_size: 48, font_weight: "bold",
  color: text.primary, text_align: "left", text_anchor: "left",
  anchor: scene.top_left, offset: (96, 96), opacity: 1
head_rule: Rect, size: (96, 4), color: accent.primary,
  anchor: scene.top_left, offset: (96, 150), opacity: 1

cap1: Caption, text: "The residual highway preserves signal through depth.",
  tag: "feedforward.amx", opacity: 1
cap2: Caption, text: format("FFN expands ×{:.0} to 3072 features to recall facts.", expansion),
  tag: "feedforward.amx", opacity: 0
cap3: Caption, text: "Sublayers add only deltas (x + Δ) into the highway.",
  tag: "feedforward.amx", opacity: 0

exp_chip: Readout, label: "EXPANSION", value: format("×{:.0}", expansion), at: (795, 210)
dim_chip: Readout, label: "D_MODEL", value: "768", at: (1055, 210)

// ── Act I: the residual highway ─────────────────────────────────────
rail: Rect, size: (1120, 8), corner_radius: 4, color: stroke.default, opacity: 0, at: (640, 400)

// ── Act II: attention card, then the FFN card ───────────────────────
attn_box: Rect, size: (300, 200), corner_radius: 18, color: surface.primary,
  stroke: accent.info, stroke_width: 1.8, opacity: 0, at: (370, 400)
attn_t: Text, text: "Self-Attention", font_size: 20, color: text.primary,
  text_anchor: "center", at: (370, 360), opacity: 0
attn_sub: Text, text: "context routing · between tokens", font_size: 16, color: accent.info,
  text_anchor: "center", at: (370, 390), opacity: 0
attn_beams: Row, at: (370, 428), gap: 12, align: "center" {
  ab1: Rect, size: (48, 14), corner_radius: 4, color: accent.info, opacity: 0
  ab2: Rect, size: (84, 14), corner_radius: 4, color: accent.info, opacity: 0
  ab3: Rect, size: (48, 14), corner_radius: 4, color: accent.info, opacity: 0
}
attn_desc: Text, text: "dynamic query–key interaction", font_size: 16, color: text.muted,
  text_anchor: "center", at: (370, 462), opacity: 0

ln1: Ellipse, size: (72, 72), color: surface.primary, stroke: accent.warning, stroke_width: 2.5, at: (170, 400)
ln1_t: Text, text: "LN", font_size: 18, color: text.primary, text_anchor: "center", at: (170, 400), opacity: 0

// Skip connections bypass each sublayer.
skip1: Path, commands: {
  move_to(170, 400), quad_to(370, 180, 570, 400)
}, color: accent.primary, stroke: accent.primary, stroke_width: 2.2, opacity: 0, fill_opacity: 0

// ── Act III: feed-forward expansion card ────────────────────────────
ln2: Ellipse, size: (72, 72), color: surface.primary, stroke: accent.warning, stroke_width: 2.5, at: (670, 400)
ln2_t: Text, text: "LN", font_size: 18, color: text.primary, text_anchor: "center", at: (670, 400), opacity: 0

skip2: Path, commands: {
  move_to(670, 400), quad_to(895, 180, 1120, 400)
}, color: accent.success, stroke: accent.success, stroke_width: 2.2, opacity: 0, fill_opacity: 0

// Traveling energy particle representing continuous residual flow.
dot: Ellipse, size: (18, 18), color: accent.primary, opacity: 0, at: (100, 400)

summary_card: Stack, at: (640, 620), size: (760, 56), opacity: 0 {
  sum_bg: Rect, size: (760, 56), corner_radius: 12, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.4
}

// ── Timeline Choreography ───────────────────────────────────────────
// Act I — the highway draws; the live dot reports the last delta.
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
formula_chip: Stack, at: (960, 78), size: (440, 50), opacity: 0 {
  f_bg: Rect, size: (440, 50), corner_radius: 12, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  f_txt: Text, text: "FFN(x) = GELU(xW₁ + b₁)W₂ + b₂", font_size: 22, color: text.secondary
}
fade-in formula_chip [320ms, ease: expo-out]
draw-in rail [600ms, ease: expo-out]
rail.opacity = 0.60 [520ms]

#0.70s
rail_label: Text, text: "Residual Stream Highway (768 Float32)", font_size: 18, color: text.muted,
  text_align: "left", text_anchor: "left", at: (96, 530), opacity: 0
fade-in rail_label [360ms, ease: expo-out]

// Act II — attention lands on the highway, then the FFN widens it.
#1.00s
wipe-in ln1 [360ms, ease: expo-out]
fade-in ln1_t [240ms, delay: 140ms, ease: expo-out]
attn_box.opacity = 0.90 [420ms]
fade-in attn_t [280ms, delay: 120ms, ease: expo-out]
fade-in attn_sub [260ms, delay: 220ms, ease: expo-out]
fade-in attn_desc [260ms, delay: 300ms, ease: expo-out]
stagger [80ms] {
  ab1.opacity = 0.70 [280ms]
  ab2.opacity = 1.00 [280ms]
  ab3.opacity = 0.70 [280ms]
}

#1.90s
draw-in skip1 [520ms, ease: expo-out]
skip1.opacity = 0.85 [460ms]
plus1: Text, text: "+", font_size: 26, color: accent.primary, text_anchor: "center", at: (570, 360), opacity: 0
fade-in plus1 [280ms, delay: 200ms, ease: expo-out]

#2.60s
fade-out cap1 [240ms, ease: ease-in]
fade-in cap2 [280ms, delay: 200ms, ease: expo-out]
wipe-in ln2 [360ms, ease: expo-out]
fade-in ln2_t [240ms, delay: 140ms, ease: expo-out]
ffn_box: Rect, size: (350, 200), corner_radius: 18, color: surface.primary,
  stroke: accent.success, stroke_width: 1.8, opacity: 0.90, at: (895, 400)
ffn_t: Text, text: "Feed-Forward (MLP)", font_size: 20, color: text.primary,
  text_anchor: "center", at: (895, 330), opacity: 0
ffn_sub: Text, text: "associative factual memory · token alone", font_size: 16, color: accent.success,
  text_anchor: "center", at: (895, 360), opacity: 0
ffn_flow: Row, at: (895, 400), gap: 10, align: "center" {
  f_in: Rect, size: (36, 16), corner_radius: 4, color: accent.success, opacity: 0
  f_arr1: Text, text: "→", font_size: 18, color: text.muted
  for e in exp_span {
    f_wide[e]: Rect, size: (22, 22), corner_radius: 5, color: accent.success, opacity: 0
  }
  f_arr2: Text, text: "→", font_size: 18, color: text.muted
  f_out: Rect, size: (36, 16), corner_radius: 4, color: accent.success, opacity: 0
}
ffn_dims: Text, text: format("768 → {:.0} (GELU) → 768", 768 * expansion), font_size: 16,
  color: text.primary, text_anchor: "center", at: (895, 440), opacity: 0
ffn_desc: Text, text: "stores factual knowledge in weights", font_size: 16, color: text.muted,
  text_anchor: "center", at: (895, 468), opacity: 0
fade-in ffn_t [280ms, delay: 160ms, ease: expo-out]
fade-in ffn_sub [260ms, delay: 240ms, ease: expo-out]
fade-in ffn_dims [280ms, delay: 320ms, ease: expo-out]
fade-in ffn_desc [260ms, delay: 360ms, ease: expo-out]
fade-in f_arr1 [240ms, delay: 300ms, ease: expo-out]
fade-in f_arr2 [240ms, delay: 300ms, ease: expo-out]
for e in exp_span [step: 55ms] {
  f_wide[e].opacity = 1.00 [300ms]
}
stagger [80ms] {
  f_in.opacity = 0.70 [280ms]
  f_out.opacity = 0.70 [280ms]
}

// Act III — the second skip, then the deltas reconcile into the summary.
#4.10s
fade-out cap2 [240ms, ease: ease-in]
fade-in cap3 [280ms, delay: 200ms, ease: expo-out]
draw-in skip2 [520ms, ease: expo-out]
skip2.opacity = 0.85 [460ms]
plus2: Text, text: "+", font_size: 26, color: accent.success, text_anchor: "center", at: (1120, 360), opacity: 0
fade-in plus2 [280ms, delay: 150ms, ease: expo-out]

#4.80s
fade-in dot [220ms, ease: expo-out]
shift dot [by: (1080, 0), 1600ms, ease: ease-in-out]
fade-out dot [260ms, delay: 1480ms, ease: ease-in]
fade-in summary_card [380ms, delay: 500ms, ease: expo-out]

#5.10s
sum_t: Text, text: "Residual principle: sublayers compute only additive deltas (x + Δ); the highway preserves signal depth.",
  font_size: 18, color: text.secondary, text_anchor: "center", at: (640, 620), opacity: 0
fade-in sum_t [300ms, delay: 300ms, ease: expo-out]

// Payoff: push toward the FFN expansion, then settle on the whole highway.
#6.10s
camera.zoom = 1.04 [1.0s, ease: ease-in-out]

#7.10s
camera.zoom = 1.0 [1.0s, ease: ease-in-out]

// ── Rest ────────────────────────────────────────────────────────────
#8.10s
// Highway, both sublayers, both skip arcs, plus marks and the summary card all
// stand. The dot has delivered its delta; nothing erases.
