// 05 · Feed-forward network & residual highway.
//
// Explains:
//   1. Residual Stream: Identity highway carrying token embeddings unbroken across layers.
//   2. Sublayer 1 (Attention): Contextual mixing between tokens.
//   3. Sublayer 2 (FFN): Token-wise non-linear expansion (768 → 3072 → 768), acting as
//      an associative key-value memory store for factual knowledge.
//   4. Add & Norm: Each sublayer computes an update delta added back into the highway:
//      x_next = x + Sublayer(LN(x))

import "../../lib/theme.amx"
import "../../lib/ambience.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 8.2 }

bg: Ambience, tint: accent.success, base_opacity: 0.14, seed: 50

// ── Header / Narration (top-left) ───────────────────────────────────
head_eyebrow: Text, text: "FIG 05 // FEED-FORWARD NETWORK & RESIDUAL HIGHWAY", font_size: 13,
  color: accent.success, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 48)

phase1: Text, text: "1 · Unbroken residual highway preserves identity signal throughout the depth", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase2: Text, text: "2 · Sublayer 1 mixes context; Sublayer 2 (FFN) expands 4× for factual memory recall", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)
phase3: Text, text: "3 · Add & Norm: Non-linear updates add back as deltas: x + Sublayer(LN(x))", font_size: 18, color: text.primary,
  text_max_width: 500, text_align: "left", text_anchor: "left", anchor: scene.top_left, offset: (80, 74)

formula_chip: Stack, at: (1080, 68) {
  f_bg: Rect, size: (260, 40), corner_radius: 10, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.2
  f_txt: Text, text: "FFN(x) = GELU(x W1 + b1) W2 + b2", font_size: 13, color: text.secondary
}

// ── The Residual Stream Highway (y = 400) ───────────────────────────
rail: Rect, size: (1120, 8), corner_radius: 4, color: stroke.default, opacity: 0.0, at: (640, 400)
rail_label: Text, text: "Residual Stream Highway (768 Float32)", font_size: 14, color: text.muted,
  text_align: "left", at: (180, 440)

// Skip connections (Arcs bypassing each sublayer)
skip1: Path, commands: {
  move_to(170, 400), quad_to(370, 60, 570, 400)
}, color: accent.primary, stroke: accent.primary, stroke_width: 2.2, opacity: 0.0, fill_opacity: 0.0

skip2: Path, commands: {
  move_to(670, 400), quad_to(895, 60, 1120, 400)
}, color: accent.success, stroke: accent.success, stroke_width: 2.2, opacity: 0.0, fill_opacity: 0.0

// LayerNorm Pre-LN Rings
ln1_stack: Stack, at: (170, 400) {
  ln1: Ellipse, size: (72, 72), color: surface.primary, stroke: accent.warning, stroke_width: 2.5
  ln1_t: Text, text: "LN", font_size: 16, color: text.primary
}

ln2_stack: Stack, at: (670, 400) {
  ln2: Ellipse, size: (72, 72), color: surface.primary, stroke: accent.warning, stroke_width: 2.5
  ln2_t: Text, text: "LN", font_size: 16, color: text.primary
}

// ── Sublayer 1: Multi-Head Attention (x = 370, y = 400) ─────────────
attn_stack: Stack, at: (370, 400) {
  attn_box: Rect, size: (300, 200), corner_radius: 18, color: surface.primary,
    stroke: accent.info, stroke_width: 1.8, opacity: 0.0
  attn_content: Col, gap: 10, align: "center" {
    attn_t: Text, text: "Self-Attention", font_size: 20, color: text.primary
    attn_sub: Text, text: "Context Routing (Between Tokens)", font_size: 12, color: accent.info
    attn_beams: Row, gap: 12, align: "center" {
      ab1: Rect, size: (48, 14), corner_radius: 4, color: accent.info, opacity: 0.0
      ab2: Rect, size: (84, 14), corner_radius: 4, color: accent.info, opacity: 0.0
      ab3: Rect, size: (48, 14), corner_radius: 4, color: accent.info, opacity: 0.0
    }
    attn_desc: Text, text: "Dynamic query-key interaction", font_size: 12, color: text.muted
  }
}

// ── Sublayer 2: Feed-Forward Network (x = 895, y = 400) ─────────────
ffn_stack: Stack, at: (895, 400) {
  ffn_box: Rect, size: (350, 200), corner_radius: 18, color: surface.primary,
    stroke: accent.success, stroke_width: 1.8, opacity: 0.0
  ffn_content: Col, gap: 8, align: "center" {
    ffn_t: Text, text: "Feed-Forward (MLP)", font_size: 20, color: text.primary
    ffn_sub: Text, text: "Associative Factual Memory (Token Alone)", font_size: 12, color: accent.success
    // 4× Expansion Graphic: 768 → 3072 → 768
    ffn_flow: Row, gap: 14, align: "center" {
      f_in: Rect, size: (36, 16), corner_radius: 4, color: accent.success, opacity: 0.0
      f_arr1: Text, text: "->", font_size: 14, color: text.muted
      f_wide: Rect, size: (120, 22), corner_radius: 6, color: accent.success, opacity: 0.0
      f_arr2: Text, text: "->", font_size: 14, color: text.muted
      f_out: Rect, size: (36, 16), corner_radius: 4, color: accent.success, opacity: 0.0
    }
    ffn_dims: Text, text: "768-dim -> 3072-dim (GELU) -> 768-dim", font_size: 13, color: text.primary
    ffn_desc: Text, text: "Stores factual knowledge in weights", font_size: 12, color: text.muted
  }
}

// ── Rejoin points: Addition "+" Symbols ─────────────────────────────
plus1: Text, text: "+", font_size: 26, color: accent.primary, opacity: 0.0, at: (570, 360)
plus2: Text, text: "+", font_size: 26, color: accent.success, opacity: 0.0, at: (1120, 360)

// Traveling energy particle representing continuous residual flow
dot: Ellipse, size: (18, 18), color: accent.primary, opacity: 0.0, at: (100, 400)

// ── Summary Card on Bottom ──────────────────────────────────────────
summary_card: Stack, at: (640, 620) {
  sum_bg: Rect, size: (740, 52), corner_radius: 12, color: surface.primary,
    stroke: stroke.default, stroke_width: 1.4
  sum_t: Text, text: "Residual Principle: Sublayers only compute deltas; the stream preserves signal depth",
    font_size: 14, color: text.secondary
}

// ── Timeline Choreography ───────────────────────────────────────────
#0.10s
fade-in head_eyebrow [260ms, ease: expo-out]
fade-in phase1 [300ms, ease: expo-out]
fade-in formula_chip [320ms, ease: expo-out]
draw-in rail [700ms, ease: expo-out]
rail.opacity = 0.60 [600ms]
fade-in rail_label [360ms, delay: 300ms, ease: expo-out]

#1.00s
wipe-in ln1 [360ms, ease: expo-out]
fade-in ln1_t [260ms, delay: 140ms, ease: expo-out]
attn_box.opacity = 0.90 [420ms]
fade-in attn_t [280ms, delay: 180ms, ease: expo-out]
fade-in attn_sub [260ms, delay: 260ms, ease: expo-out]
fade-in attn_desc [260ms, delay: 320ms, ease: expo-out]
stagger [80ms] {
  ab1.opacity = 0.70 [280ms]
  ab2.opacity = 1.00 [280ms]
  ab3.opacity = 0.70 [280ms]
}

#1.90s
draw-in skip1 [520ms, ease: expo-out]
skip1.opacity = 0.85 [460ms]
fade-in plus1 [280ms, delay: 380ms, ease: expo-out]

#2.60s
fade-out phase1 [240ms, ease: ease-in]
fade-in phase2 [280ms, delay: 240ms, ease: expo-out]
wipe-in ln2 [360ms, ease: expo-out]
fade-in ln2_t [260ms, delay: 140ms, ease: expo-out]
ffn_box.opacity = 0.90 [420ms]
fade-in ffn_t [280ms, delay: 180ms, ease: expo-out]
fade-in ffn_sub [260ms, delay: 260ms, ease: expo-out]
fade-in ffn_dims [280ms, delay: 320ms, ease: expo-out]
fade-in ffn_desc [260ms, delay: 360ms, ease: expo-out]
fade-in f_arr1 [240ms, delay: 300ms, ease: expo-out]
fade-in f_arr2 [240ms, delay: 300ms, ease: expo-out]
stagger [80ms] {
  f_in.opacity = 0.70 [280ms]
  f_wide.opacity = 1.00 [320ms]
  f_out.opacity = 0.70 [280ms]
}
pulse f_wide [600ms, intensity: 0.05, delay: 500ms]

#4.10s
fade-out phase2 [240ms, ease: ease-in]
fade-in phase3 [280ms, delay: 240ms, ease: expo-out]
draw-in skip2 [520ms, ease: expo-out]
skip2.opacity = 0.85 [460ms]
fade-in plus2 [280ms, delay: 380ms, ease: expo-out]

#4.80s
fade-in dot [220ms, ease: expo-out]
shift dot [by: (1080, 0), 1600ms, ease: ease-in-out]
fade-out dot [260ms, delay: 1480ms, ease: ease-in]
fade-in summary_card [380ms, delay: 600ms, ease: expo-out]
fade-in sum_t [300ms, delay: 750ms, ease: expo-out]

// ── Outro Rest Frame ────────────────────────────────────────────────
#7.80s
// Complete dual-sublayer block, residual arcs, and dimensional specs stand held.
