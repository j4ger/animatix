// 05 · Feed-forward and residuals.
//
// Fixes over the original geometry, all of which were visible on screen:
//   · the LayerNorm circles (x 247–303) overlapped the block they precede
//     (x 290–510) by 13px, and were painted last, so each circle sat on top of
//     the block's border. The rings now stand in the gaps either side of each
//     block;
//   · "d → 4d" / "4d → d" floated at x = 1020 while the bars they named ended
//     at x = 955. The widening is drawn inside the FFN block instead;
//   · the arcs were filled, not stroked. A Path fills with `color` by default
//     and only strokes when it has a `stroke` and no fill, so the original — and
//     a first pass at this scene — drew two grey lenses with white outlines
//     rather than two skip connections. `fill_opacity: 0.0` fixes it.
//
// The residual rail is drawn first and the blocks sit on top of it, so the rail
// reads as passing behind them rather than as three loose stubs.
//
// Three accents, one job each: primary = the attention half, success = the FFN
// half, warning = normalisation.
//
// Grid: 1280×720. Rail on y = 390 from x = 120 to 1160, blocks 320×190 at
// x = 460 / 980, LayerNorm rings at x = 210 / 740.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7.4 }

// ── the residual stream ─────────────────────────────────────────────
rail: Rect, size: (1040, 6), corner_radius: 3, color: text.muted, opacity: 0.40, at: (640, 390)
rail_label: Text, text: "residual stream", font_size: 15, color: text.muted,
  text_max_width: 130, text_align: "left", at: (205, 450)

// Skip connections leave the rail before the block and rejoin it after, arcing
// clear of both the ring and the block.
skip1: Path, commands: {
  move_to(150, 390), quad_to(385, 10, 620, 390)
}, color: text.muted, stroke: text.muted, stroke_width: 2, opacity: 0.55, fill_opacity: 0.0
skip2: Path, commands: {
  move_to(640, 390), quad_to(890, 10, 1140, 390)
}, color: text.muted, stroke: text.muted, stroke_width: 2, opacity: 0.55, fill_opacity: 0.0

// ── LayerNorm: rings standing in the gaps, not on the borders ───────
ln1: Ellipse, size: (76, 76), color: surface.primary, stroke: accent.warning, stroke_width: 3, at: (210, 390)
ln1_t: Text, text: "LN", font_size: 17, color: text.primary, at: (210, 390)
ln2: Ellipse, size: (76, 76), color: surface.primary, stroke: accent.warning, stroke_width: 3, at: (740, 390)
ln2_t: Text, text: "LN", font_size: 17, color: text.primary, at: (740, 390)

// ── the two halves of a block ───────────────────────────────────────
attn: Rect, size: (320, 190), corner_radius: 20, color: surface.primary,
  stroke: (0.38, 0.78, 1.0, 1.0), stroke_width: 2, at: (460, 390)
attn_t: Text, text: "Attention", font_size: 24, color: text.primary, at: (460, 352)
attn_s: Text, text: "across tokens", font_size: 15, color: text.muted, at: (460, 398)

ffn: Rect, size: (320, 190), corner_radius: 20, color: surface.primary,
  stroke: (0.35, 0.86, 0.63, 1.0), stroke_width: 2, at: (980, 390)
ffn_t: Text, text: "FFN", font_size: 24, color: text.primary, at: (980, 340)

// d → 4d → d, drawn where it happens rather than labelled from a distance
wide_a: Rect, size: (44, 14), corner_radius: 5, color: accent.success, opacity: 0.5, at: (861, 400)
wide_b: Rect, size: (150, 14), corner_radius: 5, color: accent.success, opacity: 1.0, at: (980, 400)
wide_c: Rect, size: (44, 14), corner_radius: 5, color: accent.success, opacity: 0.5, at: (1099, 400)
ffn_s: Text, text: "d → 4d → d", font_size: 15, color: text.muted, at: (980, 442)

// Closing beat: the signal carried straight through by the rail.
dot: Ellipse, size: (16, 16), color: accent.warning, opacity: 0.0, at: (150, 390)

// ── timeline ────────────────────────────────────────────────────────
#0.15s
draw-in rail [800ms, ease: ease-out]
fade-in rail_label [420ms, delay: 400ms]

#0.90s
wipe-in ln1 [400ms, ease: ease-out]
fade-in ln1_t [300ms, delay: 140ms]

#1.35s
wipe-in attn [450ms, ease: ease-out]
fade-in attn_t [320ms, delay: 160ms]
fade-in attn_s [320ms, delay: 300ms]

#1.95s
draw-in skip1 [600ms, ease: ease-out]

#2.55s
wipe-in ln2 [400ms, ease: ease-out]
fade-in ln2_t [300ms, delay: 140ms]

#3.00s
wipe-in ffn [450ms, ease: ease-out]
fade-in ffn_t [320ms, delay: 160ms]

#3.45s
wipe-in wide_a [320ms]
wipe-in wide_b [320ms]
wipe-in wide_c [320ms]
fade-in ffn_s [320ms, delay: 300ms]

#4.05s
draw-in skip2 [600ms, ease: ease-out]

// The residual carried the whole way, past both blocks.
#4.85s
fade-in dot [260ms]
shift dot [by: (990, 0), 1500ms, ease: ease-in-out]
fade-out dot [300ms, delay: 1380ms]
