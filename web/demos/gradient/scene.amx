import "../../demos/lib/theme.amx"
import "../../demos/lib/ambience.amx"
import "../../demos/lib/ui.amx"

// Gradient Descent Animation
// A visual walkthrough of gradient descent on a 2D loss surface:
// loss surface → against the gradient → roll to the minimum → step size matters.

config { colorscheme: "ink", resolution: (1280, 720) }

// =============================================================================
// Scene 1: Title card
// =============================================================================
# TitleCard
config { colorscheme: "ink", duration: 2.6 }

bg1: Ambience, tint: accent.primary

hero: TitleCard,
  title: "Gradient Descent",
  kicker: "OPTIMIZATION DYNAMICS",
  sub: "Rolling down the loss surface toward the minimum",
  at: (640, 360)

#0.0s
fade-in hero [800ms, ease: expo-out]

play LossSurface [fade, 400ms]

// =============================================================================
// Scene 2: Show the loss surface contours with gradient vector field
// =============================================================================
# LossSurface
config { colorscheme: "ink", duration: 5.0 }

bg2: Ambience, tint: accent.primary

step_title: Text, text: "1. The Loss Surface", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 48)

heat: Ellipse, size: (560, 560), at: (420, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d15820"), (26%, "#ffd60a12"), (62%, "#ff86662a"), (86%, "#ff2d5538"), (100%, "#ff2d5500")}),
  blend: "screen"

// Side panel framing the objective & color legend
side_card: Rect, size: (280, 320), at: (980, 380), corner_radius: 12,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
card_kicker: Text, text: "OBJECTIVE SURFACE", font_size: 11, font_weight: 600,
  color: accent.primary, at: (980, 250)
card_fn: Text, text: "L(x, y) = x² + y²", font_size: 20, font_weight: "bold",
  color: text.primary, at: (980, 280)
card_opt: Text, text: "Minimum: (0, 0)  ·  L = 0", font_size: 13,
  color: accent.success, at: (980, 310)

legend_bar: Rect, size: (180, 14), at: (980, 370), corner_radius: 7,
  fill_gradient: linear(90, {"#30d158", "#ffd60a", "#ff8666", "#ff2d55"})
legend_lo: Text, text: "low loss", font_size: 12, color: text.muted, at: (910, 396)
legend_hi: Text, text: "high loss", font_size: 12, color: text.muted, at: (1050, 396)

card_field: Text, text: "Arrows: grad L (steepest ascent)", font_size: 12,
  color: text.secondary, at: (980, 440)

// Contour map of the loss function f(x, y) = x² + y²
contours: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0

// Gradient vector field: ∇f = (2x, 2y) pointing radially outward (uphill)
field: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  color: text.muted

// Global minimum at (0, 0)
min_dot: Ellipse, size: (16, 16), at: (420, 380),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#d8f0dc"), (45%, "#30d158"), (100%, "#0d5c2e")})

caption: Text, text: "Contours denote equal loss; vector arrows point uphill",
  font_size: 15, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in step_title [500ms, ease: expo-out]
fade-in side_card [500ms, ease: expo-out]
fade-in card_kicker [400ms, ease: expo-out]
fade-in card_fn [400ms, ease: expo-out]
fade-in card_opt [400ms, ease: expo-out]
fade-in legend_bar [400ms, ease: expo-out]
fade-in legend_lo [400ms, ease: expo-out]
fade-in legend_hi [400ms, ease: expo-out]
fade-in card_field [400ms, ease: expo-out]

#0.6s
fade-in heat [900ms, ease: expo-out]

#1.0s
stagger [150ms] {
  fade-in contours [600ms, ease: expo-out]
  fade-in field [600ms, ease: expo-out]
  fade-in min_dot [400ms, ease: expo-out]
}

#3.5s
fade-in caption [500ms, ease: expo-out]

play GradientDirection [wipe-left, 400ms]

// =============================================================================
// Scene 3: Show which direction to step — against the gradient
// =============================================================================
# GradientDirection
config { colorscheme: "ink", duration: 4.6 }

bg3: Ambience, tint: accent.warning

step2_title: Text, text: "2. Go Against the Gradient", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 48)

// Dimmed backdrop of the same contour map and field
contours_bg: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

field_bg: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  color: text.muted

heat: Ellipse, size: (560, 560), at: (420, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Ball at starting point
ball: Ellipse, size: (20, 20), at: (608, 230),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffffff"), (45%, "#ece7db"), (100%, "#6e6a62")})

// Arrow pointing uphill along +∇f
up_arrow: Arrow, from: (608, 230), to: (702, 155),
  stroke: accent.danger, stroke_width: 3

// Arrow pointing downhill along −∇f
down_arrow: Arrow, from: (608, 230), to: (514, 305),
  stroke: accent.success, stroke_width: 3

// Labels near arrow tips
up_label: Text, text: "grad f (uphill)", font_size: 15, font_weight: 600,
  color: accent.danger, at: (716, 138)

down_label: Text, text: "-grad f (descend)", font_size: 15, font_weight: 600,
  color: accent.success, at: (490, 312)

// Side panel framing update equation
eq_card: Rect, size: (300, 200), at: (980, 380), corner_radius: 12,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
card_kicker: Text, text: "GRADIENT UPDATE RULE", font_size: 11, font_weight: 600,
  color: accent.warning, at: (980, 315)
card_eq: Text, text: "theta = theta - alpha * grad L", font_size: 18, font_weight: "bold",
  color: text.primary, at: (980, 360)
card_sub: Text, text: "Step opposite to gradient vector to minimize loss", font_size: 12,
  color: text.secondary, at: (980, 410)

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in contours_bg [600ms, ease: expo-out]
fade-in field_bg [600ms, ease: expo-out]
fade-in step2_title [500ms, ease: expo-out, delay: 450ms]
fade-in eq_card [500ms, ease: expo-out]
fade-in card_kicker [400ms, ease: expo-out]
fade-in card_eq [400ms, ease: expo-out]
fade-in card_sub [400ms, ease: expo-out]
pop-in ball [450ms, ease: expo-out]

#1.5s
fade-in up_arrow [800ms, ease: expo-out]
fade-in up_label [800ms, ease: expo-out]

#3.2s
fade-in down_arrow [800ms, ease: expo-out]
fade-in down_label [800ms, ease: expo-out]

#3.5s
pulse ball [500ms]

play Descent [fade, 400ms]

// =============================================================================
// Scene 4: Roll the ball to the minimum along the descent trail
// =============================================================================
# Descent
config { colorscheme: "ink", duration: 8.0 }

bg4: Ambience, tint: accent.success

step3_title: Text, text: "3. Roll to the Minimum", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 48)

// Dimmed contour backdrop
contours_dim: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

// Graph with the parametric descent trail.
descent_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (500, 500), at: (420, 380) {
  trail: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3,
    stroke_progress: 0
}

heat: Ellipse, size: (560, 560), at: (420, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Ball driven by the always block
ball: Ellipse, size: (20, 20), at: (608, 230),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffffff"), (45%, "#ece7db"), (100%, "#6e6a62")})
ball_glow: Ellipse, size: (120, 120), at: (608, 230), opacity: 0.0,
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#8fc7a33d"), (60%, "#8fc7a314"), (100%, "#8fc7a300")}),
  blend: "screen"

// Telemetry card on the right
telemetry_card: Rect, size: (280, 220), at: (980, 380), corner_radius: 12,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
card_kicker: Text, text: "LIVE CONVERGENCE METRIC", font_size: 11, font_weight: 600,
  color: accent.success, at: (980, 305)
live_loss: Text, text: "L = 14.75", font_size: 34, font_weight: "bold",
  color: accent.success, at: (980, 355)
card_status: Text, text: "OPTIMIZING: -grad L trajectory", font_size: 12, font_weight: 600,
  color: text.secondary, at: (980, 405)
card_target: Text, text: "Target: global minimum L = 0.00", font_size: 11,
  color: text.muted, at: (980, 435)

takeaway: Text, text: "Step against the gradient to smoothly descend to the basin",
  font_size: 15, color: text.secondary, anchor: scene.bottom, offset: (0, -40)

always {
  let s = clamp(t - 1.0, 0.0, 4.5)
  let r = 3.84 * exp(-0.55 * s)
  let th = 0.676
  let mx = r * cos(th)
  let my = r * sin(th)
  let bx = 2.0 * mx
  let by = 2.0 * my
  ball.at = descent_graph.map(bx, by)
  ball_glow.at = ball.at
  let loss = r * r
  live_loss.text = format("L = {:.2}", loss)
}

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in step3_title [500ms, ease: expo-out, delay: 450ms]
fade-in contours_dim [600ms, ease: expo-out]
fade-in descent_graph [600ms, ease: expo-out]
fade-in telemetry_card [500ms, ease: expo-out]
fade-in card_kicker [400ms, ease: expo-out]
fade-in card_status [400ms, ease: expo-out]
fade-in card_target [400ms, ease: expo-out]

#1.0s
fade-in ball_glow [400ms, ease: expo-out]
pop-in ball [450ms, ease: expo-out]
fade-in live_loss [400ms, ease: expo-out]
fade-in trail [400ms, ease: expo-out]
trail.stroke_progress = 1.0 [4.5s, ease: ease-out]

#5.7s
pulse ball [500ms]

#6.5s
fade-in takeaway [600ms, ease: expo-out]

play LearningRate [fade, 400ms]

// =============================================================================
// Scene 5: Compare three step sizes — too small, just right, too big
// =============================================================================
# LearningRate
config { colorscheme: "ink", duration: 6.8 }

bg5: Ambience, tint: accent.info

step4_title: Text, text: "4. Step Size Matters", font_size: 38, font_weight: "bold",
  color: text.primary, anchor: scene.top, offset: (0, 48)

heat: Ellipse, size: (560, 560), at: (420, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Dimmed contour backdrop
contours_lr: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), at: (420, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

// Graph with three parametric curves showing different decay rates.
lr_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (500, 500), at: (420, 380) {
  too_small: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.12 * s) * cos(0.95),
                  3.84 * exp(-0.12 * s) * sin(0.95)),
    t_domain: (0, 4.5), color: text.muted, stroke_width: 2, opacity: 0.0
  just_right: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3, opacity: 0.0
  too_big: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(0.15 * s) * cos(0.40),
                  3.84 * exp(0.15 * s) * sin(0.40)),
    t_domain: (0, 2.5), color: accent.danger, stroke_width: 2, opacity: 0.0
}

// Side comparison card
lr_card: Rect, size: (280, 240), at: (980, 380), corner_radius: 12,
  color: surface.primary, stroke: stroke.default, stroke_width: 1
card_kicker: Text, text: "STEP SIZE COMPARISON (α)", font_size: 11, font_weight: 600,
  color: accent.info, at: (980, 290)

dot_small: Ellipse, size: (8, 8), color: text.muted, at: (870, 335)
label_small: Text, text: "Too small: slow decay", font_size: 13, font_weight: 500,
  color: text.muted, at: (975, 335)

dot_right: Ellipse, size: (8, 8), color: accent.success, at: (870, 380)
label_right: Text, text: "Just right: converges", font_size: 13, font_weight: 600,
  color: accent.success, at: (975, 380)

dot_big: Ellipse, size: (8, 8), color: accent.danger, at: (870, 425)
label_big: Text, text: "Too big: diverges / explodes", font_size: 13, font_weight: 500,
  color: accent.danger, at: (980, 425)

card_note: Text, text: "Optimal α balances stability & speed", font_size: 11,
  color: text.muted, at: (980, 465)

lesson: Text, text: "Pick a learning rate that converges — not too small, not too large",
  font_size: 15, color: text.secondary, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in step4_title [500ms, ease: expo-out, delay: 450ms]
fade-in contours_lr [600ms, ease: expo-out]
fade-in lr_graph [600ms, ease: expo-out]
fade-in lr_card [500ms, ease: expo-out]
fade-in card_kicker [400ms, ease: expo-out]
fade-in card_note [400ms, ease: expo-out]

#1.0s
stagger [400ms] {
  fade-in too_small [600ms, ease: expo-out]
  fade-in just_right [600ms, ease: expo-out]
  fade-in too_big [600ms, ease: expo-out]
}

#2.5s
stagger [150ms] {
  fade-in dot_small [300ms, ease: expo-out]
  fade-in label_small [300ms, ease: expo-out]
  fade-in dot_right [300ms, ease: expo-out]
  fade-in label_right [300ms, ease: expo-out]
  fade-in dot_big [300ms, ease: expo-out]
  fade-in label_big [300ms, ease: expo-out]
}

#4.5s
fade-in lesson [600ms, ease: expo-out]

play Outro [fade, 400ms]

// =============================================================================
// Scene 6: Outro — the goal of gradient descent
// =============================================================================
# Outro
config { colorscheme: "ink" }

bg6: Ambience, tint: accent.success

thanks: Text, text: "theta* = argmin L(theta)",
  font_size: 42, font_weight: "bold", color: text.primary, anchor: scene.center, offset: (0, -26)

tag: Text, text: "gradient descent  ·  animatix optimization theatre", font_size: 16,
  color: text.secondary, anchor: scene.center, offset: (0, 36)

#0.0s
fade-in thanks [700ms, ease: expo-out]

#0.8s
fade-in tag [500ms, ease: expo-out]
