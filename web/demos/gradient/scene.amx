import "../lib/theme.amx"
// Gradient Descent Animation
// A visual walkthrough of gradient descent on a 2D loss surface:
// loss surface → against the gradient → roll to the minimum → step size matters.

config { colorscheme: "ink", resolution: (1280, 720) }

// =============================================================================
// Scene 1: Title card
// =============================================================================
# TitleCard
config { colorscheme: "ink", duration: 2.6 }

wash: Ellipse, size: (820, 820), at: (640, 340),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#ff86661a"), (50%, "#ffd60a0e"), (100%, "#ffd60a00")}),
  blend: "screen"

title: Text, text: "Gradient Descent", font_size: 64,
  color: text.primary, anchor: scene.center, offset: (0, -40)

subtitle: Text, text: "Rolling down the loss surface", font_size: 28,
  color: text.secondary, anchor: scene.center, offset: (0, 40)

#0.0s
fade-in wash [900ms, ease: expo-out]
fade-in title [800ms, ease: expo-out]

#1.4s
fade-in subtitle [600ms, ease: expo-out]

play LossSurface [fade, 400ms]

// =============================================================================
// Scene 2: Show the loss surface contours with gradient vector field
// =============================================================================
# LossSurface
config { colorscheme: "ink", duration: 5.0 }

step_title: Text, text: "1. The Loss Surface", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// The loss field itself. Contour rings tell you there IS a surface; this
// screen-blend annulus shows you its shape — green in the basin, hot at the
// rim, dissolving to transparent so it never reads as a disc. Every scene
// that follows re-uses the same ramp so the reader never has to re-learn it.
heat: Ellipse, size: (640, 640), at: (400, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d15820"), (26%, "#ffd60a12"), (62%, "#ff86662a"), (86%, "#ff2d5538"), (100%, "#ff2d5500")}),
  blend: "screen"

// The legend for the ramp above, in the empty right third.
legend_bar: Rect, size: (18, 300), at: (1080, 380), corner_radius: 9,
  fill_gradient: linear(0, {"#30d158", "#ffd60a", "#ff8666", "#ff2d55"})
legend_hi: Text, text: "L high", font_size: 18, color: text.secondary, at: (1080, 205)
legend_lo: Text, text: "L low", font_size: 18, color: text.secondary, at: (1080, 555)
legend_cap: Text, text: "loss", font_size: 20, color: text.muted, at: (1080, 165)

// Contour map of the loss function f(x, y) = x² + y²
contours: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0

// Gradient vector field: ∇f = (2x, 2y) pointing radially outward (uphill)
field: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  color: text.muted

// Global minimum at (0, 0)
min_dot: Ellipse, size: (16, 16), at: (400, 380),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#d8f0dc"), (45%, "#30d158"), (100%, "#0d5c2e")})

caption: Text,
  text: "Contours = equal loss; arrows = gradient (uphill)",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.0s
fade-in step_title [500ms, ease: expo-out]

#0.6s
fade-in heat [900ms, ease: expo-out]

#1.0s
stagger [150ms] {
  fade-in contours [600ms, ease: expo-out]
  fade-in field [600ms, ease: expo-out]
  pop-in min_dot [400ms, ease: expo-out]
}

#1.9s
stagger [90ms] {
  fade-in legend_bar [400ms, ease: expo-out]
  fade-in legend_cap [400ms, ease: expo-out]
  fade-in legend_hi [400ms, ease: expo-out]
  fade-in legend_lo [400ms, ease: expo-out]
}

#3.5s
fade-in caption [500ms, ease: expo-out]

play GradientDirection [wipe-left, 400ms]

// =============================================================================
// Scene 3: Show which direction to step — against the gradient
// =============================================================================
# GradientDirection
config { colorscheme: "ink", duration: 4.6 }

step2_title: Text, text: "2. Go Against the Gradient", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed backdrop of the same contour map and field
contours_bg: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

field_bg: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  color: text.muted

heat: Ellipse, size: (640, 640), at: (400, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Ball at starting point (math: (3, 2.4), screen: 400+3*70, 380-2.4*70).
// A lit sphere, because it is about to roll — the highlight is what makes it
// read as a body in a field rather than a dot on a map.
ball: Ellipse, size: (20, 20), at: (610, 212),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffffff"), (45%, "#ece7db"), (100%, "#6e6a62")})

// Arrow pointing uphill along +∇f
up_arrow: Arrow, from: (610, 212), to: (715, 128),
  stroke: accent.danger, stroke_width: 3

// Arrow pointing downhill along −∇f
down_arrow: Arrow, from: (610, 212), to: (505, 296),
  stroke: accent.success, stroke_width: 3

// Labels near arrow tips
up_label: Text, text: "grad f (uphill)", font_size: 16,
  color: accent.danger, at: (730, 110)

down_label: Text, text: "-grad f (descend)", font_size: 16,
  color: accent.success, at: (480, 300)

// Gradient equation
gradient_eq: Text,
  text: "grad f = (dL/dx, dL/dy)",
  font_size: 22, color: text.secondary, anchor: scene.center, offset: (330, -170)

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in contours_bg [600ms, ease: expo-out]
fade-in field_bg [600ms, ease: expo-out]
fade-in step2_title [500ms, ease: expo-out, delay: 450ms]
pop-in ball [450ms, ease: expo-out]

#1.5s
fade-in up_arrow [800ms, ease: expo-out]
fade-in up_label [800ms, ease: expo-out]

#2.0s
fade-in gradient_eq [600ms, ease: expo-out]

#3.2s
fade-in down_arrow [800ms, ease: expo-out]
fade-in down_label [800ms, ease: expo-out]

#3.5s
highlight ball [600ms]

play Descent [fade, 400ms]

// =============================================================================
// Scene 4: Roll the ball to the minimum along the descent trail
// =============================================================================
# Descent
config { colorscheme: "ink", duration: 8.0 }

step3_title: Text, text: "3. Roll to the Minimum", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed contour backdrop
contours_dim: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

// Graph with the parametric descent trail. For f(x, y) = x² + y² the
// gradient is radial, so steepest descent stays on a constant-angle ray.
descent_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (560, 560), at: (400, 380) {
  trail: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3,
    stroke_progress: 0
}

heat: Ellipse, size: (640, 640), at: (400, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Ball driven by the always block (math coords → screen coords)
ball: Ellipse, size: (20, 20), at: (610, 212),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffffff"), (45%, "#ece7db"), (100%, "#6e6a62")})
// Its light, parked under it by the same always block that parks the ball.
ball_glow: Ellipse, size: (120, 120), at: (610, 212), opacity: 0.0,
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#8fc7a33d"), (60%, "#8fc7a314"), (100%, "#8fc7a300")}),
  blend: "screen"

// Live loss readout
live_loss: Text, text: "loss = 14.75", font_size: 18,
  color: accent.success, at: (650, 130)

// Takeaway text
takeaway: Text, text: "Step against the gradient, reach the minimum", font_size: 22,
  color: text.secondary, anchor: scene.center, offset: (0, 260)

always {
  let s = clamp(t - 1.0, 0.0, 4.5)
  let r = 3.84 * exp(-0.55 * s)
  let th = 0.676
  let mx = r * cos(th)
  let my = r * sin(th)
  // graph.map() runs at half the px/unit of the plotted curve — double
  // the math coords to land the ball on the drawn stroke
  let bx = 2.0 * mx
  let by = 2.0 * my
  ball.at = descent_graph.map(bx, by)
  ball_glow.at = ball.at
  let loss = r * r
  live_loss.text = format("loss = {:.2}", loss)
}

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in step3_title [500ms, ease: expo-out, delay: 450ms]
fade-in contours_dim [600ms, ease: expo-out]
fade-in descent_graph [600ms, ease: expo-out]

#1.0s
fade-in ball_glow [400ms, ease: expo-out]
pop-in ball [450ms, ease: expo-out]
fade-in live_loss [400ms, ease: expo-out]
fade-in trail [400ms, ease: expo-out]
trail.stroke_progress = 1.0 [4.5s, ease: ease-out]

#5.7s
highlight ball [600ms]

#6.5s
fade-in takeaway [600ms, ease: expo-out]

play LearningRate [fade, 400ms]

// =============================================================================
// Scene 5: Compare three step sizes — too small, just right, too big
// =============================================================================
# LearningRate
config { colorscheme: "ink", duration: 6.8 }

step4_title: Text, text: "4. Step Size Matters", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

heat: Ellipse, size: (640, 640), at: (400, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581a"), (26%, "#ffd60a0e"), (62%, "#ff866622"), (86%, "#ff2d552e"), (100%, "#ff2d5500")}),
  blend: "screen"

// Dimmed contour backdrop
contours_lr: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

// Graph with three parametric curves showing different decay rates.
// Each rides its own radial ray (0.95 / 0.676 / 0.40) so all three stay
// visible side by side; only the rate toward/away from the minimum changes,
// matching the radial gradient of x² + y².
lr_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (560, 560), at: (400, 380) {
  too_small: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.12 * s) * cos(0.95),
                  3.84 * exp(-0.12 * s) * sin(0.95)),
    t_domain: (0, 4.5), color: text.muted, stroke_width: 2, opacity: 0.0
  just_right: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3, opacity: 0.0
  too_big: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(0.15 * s) * cos(0.40),
                  3.84 * exp(0.15 * s) * sin(0.40)),
    t_domain: (0, 2.5), color: accent.danger, stroke_width: 2, opacity: 0.0
}

// Labels for each curve
label_small: Text, text: "Too small: slow", font_size: 14,
  color: text.muted, at: (180, 200)
label_right: Text, text: "Just right: converges", font_size: 14,
  color: accent.success, at: (180, 230)
label_big: Text, text: "Too big: diverges", font_size: 14,
  color: accent.danger, at: (180, 260)

// Lesson text
lesson: Text,
  text: "Pick a learning rate that converges — not too small, not too large",
  font_size: 20, color: text.secondary, anchor: scene.center, offset: (0, 280)

#0.0s
fade-in heat [700ms, ease: expo-out]
fade-in step4_title [500ms, ease: expo-out, delay: 450ms]
fade-in contours_lr [600ms, ease: expo-out]
fade-in lr_graph [600ms, ease: expo-out]

#1.0s
stagger [400ms] {
  fade-in too_small [600ms, ease: expo-out]
  fade-in just_right [600ms, ease: expo-out]
  fade-in too_big [600ms, ease: expo-out]
}

#3.5s
fade-in label_small [400ms, ease: expo-out]
fade-in label_right [400ms, ease: expo-out]
fade-in label_big [400ms, ease: expo-out]

#5.0s
fade-in lesson [600ms, ease: expo-out]

play Outro [fade, 400ms]

// =============================================================================
// Scene 6: Outro — the goal of gradient descent
// =============================================================================
# Outro
config { colorscheme: "ink" }

wash: Ellipse, size: (820, 820), at: (640, 360),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#30d1581e"), (50%, "#ffd60a0d"), (100%, "#ffd60a00")}),
  blend: "screen"

thanks: Text, text: "theta* = argmin L(theta)",
  font_size: 40, color: text.primary, anchor: scene.center, offset: (0, -30)

tag: Text, text: "gradient descent  ·  animatix", font_size: 18,
  color: text.muted, anchor: scene.center, offset: (0, 50)

#0.0s
fade-in wash [800ms, ease: expo-out]
fade-in thanks [700ms, ease: expo-out]

#1.0s
fade-in tag [500ms, ease: expo-out]

// No erase cascade: the embed dissolves the finished frame into the next cycle
// itself, so clearing the plate only blanked the figure through the `hold` at the
// end of the loop. The composition now rests complete.
