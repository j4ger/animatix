// house-style: direction hook + payoff — +/- gradient arrows resolve into a stepped descent; rest holds the full surface, the path and the basin marker.
//
// The second act of the walkthrough makes the sign of the update the subject.
//
// Act I (0.0–2.1 s): the same loss bowl arrives with a lone ball on its rim;
// the question is which way the next move goes. Act II (2.1–4.5 s): the
// gradient arrow draws uphill, its negation draws downhill, and the update
// rule lands in the reading rail. Act III (4.5–6.8 s): the ball takes the
// negative-gradient path in discrete steps, the basin blooms and the camera
// pushes a touch before settling on the full plate.
//
// The path is precomputed from `lr` at build time: `--set lr=0.35` zigzags
// across the valley, `--set lr=0.02` visibly crawls toward the basin.
//
// Type floors (DESIGN §1.5): nothing below 16 px; formula 26/22, readouts 28,
// captions 24, the ActHead title 64.
import "../../../examples/lib/theme.amx"

import "../../../examples/lib/stage.amx"

config { colorscheme: "ember", resolution: (1280, 720), duration: 7.9 }

// The build-time slider targets. `steps` is the number of update steps drawn;
// 24 keeps the geometric step sizes legible on both sides of the basin.
let lr = 0.1

let steps = 24

// The plot is 80 px per unit: x ∈ [-5.5, 5.5], y ∈ [-2.5, 2.5].
let x0 = 3.6

let y0 = 1.8

floor: StageFloor, glow: 1.2

head: ActHead, kicker: "FIG 02 · GO AGAINST THE GRADIENT", title: "The sign is the trick", sub: "The gradient points uphill; the update steps the other way."

cap1: Caption, text: "Act I · A ball on the rim of the bowl; every direction is still available.", tag: "gradientdirection.amx"

cap2: Caption, text: "Act II · +∇L is uphill in red; −∇L is downhill in green.", tag: "gradientdirection.amx", opacity: 0

cap3: Caption, text: "Act III · Do that again and again: the selected rate determines the outcome.", tag: "gradientdirection.amx", opacity: 0

// ── the surface plate ──────────────────────────────────────────────
plot_panel: Rect, size: (880, 400), corner_radius: 20, color: surface.secondary, opacity: 0.55, stroke: stroke.default, stroke_width: 1.2, at: (480, 445), legend: false

heat: Ellipse, size: (860, 390), at: (480, 445), blend: "screen", opacity: 0.9, fill_gradient: radial((0.5, 0.5), 0.6, {(0%, accent.success * 0.28), (32%, accent.success * 0.1), (56%, accent.primary * 0.08), (78%, accent.warning * 0.18), (100%, accent.danger * 0.32)})

contours: ContourSet, func: (x, y) => 2 * x ^ 2 + y ^ 2, levels: {2, 8, 18, 32, 50}, x_domain: (-5.5, 5.5), y_domain: (-2.5, 2.5), size: (880, 400), at: (480, 445), resolution: 128, color: accent.primary, stroke_width: 2, opacity: 0.72

axis_x: Line, from: (40, 445), to: (920, 445), stroke: text.muted, stroke_width: 1, opacity: 0.18

axis_y: Line, from: (480, 245), to: (480, 645), stroke: text.muted, stroke_width: 1, opacity: 0.18

axis_x_label: Text, text: "x", font_size: 16, font_family: "mono", color: text.muted, at: (906, 465), opacity: 0.7

axis_y_label: Text, text: "y", font_size: 16, font_family: "mono", color: text.muted, at: (496, 262), opacity: 0.7

// ── the ball and the two directions ────────────────────────────────
// Start point (3.6, 1.8) sits on the rim; the gradient there is (14.4, 3.6),
// so the uphill arrow climbs right and the downhill arrow falls left.
ball: Ellipse, size: (22, 22), at: (768, 301), opacity: 0, fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("ffffff")), (45%, hex_color("f4efe2")), (100%, hex_color("6e6a62"))})

ball_glow: Ellipse, size: (100, 100), at: (768, 301), blend: "screen", opacity: 0, fill_gradient: radial((0.5, 0.5), 0.5, {(0%, accent.primary * 0.55), (58%, accent.primary * 0.14), (100%, (0, 0, 0, 0))})

start_label: Text, text: "START", font_size: 16, font_family: "mono", color: text.secondary, at: (768, 266), opacity: 0

up_arrow: Arrow, from: (768, 301), to: (892, 271), stroke: accent.danger, stroke_width: 3.2, head_size: 13, opacity: 0

up_label: Text, text: "∇L · uphill", font_size: 18, font_weight: 600, color: accent.danger, at: (902, 252), opacity: 0

down_arrow: Arrow, from: (768, 301), to: (644, 331), stroke: accent.success, stroke_width: 3.2, head_size: 13, opacity: 0

down_label: Text, text: "−∇L · downhill", font_size: 18, font_weight: 600, color: accent.success, at: (560, 392), opacity: 0

// ── the step path, precomputed from lr ─────────────────────────────
let px = x0

let py = y0

for i in range(0, 48) {
  let nx = if i < steps { px - (lr * 4) * px } else { px }
  let ny = if i < steps { py - (lr * 2) * py } else { py }
  seg[i]: Line, from: (480 + px * 80, 445 - py * 80), to: (480 + nx * 80, 445 - ny * 80), stroke: accent.success, stroke_width: 2.6, opacity: 0
  dot[i]: Ellipse, size: (8, 8), color: accent.secondary, at: (480 + px * 80, 445 - py * 80), opacity: 0
  let px = if i < steps { nx } else { px }
  let py = if i < steps { ny } else { py }
}

end_dot: Ellipse, size: (8, 8), color: accent.secondary, at: (480 + px * 80, 445 - py * 80), opacity: 0

// ── the basin ──────────────────────────────────────────────────────
basin_glow: Ellipse, size: (210, 210), at: (480, 445), blend: "screen", opacity: 0.3, fill_gradient: radial((0.5, 0.5), 0.55, {(0%, accent.success * 0.5), (45%, accent.success * 0.18), (100%, (0, 0, 0, 0))})

basin_ring: Ellipse, size: (54, 54), stroke: accent.success, stroke_width: 2, opacity: 0.85, at: (480, 445)

basin_core: Ellipse, size: (12, 12), at: (480, 445), opacity: 1, fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("eafff0")), (45%, hex_color("45d488")), (100%, hex_color("0d5c2e"))})

basin_label: Text, text: "GLOBAL MINIMUM · L = 0", font_size: 16, font_family: "mono", color: accent.success, at: (480, 612), opacity: 0.8

// ── the reading rail ──────────────────────────────────────────────
loss_chip: Readout, label: "LOSS", value: format("{:.2}", 2 * px ^ 2 + py ^ 2), at: (1085, 248)

lr_chip: Readout, label: "LEARNING RATE", value: format("{:.2}", lr), at: (1085, 585)

eq_card: Rect, size: (250, 220), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1.2, at: (1085, 420), opacity: 0

eq_kicker: Text, text: "UPDATE RULE", font_size: 16, font_weight: 600, font_family: "mono", color: accent.primary, at: (1085, 340), opacity: 0

eq_line: Text, text: "θ ← θ − lr · ∇L", font_size: 26, font_weight: "bold", color: text.primary, at: (1085, 382), opacity: 0

eq_sub: Text, text: "the minus sign is the descent", font_size: 18, color: text.secondary, at: (1085, 426), opacity: 0

eq_lr: Text, text: format("lr = {:.2}", lr), font_size: 18, font_family: "mono", color: accent.primary, at: (1085, 470), opacity: 0

eq_note: Text, text: "one step is lr · |∇L| long", font_size: 16, font_family: "mono", color: text.muted, at: (1085, 500), opacity: 0

// ── Act I · the question is direction ─────────────────────────────
#0.05s
  fade_in(target: heat, duration: 0.8s, ease: expo_out)
  draw_in(target: contours, duration: 0.95s, ease: expo_out)
  fade_in(target: axis_x, duration: 0.5s, ease: expo_out)
  fade_in(target: axis_y, duration: 0.5s, ease: expo_out)
  fade_in(target: axis_x_label, duration: 0.4s, delay: 0.22s, ease: expo_out)
  fade_in(target: axis_y_label, duration: 0.4s, delay: 0.22s, ease: expo_out)
  pop_in(target: ball, duration: 0.46s, delay: 0.32s, ease: expo_out)
  fade_in(target: ball_glow, duration: 0.7s, delay: 0.32s, ease: expo_out)
  fade_in(target: start_label, duration: 0.4s, delay: 0.5s, ease: expo_out)
  pop_in(target: basin_core, duration: 0.42s, delay: 0.52s, ease: expo_out)
  fade_in(target: basin_ring, duration: 0.5s, delay: 0.52s, ease: expo_out)

// ── Act II · the sign is the mechanism ────────────────────────────
#2.1s
  fade_out(target: cap1, duration: 0.24s, ease: ease_in)
  fade_in(target: cap2, duration: 0.28s, delay: 0.2s, ease: expo_out)
  fade_in(target: eq_card, duration: 0.42s, ease: expo_out)
  fade_in(target: eq_kicker, duration: 0.3s, delay: 0.16s, ease: expo_out)
  fade_in(target: eq_line, duration: 0.36s, delay: 0.24s, ease: expo_out)
  fade_in(target: eq_sub, duration: 0.34s, delay: 0.4s, ease: expo_out)
  fade_in(target: eq_lr, duration: 0.32s, delay: 0.54s, ease: expo_out)
  fade_in(target: eq_note, duration: 0.32s, delay: 0.66s, ease: expo_out)
  draw_in(target: up_arrow, duration: 0.6s, delay: 0.18s, ease: expo_out)
  fade_in(target: up_label, duration: 0.36s, delay: 0.52s, ease: expo_out)

#2.95s
  draw_in(target: down_arrow, duration: 0.6s, ease: expo_out)
  fade_in(target: down_label, duration: 0.36s, delay: 0.34s, ease: expo_out)

// ── Act III · follow −∇L ──────────────────────────────────────────
#4.5s
  fade_out(target: cap2, duration: 0.24s, ease: ease_in)
  fade_in(target: cap3, duration: 0.28s, delay: 0.2s, ease: expo_out)
  for i in range(0, 48) [step: 0.032s] {
      draw_in(target: seg[i], duration: 0.11s, ease: expo_out)
      fade_in(target: dot[i], duration: 0.09s, ease: expo_out)
    }
  fade_in(target: end_dot, duration: 0.16s, delay: 1.55s, ease: expo_out)
  pulse(target: ball, duration: 0.52s, delay: 1.4s)
  camera.zoom = 1.05 [1.3s, ease: ease_in_out]

#6.05s
  basin_glow.opacity = 1 [0.32s, ease: expo_out]
  pulse(target: basin_ring, duration: 0.62s, intensity: 0.06)
  basin_ring.stroke_width = 3.2 [0.32s, ease: expo_out]

#6.7s
  basin_glow.opacity = 0.3 [0.9s, ease: ease_in_out]
  basin_ring.stroke_width = 2 [0.9s, ease: ease_in_out]
  camera.zoom = 1 [1.1s, ease: ease_in_out]

// ── Rest ──────────────────────────────────────────────────────────
#7s
  // The surface, both direction arrows, the stepped path and the basin marker
  // hold; only the ball's own glow cools.
  // The ball walks the same build-time path as the drawn segments, interpolated
  // between adjacent iterates so the motion stays frame-exact and scrubbable.
  always {
      let raw = clamp((t - 4.55) / 1.7, 0, 1) * steps
      let n = clamp(floor(raw), 0, steps - 1)
      let f = clamp(raw - n, 0, 1)
      let kx = 1 - 4 * lr
      let ky = 1 - 2 * lr
      let sx0 = if kx < 0 { if n % 2 == 1 { -1 } else { 1 } } else { 1 }
      let sx1 = if kx < 0 { if (n + 1) % 2 == 1 { -1 } else { 1 } } else { 1 }
      let sy0 = if ky < 0 { if n % 2 == 1 { -1 } else { 1 } } else { 1 }
      let sy1 = if ky < 0 { if (n + 1) % 2 == 1 { -1 } else { 1 } } else { 1 }
      let xn = (x0 * pow(abs(kx), n)) * sx0
      let xn1 = (x0 * pow(abs(kx), n + 1)) * sx1
      let yn = (y0 * pow(abs(ky), n)) * sy0
      let yn1 = (y0 * pow(abs(ky), n + 1)) * sy1
      let bx = xn + (xn1 - xn) * f
      let by = yn + (yn1 - yn) * f
      ball.at = (480 + bx * 80, 445 - by * 80)
      ball_glow.at = ball.at
      let loss = 2 * bx ^ 2 + by ^ 2
      loss_chip.value_text.text = format("{:.2}", loss)
    }
