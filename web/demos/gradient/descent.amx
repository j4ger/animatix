import "../../demos/lib/theme.amx"

config { resolution: (1280, 720) }

# Descent
config { colorscheme: "ink", duration: 8.0 }

step3_title: Text, text: "3. Roll to the Minimum", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed contour backdrop
contours_dim: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: stroke.default, stroke_width: 2.0

// Graph with the parametric descent trail. For f(x, y) = x² + y² the
// gradient is radial, so steepest descent stays on a constant-angle ray.
descent_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (560, 560), at: (400, 380) {
  trail: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3,
    stroke_progress: 0
}

// Ball driven by the always block (math coords → screen coords)
ball: Ellipse, size: (16, 16), color: text.primary, at: (610, 212)

// Live loss readout
live_loss: Text, text: "loss = 14.75", font_size: 18,
  color: accent.success, at: (650, 130)

// Takeaway text
takeaway: Text, text: "Step against the gradient, reach the minimum", font_size: 22,
  color: text.secondary, anchor: scene.center, offset: (330, 180)

always {
  let s = clamp(t - 1.0, 0.0, 4.5)
  let r = 3.84 * exp(-0.55 * s)
  let th = 0.676
  let mx = r * cos(th)
  let my = r * sin(th)
  // graph.map() runs at half the px/unit of the plotted curve — double
  // the math coords to land the ball on the drawn stroke
  let bx = 2.0 * mx
  let by = 2.0 * my
  ball.at = descent_graph.map(bx, by)
  let loss = r * r
  live_loss.text = format("loss = {:.2}", loss)
}

#0.5s
fade-in step3_title [500ms, ease: expo-out]
fade-in contours_dim [600ms, ease: expo-out]
fade-in descent_graph [600ms, ease: expo-out]

#1.0s
fade-in ball [400ms, ease: expo-out]
fade-in live_loss [400ms, ease: expo-out]
fade-in trail [400ms, ease: expo-out]
trail.stroke_progress = 1.0 [4.5s, ease: ease-out]

#5.7s
pulse ball [500ms]

#6.5s
fade-in takeaway [600ms, ease: expo-out]

// Scene 5: Compare three step sizes — too small, just right, too big

// Cut point: this divider belongs to the plate (./scene.amx). The section it names
// is a later figure in its own file — nothing is missing from the scene above.
