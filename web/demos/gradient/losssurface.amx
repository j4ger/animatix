import "../../demos/lib/theme.amx"
config { resolution: (1280, 720) }

# LossSurface
config { colorscheme: "ink", duration: 5.0 }

step_title: Text, text: "The Loss Surface", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Contour map of the loss function f(x, y) = x² + y²
contours: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (640, 372),
  resolution: 96, color: accent.primary, stroke_width: 2.0

// Gradient vector field: ∇f = (2x, 2y) pointing radially outward (uphill)
field: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (640, 372),
  color: text.muted

// Global minimum at (0, 0)
min_dot: Ellipse, size: (12, 12), color: accent.success, at: (640, 372)

caption: Text,
  text: "Contours = equal loss; arrows = gradient (uphill)",
  font_size: 20, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.5s
fade-in step_title [500ms, ease: expo-out]

#1.0s
stagger [150ms] {
  fade-in contours [600ms, ease: expo-out]
  fade-in field [600ms, ease: expo-out]
  fade-in min_dot [400ms, ease: expo-out]
}

#3.5s
fade-in caption [500ms, ease: expo-out]

// Scene 3: Show which direction to step — against the gradient

// Cut point: this divider belongs to the plate (./scene.amx). The section it names
// is a later figure in its own file — nothing is missing from the scene above.

// No erase cascade: the embed dissolves the finished frame into the next cycle
// itself, so clearing the plate only blanked the figure through the `hold` at the
// end of the loop. The composition now rests complete.
