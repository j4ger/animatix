// house-style: landscape hook + payoff — the contour survey resolves into a blooming basin; rest holds the full surface, fall line and basin marker.
//
// The opening act of the gradient-descent walkthrough. It answers one question
// before any stepping happens: what is the thing the model is standing on?
//
// Act I (0.0–2.2 s): the surface arrives inside a lit editorial stage — heat
// wash, contour rings, axes, basin. Act II (2.2–4.3 s): the gradient vector
// field fades in and a dashed fall line is drawn from a start point at the rim;
// arrows point uphill, so the fall line is the one everyone forgets. Act III
// (4.3–7.2 s): a probe follows the fall line into the basin, the basin blooms,
// and the camera pushes a touch before settling back onto the full surface.
//
// Type floors (DESIGN §1.5): nothing renders below 16 px; formula lines 26/22,
// readout values 28, captions 24, the ActHead title 64.
//
// The surface is an elongated bowl, L(x, y) = 2x² + y², so the path can show
// the two curvature directions later: the x axis is the fast one, y the slow
// one. Its full loss range lives on the right-hand card.
import "../../../examples/lib/theme.amx"

import "../../../examples/lib/stage.amx"

config { colorscheme: "ember", resolution: (1280, 720), duration: 7.8 }

// The walkthrough's slider is introduced here as a value only: the descent
// scenes read it for real. `--set lr=N` on those files re-derives their paths
// at build time.
let lr = 0.1

floor: StageFloor, glow: 1.25

head: ActHead, kicker: "FIG 01 · THE LOSS SURFACE", title: "The shape of loss", sub: "Height is loss; the basin is what every step is trying to find."

cap1: Caption, text: "Act I · Rings of equal loss; the innermost loop is the basin.", tag: "losssurface.amx"

cap2: Caption, text: "Act II · Arrows are the gradient: everywhere they point uphill.", tag: "losssurface.amx", opacity: 0

cap3: Caption, text: "Act III · This straight probe lowers loss; it is not a gradient-descent path.", tag: "losssurface.amx", opacity: 0

// ── the surface plate ──────────────────────────────────────────────
// A constant panel (visible at t=0) anchors the map inside the frame. The plot
// is 80 px per unit: x ∈ [-5.5, 5.5], y ∈ [-2.5, 2.5].
plot_panel: Rect, size: (880, 400), corner_radius: 20, color: surface.secondary, opacity: 0.55, stroke: stroke.default, stroke_width: 1.2, at: (480, 445), legend: false

heat: Ellipse, size: (860, 390), at: (480, 445), blend: "screen", opacity: 0.9, fill_gradient: radial((0.5, 0.5), 0.6, {(0%, accent.success * 0.3), (32%, accent.success * 0.1), (56%, accent.primary * 0.08), (78%, accent.warning * 0.2), (100%, accent.danger * 0.36)})

// Contour levels L = 2x² + y². At y = 0 the rings sit at x = 1, 2, 3, 4, 5.
contours: ContourSet, func: (x, y) => 2 * x ^ 2 + y ^ 2, levels: {2, 8, 18, 32, 50}, x_domain: (-5.5, 5.5), y_domain: (-2.5, 2.5), size: (880, 400), at: (480, 445), resolution: 128, color: accent.primary, stroke_width: 2, opacity: 0.85

axis_x: Line, from: (40, 445), to: (920, 445), stroke: text.muted, stroke_width: 1, opacity: 0.2

axis_y: Line, from: (480, 245), to: (480, 645), stroke: text.muted, stroke_width: 1, opacity: 0.2

axis_x_label: Text, text: "x", font_size: 16, font_family: "mono", color: text.muted, at: (906, 465), opacity: 0.8

axis_y_label: Text, text: "y", font_size: 16, font_family: "mono", color: text.muted, at: (496, 262), opacity: 0.8

ring_label: Text, text: "L = 8", font_size: 16, font_family: "mono", color: accent.primary, at: (650, 465), opacity: 0

// The gradient field: ∇L = (4x, 2y). The primitive normalises the arrows, so
// this reads as direction only — the magnitudes live in the card.
field: VectorField, func: (x, y) => (4 * x, 2 * y), density: 10, x_domain: (-5.5, 5.5), y_domain: (-2.5, 2.5), size: (880, 400), at: (480, 445), color: text.muted, opacity: 0

// A start point on the rim and its fall line — the one direction the field
// does not name. The ball is the future descent, parked at the rim.
start_ball: Ellipse, size: (20, 20), at: (768, 301), opacity: 0, fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("ffffff")), (45%, hex_color("f4efe2")), (100%, hex_color("6e6a62"))})

start_ring: Ellipse, size: (48, 48), stroke: accent.secondary, stroke_width: 1.6, opacity: 0, at: (768, 301)

start_label: Text, text: "START", font_size: 16, font_family: "mono", color: text.secondary, at: (768, 266), opacity: 0

fall_line: Line, from: (768, 301), to: (480, 445), stroke: accent.success, stroke_width: 2.2, dash_pattern: {10, 8}, opacity: 0

fall_label: Text, text: "straight probe", font_size: 16, font_family: "mono", color: accent.success, at: (700, 356), opacity: 0

// The basin marker: a screen-blended bloom under a ring and a core dot.
basin_glow: Ellipse, size: (220, 220), at: (480, 445), blend: "screen", opacity: 0.35, fill_gradient: radial((0.5, 0.5), 0.55, {(0%, accent.success * 0.55), (45%, accent.success * 0.2), (100%, (0, 0, 0, 0))})

basin_ring: Ellipse, size: (54, 54), stroke: accent.success, stroke_width: 2, opacity: 0.9, at: (480, 445)

basin_core: Ellipse, size: (12, 12), at: (480, 445), opacity: 1, fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("eafff0")), (45%, hex_color("45d488")), (100%, hex_color("0d5c2e"))})

basin_label: Text, text: "GLOBAL MINIMUM · L = 0", font_size: 16, font_family: "mono", color: accent.success, at: (480, 612), opacity: 0.8

// The probe that rides the fall line at the payoff.
probe: Ellipse, size: (20, 20), at: (768, 301), opacity: 0, fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("ffffff")), (45%, hex_color("f4efe2")), (100%, hex_color("6e6a62"))})

probe_glow: Ellipse, size: (92, 92), at: (768, 301), blend: "screen", opacity: 0, fill_gradient: radial((0.5, 0.5), 0.5, {(0%, accent.primary * 0.6), (58%, accent.primary * 0.16), (100%, (0, 0, 0, 0))})

// ── the reading rail ────────────────────────────────────────────────
loss_chip: Readout, label: "LOSS AT PROBE", value: "29.16", at: (1085, 285)

start_chip: Readout, label: "LOSS AT START", value: "29.16", at: (1085, 390)

eq_card: Rect, size: (250, 190), corner_radius: 16, color: surface.primary, stroke: stroke.default, stroke_width: 1.2, at: (1085, 532), opacity: 1

eq_kicker: Text, text: "THE BOWL", font_size: 16, font_weight: 600, font_family: "mono", color: accent.primary, at: (1085, 464), opacity: 1

eq_line: Text, text: "L(x, y) = 2x² + y²", font_size: 26, font_weight: "bold", color: text.primary, at: (1085, 500), opacity: 1

eq_grad: Text, text: "∇L = (4x, 2y)", font_size: 22, color: text.secondary, at: (1085, 540), opacity: 1

eq_min: Text, text: "minimum at (0, 0) · L = 0", font_size: 18, color: accent.success, at: (1085, 576), opacity: 1

eq_lr: Text, text: format("learning rate lr = {:.2}", lr), font_size: 16, font_family: "mono", color: text.muted, at: (1085, 606), opacity: 1

// ── Act I · the surface is already a stage ─────────────────────────
#0.05s
  fade_in(target: heat, duration: 0.8s, ease: expo_out)
  draw_in(target: contours, duration: 0.95s, ease: expo_out)
  fade_in(target: axis_x, duration: 0.5s, ease: expo_out)
  fade_in(target: axis_y, duration: 0.5s, ease: expo_out)
  fade_in(target: axis_x_label, duration: 0.4s, delay: 0.22s, ease: expo_out)
  fade_in(target: axis_y_label, duration: 0.4s, delay: 0.22s, ease: expo_out)
  pop_in(target: basin_core, duration: 0.42s, delay: 0.28s, ease: expo_out)
  fade_in(target: basin_ring, duration: 0.5s, delay: 0.28s, ease: expo_out)
  fade_in(target: basin_glow, duration: 0.7s, delay: 0.28s, ease: expo_out)

// ── Act II · the field names uphill ────────────────────────────────
#2.2s
  fade_out(target: cap1, duration: 0.24s, ease: ease_in)
  fade_in(target: cap2, duration: 0.28s, delay: 0.2s, ease: expo_out)
  fade_in(target: field, duration: 0.8s, ease: expo_out)
  field.opacity = 0.55 [0.5s, delay: 0.4s, ease: ease_in_out]
  fade_in(target: ring_label, duration: 0.4s, delay: 0.3s, ease: expo_out)
  pop_in(target: start_ball, duration: 0.42s, delay: 0.26s, ease: expo_out)
  fade_in(target: start_ring, duration: 0.5s, delay: 0.26s, ease: expo_out)
  fade_in(target: start_label, duration: 0.4s, delay: 0.34s, ease: expo_out)
  draw_in(target: fall_line, duration: 0.75s, delay: 0.42s, ease: expo_out)
  fade_in(target: fall_label, duration: 0.42s, delay: 0.3s, ease: expo_out)

// ── Act III · the probe takes the fall line ────────────────────────
#4.3s
  fade_out(target: cap2, duration: 0.24s, ease: ease_in)
  fade_in(target: cap3, duration: 0.28s, delay: 0.2s, ease: expo_out)
  fade_out(target: start_ball, duration: 0.22s, ease: ease_in)
  fade_out(target: start_ring, duration: 0.22s, ease: ease_in)
  fade_out(target: start_label, duration: 0.22s, ease: ease_in)
  pop_in(target: probe, duration: 0.36s, ease: expo_out)
  fade_in(target: probe_glow, duration: 0.7s, ease: expo_out)
  camera.zoom = 1.05 [1.3s, ease: ease_in_out]

#5.65s
  basin_glow.opacity = 1 [0.32s, ease: expo_out]
  pulse(target: basin_ring, duration: 0.62s, intensity: 0.06)
  basin_ring.stroke_width = 3.2 [0.32s, ease: expo_out]

#6.45s
  basin_glow.opacity = 0.34 [0.9s, ease: ease_in_out]
  basin_ring.stroke_width = 2 [0.9s, ease: ease_in_out]
  camera.zoom = 1 [1.1s, ease: ease_in_out]

// ── Rest ───────────────────────────────────────────────────────────
#7.1s
  // The whole surface — heat, five contour rings, gradient field, fall line,
  // probe and basin marker — holds. Nothing erases.
  // This illustrative straight probe is not the negative-gradient trajectory.
  // Only current loss changes; LOSS AT START remains the initial 29.16.
  always {
      let p = clamp((t - 4.35) / 1.45, 0, 1)
      let e = (p * p) * (3 - 2 * p)
      probe.at = (768 - 288 * e, 301 + 144 * e)
      probe_glow.at = probe.at
      let loss = 29.16 * (1 - e) ^ 2
      loss_chip.value_text.text = format("{:.2}", loss)
    }
