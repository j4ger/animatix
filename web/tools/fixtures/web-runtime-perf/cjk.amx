// CJK font fallback and vector geometry for a stable browser playback workload.
config { canvas_size: (1280, 720), duration: 2 }

title: Text, text: "动画运行时性能", font_size: 48, color: hex_color("f2f4f8"), anchor: scene.center, offset: (0, -150), opacity: 1

caption: Text, text: "字体回退 · 实时播放 · 你好", font_size: 30, color: hex_color("9bb0c8"), anchor: scene.center, offset: (0, -75), opacity: 1

panel: Rect, size: (560, 260), color: hex_color("26364a"), at: (640, 400), opacity: 1

orb: Ellipse, size: (170, 170), color: hex_color("f3a85b"), at: (640, 400), opacity: 1

#0s
  shift(target: orb, by: (-220, 0), duration: 2s, ease: ease_in_out)
