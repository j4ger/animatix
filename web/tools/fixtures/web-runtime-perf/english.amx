// English text plus vector geometry for a stable browser playback workload.
config { canvas_size: (1280, 720), duration: 2 }

title: Text, text: "Animatix Web Runtime", font_size: 46, color: hex_color("f2f4f8"), anchor: scene.center, offset: (0, -170), opacity: 1

caption: Text, text: "English labels · vector geometry · 123", font_size: 28, color: hex_color("9bb0c8"), anchor: scene.center, offset: (0, -105), opacity: 1

panel: Rect, size: (520, 270), color: hex_color("26364a"), at: (640, 390), opacity: 1

orb: Ellipse, size: (180, 180), color: hex_color("55c6a9"), at: (640, 390), opacity: 1

#0s
  shift(target: orb, by: (220, 0), duration: 2s, ease: ease_in_out)
