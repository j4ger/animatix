// count_up.amx — `format` plus an `always` text write. The glyphs recompile on
// the frames the string changes, so the number climbs instead of appearing.
import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (640, 360), duration: 5 }

kpi: Text, text: "0", font_size: 92, color: accent.warning, at: (320, 158), opacity: 1.0
cap: Text, text: "requests per second", font_size: 20, color: text.secondary,
  at: (320, 226), opacity: 1.0

always {
  let p = clamp(t / 1.6, 0, 1)
  // Eased by hand: the counter should arrive with the plate, not linearly.
  let eased = 1.0 - pow(1.0 - p, 3.0)
  // `format` substitutes; it has no thousands grouping, so the target is a
  // number that does not need one.
  kpi.text = format("{}", floor(8412 * eased))
}

#0s
fade-in cap [400ms]
settle-in kpi [420ms]
