// analytic_sparks.amx — particles with no state model. Each spark's position is
// a function of its seed and its age, so the burst is deterministic frame by
// frame and survives a scrub in either direction.
import "../../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (640, 360), duration: 6 }

let spark_indices = range(0, 12)

glow: Ellipse, size: (300, 300), at: (320, 190), opacity: 1, blend: "screen", fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("ff9f0a55")), (55%, hex_color("ff2d5522")), (100%, hex_color("ff2d5500"))})

origin: Ellipse, size: (12, 12), at: (320, 190), color: hex_color("ffe9c7"), opacity: 1

for i in spark_indices {
  spark[i]: Ellipse, size: (10, 10), at: (320, 190), color: hex_color("ffd60a"), opacity: 1
}

always {
  let age = clamp(t - 0.4, 0, 2.2)
  let fade = linear_progress(age, 0, 2.2)
  for i in spark_indices {
      let dir = seeded_noise(i * 1.37, 0.5) * 6.28318
      let speed = 90 + seeded_noise(i * 2.11, 9) * 170
      let reach = speed * age
      spark[i].at = (320 + cos(dir) * reach, (190 + sin(dir) * reach) + (150 * age) * age)
      spark[i].size = (10 * (1 - age / 2.6), 10 * (1 - age / 2.6))
      spark[i].color = lerp_color_oklab(hex_color("ffe9c7"), hex_color("ff2d55"), fade)
      spark[i].opacity = 1 - fade
    }
}

#0s
  fade_in(target: glow, duration: 0.4s)
