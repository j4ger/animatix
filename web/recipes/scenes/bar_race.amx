// bar_race.amx — `data` keyframes: bars travel to their own new value.
//
// The chart swaps datasets twice and ends where it started, so the loop has no
// seam. Bars are matched by label — `web` slides down while `batch` climbs — and
// the slot each bar sits in is fixed at the start of the window, so heights
// animate and positions do not. Both datasets therefore keep the same labels in
// the same order: captions are compiled at build, and a re-ordered or re-labelled
// set would put the old caption under a new bar.
//
// `max_value` is pinned at 70 on purpose. Left on the default `auto`, the
// tallest bar is normalised to the full plot height every frame, so a growing
// maximum is invisible and only the relative differences survive.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 5.4 }

chart: BarChart, data: {("api", 34), ("web", 52), ("batch", 18)},
  max_value: 70, at: (640, 400), size: (700, 400), bar_width: 110, gap: 54,
  color: accent.primary, opacity: 1.0

title: Text, text: "requests by service, thousands", font_size: 26,
  color: text.primary, at: (640, 150)
cap: Text, text: "same labels, new heights", font_size: 22,
  color: text.secondary, at: (640, 640), opacity: 1.0

#0s
fade-in title [400ms, ease: expo-out]
fade-in cap [400ms, ease: expo-out]
settle-in chart [520ms, ease: expo-out]

#1.5s
chart.data = {("api", 61), ("web", 24), ("batch", 45)}
  [900ms, ease: ease-in-out]

#3.2s
chart.data = {("api", 34), ("web", 52), ("batch", 18)}
  [1.2s, ease: ease-in-out]
