// two_point_light.amx — the cheapest move that separates a lit stage from a
// black field with a shape on it: a warm key behind the subject, a cool fill
// somewhere else, both on `screen` so they can only ever add light.
import "../../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (640, 360), duration: 5 }

key: Ellipse, size: (420, 420), at: (250, 150), opacity: 1, blend: "screen", fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b94233")), (55%, hex_color("f5b9420f")), (100%, hex_color("f5b94200"))})

fill: Ellipse, size: (360, 360), at: (430, 260), opacity: 1, blend: "screen", fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("64d2ff2b")), (55%, hex_color("64d2ff0c")), (100%, hex_color("64d2ff00"))})

subject: Rect, size: (190, 120), at: (320, 176), corner_radius: 16, fill_gradient: linear(135, {hex_color("1b2534"), hex_color("0c1118")}), stroke: stroke.default, stroke_width: 1

label: Text, text: "the subject", font_size: 18, color: text.secondary, at: (320, 176)

#0s
  settle_in(target: subject, duration: 0.52s)
  fade_in(target: label, duration: 0.4s, delay: 0.12s)
  // The lights drift, so the plate is never fully still.
  always {
      key.at = (250 + noise(t * 0.6) * 26, 150 + seeded_noise(3, t * 0.5) * 18)
      fill.at = (430 - seeded_noise(9, t * 0.55) * 22, 260 + seeded_noise(5, t * 0.45) * 16)
    }
