// rest-check: exempt - this plate is the page: full-bleed behind the copy (`sealed`,
//   fit=cover, no frame), so its close clears back to the page's own ink.
// hero.amx — the homepage plate: a title sequence, not a demo card.
//
// The page's ground and this scene's background are the same ink (#0b0e14,
// the `ink` colorscheme), and the embed is fit=cover — so there is no frame:
// the grid, the wordmark and the choreography simply live on the page. Built
// for the slim engine (plain text and vector shapes only).
//
// Structure: the plate is *lit* before it is drawn — two screen-blend washes
// give the ink ground depth — then viewfinder brackets trace in (the
// instrument frame), the layout grid flashes in and recedes, the wordmark
// settles onto it while an amber→coral underline draws itself under a riding
// carriage, the tagline follows, then three primitives fly in from off-stage
// and trade shapes and colors — one of them morphing — over a glow that
// drifts on its own noise, and a lit red ball hops across a marching-dash
// footer rail under its own gravity to close the loop.
//
// Light rule: every glow on this plate is a `radial` ramp whose outer stop is
// transparent, composited with `blend: "screen"`. The ramp's own alpha is what
// sets the brightness, so the actors can ride to full `opacity: 1.0` and still
// read as light rather than as grey ellipses.
//
// Layout rule observed: every actor is declared before the first keyframe;
// ones with no authored opacity stay hidden until their entrance action.
// Content keeps to the center ~88% of the 1600×900 stage because the embed
// crops with fit=cover.

import "../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1600, 900), duration: 13.0 }

// ── the light layer ─────────────────────────────────────────────────
// Key light warm from behind the wordmark, fill cool from low left. Two
// tones is enough to make a flat ground read as a room; the drift is sin/cos
// of the loop phase, so the wash is at the same place on frame 0 and frame
// last and the wrap never pops.

wash_key: Ellipse, size: (1160, 1160), at: (800, 300),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b94226"), (45%, "#f5b94210"), (100%, "#f5b94200")}),
  blend: "screen"

wash_fill: Ellipse, size: (920, 920), at: (280, 770),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#8ab4f61f"), (55%, "#8ab4f60a"), (100%, "#8ab4f600")}),
  blend: "screen"

// ── the instrument frame ────────────────────────────────────────────
// Four corner brackets framing the safe area — the viewfinder motif the
// site chrome carries too (the ruler diamond, the keyframe stamps). Each
// traces on a warm→coral ramp so the frame has a light direction.

bracket_tl: Path,
  commands: {move_to(46, 0), line_to(0, 0), line_to(0, 46)},
  stroke_width: 3, fill_opacity: 0.0,
  stroke_gradient: linear(135, {"#f5b942", "#ff8666"}),
  anchor: scene.center, offset: (-620, -330)

bracket_tr: Path,
  commands: {move_to(-46, 0), line_to(0, 0), line_to(0, 46)},
  stroke_width: 3, fill_opacity: 0.0,
  stroke_gradient: linear(45, {"#ff8666", "#f5b942"}),
  anchor: scene.center, offset: (620, -330)

bracket_bl: Path,
  commands: {move_to(0, -46), line_to(0, 0), line_to(46, 0)},
  stroke_width: 3, fill_opacity: 0.0,
  stroke_gradient: linear(225, {"#f5b942", "#ff8666"}),
  anchor: scene.center, offset: (-620, 330)

bracket_br: Path,
  commands: {move_to(0, -46), line_to(0, 0), line_to(-46, 0)},
  stroke_width: 3, fill_opacity: 0.0,
  stroke_gradient: linear(315, {"#ff8666", "#f5b942"}),
  anchor: scene.center, offset: (620, 330)

// ── the layout grid: flashes in, then recedes behind the type ───────

grid: NumberPlane,
  x_domain: (-8, 8), y_domain: (-4.5, 4.5),
  x_range: (-8, 8, 1), y_range: (-4.5, 4.5, 1),
  size: (1440, 780), stroke: stroke.default,
  anchor: scene.center

// ── the wordmark block (center-relative offsets; y down is +) ───────

wordmark: Text, text: "Animatix", font_size: 168, color: text.primary,
  anchor: scene.center, offset: (0, -118)

// The rule draws in as a warm→coral ramp; a wide low-alpha copy of the same
// geometry, screen-blended, is its bloom. Both are trimmed by their own
// `draw-in`, so the light arrives with the stroke instead of ahead of it.
underline: Path,
  commands: {move_to(-230, 0), line_to(230, 0)},
  stroke_width: 6, fill_opacity: 0.0,
  stroke_gradient: linear(90, {"#f5b942", "#ff8666"}),
  anchor: scene.center, offset: (0, -22)

underline_bloom: Path,
  commands: {move_to(-230, 0), line_to(230, 0)},
  stroke_width: 20, fill_opacity: 0.0,
  stroke_gradient: linear(90, {"#f5b94242", "#ff866642"}),
  blend: "screen",
  anchor: scene.center, offset: (0, -22)

carriage: Rect, size: (12, 26), corner_radius: 3, at: (570, 428),
  fill_gradient: linear(0, {"#ffd60a", "#ff8666"})

tagline: Text, text: "a declarative animation language", font_size: 38,
  color: text.secondary, anchor: scene.center, offset: (0, 38)

// ── the trio: three primitives that trade shapes and colors ─────────
// Declared off-stage (so the entrance is a flight, not a fade in place);
// no authored opacity, each is revealed by its own entrance beat.
//
// The trio deliberately keeps FLAT `color:` fills: the #6.2s beat is a colour
// trade, and a `fill_gradient` overrides the solid fill, so ramping these
// three would silently kill the beat that teaches morphing. The light under
// them does that job instead.

sq: Rect, size: (76, 76), corner_radius: 14, color: accent.primary, at: (-90, 990)
ci: Ellipse, size: (76, 76), color: accent.secondary, at: (1690, -90)
di: Polygon, points: {(0, -49), (49, 0), (0, 49), (-49, 0)},
  color: accent.warning, at: (800, 1010)

// The bench they land on: a warm pool that drifts on seeded noise. Its `at`
// is noise-driven and never keyframed, so the two owners cannot fight.
trio_glow: Ellipse, size: (480, 480), at: (800, 640),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b9421f"), (55%, "#ff86660d"), (100%, "#ff866600")}),
  blend: "screen"

// ── the closing ball ────────────────────────────────────────────────
// A lit sphere, not a disc: the radial ramp puts the highlight up-left and
// the terminator down-right, which is what sells the hop as physical.

ball: Ellipse, size: (30, 30), at: (240, 726),
  fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffb3b3"), (45%, "#ff5c5c"), (100%, "#b3123a")})

// The footer rail: a live edge for the lower third and the ground the ball
// hops on. Marching ants start when the ball does.
rail: Path,
  commands: {move_to(240, 748), line_to(1360, 748)},
  stroke: accent.info, stroke_width: 2, fill_opacity: 0.0,
  dash_pattern: {10, 7}

// ── the instrument sweep ────────────────────────────────────────────
// One hairline scanning the grid for the whole loop. A title sequence with
// dead seconds reads as a stalled render; this is the element that says the
// clock is running even when nothing else moves. The ramp fades both ends to
// transparent so it enters and leaves the plate without a hard edge.

sweep: Rect, size: (3, 780), at: (80, 450), opacity: 0.0,
  fill_gradient: linear(0, {"#f5b94200", "#f5b942", "#f5b94200"}),
  blend: "screen"

// ── timeline ────────────────────────────────────────────────────────

// The room is lit before anything is drawn in it.
#0.05s
fade-in wash_key [900ms, ease: expo-out]
fade-in wash_fill [1.3s, ease: expo-out]

#0.1s
stagger [90ms] {
  draw-in bracket_tl [450ms, ease: expo-out]
  draw-in bracket_tr [450ms, ease: expo-out]
  draw-in bracket_bl [450ms, ease: expo-out]
  draw-in bracket_br [450ms, ease: expo-out]
}

#0.3s
fade-in grid [650ms, ease: expo-out]

// The sweep crosses the plate exactly once per loop, so the scan and the
// sequence share one clock.
#0.6s
sweep.opacity = 0.14 [900ms, ease: expo-out]

always {
  sweep.at = (80.0 + 1440.0 * (t / 13.0), 450.0)

  // Loop-phase drift for the light layer: period 13s, so the wash sits in the
  // same place at t=0 and t=13. The second sine is the second harmonic — an
  // integer multiple keeps the wrap exact.
  let u = t / 13.0 * 6.283185307179586
  wash_key.at = (800.0 + 44.0 * sin(u) + 16.0 * sin(2.0 * u), 300.0 + 26.0 * cos(u))
  wash_fill.at = (280.0 - 34.0 * cos(u), 770.0 + 22.0 * sin(u))

  // The bench glow wanders on fractal noise instead of a sine — it is faded
  // out across the wrap, so a non-looping path is free here and the organic
  // drift is what keeps the 4s–6s hold from sitting still.
  trio_glow.at = (800.0 + fbm(t * 0.35, 4) * 90.0, 640.0 + seeded_fbm(7, t * 0.3, 3) * 34.0)
}

// The grid flashes to full, then recedes to a texture as the type arrives;
// the wordmark settles the last few pixels. Display type never overshoots —
// a 168px wordmark on a back-ease reads as jelly, not as motion design — but
// it does wind up: a 70ms counter-move before the drop is what makes the
// settle read as weight rather than as a fade with a translate.
#0.9s
grid.opacity = 0.15 [1s, ease: ease-out]

#1.0s
fade-in wordmark [550ms, ease: expo-out]

#1.1s
shift wordmark [by: (0, 24), 750ms, ease: expo-out, anticipate: 70ms]

#1.7s
draw-in underline [750ms, ease: expo-out]
draw-in underline_bloom [750ms, ease: expo-out]
fade-in carriage [180ms, ease: expo-out]
// The carriage rides the draw tip: same start, span and ease as the draw.
// The ease here must move in lockstep with the `draw-in` above or the tip
// and the carriage separate mid-stroke.
carriage.at = (1030, 428) [750ms, ease: expo-out]

#2.6s
fade-out carriage [300ms, ease: ease-in]
fade-out underline_bloom [400ms, ease: ease-in]

// settle-in: fade plus a slight scale, arriving on expo-out. Small type can
// take the scale that the 168px wordmark cannot.
#2.8s
settle-in tagline [650ms, ease: expo-out]

// The trio flies in — each from a different edge — and lands on a spring, so
// the three props arrive with weight instead of sliding to a halt. The
// stagger is tight (60ms) so all three are airborne together and the beat
// reads as a trio, not a sequence of solo dots. `pop-in` gives each an
// overshoot on arrival, which is what the flat fade-in lacked.
#3.9s
fade-in trio_glow [900ms, ease: expo-out]
fade-in rail [400ms, ease: expo-out]
rail.dash_offset = 0
stagger [60ms] {
  pop-in sq [700ms, ease: expo-out]
  sq.at = (704, 610) [700ms, ease: spring]
  pop-in ci [700ms, ease: expo-out]
  ci.at = (800, 610) [700ms, ease: spring]
  pop-in di [700ms, ease: expo-out]
  di.at = (896, 610) [700ms, ease: spring]
}

// The trade: square morphs round, the diamond squares up and takes the
// amber, the circle squashes and recovers. One beat, three personalities.
#6.2s
sq: Ellipse, size: (76, 76), color: accent.success [900ms, strategy: match]
rotate di [by: deg(45), 900ms, ease: ease-in-out]
di: Polygon, points: {(0, -49), (49, 0), (0, 49), (-49, 0)},
  color: accent.primary [900ms, strategy: auto]
ci.size = (96, 42) [450ms, ease: ease-in-out]

#6.7s
ci.size = (76, 76) [500ms, ease: spring]

// The red ball hops across the footer under real gravity. `ease: bounce` on a
// straight traverse is not a bounce — it is the curve wobbling past its
// target, so the ball jerks sideways and stops. The `bounce` ACTION is the
// physics: it writes the additive `motion_offset` channel, so a linear carry
// and a decaying hop run at the same time without fighting each other. The
// rail's ants march one dash period (17px) per 130px of ball travel, so the
// ground reads as moving under it.
#7.8s
pop-in ball [420ms, ease: expo-out]

#8.3s
ball.at = (1360, 726) [2.3s, ease: linear]
bounce ball [2.3s, intensity: 190, restitution: 0.6]
rail.dash_offset = 340 [2.3s, ease: linear]

// Settle: the grid breathes once…
#10.3s
grid.opacity = 0.3 [1.2s, ease: ease-in-out]

// …and the scan winds down with it, so the outro empties in one gesture.
#10.6s
sweep.opacity = 0.0 [700ms, ease: ease-in]

// …then the plate empties itself in reverse order, so the loop wraps from a
// quiet stage into the bracket draw-in instead of hard-cutting a full frame
// to black. The washes are the last thing to go and the first thing back —
// the room keeps its light through the wrap.
#10.6s
fade-out ball [350ms, ease: ease-in]

#11.2s
stagger [90ms] {
  fade-out tagline [450ms, ease: ease-in]
  fade-out underline [450ms, ease: ease-in]
  fade-out rail [350ms, ease: ease-in]
  fade-out sq [450ms, ease: ease-in]
  fade-out ci [450ms, ease: ease-in]
  fade-out di [450ms, ease: ease-in]
}

#11.5s
fade-out trio_glow [500ms, ease: ease-in]

#11.9s
fade-out wordmark [650ms, ease: ease-in]

#12.0s
grid.opacity = 0.05 [700ms, ease: ease-in]

#12.3s
stagger [80ms] {
  fade-out bracket_tl [380ms, ease: ease-in]
  fade-out bracket_tr [380ms, ease: ease-in]
  fade-out bracket_bl [380ms, ease: ease-in]
  fade-out bracket_br [380ms, ease: ease-in]
}

#12.5s
fade-out wash_key [500ms, ease: ease-in]
fade-out wash_fill [500ms, ease: ease-in]
