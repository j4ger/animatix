// house-style: title sequence; rests on the assembled wordmark, trio and rail.
//   Centered wordmark is kept as a deliberate brand title card (DESIGN §1 rule 6
//   retires the centered stack for diagram scenes, not for the wordmark itself).
// hero.amx — the homepage plate: a title sequence, not a demo card.
//
// The page's ground and this scene's background are the same ink (#0b0e14,
// the `ink` colorscheme), and the embed is fit=cover — so there is no frame:
// the grid, the wordmark and the choreography simply live on the page. Built
// for the slim engine (plain text and vector shapes only).
//
// Structure: the plate is *lit* before it is drawn — two screen-blend washes
// give the ink ground depth — then viewfinder brackets trace in (the
// instrument frame), the layout grid flashes in and recedes, the wordmark
// settles onto it while an amber→coral underline draws itself under a riding
// carriage, the tagline follows, then three primitives fly in from off-stage
// and trade shapes and colors — one of them morphing — over a glow that
// drifts on its own noise, and a lit red ball hops across a marching-dash
// footer rail under its own gravity to close the loop.
//
// Light rule: every glow on this plate is a `radial` ramp whose outer stop is
// transparent, composited with `blend: "screen"`. The ramp's own alpha is what
// sets the brightness, so the actors can ride to full `opacity: 1.0` and still
// read as light rather than as grey ellipses.
//
// Layout rule observed: every actor is declared before the first keyframe;
// ones with no authored opacity stay hidden until their entrance action.
// Content keeps to the center ~88% of the 1600×900 stage because the embed
// crops with fit=cover.
import "../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (1600, 900), duration: 13 }

// ── the light layer ─────────────────────────────────────────────────
// Key light warm from behind the wordmark, fill cool from low left. Two
// tones is enough to make a flat ground read as a room; the drift is sin/cos
// of the loop phase, so the wash is at the same place on frame 0 and frame
// last and the wrap never pops.
//
// House-style §1: the washes and the grid carry an authored opacity instead of
// fading in, so frame 0 is already a lit room — the first-frame ink floor in
// web/tools/site/site-rest-check.py measures exactly this.
wash_key: Ellipse, size: (1160, 1160), at: (800, 300), opacity: 1, fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b94226")), (45%, hex_color("f5b94210")), (100%, hex_color("f5b94200"))}), blend: "screen"

wash_fill: Ellipse, size: (920, 920), at: (280, 770), opacity: 1, fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("8ab4f61f")), (55%, hex_color("8ab4f60a")), (100%, hex_color("8ab4f600"))}), blend: "screen"

// ── the instrument frame ────────────────────────────────────────────
// Four corner brackets framing the safe area — the viewfinder motif the
// site chrome carries too (the ruler diamond, the keyframe stamps). Each
// traces on a warm→coral ramp so the frame has a light direction.
bracket_tl: Path, commands: {move_to(46, 0), line_to(0, 0), line_to(0, 46)}, stroke_width: 3, fill_opacity: 0, stroke_gradient: linear(135, {hex_color("f5b942"), hex_color("ff8666")}), anchor: scene.center, offset: (-620, -330)

bracket_tr: Path, commands: {move_to(-46, 0), line_to(0, 0), line_to(0, 46)}, stroke_width: 3, fill_opacity: 0, stroke_gradient: linear(45, {hex_color("ff8666"), hex_color("f5b942")}), anchor: scene.center, offset: (620, -330)

bracket_bl: Path, commands: {move_to(0, -46), line_to(0, 0), line_to(46, 0)}, stroke_width: 3, fill_opacity: 0, stroke_gradient: linear(225, {hex_color("f5b942"), hex_color("ff8666")}), anchor: scene.center, offset: (-620, 330)

bracket_br: Path, commands: {move_to(0, -46), line_to(0, 0), line_to(-46, 0)}, stroke_width: 3, fill_opacity: 0, stroke_gradient: linear(315, {hex_color("ff8666"), hex_color("f5b942")}), anchor: scene.center, offset: (620, 330)

// ── the layout grid: flashes in, then recedes behind the type ───────
grid: NumberPlane, x_domain: (-8, 8), y_domain: (-4.5, 4.5), x_range: (-8, 8, 1), y_range: (-4.5, 4.5, 1), size: (1440, 780), stroke: stroke.default, opacity: 0.15, anchor: scene.center

// ── the wordmark block (center-relative offsets; y down is +) ───────
wordmark: Text, text: "Animatix", font_size: 168, color: text.primary, anchor: scene.center, offset: (0, -118)

// The rule draws in as a warm→coral ramp; a wide low-alpha copy of the same
// geometry, screen-blended, is its bloom. Both are trimmed by their own
// `draw-in`, so the light arrives with the stroke instead of ahead of it.
underline: Path, commands: {move_to(-230, 0), line_to(230, 0)}, stroke_width: 6, fill_opacity: 0, stroke_gradient: linear(90, {hex_color("f5b942"), hex_color("ff8666")}), anchor: scene.center, offset: (0, -22)

underline_bloom: Path, commands: {move_to(-230, 0), line_to(230, 0)}, stroke_width: 20, fill_opacity: 0, stroke_gradient: linear(90, {hex_color("f5b94242"), hex_color("ff866642")}), blend: "screen", anchor: scene.center, offset: (0, -22)

carriage: Rect, size: (12, 26), corner_radius: 3, at: (570, 428), fill_gradient: linear(0, {hex_color("ffd60a"), hex_color("ff8666")})

tagline: Text, text: "a declarative animation language", font_size: 38, color: text.secondary, anchor: scene.center, offset: (0, 38)

// ── the trio: three primitives that trade shapes and colors ─────────
// Declared off-stage (so the entrance is a flight, not a fade in place);
// no authored opacity, each is revealed by its own entrance beat.
//
// The trio deliberately keeps FLAT `color:` fills: the #6.2s beat is a colour
// trade, and a `fill_gradient` overrides the solid fill, so ramping these
// three would silently kill the beat that teaches morphing. The light under
// them does that job instead.
sq: Rect, size: (76, 76), corner_radius: 14, color: accent.primary, at: (-90, 990)

ci: Ellipse, size: (76, 76), color: accent.secondary, at: (1690, -90)

di: Polygon, points: {(0, -49), (49, 0), (0, 49), (-49, 0)}, color: accent.warning, at: (800, 1010)

// The bench they land on: a warm pool that drifts on seeded noise. Its `at`
// is noise-driven and never keyframed, so the two owners cannot fight.
trio_glow: Ellipse, size: (480, 480), at: (800, 640), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b9421f")), (55%, hex_color("ff86660d")), (100%, hex_color("ff866600"))}), blend: "screen"

// ── the closing ball ────────────────────────────────────────────────
// A lit sphere, not a disc: the radial ramp puts the highlight up-left and
// the terminator down-right, which is what sells the hop as physical.
ball: Ellipse, size: (30, 30), at: (240, 726), fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("ffb3b3")), (45%, hex_color("ff5c5c")), (100%, hex_color("b3123a"))})

// The footer rail: a live edge for the lower third and the ground the ball
// hops on. Marching ants start when the ball does.
rail: Path, commands: {move_to(240, 748), line_to(1360, 748)}, stroke: accent.info, stroke_width: 2, fill_opacity: 0, dash_pattern: {10, 7}

// ── the instrument sweep ────────────────────────────────────────────
// One hairline scanning the grid for the whole loop. A title sequence with
// dead seconds reads as a stalled render; this is the element that says the
// clock is running even when nothing else moves. The ramp fades both ends to
// transparent so it enters and leaves the plate without a hard edge.
sweep: Rect, size: (3, 780), at: (80, 450), opacity: 0, fill_gradient: linear(0, {hex_color("f5b94200"), hex_color("f5b942"), hex_color("f5b94200")}), blend: "screen"

// ── timeline ────────────────────────────────────────────────────────
// The room is lit at frame 0: washes and grid carry authored opacity, so the
// plate opens on a lit stage rather than on black (house-style §1).
#0.1s
  stagger [0.09s] {
      draw_in(target: bracket_tl, duration: 0.45s, ease: expo_out)
      draw_in(target: bracket_tr, duration: 0.45s, ease: expo_out)
      draw_in(target: bracket_bl, duration: 0.45s, ease: expo_out)
      draw_in(target: bracket_br, duration: 0.45s, ease: expo_out)
    }

// The sweep crosses the plate exactly once per loop, so the scan and the
// sequence share one clock.
#0.6s
  sweep.opacity = 0.14 [0.9s, ease: expo_out]
  always {
      sweep.at = (80 + 1440 * (t / 13), 450)
      // Loop-phase drift for the light layer: period 13s, so the wash sits in the
      // same place at t=0 and t=13. The second sine is the second harmonic — an
      // integer multiple keeps the wrap exact.
      let u = (t / 13) * 6.283185307179586
      wash_key.at = ((800 + 44 * sin(u)) + 16 * sin(2 * u), 300 + 26 * cos(u))
      wash_fill.at = (280 - 34 * cos(u), 770 + 22 * sin(u))
      // The bench glow wanders on fractal noise instead of a sine — it is faded
      // out across the wrap, so a non-looping path is free here and the organic
      // drift is what keeps the 4s–6s hold from sitting still.
      trio_glow.at = (800 + fbm(t * 0.35, 4) * 90, 640 + seeded_fbm(7, t * 0.3, 3) * 34)
    }

// The grid flashes to full, then recedes to a texture as the type arrives;
// the wordmark settles the last few pixels. Display type never overshoots —
// a 168px wordmark on a back-ease reads as jelly, not as motion design — but
// it does wind up: a 70ms counter-move before the drop is what makes the
// settle read as weight rather than as a fade with a translate.
#0.9s
  grid.opacity = 0.15 [1s, ease: ease_out]

#1s
  fade_in(target: wordmark, duration: 0.55s, ease: expo_out)

#1.1s
  shift(target: wordmark, by: (0, 24), duration: 0.75s, ease: expo_out, anticipate: 0.07s)

#1.7s
  draw_in(target: underline, duration: 0.75s, ease: expo_out)
  draw_in(target: underline_bloom, duration: 0.75s, ease: expo_out)
  fade_in(target: carriage, duration: 0.18s, ease: expo_out)
  // The carriage rides the draw tip: same start, span and ease as the draw.
  // The ease here must move in lockstep with the `draw-in` above or the tip
  // and the carriage separate mid-stroke.
  carriage.at = (1030, 428) [0.75s, ease: expo_out]

#2.6s
  fade_out(target: carriage, duration: 0.3s, ease: ease_in)
  fade_out(target: underline_bloom, duration: 0.4s, ease: ease_in)

// settle-in: fade plus a slight scale, arriving on expo-out. Small type can
// take the scale that the 168px wordmark cannot.
#2.8s
  settle_in(target: tagline, duration: 0.65s, ease: expo_out)

// The trio flies in — each from a different edge — and lands on a spring, so
// the three props arrive with weight instead of sliding to a halt. The
// stagger is tight (60ms) so all three are airborne together and the beat
// reads as a trio, not a sequence of solo dots. `pop-in` gives each an
// overshoot on arrival, which is what the flat fade-in lacked.
#3.9s
  fade_in(target: trio_glow, duration: 0.9s, ease: expo_out)
  fade_in(target: rail, duration: 0.4s, ease: expo_out)
  rail.dash_offset = 0
  stagger [0.06s] {
      pop_in(target: sq, duration: 0.7s, ease: expo_out)
      sq.at = (704, 610) [0.7s, ease: spring(6, 9)]
      pop_in(target: ci, duration: 0.7s, ease: expo_out)
      ci.at = (800, 610) [0.7s, ease: spring(6, 9)]
      pop_in(target: di, duration: 0.7s, ease: expo_out)
      di.at = (896, 610) [0.7s, ease: spring(6, 9)]
    }

// The trade: square morphs round, the diamond squares up and takes the
// amber, the circle squashes and recovers. One beat, three personalities.
#6.2s
  sq: Ellipse, size: (76, 76), color: accent.success [0.9s, strategy: match]
  rotate(target: di, by: deg(45), duration: 0.9s, ease: ease_in_out)
  di: Polygon, points: {(0, -49), (49, 0), (0, 49), (-49, 0)}, color: accent.primary [0.9s, strategy: auto]
  ci.size = (96, 42) [0.45s, ease: ease_in_out]

#6.7s
  ci.size = (76, 76) [0.5s, ease: spring
    // The red ball hops across the footer under real gravity. `ease: bounce_in` on a

    // straight traverse is not a bounce — it is the curve wobbling past its

    // target, so the ball jerks sideways and stops. The `bounce` ACTION is the

    // physics: it writes the additive `motion_offset` channel, so a linear carry

    // and a decaying hop run at the same time without fighting each other. The

    // rail's ants march one dash period (17px) per 130px of ball travel, so the

    // ground reads as moving under it.
    (6, 9)]

#7.8s
  pop_in(target: ball, duration: 0.42s, ease: expo_out)

#8.3s
  ball.at = (1360, 726) [2.3s, ease: linear]
  bounce(target: ball, duration: 2.3s, intensity: 190, restitution: 0.6)
  rail.dash_offset = 340 [2.3s, ease: linear]

// ── payoff & rest ───────────────────────────────────────────────────
// House-style §2: the loop rests on the FULLEST composition, so there is no
// outro that empties the plate — the old reverse-order fade-out (which left
// the rest frame black and bought this scene its rest-check exemption) is
// gone. The payoff is a breath instead of an exit: the grid lifts, the
// underline's bloom re-lights, and the camera pushes a touch and settles
// back, so the assembled title card holds into the rest frame.
#10.3s
  grid.opacity = 0.3 [1.2s, ease: ease_in_out]
  fade_in(target: underline_bloom, duration: 0.9s, ease: expo_out)
  camera.zoom = 1.05 [1.4s, ease: ease_in_out]

#11.9s
  grid.opacity = 0.22 [1.1s, ease: ease_in_out]
  camera.zoom = 1 [1.1s, ease: ease_in_out]
