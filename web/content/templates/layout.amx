// Shared layout and components. Import this file into an existing scene to reuse them.
pub fn unit() -> Num { min(scene_width, scene_height) / 720 }
pub fn content_width() -> Num { scene_width - 2 * theme.margin }
pub fn stacked() -> Bool { scene_width < 1.25 * scene_height }

pub fn tall() -> Bool { scene_height > 1.25 * scene_width }
pub fn figure_top() -> Num { theme.margin + (if tall() { 207 } else { 184 }) * unit() }
pub fn takeaway_y() -> Num {
  scene_height - theme.margin - (if tall() { 65 } else { 35 }) * unit()
}
pub fn figure_gap() -> Num { theme.gap }
pub fn notes_width() -> Num { min(content_width() * 0.36, 360 * unit()) }
pub fn notes_height() -> Num { (if tall() { 158 } else { 144 }) * unit() }
pub fn figure_width(with_notes: Bool) -> Num {
  if with_notes && !stacked() { content_width() - notes_width() - figure_gap() } else { content_width() }
}
pub fn figure_height(with_notes: Bool) -> Num {
  scene_height - figure_top() - theme.margin - (if tall() { 160 } else { 122 }) * unit()
    - (if stacked() && with_notes { notes_height() + figure_gap() } else { 0 })
}

// The backdrop owns the stage fill. Its gradient uses normalized coordinates.
pub component Backdrop(tint: Color = surface.secondary, center: Vec2 = (0.30, 0.30), strength: Num = 0.45,
  radius: Num = 0.9) {
  floor: Rect, size: (scene_width, scene_height), anchor: scene.center, opacity: 1, legend: false,
    fill_gradient: radial(center, radius, {lerp_color(scene.background, tint, clamp(strength, 0, 1)), scene.background})
}

// Place above the backdrop and behind the content. Animate the instance's at
// to follow an authored cue. Its default position and opacity stay constant.
pub component FocusWash(tint: Color = accent.primary, strength: Num = 0.08, reach: Vec2 = (0.74, 1.08)) {
  light: Ellipse, size: (scene_width * reach[0], scene_height * reach[1]),
    at: (scene_width / 2, scene_height / 2), opacity: clamp(strength, 0, 1), legend: false,
    fill_gradient: radial((0.5, 0.5), 0.48, {
      (0%, rgba(tint[0], tint[1], tint[2], tint[3])),
      (40%, rgba(tint[0], tint[1], tint[2], tint[3] * 0.55)),
      (78%, rgba(tint[0], tint[1], tint[2], tint[3] * 0.12)),
      (100%, rgba(tint[0], tint[1], tint[2], 0))
    })
}

pub component ChapterHeader(eyebrow: Str, heading: Str) {
  header: Group, at: (theme.margin, theme.margin) {
    category: Text, text: eyebrow, role: roles::eyebrow, text_anchor: "left", at: (0, 14 * unit())
    heading_ink: Text, text: heading, role: roles::title, text_anchor: "left",
      text_max_width: content_width(), fit_min_size: 32 * unit(), fit_max_lines: 2,
      fit_max_height: (if tall() { 144 } else { 132 }) * unit(),
      at: (0, (if tall() { 106 } else { 96 }) * unit())
  }
}

// Size is an ordinary layout property on the instance. The surface uses the
// measured content box plus padding, or the definite size supplied by a parent.
pub component Panel(size: Any = (auto, auto), face: Color = surface.primary, border: Color = stroke.default,
  border_width: Num = unit(), inset: Num = theme.inset, raised: Bool = false,
  align: Str = "center", gap: Num = theme.gap) {
  content: Col, size: size, padding: inset, align: align, gap: gap,
    backdrop: true, backdrop_color: face, backdrop_radius: theme.radius,
    backdrop_stroke: border, backdrop_stroke_width: border_width,
    shadow: if raised { (0, 6 * unit(), 16 * unit(), 0) } else { (0, 0, 0, 0) },
    shadow_color: (0, 0, 0, 0.24) {
    @slot
  }
}

pub component CaptionPlate(text: Str, level: Str = roles::body, width: Num = content_width()) {
  label: Text, text: text, role: level, text_align: "center",
    text_max_width: max(1, width - 2 * theme.inset), fit_min_size: 20 * unit(), fit_max_lines: 3, backdrop: true,
    backdrop_color: surface.primary, backdrop_radius: theme.radius,
    backdrop_padding: (theme.inset, theme.inset * 0.5)
}

pub component MetricCard(label: Str, value: Str, detail: Str, width: Num, height: Num,
  ink: Color = text.primary, raised: Bool = false) {
  card: Panel, size: (width, height), align: "start", gap: 8 * unit(), raised: raised,
    border: lerp_color(surface.primary, text.secondary, 0.3) {
    @content {
      card_label: Text, text: label, role: roles::note, text_max_width: max(1, width - 2 * theme.inset),
        fit_min_size: 16 * unit(), fit_max_lines: 1
      card_value: Text, text: value, role: roles::metric, color: ink, text_max_width: max(1, width - 2 * theme.inset),
        fit_min_size: 24 * unit(), fit_max_lines: 1
      card_detail: Text, text: detail, role: roles::note, text_max_width: max(1, width - 2 * theme.inset),
        fit_min_size: 16 * unit(), fit_max_lines: 2
    }
  }
}

pub component SceneCaption(text: Str, level: Str = roles::body, plate: Bool = false) {
  caption: Text, text: text, role: level, at: (scene_width / 2, takeaway_y()),
    text_max_width: content_width() - (if plate { 2 * theme.inset } else { 0 }), text_align: "center",
    fit_min_size: 20 * unit(), fit_max_lines: 2,
    backdrop: plate, backdrop_color: surface.primary, backdrop_radius: theme.radius,
    backdrop_padding: (theme.inset, theme.inset * 0.5)
}

pub component SequenceTile(value: Str, extent: Vec2, face: Color = surface.primary) {
  tile: Rect, size: extent, corner_radius: theme.radius, color: face,
    stroke: lerp_color(face, text.secondary, 0.48), stroke_width: 2 * unit()
  digit: Text, text: value, role: roles::metric, font_size: min(extent[0] * 0.46, extent[1] * 0.63)
}

pub component SignalLane(extent: Vec2, domain: Vec2, span: Vec2) {
  graph: Graph, size: extent, x_domain: domain, y_domain: span, padding: 0,
    stroke: text.muted, grid: false, ticks: false, tick_labels: "none" {
    @slot
  }
}

pub component SignalKey(label: Str, ink: Color) {
  key: Row, align: "center", gap: theme.gap * 0.45 {
    dot: Ellipse, size: (14 * unit(), 14 * unit()), color: ink
    name: Text, text: label, role: roles::body
  }
}

// Compatibility for earlier layout.amx projects. New scenes compose the
// components above directly or keep their own scene-specific layout.

pub component ExplainerLayout(eyebrow: Str, heading: Str, takeaway: Str, with_notes: Bool = true) {
  page: Group, at: (0, 0) {
    head: ChapterHeader, eyebrow: eyebrow, heading: heading
    figure_plate: Rect, size: (figure_width(with_notes), figure_height(with_notes)),
      color: surface.primary, stroke: stroke.default, stroke_width: unit(), corner_radius: theme.radius,
      at: (theme.margin + figure_width(with_notes) / 2, figure_top() + figure_height(with_notes) / 2)
    figure: Group, at: (theme.margin + figure_width(with_notes) / 2, figure_top() + figure_height(with_notes) / 2) {
      @slot
      figure_placeholder: Text, text: "Add a figure to this slot", role: roles::note
    }
    notes: Group, at: (
      if stacked() { scene_width / 2 } else { scene_width - theme.margin - notes_width() / 2 },
      if stacked() {
        figure_top() + figure_height(with_notes) + figure_gap() + notes_height() / 2
      } else {
        figure_top() + figure_height(with_notes) / 2
      }
    ) {
      @slot
    }
    conclusion: Text, text: takeaway, role: roles::body, text_anchor: "left",
      text_max_width: content_width(), at: (theme.margin, takeaway_y())
  }
}

pub component NarrationStep(label: Str, width: Num) {
  tile: Stack, size: (width, 68 * unit()) {
    plate: Rect, size: (width, 68 * unit()), color: surface.primary, corner_radius: theme.radius
    step_label: Text, text: label, role: roles::body
  }
}

// A lesson frame keeps the demonstration's timed actors at scene scope.
pub component TechniqueStage(topic: Str, heading: Str, takeaway: Str = "") {
  stage: Group, at: (0, 0) {
    floor: Backdrop, strength: 0.28
    head: ChapterHeader, eyebrow: topic, heading: heading
    for index in range(0, if takeaway != "" { 1 } else { 0 }) {
      footer: SceneCaption, text: takeaway
    }
  }
}

pub component MetricNumber(initial: Num = 0, places: Num = 0, ink: Color = text.primary) {
  amount: Counter, value: initial, decimals: places, role: roles::metric, color: ink
}

pub component ReadingField(label: Str, detail: Str, width: Num) {
  field: Col, size: (width, auto), gap: theme.gap * 0.3, align: "start" {
    name: Text, text: label, role: roles::eyebrow
    copy: Text, text: detail, role: roles::body, text_max_width: width
  }
}

pub component ReadingPanel(extent: Vec2, face: Color = surface.primary) {
  panel: Stack, size: extent, align: "center" {
    sheet: Rect, size: extent, color: face, corner_radius: theme.radius, stroke: stroke.default
    content: Group { @slot }
  }
}
