// A maintenance notice, split into three answers and revealed in reading order.
import "../templates/layout.amx"

config { style: "compact", colorscheme: "paper", resolution: (1280, 720), duration: 20 }

let impact = "The editor will be read-only"
let window = "Sunday, 02:00–02:20 UTC"
let available = "Reading and exports"
let panel_size = (520, 340)
let panel_gap = 44
let column_offset = (panel_size[0] + panel_gap) / 2
let inset = 40
let field_width = panel_size[0] - 2 * inset
let notice_face = surface.secondary
let clear_face = rgba(notice_face[0], notice_face[1], notice_face[2], 0)

component NoticeField(label: Str, detail: Str) {
  field: Col, size: (field_width, auto), gap: theme.gap * 0.3, align: "start" {
    name: Text, text: label, role: eyebrow
    copy: Text, text: detail, role: body, text_max_width: field_width
  }
}

#0s
  ground: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: linear(150, {surface.primary, scene.background})
  heading: Text, anchor: scene.top, offset: (0, 101), text: "Scheduled maintenance",
    role: title
  original: Panel, size: panel_size, anchor: scene.center {
    @content {
      copy: Text, text: format("{} on {}. {} stay available.", impact, window, available),
        role: body, text_max_width: 428, line_height: 1.35
    }
  }
  notice: Panel, size: panel_size, anchor: scene.center, offset: (column_offset, 0),
    align: "start", inset: inset, face: clear_face, border_width: 0 {
    @content {
      for entry, i in {{"What changes", impact}, {"When", window}, {"Still available", available}} {
        field[i]: NoticeField, label: entry[0], detail: entry[1], opacity: 0
      }
    }
  }

#4s
  original.offset = (0 - column_offset, 0) [650ms, ease: ease_in_out]

#4.4s
  notice.backdrop_color = notice_face [500ms]
  fade_in(target: notice.field[0], duration: 500ms)

#8s
  fade_in(target: notice.field[1], duration: 500ms)

#12s
  fade_in(target: notice.field[2], duration: 500ms)
