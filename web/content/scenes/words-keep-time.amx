// A maintenance notice, split into three answers and revealed in reading order.
import "../templates/layout.amx"

config { style: "compact", colorscheme: "paper", resolution: (1280, 720), duration: 20 }

let impact = "The editor will be read-only"
let window = "Sunday, 02:00–02:20 UTC"
let available = "Reading and exports"
let panel_size = (520, 340)
let column_offset = panel_size[0] / 2 + 22

#0s
  ground: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: linear(150, {surface.primary, scene.background})
  heading: Text, anchor: scene.top, offset: (0, 101), text: "Scheduled maintenance",
    role: title
  original: ReadingPanel, extent: panel_size, anchor: scene.center {
    @content {
      copy: Text, text: format("{} on {}. {} stay available.", impact, window, available),
        role: body, text_max_width: 428, line_height: 1.35
    }
  }
  notice: Stack, anchor: scene.center, offset: (column_offset, 0), align: "center" {
    sheet: Rect, size: panel_size, corner_radius: theme.radius, color: surface.secondary, opacity: 0
    entries: Col, align: "start", gap: theme.gap {
      changed: ReadingField, width: 440, label: "What changes", detail: impact, opacity: 0
      time: ReadingField, width: 440, label: "When", detail: window, opacity: 0
      usable: ReadingField, width: 440, label: "Still available", detail: available, opacity: 0
    }
  }

#4s
  original.offset = (0 - column_offset, 0) [650ms, ease: ease_in_out]
  fade_in(targets: {notice.sheet, notice.entries.changed}, duration: 500ms, delay: 400ms)

#8s
  fade_in(target: notice.entries.time, duration: 500ms)

#12s
  fade_in(target: notice.entries.usable, duration: 500ms)
