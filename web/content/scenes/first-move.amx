// First lesson: declare a shape, then animate one property at a # time marker.
config { style: "compact", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 3 }

#0s
  track: Line, from: (360, 360), to: (920, 360), stroke: text.muted, stroke_width: 2
  dot: Ellipse, at: (360, 360), size: (88, 88), color: accent.primary

#0.5s
  dot.at = (920, 360) [1.5s, ease: ease_in_out]

#3s
