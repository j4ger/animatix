// First lesson: declare a shape, then animate one property at a # time marker.
config { style: "compact", colorscheme: "editorial-dark", canvas_size: (1280, 720), duration: 3 }

let track_half = (280, 0)
let center = (scene_width / 2, scene_height / 2)
let start = center - track_half
let end = center + track_half

#0s
  track: Line, from: start, to: end, stroke: text.muted, stroke_width: 2
  dot: Ellipse, at: start, size: (88, 88), color: accent.primary

#0.5s
  dot.at = end [1.5s, ease: ease_in_out]

#3s
