// Insert 3 into the sorted row [2, 4, 5].
config { colorscheme: "paper", resolution: (960, 540), duration: 12.5 }

let card_size = (172, 116)
let spacing = 220
let row_y = 350
let compare_y = row_y - card_size[1] - 40
let slot = (index, y) => (480 + (index - 1.5) * spacing, y)

pub component Card(value: Str, face: Color = surface.primary) {
  front: Rect, size: card_size, corner_radius: 12, color: face, stroke: stroke.default, stroke_width: 2
  digit: Text, text: value, font_size: 74
}

#0s
  paper: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.25, 0.22), 0.9, {surface.primary, scene.background})
  caption: Text, anchor: scene.top, offset: (0, 91), text: "Where does 3 fit?", font_size: 36
  for i in range(0, 4) {
    let center = slot(i, row_y + card_size[1] / 2 + 18)
    let half = card_size[0] / 2 - 6
    marker[i]: Line, from: center - (half, 0), to: center + (half, 0),
      stroke: text.muted, stroke_width: 2, opacity: 0.65
  }
  two: Card, value: "2", at: slot(0, row_y)
  four: Card, value: "4", at: slot(1, row_y)
  five: Card, value: "5", at: slot(2, row_y)
  key: Card, value: "3", at: slot(3, compare_y + 28), face: lerp_color_oklab(surface.primary, accent.success, 0.24)

#0.7s
  key.at = slot(3, compare_y) [1s, ease: ease_out]

#2.2s
  caption.text = "Compare 3 with 5."
  key.at = slot(2, compare_y) [1.1s, ease: ease_in_out]

#3.7s
  caption.text = "5 is larger. Move it right."
  five.at = slot(3, row_y) [1.25s, ease: ease_in_out]

#5.4s
  caption.text = "Now compare 3 with 4."
  key.at = slot(1, compare_y) [1.1s, ease: ease_in_out]

#6.95s
  caption.text = "4 is larger too. Move it right."
  four.at = slot(2, row_y) [1.25s, ease: ease_in_out]

#8.7s
  caption.text = "3 is larger than 2. Fill the gap."
  key.at = slot(1, row_y) [1.5s, ease: ease_in_out]

#10.65s
  caption.text = "The row is sorted."
