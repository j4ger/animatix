// Add the two displacements at each x. Every lane uses the same y scale.
config { colorscheme: "neon-night", resolution: (1280, 720), duration: 28 }

let phase_degrees = 0
let initial = deg_to_rad(phase_degrees)
let phase = initial
let advance = (time, start, end) => pi * ease_in_out(linear_progress(time, start, end))
let domain = 4 * pi
let plot_size = (710, 168)
let y_unit = 40
let plot_left = 130
let lane_x = plot_left + plot_size[0] / 2
let lane_gap = 174
let center_y = 360
let lane_a = center_y - lane_gap
let lane_sum = center_y + lane_gap
let sample = pi / 2
let sample_x = lane_x + plot_size[0] * (sample / domain - 0.5)

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: linear(115, {scene.background, surface.secondary})
  waves: Col, at: (lane_x, center_y), gap: lane_gap - plot_size[1] {
    input_a: Graph, size: plot_size, x_domain: (0, domain), y_domain: (-2.1, 2.1),
      stroke: text.muted, grid: false, ticks: false, tick_labels: "none", opacity: 0 {
      wave_a: PlotCurve, func: (x) => sin(x), stroke_width: 5, stroke: accent.info
    }
    input_b: Graph, size: plot_size, x_domain: (0, domain), y_domain: (-2.1, 2.1),
      stroke: text.muted, grid: false, ticks: false, tick_labels: "none", opacity: 0 {
      wave_b: PlotCurve, func: (x) => sin(x + phase), stroke_width: 5, stroke: accent.secondary
    }
    sum: Graph, size: plot_size, x_domain: (0, domain), y_domain: (-2.1, 2.1),
      stroke: text.muted, grid: false, ticks: false, tick_labels: "none", opacity: 0 {
      wave_sum: PlotCurve, func: (x) => sin(x) + sin(x + phase), stroke_width: 5, stroke: accent.success
    }
  }
  labels: Col, anchor: scene.left, offset: (68, -24), gap: lane_gap - 42 {
    first: Text, text: "A", font_size: 24, line_height: 1.75, color: accent.info, opacity: 0
    second: Text, text: "B", font_size: 24, line_height: 1.75, color: accent.secondary, opacity: 0
    total: Text, text: "A + B", font_size: 24, line_height: 1.75, color: accent.success, opacity: 0
  }
  sample_guide: Line, from: (sample_x, lane_a - 80), to: (sample_x, lane_sum + 80),
    stroke: text.muted, dash_pattern: {5, 7}, opacity: 0
  sum_axis: Line, from: (plot_left, lane_sum), to: (plot_left + plot_size[0], lane_sum),
    stroke: text.muted, opacity: 0
  point_a: Ellipse, at: (sample_x, lane_a - y_unit), size: (14, 14), color: accent.info, opacity: 0
  point_b: Ellipse, size: (14, 14), color: accent.secondary, opacity: 0
  point_sum: Ellipse, size: (14, 14), color: accent.success, opacity: 0
  addition: Text, at: (82%, 50%), text: "1 + 1 = 2", font_size: 30, opacity: 0
  readout: Col, at: (82%, 50%), align: "start", gap: 12, opacity: 0 {
    phase_value: Text, text: "Phase: 0°", font_size: 32
    amplitude_value: Text, text: "Amplitude: 2.00", font_size: 27, color: accent.success
  }

  always {
    phase = initial + advance(t, 12, 18) + advance(t, 21, 26)
    let height_b = sin(sample + phase)
    point_b.at = (sample_x, center_y - y_unit * height_b)
    point_sum.at = (sample_x, lane_sum - y_unit * (1 + height_b))
    addition.text = format("1 + ({:.1}) = {:.1}", height_b, 1 + height_b)
    phase_value.text = format("Phase: {:.0}°", rad_to_deg(phase))
    amplitude_value.text = format("Amplitude: {:.2}", 2 * abs(cos(phase / 2)))
  }

#0.2s
  fade_in(targets: {labels.first, waves.input_a}, duration: 0.6s)

#2.5s
  fade_in(targets: {labels.second, waves.input_b}, duration: 0.6s)

#5.5s
  fade_in(targets: {sample_guide, point_a, point_b, addition}, duration: 0.5s)

#6.5s
  fade_in(targets: {labels.total, point_sum, sum_axis}, duration: 0.5s)

#8.5s
  fade_in(target: waves.sum, duration: 1s)
  fade_out(target: sum_axis, duration: 1s)

#10.5s
  fade_out(targets: {sample_guide, point_a, point_b, point_sum, addition}, duration: 0.5s)

#11s
  fade_in(target: readout, duration: 0.5s)
