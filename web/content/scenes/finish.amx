config { style: "compact", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 5 }

#0s
  // A silent complete composition: explicit resolution, duration and held ending.
  plate: Rect, at: (640, 360), size: (440, 220), corner_radius: theme.radius, color: surface.primary
  mark: Ellipse, at: (640, 325), size: (54, 54), color: accent.primary, opacity: 0
  label: Text, text: "Made to move.", at: (640, 395), role: title, opacity: 0

#0.5s
  fade_in(target: mark, duration: 0.7s)

#1.2s
  fade_in(target: label, duration: 0.7s)

#2s
// Hold intact through 5 s; image export at 5 s remains a complete poster.
