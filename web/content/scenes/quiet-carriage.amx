// One low train tone plus the headphones' opposing pressure wave.
config { colorscheme: "editorial-dark", resolution: (960, 560), duration: 16 }

let speaker_level = 1
let phase = 0
let gain = 0
let wave = (x, angle) => sin(x - angle)
let plot_size = (864, 146)
let domain = (0, 15)
let pressure = (-1.2, 1.2)

pub component WaveLabel(label: Str, ink: Color) {
  tag: Row, align: "center", gap: 10 {
    dot: Ellipse, size: (13, 13), color: ink
    name: Text, text: label, font_size: 26
  }
}

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.76, 0.2), 0.9, {surface.secondary, scene.background})
  signals: Col, anchor: scene.center, offset: (0, -36), gap: 10, align: "start" {
    legend: Row, gap: 32, align: "center" {
      train: WaveLabel, label: "Train rumble", ink: accent.warning
      headphones: WaveLabel, label: "Headphones", ink: accent.info, opacity: 0
    }
    outside: Graph, size: plot_size, x_domain: domain, y_domain: pressure,
      stroke: text.muted, ticks: false, tick_labels: "none" {
      rumble: PlotCurve, func: (x) => wave(x, phase), stroke: accent.warning, stroke_width: 5
      opposing: PlotCurve, func: (x) => -gain * wave(x, phase), stroke: accent.info, stroke_width: 5, opacity: 0
    }
    result: WaveLabel, label: "At your ear", ink: accent.success
    inside: Graph, size: plot_size, x_domain: domain, y_domain: pressure,
      stroke: text.muted, ticks: false, tick_labels: "none" {
      heard: PlotCurve, func: (x) => (1 - gain) * wave(x, phase), stroke: accent.success, stroke_width: 5
    }
  }
  caption: Text, anchor: scene.bottom, offset: (0, -46),
    text: "A low rumble reaches your ear.", font_size: 30

  always {
    phase = 0.85 * t
    gain = speaker_level * smoothstep(4, 12, t)
  }

#4s
  caption.text = "The speaker pushes when the rumble pulls."
  fade_in(targets: {signals.outside.opposing, signals.legend.headphones}, duration: 500ms)

#10s
  caption.text = "The two pressures add at your ear."

#12s
  caption.text = if speaker_level == 1 { "Equal and opposite, this tone cancels." } else { "A mismatch leaves some rumble." }
