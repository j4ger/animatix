// One low train tone plus the headphones' opposing pressure wave.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", resolution: (960, 560), duration: 16 }

let speaker_level = 1
let phase = 0
let gain = 0
let wave = (x, angle) => sin(x - angle)
let plot_size = (864, 146)
let domain = (0, 15)
let pressure = (-1.2, 1.2)

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.76, 0.2), 0.9, {surface.secondary, scene.background})
  signals: Col, anchor: scene.center, offset: (0, -36), gap: 10, align: "start" {
    legend: Row, gap: 32, align: "center" {
      train: SignalKey, label: "Train rumble", ink: accent.warning
      headphones: SignalKey, label: "Headphones", ink: accent.info, opacity: 0
    }
    outside: SignalLane, extent: plot_size, domain: domain, span: pressure {
      @graph {
        rumble: PlotCurve, func: (x) => wave(x, phase), stroke: accent.warning, role: focus
        opposing: PlotCurve, func: (x) => -gain * wave(x, phase), stroke: accent.info, role: focus, opacity: 0
      }
    }
    result: SignalKey, label: "At your ear", ink: accent.success
    inside: SignalLane, extent: plot_size, domain: domain, span: pressure {
      @graph {
        heard: PlotCurve, func: (x) => (1 - gain) * wave(x, phase), stroke: accent.success, role: focus
      }
    }
  }
  caption: SceneCaption, text: "A low rumble reaches your ear."

  always {
    phase = 0.85 * t
    gain = speaker_level * smoothstep(4, 12, t)
  }

#4s
  caption.text = "The speaker pushes when the rumble pulls."
  fade_in(targets: {signals.outside.opposing, signals.legend.headphones}, duration: 500ms)

#10s
  caption.text = "The two pressures add at your ear."

#12s
  caption.text = if speaker_level == 1 { "Equal and opposite, this tone cancels." } else { "A mismatch leaves some rumble." }
