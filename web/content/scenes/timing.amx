config { style: "compact", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6 }

#0s
  // Three absolute # markers: no hidden cumulative timing.
  left: Rect, at: (460, 360), size: (100, 100), corner_radius: theme.radius, color: accent.primary, opacity: 0.2
  middle: Rect, at: (640, 360), size: (100, 100), corner_radius: theme.radius, color: accent.info, opacity: 0.2
  right: Rect, at: (820, 360), size: (100, 100), corner_radius: theme.radius, color: accent.warning, opacity: 0.2

#1s
  left.opacity = 1[0.5s]

#2s
  middle.opacity = 1[0.5s]

#3s
  right.opacity = 1[0.5s]

#4s
  left.rotation = 0.12[0.5s]
  middle.rotation = 0.12[0.5s]
  right.rotation = 0.12[0.5s]
