config { style: "compact", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6 }

let inks = {accent.primary, accent.info, accent.warning}
let tile_size = 100

#0s
  // Three absolute # markers: no hidden cumulative timing.
  strip: Row, anchor: scene.center, gap: 80, align: "center" {
    for ink, i in inks {
      tile[i]: Rect, size: (tile_size, tile_size), corner_radius: theme.radius,
        color: ink, opacity: 0.2
    }
  }

#1s
  strip.tile[0].opacity = 1 [500ms]

#2s
  strip.tile[1].opacity = 1 [500ms]

#3s
  strip.tile[2].opacity = 1 [500ms]

#4s
  for i in range(0, inks.length) {
    strip.tile[i].rotation = 0.12 [500ms]
  }
