config { style: "compact", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 5 }

let columns = 6
let rows = 2
let tiles = range(0, columns * rows)

#0s
  // One declaration creates twelve distinct actors. Grid owns their slots.
  field: Grid, opacity: 1, cols: columns, gap: theme.gap, anchor: scene.center {
    for mix, i in linspace(0, 1, tiles.length) {
      tile[i]: Rect, opacity: 1, size: (72, 72), corner_radius: theme.radius,
        color: lerp_color_oklab(accent.primary, accent.info, mix)
    }
  }
  always {
    for i in tiles {
      let reveal = linear_progress(t - i * 0.16, 0.5, 0.9)
      tile[i].scale = lerp(0.65, 1, reveal)
      tile[i].opacity = lerp(0.25, 1, reveal)
    }
  }
