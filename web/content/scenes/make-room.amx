// Sort [4, 2a, 5, 2b, 3]. The letters show the relative order of equal values.
import "../templates/layout.amx"

config { style: "compact", colorscheme: "default-light", canvas_size: (1280, 720), duration: 24 }

let keys = {"4", "2a", "5", "2b", "3"}
let width = 110
let spacing = 152
let row_y = 396
let lifted_y = row_y - 135
let underline_y = row_y + width / 2 + 18
let slot = (index, y) => (180 + index * spacing, y)
let neutral = surface.primary
let active = accent.warning

fn place(card: Actor, index: Num, y: Num) {
  return #{ card.at = slot(index, y) [400ms, ease: ease_in_out] }
}

fn compare_card(face: Actor, count: Actor, step: Num) {
  return #{
    count.value = step [200ms, ease: ease_in_out]
    face.color = surface.secondary [200ms]
  }
}

fn shift_card(card: Actor, face: Actor, index: Num, count: Actor, step: Num) {
  return #{
    card.at = slot(index, row_y) [400ms, ease: ease_in_out]
    face.color = neutral [400ms]
    count.value = step [400ms, ease: ease_in_out]
  }
}

fn grow_prefix(line: Actor, count: Num) {
  return #{
    line.at = slot((count - 1) / 2, underline_y) [400ms]
    line.size = (width + (count - 1) * spacing, 5) [400ms]
  }
}

#0s
  backdrop: Backdrop, tint: surface.primary, center: (0.30, 0.32), strength: 1
  caption: SceneCaption, at: (scene_width / 2, 103), text: "Start with one sorted item. Insert the next."
  prefix: Rect, at: slot(0, underline_y), size: (width, 5), color: accent.success
  stats: Col, at: (83%, 54%), gap: theme.gap * 0.65, align: "start" {
    comparison_label: Text, text: "Comparisons", role: note
    comparisons: Counter, role: metric
    shift_label: Text, text: "Rightward shifts", role: note
    shifts: Counter, role: metric
  }
  for key, i in keys {
    cards[i]: SequenceTile, extent: (width, width), value: key, at: slot(i, row_y)
  }

#3s
  caption.text = "Lift 2a. Compare it with the sorted prefix."
  place(cards[1], 1, lifted_y)
  cards[1].tile.color = active [0.3s]

#3.8s
  compare_card(cards[0].tile, stats.comparisons, 1)

#4.15s
  caption.text = "4 is larger. Shift it right."
  shift_card(cards[0], cards[0].tile, 1, stats.shifts, 1)

#4.85s
  place(cards[1], 0, lifted_y)

#5.25s
  caption.text = "Insert 2a. The sorted prefix grows."
  place(cards[1], 0, row_y)
  cards[1].tile.color = neutral [0.4s]
  grow_prefix(prefix, 2)

#6.45s
  caption.text = "Lift 5. Compare it with the sorted prefix."
  place(cards[2], 2, lifted_y)
  cards[2].tile.color = active [0.3s]

#7.25s
  caption.text = "4 is smaller. The key belongs after it."
  compare_card(cards[0].tile, stats.comparisons, 2)

#7.9s
  cards[0].tile.color = neutral [200ms]

#8.3s
  caption.text = "Insert 5. The sorted prefix grows."
  place(cards[2], 2, row_y)
  cards[2].tile.color = neutral [0.4s]
  grow_prefix(prefix, 3)

#9.5s
  caption.text = "Lift 2b. Compare it with the sorted prefix."
  place(cards[3], 3, lifted_y)
  cards[3].tile.color = active [0.3s]

#10.3s
  compare_card(cards[2].tile, stats.comparisons, 3)

#10.65s
  caption.text = "5 is larger. Shift it right."
  shift_card(cards[2], cards[2].tile, 3, stats.shifts, 2)

#11.35s
  compare_card(cards[0].tile, stats.comparisons, 4)

#11.7s
  caption.text = "4 is larger. Shift it right."
  shift_card(cards[0], cards[0].tile, 2, stats.shifts, 3)

#12.4s
  caption.text = "Equal keys stay in their original order."
  compare_card(cards[1].tile, stats.comparisons, 5)

#13.05s
  cards[1].tile.color = neutral [0.2s]
  place(cards[3], 1, lifted_y)

#13.45s
  caption.text = "Insert 2b. The sorted prefix grows."
  place(cards[3], 1, row_y)
  cards[3].tile.color = neutral [0.4s]
  grow_prefix(prefix, 4)

#14.65s
  caption.text = "Lift 3. Compare it with the sorted prefix."
  place(cards[4], 4, lifted_y)
  cards[4].tile.color = active [0.3s]

#15.45s
  compare_card(cards[2].tile, stats.comparisons, 6)

#15.8s
  caption.text = "5 is larger. Shift it right."
  shift_card(cards[2], cards[2].tile, 4, stats.shifts, 4)

#16.5s
  compare_card(cards[0].tile, stats.comparisons, 7)

#16.85s
  caption.text = "4 is larger. Shift it right."
  shift_card(cards[0], cards[0].tile, 3, stats.shifts, 5)

#17.55s
  caption.text = "2b is smaller. The key belongs after it."
  compare_card(cards[3].tile, stats.comparisons, 8)

#18.2s
  cards[3].tile.color = neutral [0.2s]
  place(cards[4], 2, lifted_y)

#18.6s
  caption.text = "Insert 3. The sorted prefix grows."
  place(cards[4], 2, row_y)
  cards[4].tile.color = neutral [0.4s]
  grow_prefix(prefix, 5)

#19.8s
  caption.text = "Sorted. The two equal keys still read 2a, then 2b."
  cards[1].tile.color = accent.success [0.5s]
  cards[3].tile.color = accent.success [0.5s]
