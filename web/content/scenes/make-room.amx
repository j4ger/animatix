// Sort [4, 2a, 5, 2b, 3]. The letters show the relative order of equal values.
config { colorscheme: "default-light", resolution: (1280, 720), duration: 24 }

let width = 110
let spacing = 152
let row_y = 396
let lifted_y = row_y - 135
let underline_y = row_y + width / 2 + 18
let slot = (index, y) => (180 + index * spacing, y)
let neutral = surface.primary
let comparing = surface.secondary
let active = accent.warning

pub component NumberCard(value: Str) {
  tile: Rect, size: (width, width), corner_radius: 14, color: neutral
  digit: Text, text: value, font_size: 40, font_weight: "bold"
}

fn place(card: Actor, index: Num, y: Num) {
  return #{ card.at = slot(index, y) [400ms, ease: ease_in_out] }
}

fn grow_prefix(line: Actor, count: Num) {
  return #{
    line.at = slot((count - 1) / 2, underline_y) [400ms]
    line.size = (width + (count - 1) * spacing, 5) [400ms]
  }
}

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.30, 0.32), 0.9, {surface.primary, scene.background})
  caption: Text, anchor: scene.top, offset: (0, 103),
    text: "Start with one sorted item. Insert the next.", font_size: 32
  prefix: Rect, at: slot(0, underline_y), size: (width, 5), color: accent.success
  stats: Col, at: (83%, 54%), gap: 12 {
    compare_label: Text, text: "Comparisons", font_size: 22, color: text.secondary
    comparisons: Counter, value: 0, font_size: 50
    shift_label: Text, text: "Rightward shifts", font_size: 22, color: text.secondary
    shifts: Counter, value: 0, font_size: 50
  }
  four: NumberCard, value: "4", at: slot(0, row_y)
  two_a: NumberCard, value: "2a", at: slot(1, row_y)
  five: NumberCard, value: "5", at: slot(2, row_y)
  two_b: NumberCard, value: "2b", at: slot(3, row_y)
  three: NumberCard, value: "3", at: slot(4, row_y)

#3s
  caption.text = "Lift 2a. Compare it with the sorted prefix."
  place(two_a, 1, lifted_y)
  two_a.tile.color = active [0.3s]

#3.8s
  stats.comparisons.value = 1 [200ms, ease: ease_in_out]
  four.tile.color = comparing [0.2s]

#4.15s
  caption.text = "4 is larger. Shift it right."
  place(four, 1, row_y)
  four.tile.color = neutral [0.4s]
  stats.shifts.value = 1 [400ms, ease: ease_in_out]

#4.85s
  place(two_a, 0, lifted_y)

#5.25s
  caption.text = "Insert 2a. The sorted prefix grows."
  place(two_a, 0, row_y)
  two_a.tile.color = neutral [0.4s]
  grow_prefix(prefix, 2)

#6.45s
  caption.text = "Lift 5. Compare it with the sorted prefix."
  place(five, 2, lifted_y)
  five.tile.color = active [0.3s]

#7.25s
  caption.text = "4 is smaller. The key belongs after it."
  stats.comparisons.value = 2 [200ms, ease: ease_in_out]
  four.tile.color = comparing [0.2s]

#7.9s
  four.tile.color = neutral [200ms]

#8.3s
  caption.text = "Insert 5. The sorted prefix grows."
  place(five, 2, row_y)
  five.tile.color = neutral [0.4s]
  grow_prefix(prefix, 3)

#9.5s
  caption.text = "Lift 2b. Compare it with the sorted prefix."
  place(two_b, 3, lifted_y)
  two_b.tile.color = active [0.3s]

#10.3s
  stats.comparisons.value = 3 [200ms, ease: ease_in_out]
  five.tile.color = comparing [0.2s]

#10.65s
  caption.text = "5 is larger. Shift it right."
  place(five, 3, row_y)
  five.tile.color = neutral [0.4s]
  stats.shifts.value = 2 [400ms, ease: ease_in_out]

#11.35s
  stats.comparisons.value = 4 [200ms, ease: ease_in_out]
  four.tile.color = comparing [0.2s]

#11.7s
  caption.text = "4 is larger. Shift it right."
  place(four, 2, row_y)
  four.tile.color = neutral [0.4s]
  stats.shifts.value = 3 [400ms, ease: ease_in_out]

#12.4s
  caption.text = "Equal keys stay in their original order."
  stats.comparisons.value = 5 [200ms, ease: ease_in_out]
  two_a.tile.color = comparing [0.2s]

#13.05s
  two_a.tile.color = neutral [0.2s]
  place(two_b, 1, lifted_y)

#13.45s
  caption.text = "Insert 2b. The sorted prefix grows."
  place(two_b, 1, row_y)
  two_b.tile.color = neutral [0.4s]
  grow_prefix(prefix, 4)

#14.65s
  caption.text = "Lift 3. Compare it with the sorted prefix."
  place(three, 4, lifted_y)
  three.tile.color = active [0.3s]

#15.45s
  stats.comparisons.value = 6 [200ms, ease: ease_in_out]
  five.tile.color = comparing [0.2s]

#15.8s
  caption.text = "5 is larger. Shift it right."
  place(five, 4, row_y)
  five.tile.color = neutral [0.4s]
  stats.shifts.value = 4 [400ms, ease: ease_in_out]

#16.5s
  stats.comparisons.value = 7 [200ms, ease: ease_in_out]
  four.tile.color = comparing [0.2s]

#16.85s
  caption.text = "4 is larger. Shift it right."
  place(four, 3, row_y)
  four.tile.color = neutral [0.4s]
  stats.shifts.value = 5 [400ms, ease: ease_in_out]

#17.55s
  caption.text = "2b is smaller. The key belongs after it."
  stats.comparisons.value = 8 [200ms, ease: ease_in_out]
  two_b.tile.color = comparing [0.2s]

#18.2s
  two_b.tile.color = neutral [0.2s]
  place(three, 2, lifted_y)

#18.6s
  caption.text = "Insert 3. The sorted prefix grows."
  place(three, 2, row_y)
  three.tile.color = neutral [0.4s]
  grow_prefix(prefix, 5)

#19.8s
  caption.text = "Sorted. The two equal keys still read 2a, then 2b."
  two_a.tile.color = accent.success [0.5s]
  two_b.tile.color = accent.success [0.5s]
