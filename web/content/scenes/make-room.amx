// Stable insertion sort of [4, 2a, 5, 2b, 3]. Letters track equal keys.
// The timeline below is an explicit event trace of the standard algorithm:
// compare a[j] > key; shift only when true; insert key into the empty slot.
// Counts: 8 key comparisons, 5 shifts. Key lifts/insertions are NOT shifts.
// This is an explanation of one input, not a benchmark or adjustable simulation.
config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 24 }

#0s
  background: Rect, at: (640, 360), size: (1280, 720), color: "#0D1520"
  kicker: Text, text: "INSERTION SORT / MAKE ROOM FOR ONE MORE", at: (640, 58), font_size: 16, color: "#90A4B8"
  title: Text, text: "A place for every number.", at: (640, 112), font_size: 42, font_weight: "bold", color: "#F3F5F7"
  caption: Text, text: "Start with one sorted item. Insert the next.", at: (640, 630), font_size: 24, color: "#ADBCCA"
  reference: Line, from: (115, 455), to: (885, 455), stroke: "#304658", stroke_width: 2
  prefix: Rect, at: (180, 458), size: (110, 5), color: "#65D9E8"
  legend: Text, text: "TEAL UNDERLINE = SORTED PREFIX", at: (500, 515), font_size: 16, color: "#65D9E8"
  identity_note: Text, text: "2a and 2b have equal values. Letters track their original order.", at: (500, 558), font_size: 17, color: "#90A4B8"
  separator: Line, from: (940, 235), to: (940, 550), stroke: "#304658", stroke_width: 1
  clabel: Text, text: "KEY COMPARISONS", at: (1080, 265), font_size: 16, color: "#90A4B8"
  comparisons: Text, text: "0", at: (1080, 315), font_size: 44, color: "#F3F5F7"
  slabel: Text, text: "RIGHTWARD SHIFTS", at: (1080, 405), font_size: 16, color: "#90A4B8"
  shifts: Text, text: "0", at: (1080, 455), font_size: 44, color: "#F4D47B"
  count_note: Text, text: "Key placement excluded", at: (1080, 507), font_size: 16, color: "#90A4B8"
  four: Rect, at: (180, 380), size: (110, 110), color: "#24394C", corner_radius: 14
  four_label: Text, text: "4", at: (180, 380), font_size: 40, font_weight: "bold", color: "#F3F5F7"
  two_a: Rect, at: (340, 380), size: (110, 110), color: "#24394C", corner_radius: 14
  two_a_label: Text, text: "2a", at: (340, 380), font_size: 40, font_weight: "bold", color: "#F3F5F7"
  five: Rect, at: (500, 380), size: (110, 110), color: "#24394C", corner_radius: 14
  five_label: Text, text: "5", at: (500, 380), font_size: 40, font_weight: "bold", color: "#F3F5F7"
  two_b: Rect, at: (660, 380), size: (110, 110), color: "#24394C", corner_radius: 14
  two_b_label: Text, text: "2b", at: (660, 380), font_size: 40, font_weight: "bold", color: "#F3F5F7"
  three: Rect, at: (820, 380), size: (110, 110), color: "#24394C", corner_radius: 14
  three_label: Text, text: "3", at: (820, 380), font_size: 40, font_weight: "bold", color: "#F3F5F7"

#3s
