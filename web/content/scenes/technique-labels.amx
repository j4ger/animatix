// Derive the object, leader and label from one position, not three animations.
config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 8 }

#0s
  background: Rect, at: (640, 360), size: (1280, 720), color: "#0D1520"
  heading: Text, text: "A label that belongs to its subject.", at: (640, 130), font_size: 38, color: "#F3F5F7"
  track: Line, from: (380, 420), to: (900, 420), stroke: "#344455", stroke_width: 2
  point: Ellipse, at: (380, 420), size: (56, 56), color: "#65D9E8"
  leader: Line, from: (380, 380), to: (380, 325), stroke: "#65D9E8", stroke_width: 2
  label: Text, text: "subject", at: (380, 290), font_size: 28, color: "#F3F5F7"
  caption: Text, text: "One position. Three related elements.", at: (640, 560), font_size: 26, color: "#ADBCCA"
  always {
      let progress = clamp((t - 1) / 4, 0, 1)
      let x = 380 + 520 * ease_in_out(progress)
      point.at = (x, 420)
      leader.from = (x, 380)
      leader.to = (x, 325)
      label.at = (x, 290)
    }
