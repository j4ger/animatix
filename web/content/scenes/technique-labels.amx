// Derive the object, leader and label from one position, not three animations.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 8 }

let start = (scene_width / 2, scene_height / 2) + (-260, 60)
let end = (scene_width / 2, scene_height / 2) + (260, 60)
let point_size = 56
let leader_start = point_size / 2 + 12

#0s
  floor: Backdrop, strength: 0.28
  head: ChapterHeader, eyebrow: "ANCHORING", heading: "A label that belongs to its subject."
  takeaway: SceneCaption, text: "One position. Three related elements."
  track: Line, from: start, to: end, stroke: text.muted, stroke_width: 2
  annotation: Group, at: start {
    point: Ellipse, at: (0, 0), size: (point_size, point_size), color: accent.primary
    leader: Line, from: (0, -leader_start), to: (0, -95), stroke: accent.primary, stroke_width: 2
    label: CaptionPlate, text: "subject", at: (0, -130), width: 250
  }
  always {
    annotation.at = lerp_vec2(start, end, ease_in_out(linear_progress(t, 1, 5)))
  }
