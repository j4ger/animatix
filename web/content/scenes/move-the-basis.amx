// Shear maps (x, y) to (x + k*y, y). The reference axes stay fixed.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 24 }

let basis_unit = 85
let project = (x, y, shear) => (basis_unit * (x + shear * y), 0 - basis_unit * y)

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.25, 0.28), 0.9, {surface.secondary, scene.background})
  plane: Group, at: (35%, 53%) {
    lattice: Group, opacity: 0 {
      for n, i in range(-2, 3) {
        vertical[i]: Line, from: project(n, -2, 0), to: project(n, 2, 0), opacity: 0.26
        horizontal[i]: Line, from: project(-2, n, 0), to: project(2, n, 0), opacity: 0.26
      }
    }
    x_axis: Line, from: project(-3.4, 0, 0), to: project(3.4, 0, 0), opacity: 0.55
    y_axis: Line, from: project(0, -2.6, 0), to: project(0, 2.6, 0), opacity: 0.55
    x_label: Text, at: project(3.6, 0, 0), text: "x", role: body
    y_label: Text, at: project(0, 2.85, 0), text: "y", role: body
    e1: Arrow, from: (0, 0), to: project(1, 0, 0), stroke: accent.primary, stroke_width: 4
    e2: Arrow, from: (0, 0), to: project(0, 1, 0), stroke: accent.warning, stroke_width: 4
    top_edge: Line, from: project(0, 1, 0), to: project(1, 1, 0), stroke: accent.primary, stroke_width: 3, opacity: 0
    right_edge: Line, from: project(1, 0, 0), to: project(1, 1, 0), stroke: accent.primary, stroke_width: 3, opacity: 0
    point: Ellipse, size: (14, 14), color: accent.danger, opacity: 0
  }
  readout: Col, at: (81%, 52%), align: "start", gap: theme.gap * 0.7 {
    equation: Text, text: "(x, y) → (x + ky, y)", role: body
    shear: Row, align: "center", gap: theme.gap * 0.35 {
      symbol: Text, text: "k =", role: body, color: text.secondary
      amount: MetricNumber, places: 2, ink: accent.warning
    }
    area: Text, text: "Area = 1", role: note, opacity: 0
  }
  caption: SceneCaption, text: "Two basis vectors describe the original space."

  always {
    let tip = e2.to
    let k = tip[0] / basis_unit
    lattice.transform = (1, 0, -k, 1, 0, 0)
    point.at = project(1, 1, k)
    top_edge.from = project(0, 1, k)
    top_edge.to = project(1, 1, k)
    right_edge.to = project(1, 1, k)
    amount.value = k
  }

#3s
  caption.text = "Slide the second basis vector sideways."
  plane.e2.to = project(0, 1, 1) [4s, ease: ease_in_out]

#8s
  caption.text = "Apply the same rule to the grid."
  fade_in(targets: {plane.lattice, plane.point}, duration: 0.6s)

#10s
  plane.e2.to = project(0, 1, -0.6) [4s, ease: ease_in_out]

#14s
  caption.text = "The unit square becomes a parallelogram."
  fade_in(targets: {plane.top_edge, plane.right_edge, readout.area}, duration: 0.6s)

#17s
  plane.e2.to = project(0, 1, 1) [4s, ease: ease_in_out]

#19s
  caption.text = "Area stays fixed. Lengths and angles change."
