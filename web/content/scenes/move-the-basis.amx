// A horizontal shear: (x, y) -> (x + k*y, y).
// Fixed grey axes are a reference. Teal/gold arrows and the lattice transform.
// Determinant is 1: area is preserved, but lengths and angles need not be.
// Every animated endpoint uses the same k; x and y use 70 px per unit.
config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 24 }

let k = 0
let unit = 70
let project = (x, y, shear) => (400 + unit * (x + shear * y), 410 - unit * y)
let motion = (time, start) => ease_in_out(clamp((time - start) / 4, 0, 1))

#0s
  // Blueprint corners sit outside the coordinate system.
  background: Rect, at: (640, 360), size: (1280, 720),
    fill_gradient: linear(128, {hex_color("123746"), hex_color("101c29")})
  for i in {0, 1, 2, 3} {
    let x = if i % 2 == 0 { 42 } else { 1238 }
    let y = if i < 2 { 42 } else { 678 }
    let dx = if i % 2 == 0 { 28 } else { -28 }
    let dy = if i < 2 { 28 } else { -28 }
    corner_x[i]: Line, from: (x, y), to: (x + dx, y), stroke: hex_color("447082"), stroke_width: 2
    corner_y[i]: Line, from: (x, y), to: (x, y + dy), stroke: hex_color("447082"), stroke_width: 2
  }
  kicker: Text, text: "LINEAR TRANSFORMS / ONE RULE FOR EVERY POINT", at: (640, 58), font_size: 16, color: hex_color("90a4b8")
  title: Text, text: "Move the basis. Move the world.", at: (640, 112), font_size: 40, font_weight: "bold", color: hex_color("f3f5f7")
  reference_x: Line, from: (100, 410), to: (720, 410), stroke: hex_color("526273"), stroke_width: 2
  reference_y: Line, from: (400, 200), to: (400, 600), stroke: hex_color("526273"), stroke_width: 2
  x_name: Text, text: "x", at: (737, 410), font_size: 20, color: hex_color("90a4b8")
  y_name: Text, text: "y", at: (400, 184), font_size: 20, color: hex_color("90a4b8")
  origin: Ellipse, at: (400, 410), size: (9, 9), color: hex_color("f3f5f7")
  lattice: Group, at: project(0, 0, 0), opacity: 0 {
    for n, i in {-2, -1, 0, 1, 2} {
      vertical[i]: Line, from: (n * unit, 2 * unit), to: (n * unit, -2 * unit),
        stroke: hex_color("304658"), stroke_width: 1
      horizontal[i]: Line, from: (-2 * unit, -n * unit), to: (2 * unit, -n * unit),
        stroke: hex_color("304658"), stroke_width: 1
    }
  }

  unit_top: Line, from: (400, 340), to: (470, 340), stroke: hex_color("65d9e8"), stroke_width: 3, opacity: 0
  unit_right: Line, from: (470, 410), to: (470, 340), stroke: hex_color("65d9e8"), stroke_width: 3, opacity: 0
  basis_x: Arrow, from: (400, 410), to: (470, 410), stroke: hex_color("65d9e8"), stroke_width: 4
  basis_y: Arrow, from: (400, 410), to: (400, 340), stroke: hex_color("f4d47b"), stroke_width: 4
  sample: Ellipse, at: (470, 340), size: (14, 14), color: hex_color("ff947d"), opacity: 0
  split: Line, from: (800, 220), to: (800, 590), stroke: hex_color("304658"), stroke_width: 1
  rule: Text, text: "x becomes x + k·y", at: (1020, 270), font_size: 27, font_weight: "bold", color: hex_color("f3f5f7")
  rule_y: Text, text: "y stays y", at: (1020, 310), font_size: 24, color: hex_color("adbcca")
  amount: Text, text: "k = 0.00", at: (1020, 380), font_size: 40, color: hex_color("f4d47b")
  base_x: Text, text: "e1 = (1, 0)", at: (1020, 455), font_size: 24, color: hex_color("65d9e8")
  base_y: Text, text: "e2 = (0.00, 1)", at: (1020, 495), font_size: 24, color: hex_color("f4d47b")
  area: Text, text: "AREA = 1", at: (1020, 565), font_size: 20, color: hex_color("65d9e8"), opacity: 0
  caption: Text, text: "Two basis vectors describe the original space.", at: (640, 650), font_size: 24, color: hex_color("adbcca")

  always {
    k = motion(t, 3) - 1.6 * motion(t, 10) + 1.6 * motion(t, 17)

    // Screen y grows downward, so the screen-space shear has the opposite sign.
    lattice.transform = (1, 0, -k, 1, 0, 0)
    basis_y.to = project(0, 1, k)
    sample.at = project(1, 1, k)
    unit_top.from = basis_y.to
    unit_top.to = sample.at
    unit_right.to = sample.at
    amount.text = format("k = {:.2}", k)
    base_y.text = format("e2 = ({:.2}, 1)", k)
  }

#8s
  fade_in(target: lattice, duration: 0.6s)
  fade_in(target: sample, duration: 0.6s)

#14s
  fade_in(target: unit_top, duration: 0.6s)
  fade_in(target: unit_right, duration: 0.6s)
  fade_in(target: area, duration: 0.6s)

// Fade through clear space: do not stack old/new caption glyphs.
#2.88s
  fade_out(target: caption, duration: 0.12s)

#3s
  caption.text = "Slide the second basis vector sideways."
  fade_in(target: caption, duration: 0.12s)

#7.88s
  fade_out(target: caption, duration: 0.12s)

#8s
  caption.text = "Apply that same rule to every point."
  fade_in(target: caption, duration: 0.12s)

#13.88s
  fade_out(target: caption, duration: 0.12s)

#14s
  caption.text = "The unit square becomes a parallelogram. Its area stays 1."
  fade_in(target: caption, duration: 0.12s)

#18.88s
  fade_out(target: caption, duration: 0.12s)

#19s
  caption.text = "Area is preserved. Lengths and angles are not."
  fade_in(target: caption, duration: 0.12s)
