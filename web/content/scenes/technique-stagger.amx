// The same entrance, offset in time. Positions and duration do not change.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", canvas_size: (1280, 720), duration: 7 }

let count = 5
let diameter = 80
let step = 300ms
let entrance = 600ms

#0s
  floor: Backdrop, strength: 0.28
  head: ChapterHeader, eyebrow: "STAGGER", heading: "One entrance. A shared rhythm."
  takeaway: SceneCaption, text: format("Each starts {} ms after the last.", step / 1ms)
  row: Row, anchor: scene.center, offset: (0, -10), gap: 70, align: "center" {
    for i in range(0, count) {
      dot[i]: Ellipse, size: (diameter, diameter), color: accent.primary, opacity: 0
    }
  }
  let dots = tabulate(count, (i) => row.dot[i])

#1s
  stagger_each(dots, step, (dot) => fade_in(target: dot, duration: entrance))

#7s
