// Reveal meaning in an order: object, name, then relationship.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7 }

#0s
  stage: TechniqueStage, topic: "REVEAL", heading: "Give the eye a first step."
  dot: Ellipse, at: (430, 350), size: (112, 112), color: accent.primary, opacity: 0
  name: Text, text: "A point", at: (430, 465), role: note, opacity: 0
  link: Line, from: (510, 350), to: (810, 350), stroke: accent.primary, stroke_width: 3, opacity: 0
  end: Ellipse, at: (850, 350), size: (30, 30), color: accent.warning, opacity: 0
  meaning: Text, text: "Then a connection.", at: (850, 465), role: note, opacity: 0

#0.5s
  fade_in(target: dot, duration: 0.6s)

#1.5s
  fade_in(target: name, duration: 0.4s)

#3s
  draw_in(target: link, duration: 0.8s)
  fade_in(target: end, duration: 0.4s, delay: 0.6s)

#4.5s
  fade_in(target: meaning, duration: 0.4s)

// Leave the completed relationship visible for two seconds.
#7s
