// Reveal meaning in an order: object, name, then relationship.
config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7 }

#0s
  background: Rect, at: (640, 360), size: (1280, 720), color: "#0D1520"
  heading: Text, text: "Give the eye a first step.", at: (640, 130), font_size: 42, color: "#F3F5F7"
  dot: Ellipse, at: (430, 350), size: (112, 112), color: "#65D9E8", opacity: 0
  name: Text, text: "A point", at: (430, 465), font_size: 28, color: "#ADBCCA", opacity: 0
  link: Line, from: (510, 350), to: (810, 350), stroke: "#65D9E8", stroke_width: 3, opacity: 0
  end: Ellipse, at: (850, 350), size: (30, 30), color: "#F4D47B", opacity: 0
  meaning: Text, text: "Then a connection.", at: (850, 465), font_size: 28, color: "#ADBCCA", opacity: 0

#0.5s
  fade_in(target: dot, duration: 0.6s)

#1.5s
  fade_in(target: name, duration: 0.4s)

#3s
  draw_in(target: link, duration: 0.8s)
  fade_in(target: end, duration: 0.4s, delay: 0.6s)

#4.5s
  fade_in(target: meaning, duration: 0.4s)

// Leave the completed relationship visible for two seconds.
#7s
