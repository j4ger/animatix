// The same grid pulses with radial or diagonal delays.
config { colorscheme: "vivid", resolution: (1280, 720), duration: 20 }

let preset = 0
let xs = {0, 1, 2, 3, 4, 5, 6, 7}
let ys = {0, 1, 2, 3, 4, 5}
let columns = xs.length()
let rows = ys.length()
let count = columns * rows
let cell = (64, 64)
let radial_delay = 0.28
let cascade_delay = 0.14
let radial_rule = "Delay by distance from the center"
let cascade_rule = "Delay by row + column"
let pulse_at = (time, center) => exp(0 - ((time - center) / 0.65) ^ 2)

#0s
  backdrop: Rect, anchor: scene.center, size: (scene_width, scene_height),
    fill_gradient: radial((0.5, 0.5), 0.68, {surface.secondary, scene.background})
  seed: Rect, anchor: scene.center, size: cell, corner_radius: 14, color: accent.primary
  field: Grid, cols: columns, gap: 24, anchor: scene.center {
    for y in ys {
      for x in xs {
        tile[y * columns + x]: Rect, size: cell, corner_radius: 14, opacity: 0,
          color: lerp_color_oklab(accent.primary, accent.info, (y * columns + x) / (count - 1))
      }
    }
  }
  rule: Text, anchor: scene.bottom, offset: (0, -58), text: format("One shape becomes {}.", count), font_size: 28

  always {
    for y in ys {
      for x in xs {
        let i = y * columns + x
        let dx = x - (columns - 1) / 2
        let dy = y - (rows - 1) / 2
        let radial = sqrt(dx ^ 2 + dy ^ 2) * radial_delay
        let diagonal = (x + y) * cascade_delay
        let first = if preset == 1 { diagonal } else { radial }
        let second = if preset == 1 { radial } else { diagonal }
        let pulse = pulse_at(t, 5.5 + first) + pulse_at(t, 11 + second) + pulse_at(t, 16 + second)
        let reveal = clamp((t - 2 - i * 0.025) / 0.5, 0, 1)
        tile[i].scale = 0.45 + 0.37 * reveal + 0.32 * pulse
        tile[i].rotation = 0.45 * pulse
        tile[i].opacity = reveal * (0.65 + 0.35 * pulse)
      }
    }
  }

#1.7s
  fade_out(target: seed, duration: 0.4s)

#4.5s
  rule.text = if preset == 1 { cascade_rule } else { radial_rule }

#10s
  rule.text = if preset == 1 { radial_rule } else { cascade_rule }
