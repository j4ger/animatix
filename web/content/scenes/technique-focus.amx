// Emphasis changes contrast, not layout. Neighbours stay visible as context.
import "../templates/layout.amx"

config { style: "editorial", colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7 }

#0s
  stage: TechniqueStage, topic: "EMPHASIS", heading: "Keep the context. Change the focus.",
    takeaway: "The arrangement does not have to move."
  a: Rect, at: (400, 350), size: (150, 150), corner_radius: theme.radius, color: accent.primary
  b: Rect, at: (640, 350), size: (150, 150), corner_radius: theme.radius, color: accent.primary
  c: Rect, at: (880, 350), size: (150, 150), corner_radius: theme.radius, color: accent.primary
  marker: Rect, at: (640, 455), size: (48, 4), color: accent.warning, opacity: 0

#1.5s
  a.opacity = 0.25[0.5s]
  c.opacity = 0.25[0.5s]
  b.color = accent.warning[0.5s]
  fade_in(target: marker, duration: 0.5s)

#4s
  b.opacity = 0.25[0.5s]
  b.color = accent.primary[0.5s]
  c.opacity = 1[0.5s]
  c.color = accent.warning[0.5s]
  marker.at = (880, 455) [0.5s, ease: ease_in_out]

#7s
