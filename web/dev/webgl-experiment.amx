config { resolution: (640, 360) }

# Frost
config { duration: 2 }
#0s
  bg: Rect, at: (320, 180), size: (640, 360), color: "#101827"
  bar1: Rect, at: (174, 165), size: (42, 250), color: "#FC786C"
  bar2: Rect, at: (236, 172), size: (42, 198), color: "#FEC760"
  bar3: Rect, at: (298, 180), size: (42, 250), color: "#5FE4CC"
  bar4: Rect, at: (360, 166), size: (42, 186), color: "#68AAFF"
  bar5: Rect, at: (422, 174), size: (42, 244), color: "#B98FFB"
  card: Glass, at: (320, 180), size: (342, 158), corner_radius: 20 {
    frost: Blur, radius: 18
    frost_surface: Rect, size: (342, 158), corner_radius: 20, color: "#FFFFFF22", stroke: "#FFFFFF80", stroke_width: 2
    shared_badge: Ellipse, shared_id: "badge", at: (0, 0), size: (30, 30), color: "#FFFFFF"
  }
#2s
play After [fade, 1s]

# After
