// adaptive_probe.amx — self-contained, continuously animating plate for the
// adaptive-quality probe. Every frame changes (always-block drive), so neither
// the engine's frame dedup nor a static hold hides the render cost.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 4 }

box: Rect, size: (260, 260), color: rgb(0.96, 0.72, 0.26), at: (400, 360)
dot: Ellipse, size: (120, 120), color: rgb(0.56, 0.78, 0.64), at: (880, 360)

always {
  box.at = (640 + sin(t * 1.3) * 300, 360 + cos(t * 1.1) * 200)
  box.rotation = t * 0.8
  dot.at = (640 + cos(t * 0.9) * 380, 360 + sin(t * 1.4) * 220)
}
