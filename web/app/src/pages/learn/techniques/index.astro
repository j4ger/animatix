---
import Page from '../../../layouts/Page.astro';
import {pageUrl} from '../../../lib/content';
import {techniques} from '../../../lib/techniques';
import {techniqueCopy} from '../../../lib/catalog-zh';
import {pageLanguage} from '../../../lib/language';
import {ui} from '../../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t, docs} = ui(language);
const title = t('Animation techniques', '动画技法');
---
<Page title={title}>
  <section class="guide"><a class="backlink" href={pageUrl(language, 'docs/')}>← {docs}</a><h1>{title}</h1></section>
  <div class="link-list">{techniques.map(entry => <a href={pageUrl(language, 'learn/techniques/' + entry.id + '/')}>{t(entry.title, techniqueCopy[entry.id].title)}<span aria-hidden="true">→</span></a>)}</div>
</Page>
