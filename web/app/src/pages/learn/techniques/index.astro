---
import Page from '../../../layouts/Page.astro';
import LearningIndex from '../../../components/LearningIndex.astro';
import {pageUrl} from '../../../lib/content';
import {techniques} from '../../../lib/techniques';
import {techniqueCopy} from '../../../lib/catalog-zh';
import {choose, pageLanguage} from '../../../lib/language';
import {ui} from '../../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
const title = t('web-animation-techniques');
const description = t('web-open-a-scene-to-see-the-technique-in-motion-and-edit-its-amx-source');
const items = techniques.map(entry => ({
  href: pageUrl(language, `learn/techniques/${entry.id}/`),
  title: choose(language, entry.title, techniqueCopy[entry.id].title),
  goal: choose(language, entry.goal, techniqueCopy[entry.id].goal),
}));
---
<Page {title} {description}>
  <LearningIndex {title} {description} {items}/>
</Page>
