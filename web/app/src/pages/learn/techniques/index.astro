---
import Page from '../../../layouts/Page.astro';
import {url} from '../../../lib/content';
import {techniques} from '../../../lib/techniques';
---
<Page title="Animation techniques">
  <section class="page-intro">
    <a class="text-link" href={url('learn/')}>← Learning route</a>
    <p class="eyebrow">Techniques / small reusable ideas</p>
    <h1>Give motion<br/><em>a purpose.</em></h1>
    <p class="lead">Four focused studies. One intention each.<br/>Read the complete source, then make it your own.</p>
  </section>
  <div class="lessons">
    {techniques.map((technique, i) => <a href={url(`learn/techniques/${technique.id}/`)}>
      <span class="lesson-number">0{i+1}</span>
      <div><h2>{technique.title}</h2><p>{technique.goal}</p></div>
      <span aria-hidden="true">→</span>
    </a>)}
  </div>
  <section class="note"><h2>Intent first. API second.</h2><p>These are short working patterns, not finished showcase films. Each keeps its final composition visible and avoids unrelated effects.</p></section>
</Page>
