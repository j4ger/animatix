---
import Page from '../../../layouts/Page.astro';
import Scene from '../../../components/Scene.astro';
import {url, pageUrl} from '../../../lib/content';
import {techniques} from '../../../lib/techniques';
import {techniqueCopy} from '../../../lib/catalog-zh';
import {pageLanguage} from '../../../lib/language';
import {ui} from '../../../lib/ui';
export function getStaticPaths(){return techniques.map(technique=>({params:{id:technique.id},props:{technique}}));}
const language = pageLanguage(Astro.currentLocale);
const labels = ui(language);
const {t} = labels;
const original: typeof techniques[number] = Astro.props.technique;
const translation = techniqueCopy[original.id];
const technique = language === 'zh' ? {...original, ...translation} : original;
const descriptions: Record<string,string> = {
  reveal: 'A large cyan point connects by a thin line to a small gold point; the two captions appear beneath their subjects.',
  focus: 'Three aligned squares retain their positions. The right square is gold with an underline; its two neighbours are dimmed.',
  stagger: 'Five equally spaced cyan circles form the completed row after their staggered entrances.',
  labels: 'A subject point rests at the right end of a horizontal track. A vertical leader connects it to its label above.',
};
const sources=import.meta.glob<string>('../../../../../content/scenes/*.amx',{query:'?raw',import:'default',eager:true});
const source=sources[`../../../../../content/scenes/${technique.file}.amx`];
---
<Page title={technique.title}>
  <section class="work-heading">
    <a class="text-link" href={pageUrl(language, 'learn/techniques/')}>← {t('All techniques', '全部技法')}</a>
    <p class="eyebrow">{t('Technique', '技法')} / {labels.seconds(technique.duration)}</p>
    <h1>{technique.title}{t('.', '')}</h1><p class="lead">{technique.goal}</p>
  </section>
  <Scene id={technique.file} title={technique.title} posterAlt={t(descriptions[technique.id], translation.alt)}/>
  <div class="work-detail">
    <div>
      <p class="eyebrow">{t('What to notice', '观察要点')}</p><p>{technique.explanation}</p>
      <p class="eyebrow">{t('Try a change', '动手试试')}</p><h2>{technique.exercise}</h2>
      <p class="small muted">{technique.rule}</p>
      <a class="button primary" href={pageUrl(language, `playground/?scene=${technique.file}`)}>{labels.editScene} →</a>
    </div>
    <div><p class="eyebrow">{t('Complete source', '完整源码')} · {technique.file}.amx</p>
      <pre class="lesson-code"><code>{source}</code></pre>
      <a class="text-link" href={url(`content/scenes/${technique.file}.amx`)} download>{labels.downloadSource} ↓</a>
    </div>
  </div>
</Page>
