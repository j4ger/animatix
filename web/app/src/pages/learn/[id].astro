---
import Page from '../../layouts/Page.astro';import Scene from '../../components/Scene.astro';import {lessons,url} from '../../lib/content';
export function getStaticPaths(){return lessons.map((lesson,i)=>({params:{id:lesson.id},props:{lesson,i}}));}
const {lesson,i}=Astro.props;
const sources=import.meta.glob<string>('../../../../content/scenes/*.amx',{query:'?raw',import:'default',eager:true});
const source=sources[`../../../../content/scenes/${lesson.file}.amx`];
---
<Page title={lesson.title}>
  <section class="work-heading">
    <a class="text-link" href={url('learn/')}>← Learning route</a>
    <p class="eyebrow">Lesson 0{i+1} / 06</p>
    <h1>{lesson.title}.</h1><p class="lead">{lesson.goal}</p>
  </section>
  <Scene id={lesson.file} title={lesson.title} posterAlt={`Rendered still from ${lesson.title}`}/>
  <div class="work-detail">
    <div>
      <p class="eyebrow">What to notice</p><p>{lesson.explanation}</p>
      <p class="eyebrow">Try a change</p><h2>{lesson.exercise}</h2>
      <a class="button primary" href={url(`playground/?scene=${lesson.file}`)}>Edit this scene →</a>
    </div>
    <div>
      <p class="eyebrow">Complete source · {lesson.file}.amx</p>
      <pre class="lesson-code"><code>{source}</code></pre>
      <a class="text-link" href={url(`content/scenes/${lesson.file}.amx`)} download>Download source ↓</a>
    </div>
  </div>
  <div class="lesson-nav">
    {i>0&&<a href={url(`learn/${lessons[i-1].id}/`)}>← {lessons[i-1].title}</a>}
    {i<5&&<a href={url(`learn/${lessons[i+1].id}/`)}>{lessons[i+1].title} →</a>}
  </div>
</Page>
