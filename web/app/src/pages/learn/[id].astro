---
import Page from '../../layouts/Page.astro';
import LearningScene from '../../components/LearningScene.astro';
import {lessons, pageUrl} from '../../lib/content';
import {lessonCopy} from '../../lib/catalog-zh';
import {choose, pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';
export function getStaticPaths() {
  return lessons.map((lesson, i) => ({params: {id: lesson.id}, props: {lesson, i}}));
}
const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
const {i} = Astro.props;
const original: typeof lessons[number] = Astro.props.lesson;
const lesson = language === 'zh' ? {...original, ...lessonCopy[original.id]} : original;
const titleOf = (entry: typeof lessons[number]) => choose(language, entry.title, lessonCopy[entry.id].title);
---
<Page title={lesson.title}>
  <LearningScene entry={lesson} backPath="learn/" backLabel={t('web-learning-route')}
    eyebrow={t('web-lesson-number', {index: String(i + 1)})}
    posterAlt={t('web-lesson-still', {title: lesson.title})}/>
  <div class="lesson-nav">
    {i > 0 && <a href={pageUrl(language, `learn/${lessons[i - 1].id}/`)}>← {titleOf(lessons[i - 1])}</a>}
    {i < lessons.length - 1 && <a href={pageUrl(language, `learn/${lessons[i + 1].id}/`)}>{titleOf(lessons[i + 1])} →</a>}
  </div>
</Page>

<style>
  .lesson-nav { display: flex; justify-content: space-between; gap: 24px; font-size: .875rem; color: var(--accent); }
  @media (max-width: 800px) { .lesson-nav { font-size: .75rem; } }
</style>
