---
import Page from '../../layouts/Page.astro';
import {pageUrl} from '../../lib/content';
import {pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t, docs, quickstart, tutorials, techniques, reference} = ui(language);
const sections = [
  {path: 'learn/', title: tutorials, description: t('web-learn-layout-timing-and-motion-in-six-lessons')},
  {path: 'learn/techniques/', title: techniques, description: t('web-reuse-patterns-for-reveals-emphasis-and-labels')},
  {path: 'docs/reference/', title: reference, description: t('web-look-up-amx-syntax-primitives-and-properties')},
];
---
<Page title={docs}>
  <div class="docs-layout">
    <h1>{docs}</h1>
    <a class="docs-quickstart" href={pageUrl(language, 'docs/quickstart/')}>
      <div><h2>{quickstart}</h2><p>{t('web-preview-an-amx-scene-in-your-browser-then-render-it-to-video-locally')}</p></div>
      <span aria-hidden="true">→</span>
    </a>
    <div class="docs-links">
      {sections.map(section => <a href={pageUrl(language, section.path)}>
        <h2>{section.title} <span aria-hidden="true">→</span></h2><p>{section.description}</p>
      </a>)}
    </div>
  </div>
</Page>
