---
import Page from '../../layouts/Page.astro';
import DocsBackLink from '../../components/DocsBackLink.astro';
import {sceneUrl, pageUrl, github} from '../../lib/content';
import {insertionId} from '../../lib/insertion-steps';
import {pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t, quickstart} = ui(language);
const install = pageUrl(language, '#install');
const edit = pageUrl(language, `playground/?scene=${insertionId}&step=four`);
const download = sceneUrl(insertionId);
---
<Page title={quickstart}>
  <article class="docs-layout quickstart">
    <DocsBackLink/>
    <h1>{quickstart}</h1>
    <p id="local">{language === 'en'
      ? <>Download a build from <a href={install}>Install Animatix</a> and extract it. Save <a href={download} download>insertion-sort.amx</a> to that folder, or <a href={edit}>edit it in your browser</a>.</>
      : <>从<a href={install}>安装 Animatix</a>下载并解压。将 <a href={download} download>insertion-sort.amx</a> 保存到解压目录，也可以<a href={edit}>在浏览器中编辑</a>。</>}</p>
    <section id="gui" aria-labelledby="gui-title">
      <h2 id="gui-title">{t('web-gui')}</h2>
      <ol>
        <li>{language === 'en' ? <>Launch <code>animatix-gui</code>. Open the <code>.amx</code> file from the filename menu.</> : <>启动 <code>animatix-gui</code>，从文件名菜单打开 <code>.amx</code> 文件。</>}</li>
        <li>{language === 'en' ? <>Choose <strong>Write</strong> to change the source. Change the <code>1.25s</code> on the <code>sorted[1].at</code> line to <code>1.6s</code> to slow the move.</> : <>选择 <strong>Write</strong> 进入编辑。把 <code>sorted[1].at</code> 那一行的 <code>1.25s</code> 改为 <code>1.6s</code>，让卡片移动得更慢。</>}</li>
        <li>{language === 'en' ? <>Choose <strong>Review</strong> and scrub to <code>7.6s</code> to see the move in progress. Save the file when you’re done.</> : <>选择 <strong>Review</strong>，拖到 <code>7.6s</code> 查看移动中的画面。修改完成后保存文件。</>}</li>
      </ol>
      <a class="text-link" href={github + '/blob/main/docs/gui-workbench.md'}>{t('web-workbench-guide')}</a>
    </section>
    <section id="cli" aria-labelledby="cli-title">
      <h2 id="cli-title">{t('web-cli')}</h2>
      <p>{t('web-from-the-extracted-folder-validate-the-scene-and-render-a-still')}</p>
      <pre><code>{`./bin/animatix check insertion-sort.amx
./bin/animatix image insertion-sort.amx --time 7.6 --output frame.png`}</code></pre>
      <p>{t('web-use-a-video-enabled-build-to-render-the-full-scene-to-mp4')}</p>
      <pre><code>./bin/animatix video insertion-sort.amx --output insertion-sort.mp4</code></pre>
      <p>{t('web-for-a-narrated-example-with-audio-and-captions-create-a-starter-project')}</p>
      <pre><code>./bin/animatix init narrated-example</code></pre>
      <p class="quickstart-note">{language === 'en' ? <>On macOS, use <code>./animatix</code>. On Windows, use <code>{String.raw`.\animatix.exe`}</code>.</> : <>macOS 使用 <code>./animatix</code>，Windows 使用 <code>{String.raw`.\animatix.exe`}</code>。</>}</p>
    </section>
  </article>
</Page>
