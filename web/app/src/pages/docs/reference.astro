---
import Page from '../../layouts/Page.astro';
import DocsBackLink from '../../components/DocsBackLink.astro';
import {github} from '../../lib/content';
import {pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t, reference} = ui(language);
const topics = [
  [t('Language syntax', '语言语法'), 'spec.md'],
  [t('Primitives', '图元'), 'primitives.md'],
  [t('Properties', '属性'), 'properties.md'],
  [t('Effects', '效果'), 'effects.md'],
  [t('Narration', '旁白'), 'narration.md'],
  [t('Native tools and video export', '本地工具与视频导出'), 'contributing.md'],
];
---
<Page title={reference}><div class="docs-layout guide"><DocsBackLink/><h1>{reference}</h1><div class="link-list">
  {topics.map(([title, path]) => <a href={github+'/blob/main/docs/'+path}>{title}<span>{t('GitHub ↗', 'GitHub · 英文 ↗')}</span></a>)}
</div></div></Page>
