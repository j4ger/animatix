---
import Page from '../../layouts/Page.astro';
import DocsBackLink from '../../components/DocsBackLink.astro';
import {github, pageUrl} from '../../lib/content';
import {pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t, reference} = ui(language);
const topics = [
  [t('web-language-syntax'), 'spec.md'],
  [t('web-primitives'), 'primitives.md'],
  [t('web-properties'), 'properties.md'],
  [t('web-effects'), 'effects.md'],
  [t('web-narration'), 'narration.md'],
  [t('web-native-tools-and-video-export'), 'contributing.md'],
];
---
<Page title={reference}><div class="docs-layout guide"><DocsBackLink/><h1>{reference}</h1><div class="link-list">
  <a href={pageUrl(language, 'docs/web-sdk/')}>{t('web-sdk-guide-title')}</a>
  {topics.map(([title, path]) => <a href={github+'/blob/main/docs/'+path}>{title}<span>{t('web-github')}</span></a>)}
</div></div></Page>
