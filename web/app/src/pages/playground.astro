---
import Page from '../layouts/Page.astro';
import Scene from '../components/Scene.astro';
import {techniques} from '../lib/techniques';
import {works, lessons, url} from '../lib/content';
import {workCopy, lessonCopy, techniqueCopy} from '../lib/catalog-zh';
import {pageLanguage} from '../lib/language';
import {ui} from '../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const labels = ui(language);
const {t, playground} = labels;
const choices = [
  {id: 'insertion-sort', title: t('Insertion sort', '插入排序')},
  {id: 'quiet-carriage', title: t('Noise cancellation', '主动降噪')},
  ...lessons.map(x => ({id: x.file, title: t(x.title, lessonCopy[x.id].title)})),
  ...works.map(x => ({id: x.id, title: t(x.title, workCopy[x.id].title)})),
  ...techniques.map(x => ({id: x.file, title: t(x.title, techniqueCopy[x.id].title)})),
  {id: 'first-beat', title: t('First beat · wave only', '第一拍 · 波纹')},
  {id: 'give-it-a-beat', title: t('Give it a beat.', '给画面一点节奏')},
];
---
<Page title={playground} wide>
  <div class="play-heading"><h1>{playground}</h1><p>{t('Download your .amx file to keep your edits.', '下载 .amx 文件以保存修改。')}</p></div>
  <div class="playground" data-playground data-base={url('content/scenes/')}>
    <section class="editor-pane" aria-label={t('Source editor', '源码编辑器')}>
      <div class="editor-toolbar"><label for="scene-choice">{t('Source', '场景')}</label><select id="scene-choice">{choices.map(x => <option value={x.id}>{x.title}</option>)}</select><button id="open-source" class="button">{t('Open', '打开')}</button></div>
      <p id="editor-status" role="status" aria-live="polite">{labels.loadingSource}</p>
      <label class="sr-only" for="source-code">{labels.amxSource}</label>
      <textarea id="source-code" class="source-wrap" wrap="soft" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
      <div class="editor-actions"><button id="reset" class="button">{labels.reset}</button><button disabled id="download" class="button">{t('Download .amx', '下载 .amx')} ↓</button></div>
      <div id="diagnostics"></div>
    </section>
    <section class="preview-pane" aria-label={t('Animation preview', '动画预览')}><Scene editor id="first-move" title={t('Your scene', '当前场景')}/><button class="button retry-preview" type="button" hidden>{t('Retry preview', '重新预览')}</button></section>
  </div>
</Page>
<script src="../scripts/playground.ts"></script>
