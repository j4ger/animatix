---
import Page from '../layouts/Page.astro';
import EditableScene from '../components/EditableScene.astro';
import {sceneUrl} from '../lib/content';
import {firstSceneId, playgroundScenes} from '../lib/scene-catalog';
import {pageLanguage} from '../lib/language';
import {ui} from '../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const labels = ui(language);
const {t, playground} = labels;
const choices = playgroundScenes(language);
---
<Page title={playground} wide>
  <h1 class="play-heading">{playground}</h1>
  <div class="playground" data-playground>
    <EditableScene id={firstSceneId} title={t('web-your-scene')} workspace download>
      <label slot="chooser" class="sample-chooser">
        {t('web-scene')}
        <select id="scene-choice" disabled>{choices.map(x =>
          <option value={x.id} data-source={sceneUrl(x.id)} selected={x.id === firstSceneId}>{x.title}</option>
        )}</select>
      </label>
    </EditableScene>
  </div>
</Page>
<script src="../scripts/playground.ts"></script>
