---
import Page from '../layouts/Page.astro';import Scene from '../components/Scene.astro';import {works,lessons,url} from '../lib/content';
const choices=[...lessons.map(x=>({id:x.file,title:x.title})),...works];
---
<Page title="Playground" wide><div class="play-heading"><div><p class="eyebrow">Playground / a small working space</p><h1>Change a rule.<br/><em>See what moves.</em></h1></div><p>Edits stay in this tab only. Download to keep them.<br/>Your code never changes until you ask it to.</p></div><div class="playground" data-playground data-base={url('content/scenes/')}><section class="editor-pane"><div class="editor-toolbar"><label for="scene-choice">Source</label><select id="scene-choice">{choices.map(x=><option value={x.id}>{x.title}</option>)}</select><button id="open-source" class="button">Open</button></div><label class="sr-only" for="source-code">AMX source code</label><textarea id="source-code" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="editor-status"></textarea><div class="editor-actions"><button id="run" class="button primary">Run <kbd>⌘/Ctrl ↵</kbd></button><button id="reset" class="button">Reset</button><button disabled id="download" class="button">Download ↓</button></div><p id="editor-status" role="status" aria-live="polite">Loading source…</p><div id="diagnostics"></div></section><section class="preview-pane" aria-label="Animation preview"><Scene editor id="first-move" title="Your scene"/><p class="small muted">WebGPU is required for preview, not for editing or downloading. The last successful scene remains when a build fails.</p></section></div></Page>
<script src="../scripts/playground.ts"></script>
