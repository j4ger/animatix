---
import Page from '../../layouts/Page.astro';
import Scene from '../../components/Scene.astro';
import {works, url, pageUrl} from '../../lib/content';
import {workCopy} from '../../lib/catalog-zh';
import {pageLanguage} from '../../lib/language';
import {ui} from '../../lib/ui';

export function getStaticPaths() {
  return works.map(work => ({params: {id: work.id}, props: {work}}));
}
const language = pageLanguage(Astro.currentLocale);
const labels = ui(language);
const {t} = labels;
const original: typeof works[number] = Astro.props.work;
const work = language === 'zh' ? {...original, ...workCopy[original.id]} : original;
---
<Page title={work.title}>
  <section class="work-heading">
    <a class="text-link" href={pageUrl(language, '#examples')}>← {t('All works', '全部示例')}</a>
    <div class="card-meta"><span>{work.category}</span><span>{labels.seconds(work.duration)} / 2D</span></div>
    <h1>{work.title}</h1><p class="lead">{work.question}</p>
  </section>
  <div class="work-stage" style={`--work-color: ${work.color}`}>
    <Scene id={work.id} title={work.title} recording/>
  </div>
  {work.controls && <div class="controls" data-controls>
    <label>{work.controls === 'preset' ? t('Starting rule', '起始规则') : t('Initial phase', '初始相位')}
      {work.controls === 'preset'
        ? <select disabled name="preset"><option value="0">{t('Ripple', '涟漪')}</option><option value="1">{t('Cascade', '级联')}</option></select>
        : <select disabled name="phase_degrees"><option value="0">0° · {t('In phase', '同相')}</option><option value="90">90° · {t('Quarter cycle', '四分之一周期')}</option><option value="180">180° · {t('Half cycle', '半周期')}</option></select>}
    </label>
    <p role="status" aria-live="polite">{t('Start live playback, then choose a setting.', '开始实时播放后即可切换设置。')}</p>
  </div>}
  <div class="work-detail">
    <div><p class="eyebrow">{t('The idea', '原理')}</p><h2>{work.insight}</h2></div>
    <div><p>{work.description}</p><p class="small muted">{work.note}</p>
      <div class="actions">
        <a data-open-code class="button primary" href={pageUrl(language, `playground/?scene=${work.id}`)}>{t('Open the code', '打开源码')} →</a>
        <a data-source-download class="button" href={url(`content/scenes/${work.id}.amx`)} download={`${work.id}.amx`}>{t('Download AMX', '下载 AMX')} ↓</a>
      </div>
    </div>
  </div>
</Page>
