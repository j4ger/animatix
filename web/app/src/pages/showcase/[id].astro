---
import Page from '../../layouts/Page.astro';
import EditableScene from '../../components/EditableScene.astro';
import {works, url, pageUrl} from '../../lib/content';
import {workCopy} from '../../lib/catalog-zh';
import {pageLanguage} from '../../lib/language';
import {sceneSource} from '../../lib/scene-source';
import {ui} from '../../lib/ui';

export function getStaticPaths() {
  return works.map(work => ({params: {id: work.id}, props: {work}}));
}
const language = pageLanguage(Astro.currentLocale);
const labels = ui(language);
const {t} = labels;
const original: typeof works[number] = Astro.props.work;
const work = language === 'zh' ? {...original, ...workCopy[original.id]} : original;
const source = sceneSource(work.id);
const experiments: Record<string, [string, string, string]> = {
  'move-the-basis': ['#3s · plane.e2.to', 'Change 4s to 2s. The other shapes still follow the moving vector.', '把 4s 改成 2s。看看其他图形怎样继续跟着基向量运动。'],
  'make-room': ['let lifted_y = row_y - 135', 'Change 135 to 170 to lift each card higher during a comparison.', '把 135 改成 170，让待插入的卡片在比较时抬得更高。'],
  'one-rule-many-forms': ['let radial_delay = 0.28', 'Change 0.28 to 0.14 and watch the ripple move through the grid faster.', '把 0.28 改成 0.14，看看涟漪怎样更快地穿过方阵。'],
  'when-waves-meet': ['let phase_degrees = 0', 'Change 0 to 180 and see what the two waves add up to at the start.', '把 0 改成 180，看看两道波一开始叠加成什么样。'],
  'words-keep-time': ['let available = "Reading and exports"', 'Change the list of available features, then watch where it appears in the notice.', '改一下维护期间可用的功能，再看这句话在通知里的哪个位置出现。'],
};
const [exampleCode, exampleEn, exampleZh] = experiments[work.id];
const next = works[(works.indexOf(original) + 1) % works.length];
const nextTitle = t(next.title, workCopy[next.id].title);
---
<Page title={work.title}>
  <article class="example-page" style={`--work-color: ${work.color}`}>
    <header class="example-heading">
      <div class="example-breadcrumb"><a class="text-link" href={pageUrl(language, '#examples')}>← {labels.examples}</a><span>{work.category}</span></div>
      <h1>{work.title}</h1>
      <p>{work.question}</p>
    </header>
    <div class="example-workspace">
      <EditableScene id={work.id} title={work.title} {source} duration={work.duration} recording>
        <a slot="actions" data-source-download class="sample-download" href={url(`content/scenes/${work.id}.amx`)} download={`${work.id}.amx`}>{t('Download AMX', '下载 AMX')} ↓</a>
        {work.controls && <div slot="presets" class="scene-presets">
          <label>{work.controls === 'preset' ? t('Starting rule', '起始规则') : t('Initial phase', '初始相位')}
            <select data-scene-preset disabled name={work.controls === 'preset' ? 'preset' : 'phase_degrees'}>
              <option value="" hidden disabled>{t('Custom', '自定义')}</option>
              {work.controls === 'preset'
                ? <><option value="0" selected>{t('Ripple', '涟漪')}</option><option value="1">{t('Cascade', '级联')}</option></>
                : <><option value="0" selected>0° · {t('In phase', '同相')}</option><option value="90">90° · {t('Quarter cycle', '四分之一周期')}</option><option value="180">180° · {t('Half cycle', '半周期')}</option></>}
            </select>
          </label>
          <p class="source-status" role="status"></p>
        </div>}
      </EditableScene>
      <aside class="example-notes">
        <section class="example-experiment">
          <h2>{t('Try an edit', '试着改一处')}</h2>
          <code>{exampleCode}</code>
          <p>{t(exampleEn, exampleZh)}</p>
        </section>
        <section class="example-explanation">
          <h2>{work.insight}</h2>
          <p>{work.description}</p>
          <p class="small">{work.note}</p>
        </section>
      </aside>
    </div>
    <nav class="example-next" aria-label={t('Next example', '下一个示例')}>
      <a href={pageUrl(language, `showcase/${next.id}/`)}><span>{t('Next example', '下一个示例')}</span> {nextTitle} <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</Page>

<style>
  .example-page { padding-top: clamp(22px, 3vw, 42px); }
  .example-heading { margin-bottom: clamp(20px, 2.6vw, 36px); }
  .example-breadcrumb { display: flex; gap: 15px; align-items: center; margin-bottom: 14px; color: var(--muted); font-size: .85rem; }
  .example-breadcrumb span { border-inline-start: 1px solid var(--line); padding-inline-start: 15px; }
  .example-heading h1 { font-size: clamp(2.25rem, 4.5vw, 4.5rem); margin: 0 0 9px; text-wrap: balance; }
  .example-heading p { margin: 0; font-size: clamp(.98rem, 1.3vw, 1.18rem); }
  .example-workspace { display: grid; align-items: start; gap: clamp(24px, 3vw, 44px); }
  .example-workspace > :global(.sample) { border-color: color-mix(in srgb, var(--work-color) 33%, var(--edge)); }
  .example-notes { display: grid; gap: 24px; min-width: 0; }
  .example-notes h2 { margin: 0 0 10px; font-size: 1.22rem; line-height: 1.25; letter-spacing: -.025em; }
  .example-notes p { margin: 0; font-size: .94rem; }
  .example-notes p.small { margin-block-start: 10px; font-size: .83rem; }
  .example-experiment {
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--work-color) 23%, var(--line));
    border-radius: 8px;
    background: color-mix(in srgb, var(--work-color) 8%, var(--surface));
  }
  .example-experiment code { display: block; margin-bottom: 8px; font: .8rem/1.4 var(--mono); overflow-wrap: anywhere; }
  .example-next { justify-content: flex-end; margin-top: clamp(30px, 4vw, 56px); padding-top: 15px; border-top: 1px solid var(--line); }
  .example-next a { display: flex; gap: 10px; flex-wrap: wrap; color: var(--ink); }
  .example-next span { color: var(--muted); }
  .example-next a:hover { color: var(--accent); }
  @media (min-width: 700px) {
    .example-notes { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
  }
  @media (min-width: 1110px) {
    .example-workspace { grid-template-columns: minmax(0, 1fr) minmax(14rem, 27%); }
    .example-workspace:not(:has(> :global(.sample[data-source-open]))) .example-notes { grid-template-columns: 1fr; }
    .example-workspace:has(> :global(.sample[data-source-open])) .example-notes { grid-column: 1 / -1; }
  }
  @media (min-width: 1110px) and (max-height: 850px) {
    .example-page { padding-top: 22px; }
    .example-heading { margin-bottom: 20px; }
    .example-heading h1 { font-size: clamp(2.25rem, 4vw, 3.2rem); }
    .example-workspace {
      /* Leave room for the heading and transport above and below the 16:9 picture. */
      grid-template-columns: minmax(0, min(67%, max(33rem, calc((100svh - 345px) * 16 / 9)))) minmax(14rem, 1fr);
    }
  }
</style>
