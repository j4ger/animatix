---
import Page from '../../layouts/Page.astro';
import {legacyWorks} from '../../lib/legacy-works';
import {url,github} from '../../lib/content';
export function getStaticPaths() {
  return legacyWorks.map(work => ({params: {id: work.id}, props: {work}}));
}
const {work} = Astro.props;
---
<Page title={`${work.title} · Archive`} description={`An archived Animatix study: ${work.title}. See its disposition and find current work.`}>
  <section class="page-intro">
    <p class="eyebrow">Earlier work / archived</p>
    <h1>{work.title}</h1>
    <p class="lead">{work.decision}.</p>
    <p>{work.reason}</p>
    <div class="actions"><a class="button primary" href={url(work.next)}>{work.nextLabel} →</a><a class="button" href={url('archive/')}>All earlier studies</a></div>
  </section>
  <section class="note">
    <h2>A preserved link, not an endorsed demo.</h2>
    <p>This address remains available so old links still explain where the work went. The earlier player is no longer loaded here.</p>
    <p>{work.caveat}</p>
    <p class="small">Source files remain in the repository for reproducibility and existing tests, not as current featured work. The link below opens the published historical baseline; it may not include later experimental fixes.</p>
    <div class="actions"><a class="text-link" href={`${github}/tree/aa4d8d1a01633ba84d7810329735f3286096d5e1/web/demos/${work.id}`}>Historical repository source →</a></div>
  </section>
</Page>
