---
import Page from '../layouts/Page.astro';
import {pageUrl} from '../lib/content';
import {pageLanguage} from '../lib/language';
import {ui} from '../lib/ui';
const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
---
<Page title={t('web-not-found-title')} homeLinks>
  <section class="not-found">
    <p class="eyebrow">{t('web-not-found-eyebrow')}</p>
    <h1>{t('web-not-found-heading')}</h1>
    <p>{t('web-not-found-description')}</p>
    <div class="actions">
      <a class="button primary" href={pageUrl(language)}>{t('web-not-found-home')}</a>
      <a class="button" href={pageUrl(language) + '#examples'}>{t('web-not-found-examples')}</a>
    </div>
  </section>
</Page>

<style>
  .not-found { padding-block: clamp(50px, 6vw, 75px); border-top: 1px solid var(--line); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
</style>
