---
import {languagePreference, themePreference} from '../lib/language';
const {automaticHome = ''} = Astro.props;
---
<meta name="color-scheme" content="light dark"/>
<script is:inline define:vars={{automaticHome, languagePreference, themePreference}}>
  {
    let language;
    try {
      const theme = localStorage.getItem(themePreference);
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      language = localStorage.getItem(languagePreference);
    } catch {
      // The default preferences also work with storage disabled.
    }
    if (automaticHome && language !== 'en') {
      const preferences = navigator.languages ?? [navigator.language];
      const firstSupported = preferences.map(tag => tag.toLowerCase().split('-')[0])
        .find(code => code === 'en' || code === 'zh');
      if (language === 'zh' || firstSupported === 'zh') {
        location.replace(automaticHome + location.search + location.hash);
      }
    }
  }
</script>
