---
import {base, pageUrl} from '../lib/content';
import {pageLanguage, sitePagePath} from '../lib/language';
import {ui} from '../lib/ui';

const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
const path = Astro.props.homeLinks ? '' : sitePagePath(Astro.url.pathname, base);
---
<div class="site-preferences" data-site-preferences
     data-transfer-error={t('web-preferences-draft-transfer-failed')}>
  <details>
    <summary aria-label={t('web-preferences-language')} title={t('web-preferences-language-tooltip')}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25">
        <circle cx="8" cy="8" r="6.5"/>
        <ellipse cx="8" cy="8" rx="2.8" ry="6.5"/>
        <path d="M1.5 8h13"/>
      </svg>
    </summary>
    <div class="preference-menu" role="group" aria-label={t('web-preferences-language')}>
      <a href={pageUrl('en', path)} data-language="en" lang="en" aria-current={language === 'en' ? 'true' : undefined}>English</a>
      <a href={pageUrl('zh', path)} data-language="zh" lang="zh-Hans" aria-current={language === 'zh' ? 'true' : undefined}>简体中文</a>
    </div>
  </details>
  <details>
    <summary aria-label={t('web-preferences-theme')} title={t('web-preferences-theme')}>
      <span aria-hidden="true" class="theme-symbol"></span>
    </summary>
    <div class="preference-menu" role="group" aria-label={t('web-preferences-theme')}>
      <button type="button" data-theme-choice="auto" aria-pressed="true">{t('web-system')}</button>
      <button type="button" data-theme-choice="light" aria-pressed="false">{t('web-light')}</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">{t('web-dark')}</button>
    </div>
  </details>
</div>
<script src="../scripts/preferences.ts"></script>
