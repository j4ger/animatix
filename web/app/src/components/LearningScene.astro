---
import EditableScene from './EditableScene.astro';
import {pageUrl} from '../lib/content';
import {choose, pageLanguage} from '../lib/language';
import {sceneSource} from '../lib/scene-source';
import {ui} from '../lib/ui';

interface Props {
  entry: {file: string; title: string; goal: string; explanation: string; exercise: string; rule?: string};
  backPath: string;
  backLabel: string;
  eyebrow: string;
  posterAlt: string;
}

const {entry, backPath, backLabel, eyebrow, posterAlt} = Astro.props;
const {file, title, goal, explanation, exercise, rule} = entry;
const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
---
<section class="work-heading">
  <a class="text-link" href={pageUrl(language, backPath)}>← {backLabel}</a>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}{choose(language, '.', '')}</h1>
  <p class="lead">{goal}</p>
</section>
<EditableScene id={file} {title} {posterAlt} source={sceneSource(file)} download/>
<div class="learning-notes">
  <section>
    <h2>{t('web-what-to-notice')}</h2>
    <p>{explanation}</p>
  </section>
  <section>
    <h2>{t('web-try-a-change')}</h2>
    <p>{exercise}</p>
    {rule && <p class="learning-rule">{rule}</p>}
  </section>
</div>

<style>
  .work-heading { padding: 40px 0; }
  .work-heading > .text-link { margin-bottom: 40px; color: var(--muted); }
  .work-heading h1 { font-size: 56px; }
  .lead { font-size: 19px; }
  @media (max-width: 800px) {
    .work-heading h1 { font-size: 42px; }
  }
  @media (max-width: 520px) {
    .work-heading h1 { font-size: 37px; }
  }
  .learning-notes { display: grid; gap: 20px 36px; margin-block: clamp(24px, 4vw, 48px); }
  .learning-notes h2 { font-size: 1.22rem; margin-block-end: 8px; }
  .learning-notes p { margin-block-end: 8px; }
  .learning-rule { font-size: .75rem; }
  @media (min-width: 700px) {
    .learning-notes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
