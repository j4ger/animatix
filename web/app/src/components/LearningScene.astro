---
import Scene from './Scene.astro';
import {pageUrl, url} from '../lib/content';
import {pageLanguage} from '../lib/language';
import {sceneSource} from '../lib/scene-source';
import {ui} from '../lib/ui';

interface Props {
  entry: {file: string; title: string; goal: string; explanation: string; exercise: string; rule?: string};
  backPath: string;
  backLabel: string;
  eyebrow: string;
  posterAlt: string;
}

const {entry, backPath, backLabel, eyebrow, posterAlt} = Astro.props;
const {file, title, goal, explanation, exercise, rule} = entry;
const language = pageLanguage(Astro.currentLocale);
const {t, editScene, downloadSource} = ui(language);
---
<section class="work-heading">
  <a class="text-link" href={pageUrl(language, backPath)}>← {backLabel}</a>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}{t('.', '')}</h1>
  <p class="lead">{goal}</p>
</section>
<Scene id={file} {title} {posterAlt}/>
<div class="work-detail">
  <div>
    <p class="eyebrow">{t('What to notice', '观察要点')}</p>
    <p>{explanation}</p>
    <p class="eyebrow">{t('Try a change', '动手试试')}</p>
    <h2>{exercise}</h2>
    {rule && <p class="small muted">{rule}</p>}
    <a class="button primary" href={pageUrl(language, `playground/?scene=${file}`)}>{editScene} →</a>
  </div>
  <div>
    <p class="eyebrow">{t('Complete source', '完整源码')} · {file}.amx</p>
    <pre class="lesson-code"><code>{sceneSource(file)}</code></pre>
    <a class="text-link" href={url(`content/scenes/${file}.amx`)} download>{downloadSource} ↓</a>
  </div>
</div>
