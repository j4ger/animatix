---
import {github} from '../lib/content';

const platforms = [
  {id: 'linux', label: 'Linux'},
  {id: 'macos', label: 'macOS'},
  {id: 'windows', label: 'Windows'},
];
---
<section class="local-run" id="install" aria-labelledby="local-title" data-install>
  <h2 id="local-title">Install Animatix</h2>
  <div class="install-panel">
    <div class="install-tabs" role="tablist" aria-label="Operating system">
      {platforms.map((platform, i) => <button type="button" role="tab" id={`install-tab-${platform.id}`} data-platform={platform.id} aria-controls={`install-${platform.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{platform.label}</button>)}
    </div>
    {platforms.map((platform, i) => <div class="install-body" role="tabpanel" id={`install-${platform.id}`} aria-labelledby={`install-tab-${platform.id}`} hidden={i !== 0}>
      <a class="button primary" href={github + '/releases'}>GitHub Releases <span aria-hidden="true">↗</span></a>
    </div>)}
  </div>
</section>
<script src="../scripts/install-panel.ts"></script>
