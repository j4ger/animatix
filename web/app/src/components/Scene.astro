---
import {url,works} from '../lib/content';
const {id, title, source = `${id}.amx`, editor = false} = Astro.props;
const recorded=works.some(work=>work.id===id)&&!editor;
---
<div class="scene-shell" data-scene-shell data-module={url('runtime/amx-player.js')} data-source={url(`content/scenes/${source}`)} data-title={title}>
 <div class="scene-placeholder"><span class="eyebrow">AMX / {editor ? 'YOUR SOURCE' : id}</span><h2>{title}</h2><p>{editor?'Press Run to build the source in the editor.':recorded?'Play a recording, or load the interactive AMX scene.':'Load the interactive AMX scene in your browser.'}<br/>Interactive playback requires WebGPU. Nothing plays automatically.</p><div class="actions"><button class="button primary load-scene" hidden={editor}>Load interactive →</button>{recorded&&<button class="button watch-recording">Watch recording →</button>}</div></div>
 <div class="scene-mount"></div>
 {recorded&&<div class="recording-panel" hidden><video controls playsinline preload="none" width="1280" height="720" poster={url(`content/posters/${id}.png`)} data-recording={url(`content/previews/${id}.mp4`)} aria-label={`${title} — recorded default version`}></video><div class="recording-caption"><p>Recorded default version. Parameters and edited code require interactive playback.</p><div class="recording-actions"><button class="button pause-recording">Pause recording</button><button class="button restart-recording">Restart recording</button><button class="button load-scene">Try interactive →</button></div></div></div>}
 <p class="scene-status" role="status" aria-live="polite"></p>
</div>
<script src="../scripts/scene.ts"></script>
