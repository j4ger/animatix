---
import {url, pageUrl, works} from '../lib/content';
import {workCopy} from '../lib/catalog-zh';
import {choose, pageLanguage} from '../lib/language';
import {noiseCancellation} from '../lib/scene-catalog';
const language = pageLanguage(Astro.currentLocale);

const titles: Record<string, string> = {
  'move-the-basis': choose(language, 'Matrix shear', '矩阵剪切'),
  'make-room': choose(language, 'Stable insertion sort', '稳定插入排序'),
  'when-waves-meet': choose(language, 'Wave interference', '波的干涉'),
  'words-keep-time': choose(language, 'Maintenance notice', '维护通知'),
};
const examples = [
  {
    path: noiseCancellation.page, poster: 'journey/noise-waves.webp', width: 960, height: 560,
    title: choose(language, 'How do headphones cancel noise?', '降噪耳机是怎么消掉噪声的？'),
    category: choose(language, 'Physics', '物理'), color: '#cce893',
  },
  ...works.map(work => ({
    path: `showcase/${work.id}/`, poster: `posters/${work.id}.png`, width: 1280, height: 720,
    title: titles[work.id] ?? choose(language, work.title, workCopy[work.id].title),
    category: choose(language, work.category, workCopy[work.id].category), color: work.color,
  })),
];
---
<ul class="examples-gallery" role="list">
  {examples.map((example, index) => <li class:list={{'example-lead': index === 0}}>
    <a class="example-card" href={pageUrl(language, example.path)} style={`--example-color: ${example.color}`}>
      <img src={url(`content/${example.poster}`)} width={example.width} height={example.height} loading="lazy" decoding="async" alt=""/>
      <div class="example-card-body">
        <div>
          <h3>{example.title}</h3>
          <p class="example-meta">{example.category}</p>
        </div>
        <span class="example-arrow" aria-hidden="true">→</span>
      </div>
    </a>
  </li>)}
</ul>
