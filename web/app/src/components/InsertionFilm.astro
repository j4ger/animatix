---
import Scene from './Scene.astro';
import source from '../../../content/scenes/insertion-sort.amx?raw';
import {insertionId} from '../lib/insertion-steps';
import {url} from '../lib/content';
import {pageLanguage} from '../lib/language';
import {ui} from '../lib/ui';
const labels = ui(pageLanguage(Astro.currentLocale));
const {t} = labels;
---
<figure class="sample" id="insertion-sort" data-sample>
  <figcaption><span class="file-icon" aria-hidden="true"></span><span>insertion-sort.amx</span></figcaption>
  <div class="sample-preview">
    <Scene inline id={insertionId} title={t('Insertion sort', '插入排序')} posterAlt={t('Where does 3 fit? A green 3 hovers by the sorted row of 2, 4 and 5.', '绿色的 3 悬在已经排好序的 2、4、5 上方。')}/>
    <div class="sample-controls">
      <button type="button" class="sample-play" disabled><i aria-hidden="true"></i><span>{labels.play}</span></button>
      <input class="sample-time" type="range" aria-label={t('Scene time in seconds', '场景时间（秒）')} min="0" max="1" step="any" value="0" disabled/>
      <output class="sample-clock" aria-hidden="true">0.00s</output>
      <button type="button" class="inspect" aria-expanded="false" aria-controls="move-source"><b aria-hidden="true">&lt;/&gt;</b> <span>{labels.viewSource}</span></button>
    </div>
  </div>
  <div class="source-panel" id="move-source" hidden>
    <div class="source-toolbar">
      <div class="source-cues" role="group" aria-label={t('Keyframe timestamps', '关键帧时间戳')}></div>
      <button class="reset-source" type="button" aria-label={t('Reset source', '重置源码')} disabled>{labels.reset}</button>
    </div>
    <div class="source-editor">
      <div class="source-guide source-wrap" aria-hidden="true"></div>
      <textarea class="source-wrap" aria-label={labels.amxSource} aria-describedby="source-status" wrap="soft" spellcheck="false" autocomplete="off" autocapitalize="off">{source}</textarea>
    </div>
    <p id="source-status" class="source-status" role="status"></p>
  </div>
  <noscript><a href={url('content/scenes/insertion-sort.amx')}>{t('View insertion-sort.amx', '查看 insertion-sort.amx')} →</a></noscript>
</figure>
<script src="../scripts/insertion-film.ts"></script>
