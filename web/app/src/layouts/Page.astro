---
import {url, github} from '../lib/content';
import '../styles/site.css';
import '../styles/project.css';
const path = Astro.url.pathname;
const active = (prefixes: string[]) => prefixes.some(p => path.startsWith(url(p))) ? 'page' : undefined;
const {title = 'A language for animated explainers', description = 'Animatix is an open-source language for creating explanatory animations in code.', wide = false} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/><meta name="theme-color" content="#111410"/>
  <link rel="icon" href={url('logo.svg')} type="image/svg+xml"/><title>{title} · Animatix</title>
</head>
<body class="project-page">
  <a class="skip" href="#main">Skip to content</a>
  <header class="header">
    <a class="brand" href={url('')} aria-label="Animatix home"><img src={url('logo.svg')} width="34" height="34" alt=""/>animatix<span class="brand-dot">.</span></a>
    <nav aria-label="Main navigation">
      <a href={url('#examples')}>Examples</a>
      <a aria-current={active(['docs/', 'learn/'])} href={url('docs/')}>Docs</a>
      <a aria-current={active(['playground/'])} href={url('playground/')}>Playground</a>
      <a class="github" href={github}>GitHub ↗</a>
    </nav>
  </header>
  <main id="main" class:list={['main', {wide}]}><slot/></main>
  <footer class="project-footer">
    <span>© 2026 j4ger</span>
    <span aria-hidden="true">·</span>
    <a href={github+'/blob/main/LICENSE'}>MIT Licensed</a>
  </footer>
</body>
</html>
