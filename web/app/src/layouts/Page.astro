---
import {url, github} from '../lib/content';
import '../styles/site.css';
const active=(path:string)=>Astro.url.pathname.startsWith(url(path))?'page':undefined;
const {title = 'Scenes in code. Stories in motion.', description = 'Animatix is a language for programmatic 2D animation.', wide = false} = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101315"/><link rel="icon" type="image/svg+xml" href={url('logo.svg')}/><title>{title} · Animatix</title></head>
<body><a class="skip" href="#main">Skip to content</a><header class="header"><a class="brand" href={url('')} aria-label="Animatix home"><img src={url('logo.svg')} width="32" height="32" alt=""/>animatix<span class="brand-dot">.</span></a><nav aria-label="Main navigation"><a aria-current={active('showcase/')} href={url('showcase/')}>Showcase</a><a aria-current={active('learn/')} href={url('learn/')}>Learn</a><a aria-current={active('playground/')} href={url('playground/')}>Playground</a><a class="github" href={github}>GitHub →</a></nav></header><main id="main" class:list={['main', {wide}]}><slot/></main><footer><a class="brand" href={url('')}>animatix.</a><p>Small rules. Room to move.</p><div><a href={github+'/blob/main/docs/spec.md'}>Language reference →</a><a href={github+'/releases'}>Releases →</a><a href={github+'/blob/main/LICENSE'}>License →</a></div></footer></body></html>
