---
import {github} from '../lib/content';
import {pageLanguage} from '../lib/language';
import {ui} from '../lib/ui';
import SiteDocument from './SiteDocument.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/site.css';
import '../styles/project.css';
import '../styles/theme.css';
import '../styles/preferences.css';
const language = pageLanguage(Astro.currentLocale);
const {t} = ui(language);
const {
  title = t('web-page-default-title'),
  description = t('web-page-default-description'),
  wide = false, home = false, homeLinks = false,
} = Astro.props;
---
<SiteDocument {title} {description} {home} {homeLinks} bodyClass="project-page">
  <a class="skip" href="#main">{t('web-skip-to-content')}</a>
  <SiteHeader homeLinks={homeLinks}/>
  <main id="main" class:list={['main', {wide}]}><slot/></main>
  <footer class="project-footer">
    <span>© 2026 j4ger</span>
    <span aria-hidden="true">·</span>
    <a href={github+'/blob/main/LICENSE'}>{t('web-mit-licensed')}</a>
  </footer>
</SiteDocument>
