// effects.amx — tour §05: a Filter scope with animated effect parameters,
// plus the emphasis actions. Plain shapes only (slim engine plays this).
//
// The caption ladder is five separate `Text` actors handing off (never one
// shared actor re-assigned — assignments cross-fade two strings on top of
// each other), and the label rides OUTSIDE the filter scope: inside, the
// blur beat smears the scene's own text into illegibility. Effects are
// de-stacked so no frame goes sub-legible: blur resolves before the
// vignette lands, and the brightness dip starts from 1.0 — a 0.6 baseline
// renders the surface plate *darker* than the page ground, reading as a
// hole instead of a panel.
//
// The plate carries material for the filters to chew on. A flat disc under
// `blur: 14` barely changes; a gradient sphere with a dashed rim and a ramped
// bar does — the high-frequency dashes are what make the radius readable, and
// the ramp is what makes `brightness` and `vignette` visible at all. This is
// the scene about the filter system, so its subject should demonstrate it.
import "../../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.4 }

// Ambient light behind the panel, outside the filter scope so the grade beats
// act on the plate and not on the room it sits in.
wash: Ellipse, size: (760, 760), at: (640, 360), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b9421a")), (55%, hex_color("8ab4f60a")), (100%, hex_color("8ab4f600"))}), blend: "screen"

panel: Filter, anchor: scene.center {
soft: Blur, radius: 0
  // Declared after the blur on purpose: a filter pass reads what the previous
  // pass produced *and* the frame as it looked before the chain, so `Blur` then
  // `Bloom` in one scope is a light source. Bloom alone would be an exposure
  // bump; the pair is what makes the sphere read as lit.
glow: Bloom, intensity: 0, keep: 1
grade: ColorGrade, brightness: 1
vig: Vignette, amount: 0, radius: 0.55, softness: 0.7
art: Group, anchor: scene.center {
plate: Rect, size: (560, 320), corner_radius: 22, fill_gradient: linear(135, {hex_color("1b2534"), hex_color("0b1017")})
    // The subject: a lit sphere with a dashed rim, so the blur has something
    // to resolve and the vignette has an edge to fall off from.
ring: Ellipse, size: (180, 180), fill_gradient: radial((0.36, 0.3), 0.62, {(0%, hex_color("fff0c2")), (40%, hex_color("ffd60a")), (100%, hex_color("c98a00"))})
rim: Ellipse, size: (232, 232), stroke: accent.primary, stroke_width: 2, fill_opacity: 0, dash_pattern: {10, 8}
bar: Rect, size: (340, 24), at: (0, 140), corner_radius: 12, fill_gradient: linear(90, {hex_color("ff8666"), hex_color("8ab4f6")})
  }
}

label: Text, text: "filters are declared as children", font_size: 24, color: text.primary, at: (640, 168)

capB: Text, text: "blur radius 0 -> 14, bloom 0 -> 1", font_size: 22, color: text.secondary, at: (640, 660), opacity: 0

capV: Text, text: "vignette 0.75", font_size: 22, color: text.secondary, at: (640, 660), opacity: 0

capD: Text, text: "brightness dip", font_size: 22, color: text.secondary, at: (640, 660), opacity: 0

capE: Text, text: "shake + pulse", font_size: 22, color: text.secondary, at: (640, 660), opacity: 0

// The emphasis target is a real affordance, not a bare rectangle: a rounded
// chip with a bundled Lucide `plus` traced onto it, so `shake` and `pulse`
// land on something the eye already reads as a control.
chip: Rect, size: (150, 44), anchor: scene.center, offset: (0, 220), corner_radius: 22, fill_gradient: linear(135, {hex_color("ff9f0a"), hex_color("ff5c5c")})

chip_icon: Path, icon: "plus", stroke: (0.1, 0.07, 0.03, 1), stroke_width: 2, fill_opacity: 0, anchor: scene.center, offset: (-18, 202), scale: 1.5

#0s
  rim.dash_offset = 0
  rim.dash_offset = 360 [7.2s, ease: linear]

#0.5s
  fade_in(target: wash, duration: 0.7s, ease: expo_out)
  stagger [0.09s] {
      settle_in(target: plate, duration: 0.5s, ease: expo_out)
      settle_in(target: bar, duration: 0.5s, ease: expo_out)
      fade_in(target: label, duration: 0.5s, ease: expo_out)
    }

#0.65s
  pop_in(target: ring, duration: 0.55s, ease: expo_out)
  fade_in(target: rim, duration: 0.5s, ease: expo_out)

// blur in, caption first
#1.7s
  fade_in(target: capB, duration: 0.2s, ease: expo_out)

#1.8s
  panel.soft.radius = 14 [1.2s, ease: ease_out]

// The glow lands on the smeared frame. Bloom spends the second input — the
// light comes from what the scene looked like *before* the chain ran, so the
// sphere stays a sphere while everything around it keeps its softness.
#2.3s
  panel.glow.intensity = 1 [0.5s, ease: ease_out]

#2.9s
  fade_out(target: capB, duration: 0.2s, ease: ease_in)

// vignette lands once the blur is resolving
#3.15s
  fade_in(target: capV, duration: 0.2s, ease: expo_out)

#3s
  panel.vig.amount = 0.75 [0.8s, ease: ease_in_out]

#3.2s
  panel.soft.radius = 0 [1s, ease: ease_out]
  panel.glow.intensity = 0 [0.7s, ease: ease_out]

#4.1s
  fade_out(target: capV, duration: 0.2s, ease: ease_in)
  panel.vig.amount = 0 [0.6s, ease: ease_out]

// brightness dip — from the 1.0 baseline, down to a readable dusk
#4.3s
  fade_in(target: capD, duration: 0.2s, ease: expo_out)

#4.4s
  panel.grade.brightness = 0.55 [0.8s, ease: ease_in_out]

#5.15s
  fade_out(target: capD, duration: 0.2s, ease: ease_in)

#5.35s
  fade_in(target: capE, duration: 0.2s, ease: expo_out)

#5.2s
  panel.grade.brightness = 1 [0.7s, ease: ease_out]
  pop_in(target: chip, duration: 0.4s, ease: expo_out)
  pop_in(target: chip_icon, duration: 0.4s, ease: expo_out)

#5.5s
  shake(target: chip, duration: 0.5s)
  pulse(target: chip, duration: 0.4s)
  shake(target: chip_icon, duration: 0.5s)
  pulse(target: chip_icon, duration: 0.4s)

// Outro: the scene closes the way a `Filter` scope works — it loses detail
// before it loses existence. The chain swallows the plate — blur up, vignette in,
// brightness to a dusk — while the cast stays standing: an erase cascade here would
// only have blanked the figure through the `hold` at the end of the loop, which the
// embed already dissolves into the next cycle.
#6.4s
  panel.soft.radius = 18 [0.7s, ease: ease_in]
  panel.vig.amount = 0.5 [0.7s, ease: ease_in]
  panel.grade.brightness = 0.62 [0.6s, ease: ease_in]
