// morph.amx — tour §04: re-declaration morphing with strategies.
// Adapted from examples/animation/05_morph.amx.
//
// The cast contains NO state shapes: every beat is Polygon→Polygon with the
// same point count on both ends — that is what makes a span interpolate a
// real hybrid instead of pinching to a silhouette swap (the engine has no
// cross-fade between state-shape geometry or between mismatched point
// counts; docs/roadmap.md, "Morph: strategy: fade has no cross-fade for
// state shapes"). The circle is a 16-gon (1.6px flats — it reads as a
// circle), the square a phase-matched 16-gon, the match beat a 6-point
// square→hexagon. `auto` is taught twice (a circle settling into a square,
// a square tipping into a diamond).
//
// Captions are five separate `Text` actors that hand off — one fully faded
// out before the next fades in — instead of re-assigning one shared actor's
// `text`: an assignment swaps by cross-fading the two strings on top of each
// other (and a duration-free one lands a beat early). The finale unifies on
// amber; coral stays a per-beat accent.

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 11.4 }

// Caption hand-off ladder: authored 0.0 is the hidden seed; each entrance
// lifts it, each exit settles it before the next caption's entrance.
capA: Text, text: "strategy: auto", font_size: 22, color: text.secondary,
  anchor: scene.center, offset: (0, 250), opacity: 0.0
capM: Text, text: "strategy: match", font_size: 22, color: text.secondary,
  anchor: scene.center, offset: (0, 250), opacity: 0.0
capP3: Text, text: "path_arc: 0.3", font_size: 22, color: text.secondary,
  anchor: scene.center, offset: (0, 250), opacity: 0.0
capP25: Text, text: "path_arc: 0.25", font_size: 22, color: text.secondary,
  anchor: scene.center, offset: (0, 250), opacity: 0.0
capS: Text, text: "stretch: true", font_size: 22, color: text.secondary,
  anchor: scene.center, offset: (0, 250), opacity: 0.0

circle: Polygon, points: {(85, 0), (79, 32), (60, 60), (32, 79), (0, 85), (-32, 79), (-60, 60), (-79, 32), (-85, 0), (-79, -32), (-60, -60), (-32, -79), (0, -85), (32, -79), (60, -60), (79, -32)}, color: accent.primary, at: (320, 330)
rect: Polygon, points: {(0, -85), (85, -85), (85, 85), (0, 85), (-85, 85), (-85, -85)}, color: accent.success, at: (640, 330)
poly: Polygon, points: {(0, -85), (85, 0), (0, 85), (-85, 0)}, color: accent.warning, at: (960, 330)

#0.5s
stagger [100ms] {
  fade-in circle [500ms, ease: ease-out]
  fade-in rect [500ms, ease: ease-out]
  fade-in poly [500ms, ease: ease-out]
}

// Circle → square with auto strategy (both 16 points, phase-matched)
#1.9s
fade-in capA [200ms]

#2s
circle: Polygon, points: {(85, 0), (85, 35), (85, 85), (35, 85), (0, 85), (-35, 85), (-85, 85), (-85, 35), (-85, 0), (-85, -35), (-85, -85), (-35, -85), (0, -85), (35, -85), (85, -85), (85, -35)}, color: text.primary, at: (320, 330) [1s, strategy: auto]

#3.25s
fade-out capA [200ms]

// Square → hexagon with match strategy — vertex matching is what the label teaches
#3.45s
fade-in capM [200ms]

#3.5s
rect: Polygon, points: {(0, -95), (82, -48), (82, 48), (0, 95), (-82, 48), (-82, -48)}, color: accent.primary, at: (640, 330) [1s, strategy: match]

#4.75s
fade-out capM [200ms]

// Diamond → star with a path-arc hint
#4.95s
fade-in capP3 [200ms]

#5s
poly: Polygon, points: {(0, -95), (24, -30), (90, -30), (36, 12), (54, 78), (0, 42), (-54, 78), (-36, 12), (-90, -30), (-24, -30)}, color: accent.success, at: (960, 330) [1.5s, path_arc: 0.3]

#6.25s
fade-out capP3 [200ms]

// Star → diamond with a tighter arc: the return trip shows path_arc on a
// different vertex pairing than the five-point morph above.
#6.45s
fade-in capP25 [200ms]

#6.5s
poly: Polygon, points: {(0, -88), (88, 0), (0, 88), (-88, 0)}, color: accent.primary, at: (960, 330) [1.2s, path_arc: 0.25]

#7.65s
fade-out capP25 [200ms]

// The square (left) tips into a diamond under `auto` — 16 points on both
// ends, so the tip interpolates; its own caption window keeps two strategies
// out of one label.
#7.85s
fade-in capA [200ms]

#7.9s
circle: Polygon, points: {(88, 0), (62, 26), (44, 44), (26, 62), (0, 88), (-26, 62), (-44, 44), (-62, 26), (-88, 0), (-62, -26), (-44, -44), (-26, -62), (0, -88), (26, -62), (44, -44), (62, -26)}, color: accent.primary, at: (320, 330) [1s, strategy: auto]

#8.75s
fade-out capA [200ms]

// Square-based trapezoid with stretch normalization — Polygon→Polygon so
// the span interpolates (a state-shape Ellipse → Path collapsed mid-span).
#8.95s
fade-in capS [200ms]

#9s
rect: Polygon, points: {(-90, -52), (90, -52), (62, 52), (-62, 52)}, color: accent.warning, at: (640, 330) [1s, stretch: true]

// Unify on the brand amber as a finale
#9.8s
circle.color = accent.primary [500ms]
rect.color = accent.primary [500ms]
poly.color = accent.primary [500ms]

#10.4s
fade-out capS [300ms]

// Outro: quiet the plate before the wrap.
#10.6s
stagger [80ms] {
  fade-out circle [350ms]
  fade-out rect [350ms]
  fade-out poly [350ms]
}
