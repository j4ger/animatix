// plots.amx — tour §08: plots are actors; a curve traces itself with
// stroke_progress, a vector field fades in beside it.
//
// The trace is lit: the curve carries a wider, screen-blended copy of itself
// trimmed by the same progress, so the drawing tip arrives as light rather
// than as a hairline appearing out of a black field. The bloom is a second
// PlotCurve, not a filter — the tour page plays on the slim engine and this
// keeps the beat cheap.
//
// The traced curve is a ramp, not a flat accent: `stroke_gradient` is stamped
// for every `AllStrokePaths` actor, which includes `PlotCurve` — the plot
// pipeline seeds the ramp onto the track (`timeline/build/actor.rs`) and the
// primitive stamps it onto its own commands (`primitives/plot.rs`), so the
// gradient survives the `stroke_progress` trim.
import "../../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.5 }

title: Text, text: "Plots are actors too", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 56)

wash: Ellipse, size: (700, 700), at: (450, 400), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b9421a")), (55%, hex_color("8ab4f60a")), (100%, hex_color("8ab4f600"))}), blend: "screen"

main: Graph, x_domain: (-6, 6), y_domain: (-3, 3), size: (640, 420), stroke: stroke.default, at: (450, 400) {
sine: PlotCurve, kind: "cartesian", func: (x) => sin(x), color: accent.primary, stroke_width: 3, stroke_progress: 0, stroke_gradient: linear(0, {(0%, hex_color("f5b942")), (60%, hex_color("ffd60a")), (100%, hex_color("8ab4f6"))})
  // Same geometry, same trim, 18px and 22% alpha: the bloom.
sine_glow: PlotCurve, kind: "cartesian", func: (x) => sin(x), color: hex_color("ffd60a38"), stroke_width: 18, stroke_progress: 0, blend: "screen"
}

field: VectorField, func: (x, y) => (cos(x) * cos(y), -sin(x) * sin(y)), density: 9, color: accent.success, x_domain: (-2, 2), y_domain: (-2, 2), at: (1050, 390), size: (300, 300)

// The field's own light, so the right half of the plate is not empty when it
// arrives.
field_wash: Ellipse, size: (460, 460), at: (1050, 390), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("8fc7a320")), (60%, hex_color("8fc7a309")), (100%, hex_color("8fc7a300"))}), blend: "screen"

cap1: Text, text: "stroke_progress traces the curve", font_size: 22, color: text.secondary, anchor: scene.bottom, offset: (-270, -40)

cap2: Text, text: "the gradient field of sin(x)cos(y)", font_size: 22, color: text.secondary, at: (1050, 560)

#0s
  sine.stroke_progress = 0
  sine_glow.stroke_progress = 0

#0.4s
  fade_in(target: title, duration: 0.6s, ease: expo_out)
  fade_in(target: wash, duration: 0.8s, ease: expo_out)

#1s
  fade_in(target: main, duration: 0.6s, ease: expo_out)

// cap1 is up BEFORE the trace starts so the beat arrives labeled
#1.7s
  fade_in(target: cap1, duration: 0.4s, ease: expo_out)

#1.8s
  fade_in(target: sine, duration: 0.3s, ease: expo_out)
  fade_in(target: sine_glow, duration: 0.3s, ease: expo_out)
  sine.stroke_progress = 1 [2.4s, ease: ease_in_out]
  sine_glow.stroke_progress = 1 [2.4s, ease: ease_in_out]

// hand off to cap2 as the field beat starts
#4.4s
  fade_out(target: cap1, duration: 0.2s, ease: ease_in)

#4.6s
  fade_in(target: field_wash, duration: 0.7s, ease: expo_out)
  pop_in(target: field, duration: 0.6s, ease: expo_out)
  settle_in(target: cap2, duration: 0.4s, ease: expo_out)
  // No erase cascade: the embed dissolves the finished frame into the next cycle
  // itself, so clearing the plate only blanked the figure through the `hold` at the
  // end of the loop. The composition now rests complete.
