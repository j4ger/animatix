// components.amx — tour §10: import a module, instantiate its components.
// `lib/components.amx` is a copy of examples/lib/components.amx; the browser
// fetches it relative to the scene, the CLI resolves it from disk.
//
// The lead chip carries the brand amber (an imported component reads as
// part of the cast, not as grey UI); the #3.2 beat is a pulse + lift that
// actually registers on screen — a 16px shift is invisible at card scale.
// Captions hand off (one shared `text` actor would cross-fade two strings).
//
// The three boxes are bracketed by a dashed rule above and below and lit from
// behind, so the row sits ON a stage instead of floating in a void: the scene
// is about one definition producing several instances, and the rails are the
// shared frame those instances live in.

import "../../demos/lib/theme.amx"
import "../lib/components.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.0 }

heading: Text, text: "import once, instantiate many", font_size: 32,
  color: text.primary, anchor: scene.top, offset: (0, 56)

capI: Text, text: "import ../lib/components.amx", font_size: 22,
  color: text.secondary, anchor: scene.bottom, offset: (0, -48), opacity: 0.0
capX: Text, text: "one definition, three instances", font_size: 22,
  color: text.secondary, anchor: scene.bottom, offset: (0, -48), opacity: 0.0

wash: Ellipse, size: (760, 760), at: (640, 360),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b9421c"), (55%, "#8ab4f60b"), (100%, "#8ab4f600")}),
  blend: "screen"

// The shared frame: two dashed rules the three instances sit between.
rail_a: Path,
  commands: {move_to(250, 236), line_to(1030, 236)},
  stroke: stroke.default, stroke_width: 2, fill_opacity: 0.0,
  dash_pattern: {9, 7}
rail_b: Path,
  commands: {move_to(250, 484), line_to(1030, 484)},
  stroke: stroke.default, stroke_width: 2, fill_opacity: 0.0,
  dash_pattern: {9, 7}

row: Row, anchor: scene.center, gap: 28, align: "center" {
  c1: LabeledBox, label: "Query", width: 240, height: 140, text_size: 30
  c2: LabeledBox, label: "Key", width: 200, height: 140, text_size: 30,
    fill: accent.primary, text_color: (0.043, 0.055, 0.078, 1)
  c3: LabeledBox, label: "Value", width: 230, height: 140, text_size: 30
}

#0s
rail_a.dash_offset = 0
rail_a.dash_offset = 160 [6.0s, ease: linear]
rail_b.dash_offset = 0
rail_b.dash_offset = -160 [6.0s, ease: linear]

#0.4s
fade-in heading [600ms, ease: expo-out]
fade-in wash [700ms, ease: expo-out]
fade-in rail_a [450ms, ease: expo-out]
fade-in rail_b [450ms, ease: expo-out]

#0.6s
fade-in capI [300ms, ease: expo-out]

#1.0s
stagger [150ms] {
  settle-in c1 [500ms, ease: expo-out]
  settle-in c2 [500ms, ease: expo-out]
  settle-in c3 [500ms, ease: expo-out]
}

#2.4s
fade-out capI [200ms, ease: ease-in]

#2.6s
fade-in capX [300ms, ease: expo-out]

#3.2s
pulse c2 [400ms]
// anticipate: the row winds up 80ms before it lifts, which is what makes a
// 40px move read as a deliberate gesture rather than as a translate.
shift row [by: (0, -40), 500ms, ease: spring, anticipate: 80ms]

#4.6s
fade-out capX [200ms, ease: ease-in]

// No erase cascade: the embed dissolves the finished frame into the next cycle
// itself, so clearing the plate only blanked the figure through the `hold` at the
// end of the loop. The composition now rests complete.
