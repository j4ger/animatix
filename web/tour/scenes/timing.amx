// timing.amx — tour §02: sequence, stagger and the easing vocabulary.
// The five squares are one Row container; the cast is generated at build
// time by a `for` over an array of colors — layout and generation instead
// of five hand-copied lines. (For-expansion covers declarations, not the
// inside of stagger/sequence blocks: choreography stays explicit.)

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6.4 }

row: Row, anchor: scene.center, gap: 44, align: "center" {
  for color, i in {accent.primary, accent.success, accent.warning, accent.danger, text.primary} {
    square[i]: Rect, size: (70, 70), color: color
  }
}

#0.5s
stagger [120ms] {
  fade-in square[0] [500ms, ease: ease-out]
  fade-in square[1] [500ms, ease: ease-out]
  fade-in square[2] [500ms, ease: ease-out]
  fade-in square[3] [500ms, ease: ease-out]
  fade-in square[4] [500ms, ease: ease-out]
}

#2.5s
sequence {
  square[0].size = (100, 100) [400ms, ease: ease-out]
  square[1].size = (100, 100) [400ms, ease: ease-out]
  square[2].size = (100, 100) [400ms, ease: ease-out]
  square[3].size = (100, 100) [400ms, ease: ease-out]
  square[4].size = (100, 100) [400ms, ease: ease-out]
}

// five named eases, one per square
#5s
square[0].color = accent.danger [600ms, ease: linear]
square[1].color = accent.warning [600ms, ease: ease-in]
square[2].color = accent.primary [600ms, ease: ease-out]
square[3].color = accent.success [600ms, ease: ease-in-out]
square[4].color = accent.danger [600ms, ease: bounce]
