// timing.amx — tour §02: sequence, stagger and the easing vocabulary.
// The five squares are one Row container; the cast is generated at build
// time by a `for` over an array of colors — layout and generation instead
// of five hand-copied lines. (For-expansion covers declarations, not the
// inside of stagger/sequence blocks: choreography stays explicit.)
//
// The easing beat names each ease on screen: the finale palette uses all
// five distinct channels (amber/bone/coral/sage/steel) because here hue IS
// the per-square semantic channel — which is why the squares keep flat
// `color:` fills and the light under them is a separate actor.
//
// The curves are demonstrated by a DROP RACE, not by the squares: five
// neutral dots fall the same 105px under the same 900ms, each with its own
// ease, over a dashed guide. Mid-segment the frame reads as a bar chart of
// the five curves — linear is behind, ease-out is ahead, bounce has already
// landed and is still wobbling. A scale ramp cannot show that (1.25 -> 1.0
// is a 25% change on a 120px box, and every curve ends in the same place).
// The labels are hand-positioned at the Row's slot centres (x = 272 + 184i,
// from 5 slots of 120 + gap 64 centred on 640) so each name sits exactly
// under its square.

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.7 }

title: Text, text: "stagger · sequence · easing", font_size: 30, color: text.primary,
  anchor: scene.top, offset: (0, 56)

// One screen-blend pool behind the row: the plate stops being a black field
// with stickers on it. The ramp fades to transparent at its own edge, so a
// square box leaves no visible seam.
wash: Ellipse, size: (900, 900), at: (640, 380),
  fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#f5b9421e"), (50%, "#8ab4f60c"), (100%, "#8ab4f600")}),
  blend: "screen"

row: Row, anchor: scene.center, gap: 64, align: "center", offset: (0, -40) {
  for color, i in {accent.primary, text.primary, accent.warning, accent.success, accent.info} {
    square[i]: Rect, size: (120, 120), color: color, corner_radius: 14
  }
}

label_0: Text, text: "linear", font_size: 26, color: text.secondary, at: (272, 462)
label_1: Text, text: "ease-in", font_size: 26, color: text.secondary, at: (456, 462)
label_2: Text, text: "ease-out", font_size: 26, color: text.secondary, at: (640, 462)
label_3: Text, text: "ease-in-out", font_size: 26, color: text.secondary, at: (824, 462)
label_4: Text, text: "bounce", font_size: 26, color: text.secondary, at: (1008, 462)

// The race: start rail, landing rail, five neutral dots. The dots are bone,
// not the squares' hues — the position IS the read, and a coloured dot would
// compete with the channel above it.
rail_top: Path,
  commands: {move_to(212, 505), line_to(1068, 505)},
  stroke: stroke.default, stroke_width: 1, fill_opacity: 0.0,
  dash_pattern: {4, 6}
rail_bot: Path,
  commands: {move_to(212, 610), line_to(1068, 610)},
  stroke: stroke.default, stroke_width: 1, fill_opacity: 0.0,
  dash_pattern: {4, 6}

racers: Group {
  for x, i in {272, 456, 640, 824, 1008} {
    drop[i]: Ellipse, size: (24, 24), at: (x, 505),
      fill_gradient: radial((0.34, 0.28), 0.66, {(0%, "#ffffff"), (45%, "#ece7db"), (100%, "#7d786f")})
  }
}

#0.5s
fade-in title [500ms, ease: expo-out]
fade-in wash [700ms, ease: expo-out]
stagger [120ms] {
  pop-in square[0] [500ms, ease: expo-out]
  pop-in square[1] [500ms, ease: expo-out]
  pop-in square[2] [500ms, ease: expo-out]
  pop-in square[3] [500ms, ease: expo-out]
  pop-in square[4] [500ms, ease: expo-out]
}

#2.5s
sequence {
  square[0].scale = 1.25 [400ms, ease: ease-out]
  square[1].scale = 1.25 [400ms, ease: ease-out]
  square[2].scale = 1.25 [400ms, ease: ease-out]
  square[3].scale = 1.25 [400ms, ease: ease-out]
  square[4].scale = 1.25 [400ms, ease: ease-out]
}

// Labels arrive BEFORE the race (last one settles at 4.94 < 5.0) — they name
// curves that are about to run.
#4.4s
stagger [60ms] {
  fade-in label_0 [300ms, ease: expo-out]
  fade-in label_1 [300ms, ease: expo-out]
  fade-in label_2 [300ms, ease: expo-out]
  fade-in label_3 [300ms, ease: expo-out]
  fade-in label_4 [300ms, ease: expo-out]
}

#4.9s
fade-in rail_top [300ms, ease: expo-out]
fade-in rail_bot [300ms, ease: expo-out]
fade-in drop[0] [250ms, ease: expo-out]
fade-in drop[1] [250ms, ease: expo-out]
fade-in drop[2] [250ms, ease: expo-out]
fade-in drop[3] [250ms, ease: expo-out]
fade-in drop[4] [250ms, ease: expo-out]

// The race itself. Deliberately NO `anticipate:` here: a counter-move before
// the drop would be a sixth variable in a comparison that is only valid when
// all five starts are identical.
#5s
move drop[0] [to: (0, 105), 900ms, ease: linear]
move drop[1] [to: (0, 105), 900ms, ease: ease-in]
move drop[2] [to: (0, 105), 900ms, ease: ease-out]
move drop[3] [to: (0, 105), 900ms, ease: ease-in-out]
move drop[4] [to: (0, 105), 900ms, ease: bounce]

// Outro: quiet plate before the wrap.

// No erase cascade: the embed dissolves the finished frame into the next cycle
// itself, so clearing the plate only blanked the figure through the `hold` at the
// end of the loop. The composition now rests complete.
