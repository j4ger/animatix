// timing.amx — tour §02: sequence, stagger and the easing vocabulary.
// The five squares are one Row container; the cast is generated at build
// time by a `for` over an array of colors — layout and generation instead
// of five hand-copied lines. (For-expansion covers declarations, not the
// inside of stagger/sequence blocks: choreography stays explicit.)
//
// The easing beat names each ease on screen: the finale palette uses all
// five distinct channels (amber/bone/coral/sage/steel) because here hue IS
// the per-square semantic channel. The labels are hand-positioned at the
// Row's slot centres (x = 272 + 184i, from 5 slots of 120 + gap 64 centred
// on 640) so each name sits exactly under its square even after the squares
// outgrow their layout slots.

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.7 }

title: Text, text: "stagger · sequence · easing", font_size: 30, color: text.primary,
  anchor: scene.top, offset: (0, 56)

row: Row, anchor: scene.center, gap: 64, align: "center", offset: (0, -40) {
  for color, i in {accent.primary, text.primary, accent.warning, accent.success, accent.info} {
    square[i]: Rect, size: (120, 120), color: color
  }
}

label_0: Text, text: "linear", font_size: 26, color: text.secondary, at: (272, 462)
label_1: Text, text: "ease-in", font_size: 26, color: text.secondary, at: (456, 462)
label_2: Text, text: "ease-out", font_size: 26, color: text.secondary, at: (640, 462)
label_3: Text, text: "ease-in-out", font_size: 26, color: text.secondary, at: (824, 462)
label_4: Text, text: "bounce", font_size: 26, color: text.secondary, at: (1008, 462)

#0.5s
fade-in title [500ms, ease: expo-out]
stagger [120ms] {
  fade-in square[0] [500ms, ease: expo-out]
  fade-in square[1] [500ms, ease: expo-out]
  fade-in square[2] [500ms, ease: expo-out]
  fade-in square[3] [500ms, ease: expo-out]
  fade-in square[4] [500ms, ease: expo-out]
}

#2.5s
sequence {
  square[0].scale = 1.25 [400ms, ease: ease-out]
  square[1].scale = 1.25 [400ms, ease: ease-out]
  square[2].scale = 1.25 [400ms, ease: ease-out]
  square[3].scale = 1.25 [400ms, ease: ease-out]
  square[4].scale = 1.25 [400ms, ease: ease-out]
}

// five named eases, one per square — animating SCALE, not color: a color
// lerp cannot show an ease curve, and re-assigning the declared colors is
// an identity assignment (nothing moves). 1.25 -> 1.0 makes linear vs
// ease-in vs bounce visibly different. Scale rather than size: these squares
// live in a Row, so growing `size` reflows the slots and each label drifts off
// the square it names; `scale` paints without touching layout.
#5s
square[0].scale = 1.0 [600ms, ease: linear]
square[1].scale = 1.0 [600ms, ease: ease-in]
square[2].scale = 1.0 [600ms, ease: ease-out]
square[3].scale = 1.0 [600ms, ease: ease-in-out]
square[4].scale = 1.0 [600ms, ease: bounce]

// Labels arrive BEFORE the ease beat (last one settles at 4.94 < 5.0) —
// they name curves that are already over when they fade in.
#4.4s
stagger [60ms] {
  fade-in label_0 [300ms, ease: expo-out]
  fade-in label_1 [300ms, ease: expo-out]
  fade-in label_2 [300ms, ease: expo-out]
  fade-in label_3 [300ms, ease: expo-out]
  fade-in label_4 [300ms, ease: expo-out]
}

// Outro: quiet plate before the wrap.
#6.5s
stagger [80ms] {
  fade-out label_0 [300ms, ease: ease-in]
  fade-out label_1 [300ms, ease: ease-in]
  fade-out label_2 [300ms, ease: ease-in]
  fade-out label_3 [300ms, ease: ease-in]
  fade-out label_4 [300ms, ease: ease-in]
}

#6.9s
stagger [80ms] {
  fade-out square[0] [350ms, ease: ease-in]
  fade-out square[1] [350ms, ease: ease-in]
  fade-out square[2] [350ms, ease: ease-in]
  fade-out square[3] [350ms, ease: ease-in]
  fade-out square[4] [350ms, ease: ease-in]
}

#7.1s
fade-out title [300ms, ease: ease-in]
