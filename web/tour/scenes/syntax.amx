// syntax.amx — tour §01: actors and keyframes.
// One actor per line, one beat per keyframe stamp.
//
// The footer rail makes the lesson visible: it IS the timeline, and a tick
// pops onto it at exactly the moment each keyframe stamp fires, with a
// playhead sweeping the whole duration. Reading "one beat per stamp" off a
// flat list of numbers is abstract; watching five marks land under a moving
// head is not. The rail's ants march so the clock reads as running even in
// the gaps between beats.
import "../../../examples/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.2 }

title: Text, text: "Actors & keyframes", font_size: 34, color: text.primary, anchor: scene.top, offset: (0, 56)

// The light layer: one screen-blend pool under the cast. Its ramp fades to a
// transparent stop, which is what lets it ride to full opacity and still read
// as light instead of as a grey ellipse.
wash: Ellipse, size: (760, 760), at: (560, 400), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("f5b94224")), (50%, hex_color("f5b9420e")), (100%, hex_color("f5b94200"))}), blend: "screen"

// A ramp, not a flat fill — and the #2.9s beat re-keys the RAMP (same kind,
// same stop count), which is what makes the recolour beat visible at all:
// `fill_gradient` overrides the solid fill, so a plain `color:` assignment
// here would animate a value nothing reads.
box: Rect, size: (240, 240), at: (420, 390), corner_radius: 18, fill_gradient: linear(135, {hex_color("f5b942"), hex_color("ff8666")})

dot: Ellipse, size: (40, 40), at: (930, 560), fill_gradient: radial((0.34, 0.28), 0.66, {(0%, hex_color("ffb3b3")), (45%, hex_color("ff5c5c")), (100%, hex_color("b3123a"))})

// ── the timeline rail ───────────────────────────────────────────────
// x = 200 + (t / 7.2) * 880, so the five ticks sit at their own beat times.
rail: Path, commands: {move_to(200, 620), line_to(1080, 620)}, stroke: accent.info, stroke_width: 2, fill_opacity: 0, dash_pattern: {8, 6}

ticks: Group {
for x, i in {298, 396, 554, 677, 726} {
tick[i]: Rect, size: (3, 30), at: (x, 620), corner_radius: 1, color: accent.info
  }
}

head: Rect, size: (2, 56), at: (200, 620), color: accent.primary, opacity: 0

#0s
  rail.dash_offset = 0
  rail.dash_offset = 260 [6.3s, ease: linear]
  head.opacity = 0.22 [0.4s, ease: expo_out]
  always {
      head.at = (200 + 880 * (t / 7.2), 620)
    }

#0.3s
  fade_in(target: title, duration: 0.6s, ease: expo_out)
  fade_in(target: rail, duration: 0.45s, ease: expo_out)
  fade_in(target: wash, duration: 0.9s, ease: expo_out)

#0.8s
  settle_in(target: box, duration: 0.6s, ease: expo_out)
  pop_in(target: tick[0], duration: 0.28s)

#1.6s
  move(target: box, to: (220, 0), duration: 0.9s, ease: ease_in_out, anticipate: 0.08s)
  pop_in(target: tick[1], duration: 0.28s)

#2.9s
  box.size = (340, 130) [0.7s, ease: ease_out]
  box.fill_gradient = linear(135, {hex_color("ece7db"), hex_color("b9b3a6")}) [0.7s, ease: ease_out]
  pop_in(target: tick[2], duration: 0.28s)

// The dot beat starts right as the recolor settles — no dead gap.
#3.9s
  fade_in(target: dot, duration: 0.35s, ease: expo_out)
  pop_in(target: tick[3], duration: 0.28s)

#4.3s
  move(target: dot, to: (-290, 0), duration: 0.7s, ease: ease_in_out, anticipate: 0.06s)
  pop_in(target: tick[4], duration: 0.28s)
  // No erase cascade: the embed dissolves the finished frame into the next cycle
  // itself, so clearing the plate only blanked the figure through the `hold` at the
  // end of the loop. The composition now rests complete (measured: held ink was
  // 0%, peak 34-47%).
