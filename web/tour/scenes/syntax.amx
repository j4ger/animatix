// syntax.amx — tour §01: actors and keyframes.
// One actor per line, one beat per keyframe stamp.

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 7.2 }

title: Text, text: "Actors & keyframes", font_size: 34, color: text.primary,
  anchor: scene.top, offset: (0, 56)

box: Rect, size: (240, 240), color: accent.primary, at: (420, 390)
dot: Ellipse, size: (40, 40), color: accent.danger, at: (930, 390)

#0.3s
fade-in title [600ms, ease: ease-out]

#0.8s
fade-in box [500ms, ease: ease-out]

#1.6s
box.at = (640, 390) [900ms, ease: ease-in-out]

#2.9s
box.size = (340, 130) [700ms, ease: ease-out]
box.color = text.primary [700ms, ease: ease-out]

// The dot beat starts right as the recolor settles — no dead gap.
#3.9s
fade-in dot [350ms]

#4.3s
dot.at = (640, 390) [700ms, ease: bounce]

// Outro: empty the plate so the loop wraps from quiet, not from a full frame.
#6.3s
stagger [120ms] {
  fade-out dot [350ms]
  fade-out box [350ms]
}

#6.8s
fade-out title [400ms]
