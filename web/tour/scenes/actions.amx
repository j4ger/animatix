// actions.amx — tour §03: motion actions plus an always-driven satellite.
// Adapted from examples/animation/04_motion.amx.

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 9.4 }

actor: Rect, size: (100, 100), color: accent.primary, at: (640, 360)
// explicit opacity: the always block below owns `at`/`size` from frame 0,
// so no entrance action (and no keyframe conflict) applies.
pulse: Rect, size: (60, 60), color: accent.success, opacity: 1.0

#0.5s
fade-in actor [600ms, ease: ease-out]

#1.5s
shift actor [by: (180, 0), 800ms, ease: ease-in-out]

#2.5s
rotate actor [by: deg(90), 800ms, ease: ease-in-out]

#3.5s
scale actor [by: 1.4, 800ms, ease: bounce]

#4.5s
actor.color = accent.warning [600ms, ease: ease-in-out]

#5.5s
scale actor [by: 0.714, 800ms, ease: ease-in-out]

#6.5s
rotate actor [by: deg(-90), 800ms, ease: ease-in-out]

#7.5s
shift actor [by: (-180, 0), 800ms, ease: ease-in-out]

#8.5s
fade-out actor [600ms, ease: ease-in]

// Reactive expression: orbital motion, evaluated every frame. (Literal
// centre — `scene.center.x` is not available to frame-time expressions.)
always {
  pulse.at = (640 + 130 * cos(t * 2.0), 360 + 90 * sin(t * 2.0))
}
