// actions.amx — tour §03: motion actions plus an always-driven satellite.
// Adapted from examples/animation/04_motion.amx.
//
// The satellite carries its own `always { }` caption (tracking it by
// expression), so the reactive-expression differentiator reads as a language
// feature, not a stray dot. The orbit's ry clears the actor's band, and the
// actor returns to the brand amber after the recolor beat so the coral
// stays a one-beat accent.

import "../../demos/lib/theme.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 9.6 }

title: Text, text: "shift · rotate · scale · always", font_size: 30, color: text.primary,
  anchor: scene.top, offset: (0, 56)

actor: Rect, size: (160, 160), color: accent.primary, at: (640, 360)
// explicit opacity: the always block below owns `at`/`size` from frame 0,
// so no entrance action (and no keyframe conflict) applies. Authored 0 is
// the hidden-by-default seed; the #0.5s entrances lift it — without them
// the satellite hard-pops on every loop entry.
pulse: Rect, size: (60, 60), color: accent.success, opacity: 0.0
sat_label: Text, text: "always { }", font_size: 20, color: text.secondary, opacity: 0.0

#0.5s
fade-in title [500ms, ease: expo-out]
fade-in pulse [400ms, ease: expo-out]
fade-in sat_label [400ms, ease: expo-out]

#0.8s
fade-in actor [600ms, ease: expo-out]

#1.5s
shift actor [by: (160, 0), 800ms, ease: ease-in-out]

#2.5s
rotate actor [by: deg(90), 800ms, ease: ease-in-out]

#3.5s
scale actor [by: 1.4, 800ms, ease: ease-in-out]

#4.5s
actor.color = accent.warning [600ms, ease: ease-in-out]

#5.5s
scale actor [by: 0.714, 800ms, ease: ease-in-out]

// Back to the brand lead: coral was a one-beat accent, not a new owner.
#6.4s
actor.color = accent.primary [600ms, ease: ease-in-out]

#6.5s
rotate actor [by: deg(-90), 800ms, ease: ease-in-out]

#7.5s
shift actor [by: (-160, 0), 800ms, ease: ease-in-out]

// Reactive expression: orbital motion, evaluated every frame. (Literal
// centre — `scene.center.x` is not available to frame-time expressions.)
// The orbit is wide enough (rx 420, ry 200) that every pass clears the
// actor's travel band (shift is +/-160, scale peak 1.4): SAT-checked over
// the whole timeline, the tightest corner gap is ~10px at the diagonal
// crossings. rx 300 collided (max 18px penetration at t=6.0; rx 420 doubles the margin).
always {
  pulse.at = (640 + 420 * cos(t * 2.0), 360 + 200 * sin(t * 2.0))
  sat_label.at = pulse.at + (0, -52)
}

// Outro: hold the settled composition a beat, then quiet the plate.
#8.6s
fade-out actor [500ms, ease: ease-in]

#9.0s
fade-out sat_label [300ms, ease: ease-in]

#9.1s
fade-out pulse [300ms, ease: ease-in]

#9.25s
fade-out title [300ms, ease: ease-in]
