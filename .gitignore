# Local environments and credentials (templates remain versioned).
.env
.env.*
!.env.example
!.env.*.example
/.envrc
/.envrc.*
/.direnv/

# Local editor / agent state, never project source.
/.pi/
/.qoder/
/.picopi/
/.zcode/
/.zcodeignore
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Rust builds, profiles and mutation-test output.
target/
/target-*/
/debug/
*.rs.bk
*.pdb
mutants.out*/
/dhat-export.json

# Python and Node tooling caches.
__pycache__/
*.py[cod]
node_modules/

# Nix build result links and Cloudflare local state.
/result
/result-*
.wrangler/

# Generated web SDK / embed bundles (web/tools/build/build-web.sh and web/tools).
/web/pkg/
/web/pkg-slim/
/web/pkg-assets/
/web/runtime
/web/dev/pkg-hybrid-bench/
/web/embed/amx-player.js
/web/embed/amx-player.legacy.js
/web/**/*.br
/web/fonts/*.gz
/web/fonts/LICENSE-OpenSans.txt

# Astro and release staging. Sources, lockfiles and authored assets stay tracked.
/web/app/.astro/
/web/app/dist/
/_site/
/_site-*/
/_site.staging-*/
/dist/

# Local experiments and reports. Do not ignore fixtures or baseline snapshots.
/audit_log.txt
