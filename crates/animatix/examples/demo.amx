// Animatix Demonstration
// This file showcases timeline features, state morphing, and property interpolation.

// Initial state at 0 seconds
#0s
// shape1 starts as a red Circle
shape1: Circle, at: (100, 100), radius: 50, color: red
// shape2 starts as a yellow Square
shape2: Square, at: (700, 300), size: (50, 50), color: yellow

// Keyframe at 2 seconds
#2s
// shape1 morphs into a blue Square, moving and growing
shape1: Square, at: (400, 300), size: (150, 150), color: blue
// shape2 morphs into a purple Circle, moving and growing
shape2: Circle, at: (400, 100), radius: 75, color: purple

// Keyframe at 4 seconds
#4s
// shape1 morphs back into a green Circle, moving further right
shape1: Circle, at: (700, 100), radius: 50, color: green
// shape2 morphs back into an orange Square, moving further left
shape2: Square, at: (100, 300), size: (100, 100), color: orange
