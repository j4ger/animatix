#0s
c1: Circle, radius: 100, at: (200, 200), color: "#ff0000", stroke_width: 10, stroke_color: "#ffffff"
r1: Rect, size: (150, 100), at: (500, 200), color: "#00ff00", stroke_width: 5, stroke_color: "#0000ff"

