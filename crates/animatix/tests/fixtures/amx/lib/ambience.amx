// Opt-in scene statistics recipe for a small cast with keyframed positions.
import "../../../../../../web/content/templates/layout.amx"

pub component Ambience(tint: Color = accent.primary, strength: Num = 0.08) {
  plate: Backdrop
  wash: FocusWash, tint: tint, strength: strength
  always {
    let dx = (curve_at(scene.stats.focus_x, t) - scene_width / 2) * 0.16
    let dy = (curve_at(scene.stats.focus_y, t) - scene_height / 2) * 0.16
    self.wash.at = (
      scene_width / 2 + clamp(dx, -0.03 * scene_width, 0.03 * scene_width),
      scene_height / 2 + clamp(dy, -0.03 * scene_height, 0.03 * scene_height)
    )
  }
}
