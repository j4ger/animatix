import "../lib/ambience.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6, seamless_loop: true }

// Only the two moving actors contribute to the follow signal.
let wash_strength = 0.08
bg: Ambience, strength: wash_strength

hero: Ellipse, size: (120, 120), color: accent.primary, at: (320, 360), opacity: 1

satellite: Rect, size: (70, 70), corner_radius: 12, color: accent.secondary, at: (960, 360), opacity: 1

#0s
  hero.at = (320, 360)
  satellite.at = (960, 360)

#1.5s
  hero.at = (640, 240) [ease: ease_in_out]
  satellite.at = (640, 480) [ease: ease_in_out]

#3s
  hero.at = (960, 360) [ease: ease_in_out]
  satellite.at = (320, 360) [ease: ease_in_out]

#4.5s
  hero.at = (640, 480) [ease: ease_in_out]
  satellite.at = (640, 240) [ease: ease_in_out]

#6s
  hero.at = (320, 360) [ease: ease_in_out]
  satellite.at = (960, 360) [ease: ease_in_out]
