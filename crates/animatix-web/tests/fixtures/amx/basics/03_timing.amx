import "../../../../../animatix/examples/web_present_driver/fixtures/lib/theme.amx"

import "../../../../../animatix/examples/web_present_driver/fixtures/lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor

head: ActHead, kicker: "BASICS · TIMING", title: "Sequence, Stagger & Easing"

caption: Caption, text: "03_timing.amx", tag: "basics"

a: Rect, size: (70, 70), color: accent.primary, anchor: scene.center, offset: (-400, 0)

b: Rect, size: (70, 70), color: accent.success, anchor: scene.center, offset: (-200, 0)

c: Rect, size: (70, 70), color: accent.warning, anchor: scene.center, offset: (0, 0)

d: Rect, size: (70, 70), color: accent.danger, anchor: scene.center, offset: (200, 0)

e: Rect, size: (70, 70), color: text.primary, anchor: scene.center, offset: (400, 0)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s)

#0.6s
  stagger [0.12s] {
      fade_in(target: a, duration: 0.5s, ease: ease_out)
      fade_in(target: b, duration: 0.5s, ease: ease_out)
      fade_in(target: c, duration: 0.5s, ease: ease_out)
      fade_in(target: d, duration: 0.5s, ease: ease_out)
      fade_in(target: e, duration: 0.5s, ease: ease_out)
    }

#2.5s
  sequence {
      a.size = (100, 100) [0.4s, ease: ease_out]
      b.size = (100, 100) [0.4s, ease: ease_out]
      c.size = (100, 100) [0.4s, ease: ease_out]
      d.size = (100, 100) [0.4s, ease: ease_out]
      e.size = (100, 100) [0.4s, ease: ease_out]
    }

#5s
  a.color = accent.danger [0.6s, ease: linear]
  b.color = accent.warning [0.6s, ease: ease_in]
  c.color = accent.primary [0.6s, ease: ease_out]
  d.color = accent.success [0.6s, ease: ease_in_out]
  e.color = accent.danger [0.6s, ease: bounce_in]
