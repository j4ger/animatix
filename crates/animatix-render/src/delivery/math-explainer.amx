import "./layout.amx"

pub let study = Colorscheme {
  extends: "paper",
  scene.background: hex_color("f5f1e9"),
  surface.primary: hex_color("fffcf5"),
  stroke.default: hex_color("d7cec0"),
  text.primary: hex_color("252930"),
  text.secondary: hex_color("56534f"),
  accent.primary: hex_color("4436a0")
}
config { resolution: (1280, 720), duration: 7, colorscheme: "study", style: "editorial" }

let heading = "Approximating cosine"
let takeaway = "A quadratic matches cosine’s curvature at zero. The fit weakens farther away."
let formula = "$ 1 - frac(x^2, 2!) $"
let horizontal_domain = (-5.6, 5.6)
let vertical_domain = (-2, 2)
let reference_fn = (x) => cos(x)
let approximation_fn = (x, progress) => 1 - progress * x^2 / 2

let with_notes = formula != ""
let weight = 0
let figure_size = (figure_width(with_notes), figure_height(with_notes))
let chart_inset = 6 * unit()
let chart_size = figure_size - (2 * chart_inset, 2 * chart_inset)
let equation_width = if stacked() { content_width() } else { notes_width() }

#0s
  backdrop: Backdrop, tint: surface.primary
  head: ChapterHeader, eyebrow: "FUNCTION APPROXIMATION", heading: heading
  figure: Panel, size: figure_size, inset: chart_inset,
    at: (theme.margin + figure_size[0] / 2, figure_top() + figure_size[1] / 2) {
    @content {
      chart_window: Mask, size: chart_size {
        chart: Graph, size: chart_size,
          x_domain: horizontal_domain, y_domain: vertical_domain {
          exact: PlotCurve, role: reference, func: (x) => reference_fn(x)
          estimate: PlotCurve, role: focus, func: (x) => approximation_fn(x, weight)
        }
      }
    }
  }
  for index in range(0, if with_notes { 1 } else { 0 }) {
    equation: Col, gap: theme.gap * 0.50, align: "center",
      at: (
        if stacked() { scene_width / 2 } else { scene_width - theme.margin - notes_width() / 2 },
        if stacked() { figure_top() + figure_size[1] + figure_gap() + notes_height() / 2 }
        else { figure_top() + figure_size[1] / 2 }
      ),
      size: (equation_width, notes_height()) {
      equation_label: Text, text: "QUADRATIC TARGET", role: eyebrow
      expression: Typst, text: formula, role: roles::formula,
        text_max_width: equation_width - theme.inset
      key: Text, text: "Reference · cos x", role: note
    }
  }
  conclusion: Text, text: takeaway, role: body, text_anchor: "left",
    text_max_width: content_width(), at: (theme.margin, takeaway_y())

  always {
    weight = ease_in_out(clamp((t - 0.9) / 3.4, 0, 1))
  }
