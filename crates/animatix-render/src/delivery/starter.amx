// Edit the scene here. The two audio files can travel with this directory.
config { duration: 30, resolution: (640, 360) }
scene.background_color = "#101827"

voice: Audio, source: "narration.mp3", transcript: "narration.speech.json"

title: Text, text: "Animatix", at: (320, 95), font_size: 60, color: "#f5f7ff", opacity: 1
tagline: Text, text: "Animation for technical storytelling", at: (320, 180), font_size: 26, color: "#b4c6e7"
rule: Rect, size: (150, 4), at: (320, 233), color: "#5eead4"
subtitles: Captions, at: (320, 301), transcript: "narration.speech.json",
  font_size: 21, text_max_width: 544, opacity: 1

#voice@feature
  fade_in(target: tagline, duration: 400ms)

#voice@captions
  fade_in(target: rule, duration: 400ms)
