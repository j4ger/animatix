import "./layout.amx"

config { resolution: (1280, 720), duration: 6, colorscheme: "editorial-dark", style: "editorial" }

let heading = "Release readiness"
let takeaway = "Performance is within budget. Close the final review before shipping."
let passing = "42 / 42"
let latency = "184 ms"
let reviews = "1 open"

let metrics = {
  {"TEST COVERAGE", passing, "Checks passing"},
  {"P95 LATENCY", latency, "Budget · 200 ms"},
  {"RELEASE REVIEW", reviews, "Blocking approval"}
}
let count = metrics.length
let columns = if stacked() { 1 } else { count }
let rows = count / columns
let gap = theme.gap
let card_width = (content_width() - (columns - 1) * gap) / columns
let card_height = if stacked() {
  min(168 * unit(), (takeaway_y() - figure_top() - 78 * unit() - (rows - 1) * gap) / rows)
} else { 196 * unit() }
let grid_height = rows * card_height + (rows - 1) * gap
let grid_center = (scene_width / 2, if stacked() { figure_top() + grid_height / 2 } else { scene_height / 2 })
let entrance = 350ms

#0s
  backdrop: Backdrop
  fill_light: FocusWash, at: grid_center,
    tint: lerp_color(surface.secondary, accent.primary, 0.24), strength: 0.10
  head: ChapterHeader, eyebrow: "ENGINEERING UPDATE", heading: heading
  grid: Grid, cols: columns, size: (content_width(), grid_height), at: grid_center, gap: gap {
    for record, i in metrics {
      card[i]: MetricCard, label: record[0], value: record[1], detail: record[2],
        width: card_width, height: card_height, opacity: 0,
        ink: if i == count - 1 { accent.warning } else { text.primary }, raised: i == count - 1
    }
  }
  summary: Text, text: takeaway, role: body, text_anchor: "left",
    text_max_width: content_width(), at: (theme.margin, takeaway_y()), opacity: 0
  let cards = tabulate(count, (i) => grid.card[i])
  stagger_each(cards, 180ms, (card) => fade_in(target: card, duration: entrance))
  fade_in(target: summary, duration: entrance, delay: 550ms)
