// Runnable example: graph plotting with Cartesian and polar curves, plus animated graph sizing/position.

#0s
let ink = (0.04, 0.06, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let caption_ink = (0.60, 0.69, 0.80, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let gold = (0.98, 0.82, 0.42, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Plotting demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Cartesian and polar curves share the same Graph runtime and animate like any other actor", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The graph starts compact and centered, then grows and shifts to prove plot composition and animated graph transforms.", font_size: 16, color: caption_ink, anchor: scene.top, offset: (0, 136) }

legend_a: Text { text: "y = x^2 - 2", font_size: 18, color: coral, at: (242, 236) }
legend_b: Text { text: "y = 1 / x", font_size: 18, color: gold, at: (242, 264) }
legend_c: Text { text: "r = 3 sin(4t)", font_size: 18, color: green, at: (242, 292) }

graph: Graph, x_domain: (-5, 5), y_domain: (-5, 25), size: (520, 420), at: (640, 390) {
  parabola: CartesianPlot, func: (x) => x * x - 2, color: coral, width: 2,
  asymptote: CartesianPlot, func: (x) => 1 / x, color: gold, tolerance: 0.1, max_depth: 12,
  rose: PolarPlot, func: (t) => 3 * sin(4 * t), t_domain: (0, 6), stroke: green, width: 2
}

footer: Text { text: "Animated size and placement keep the plot readable during scrubbing and playback.", font_size: 16, color: subtitle_ink, anchor: scene.bottom, offset: (0, -48) }

#2s
graph.size = (640, 500) [2s, ease: ease-in-out]

#5s
graph.at = (700, 390) [1.5s, ease: ease-in-out]
