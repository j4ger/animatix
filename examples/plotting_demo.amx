#0s
scene.background_color = (0.08, 0.08, 0.12, 1.0)

title: Text { text: "Plotting Demo", font_size: 30, color: (1.0, 1.0, 1.0, 1.0), at: (640, 60) }

graph: Graph, x_domain: (-5, 5), y_domain: (-5, 25), size: (520, 420), at: (640, 380) {
  parabola: CartesianPlot, func: (x) => x * x - 2, color: (1.0, 0.35, 0.35, 1.0), width: 2,
  asymptote: CartesianPlot, func: (x) => 1 / x, color: (1.0, 0.75, 0.20, 1.0), tolerance: 0.1, max_depth: 12,
  rose: PolarPlot, func: (t) => 3 * sin(4 * t), t_domain: (0, 6), stroke: (0.25, 0.95, 0.55, 1.0), width: 2
}

#2s
graph.size = (640, 500) [2s]

#5s
graph.at = (700, 380) [1.5s, ease: ease-in-out]
