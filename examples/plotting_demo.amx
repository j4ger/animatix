// Runnable example: graph plotting with Cartesian and polar curves, plus animated graph sizing/position.

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Plotting demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Cartesian and polar curves share the same Graph runtime and animate like any other actor.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The graph starts compact and centered, then grows and shifts so plot composition and graph transforms stay readable during scrubbing.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

legend_a: Text { text: "y = x^2 - 2", font_size: 18, color_role: accent.danger, at: (242, 236) }
legend_b: Text { text: "y = 1 / x", font_size: 18, color_role: accent.warning, at: (242, 264) }
legend_c: Text { text: "r = 3 sin(4t)", font_size: 18, color_role: accent.success, at: (242, 292) }

graph: Graph, x_domain: (-5, 5), y_domain: (-5, 25), size: (520, 420), at: (640, 390) {
  parabola: CartesianPlot, func: (x) => x * x - 2, color: accent.danger, width: 2,
  asymptote: CartesianPlot, func: (x) => 1 / x, color: accent.warning, tolerance: 0.1, max_depth: 12,
  rose: PolarPlot, func: (t) => 3 * sin(4 * t), t_domain: (0, 6), stroke: accent.success, width: 2
}

footer: Text { text: "Animated size and placement keep the plot readable during scrubbing and playback.", font_size: 16, color_role: text.secondary, anchor: scene.bottom, offset: (0, -64) }

#2s
graph.size = (640, 500) [2s, ease: ease-in-out]

#5s
graph.at = (700, 390) [1.5s, ease: ease-in-out]
