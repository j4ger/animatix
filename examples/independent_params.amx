// Independent Parameter Morphing Demo
// Showcases how inherited properties allow staggering animations
// for different parameters using different easings.

#0s
// Start as a small red square on the left
morpher: Square, at: (100, 300), size: (50, 50), color: red

#1s
// 1. Move to the right quickly (only position changes)
morpher: Square, at: (700, 300) [ease: ease-out]

#2.5s
// 2. Grow large with a bounce (only size changes, position remains 700,300)
morpher: Square, size: (200, 200) [ease: bounce]

#4s
// 3. Morph into a blue circle (shape and color change)
morpher: Circle, color: blue [ease: ease-in-out]
