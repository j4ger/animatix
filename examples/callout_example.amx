// Example demonstrating the Callout primitive
//
// Coordinate-based: `from`/`to` set explicit endpoints.
// Targeted mode: `target: actor` auto-places the arrow tip on the actor;
//   `place: (side)` chooses which side (top/bottom/left/right/auto),
//   `standoff` adds gap between tip and actor edge,
//   `to_offset` nudges the tip after placement (GUI drag handle result).

config {
    colorscheme: "editorial-dark",
    resolution: (1280, 720),
}

// Static callout — points from (100, 100) to (300, 200)
// with label "Important Point" offset by (10, -10) from the arrow tip
callout1: Callout {
    from: (100, 100),
    to: (300, 200),
    label: "Important Point",
    label_at: (10, -10),
    color: (1.0, 0.0, 0.0, 1.0),
}

// Animated callout — the target moves across the scene
callout2: Callout {
    from: (50, 300),
    to: (200, 300),
    label: "Moving Target",
    label_at: (0, 15),
    color: (0.0, 0.0, 1.0, 1.0),
}

// Animate the target position of callout2
#0s
callout2.to = (200, 300)

#2s
callout2.to = (400, 300) [2s, ease: ease-in-out]

#4s
callout2.to = (200, 300) [2s, ease: ease-in-out]

// ── Targeted mode ──────────────────────────────────────────────────────────
// The actor being annotated
box1: Rect {
    at: (700, 200),
    size: (120, 60),
    color: (0.2, 0.6, 0.9, 1.0),
}

// Callout that tracks `box1` automatically.
// `place: bottom` puts the arrow tip on the bottom edge.
// `standoff: 8` leaves an 8px gap between tip and edge.
// `to_offset` is the fine-tune set by GUI drag; (0,0) means no adjustment.
callout3: Callout {
    from: (500, 400),
    target: box1,
    place: bottom,
    standoff: 8,
    to_offset: (0, 0),
    label: "Tracked Actor",
    label_at: (0, -20),
    color: (1.0, 0.8, 0.0, 1.0),
}
