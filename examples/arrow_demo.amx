// Runnable example: straight arrow primitive built on the vector path pipeline.

#0s
let ink = (0.04, 0.05, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Arrow primitive demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Arrow reuses line-style local coordinates and adds generated vector head geometry", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The directional relationship is staged clearly so the draw-in action reads as transport, not decoration.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

source: Rect, size: (150, 80), color: green, stroke: title_ink, stroke_width: 4, at: (300, 430)
target: Rect, size: (150, 80), color: accent, stroke: title_ink, stroke_width: 4, at: (980, 430)
label: Text { text: "Throughput", font_size: 24, color: title_ink, at: (640, 346) }

flow: Arrow, from: (-220, 0), to: (220, 0), tip_length: 34, tip_width: 24, color: coral, stroke: title_ink, stroke_width: 4, at: (640, 430)

#0s
draw-in flow [900ms]
