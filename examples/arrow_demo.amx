// Arrow shape demonstration: directional arrows with customizable heads.
// In Animatix, arrows are created using `Line` with the `size` property
// controlling arrowhead dimensions: `size: (tip_length * 2, tip_width * 2)`.

config { colorscheme: "editorial-dark" }

#0s
// Basic arrow with default head (size: 0, 0 means no arrowhead)
// To show an arrowhead, set size to (tip_length * 2, tip_width * 2)
arrow1: Line, from: (200, 300), to: (400, 300), color: accent.primary, width: 3, size: (24, 20)

// Arrow with larger head
arrow2: Line, from: (500, 250), to: (500, 450), color: accent.success, width: 4, size: (40, 32)

// Small annotation arrow
arrow3: Line, from: (700, 350), to: (850, 280), color: accent.warning, width: 2, size: (20, 16)

#2s
arrow1.to = (450, 350) [1.5s, ease: ease-in-out]

#4s
arrow3.from = (720, 380) [1s]
