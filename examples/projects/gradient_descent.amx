// Gradient Descent Animation
// A visual walkthrough of gradient descent on a 2D loss surface:
// loss surface → against the gradient → roll to the minimum → step size matters.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

// =============================================================================
// Scene 1: Title card
// =============================================================================
# TitleCard
config { colorscheme: "editorial-dark" }

title: Text, text: "Gradient Descent", font_size: 64,
  color: text.primary, anchor: scene.center, offset: (0, -40)

subtitle: Text, text: "Rolling down the loss surface", font_size: 28,
  color: text.secondary, anchor: scene.center, offset: (0, 40)

#0.5s
fade-in title [800ms, ease: ease-out]

#1.4s
fade-in subtitle [600ms, ease: ease-out]

play LossSurface [fade, 400ms]

// =============================================================================
// Scene 2: Show the loss surface contours with gradient vector field
// =============================================================================
# LossSurface
config { colorscheme: "editorial-dark" }

step_title: Text, text: "1. The Loss Surface", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Contour map of the loss function f(x, y) = x² + y²
contours: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0

// Gradient vector field: ∇f = (2x, 2y) pointing radially outward (uphill)
field: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  color: text.muted

// Global minimum at (0, 0)
min_dot: Ellipse, size: (12, 12), color: accent.success, at: (400, 380)

caption: Text,
  text: "Contours = equal loss  ·  Arrows = gradient (uphill)",
  font_size: 16, color: text.muted, anchor: scene.bottom, offset: (0, -40)

#0.5s
fade-in step_title [500ms, ease: ease-out]

#1.0s
stagger [150ms] {
  fade-in contours [600ms]
  fade-in field [600ms]
  fade-in min_dot [400ms]
}

#3.5s
fade-in caption [500ms]

play GradientDirection [wipe-left, 400ms]

// =============================================================================
// Scene 3: Show which direction to step — against the gradient
// =============================================================================
# GradientDirection
config { colorscheme: "editorial-dark" }

step2_title: Text, text: "2. Go Against the Gradient", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed backdrop of the same contour map and field
contours_bg: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0, opacity: 0.4

field_bg: VectorField, func: (x, y) => (x, y), density: 8,
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  color: text.muted, opacity: 0.4

// Ball at starting point (math: (3, 2.4), screen: 400+3*70, 380-2.4*70)
ball: Ellipse, size: (16, 16), color: accent.warning, at: (610, 212)

// Arrow pointing uphill along +∇f
up_arrow: Arrow, from: (610, 212), to: (715, 128),
  color: accent.danger, stroke_width: 3

// Arrow pointing downhill along −∇f
down_arrow: Arrow, from: (610, 212), to: (505, 296),
  color: accent.success, stroke_width: 3

// Labels near arrow tips
up_label: Text, text: "∇f (uphill)", font_size: 16,
  color: accent.danger, at: (730, 110)

down_label: Text, text: "−∇f (descend)", font_size: 16,
  color: accent.success, at: (480, 300)

// Gradient equation
gradient_eq: Typst,
  content: "$nabla f = (partial f)/(partial x), (partial f)/(partial y)$",
  font_size: 22, color: text.secondary, anchor: scene.center, offset: (400, 0)

#0.5s
fade-in step2_title [500ms, ease: ease-out]
fade-in ball [400ms]

#1.5s
fade-in up_arrow [800ms]
fade-in up_label [800ms]

#2.0s
fade-in gradient_eq [600ms]

#3.2s
fade-in down_arrow [800ms]
fade-in down_label [800ms]

#3.5s
highlight ball [600ms, intensity: 1.3]

play Descent [fade, 400ms]

// =============================================================================
// Scene 4: Roll the ball to the minimum along the descent trail
// =============================================================================
# Descent
config { colorscheme: "editorial-dark" }

step3_title: Text, text: "3. Roll to the Minimum", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed contour backdrop
contours_dim: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0, opacity: 0.3

// Graph with the parametric descent trail. For f(x, y) = x² + y² the
// gradient is radial, so steepest descent stays on a constant-angle ray.
descent_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (560, 560), at: (400, 380) {
  trail: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.warning, stroke_width: 3,
    stroke_progress: 0
}

// Ball driven by the always block (math coords → screen coords)
ball: Ellipse, size: (16, 16), color: accent.warning, at: (610, 212)

// Live loss readout
live_loss: Text, text: "loss = 14.75", font_size: 18,
  color: accent.warning, at: (650, 130)

// Takeaway text
takeaway: Text, text: "Follow −∇f → reach the minimum", font_size: 22,
  color: text.secondary, anchor: scene.center, offset: (0, 260)

always {
  let s = clamp(t - 1.0, 0.0, 4.5)
  let r = 3.84 * exp(-0.55 * s)
  let th = 0.676 + 2.6 * s
  let mx = r * cos(th)
  let my = r * sin(th)
  ball.at = descent_graph.map(mx, my)
  let loss = r * r
  live_loss.text = format("loss = {}", loss)
}

#0.5s
fade-in step3_title [500ms, ease: ease-out]
fade-in contours_dim [600ms]

#1.0s
fade-in ball [400ms]
fade-in live_loss [400ms]
trail.stroke_progress = 1.0 [4.5s, ease: ease-out]

#5.7s
highlight ball [600ms, intensity: 1.4]

#6.5s
fade-in takeaway [600ms]

play LearningRate [fade, 400ms]

// =============================================================================
// Scene 5: Compare three step sizes — too small, just right, too big
// =============================================================================
# LearningRate
config { colorscheme: "editorial-dark" }

step4_title: Text, text: "4. Step Size Matters", font_size: 40,
  color: text.primary, anchor: scene.top, offset: (0, 60)

// Dimmed contour backdrop
contours_lr: ContourSet, func: (x, y) => x^2 + y^2, levels: {1, 4, 9, 16, 25},
  x_domain: (-4, 4), y_domain: (-4, 4), size: (560, 560), at: (400, 380),
  resolution: 96, color: accent.primary, stroke_width: 2.0, opacity: 0.3

// Graph with three parametric curves showing different decay rates.
// All stay on the same radial ray; only the rate toward/away from the
// minimum changes, matching the radial gradient of x² + y².
lr_graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4),
  size: (560, 560), at: (400, 380) {
  too_small: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.12 * s) * cos(0.676),
                  3.84 * exp(-0.12 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: text.muted, stroke_width: 2, opacity: 0.0
  just_right: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(-0.55 * s) * cos(0.676),
                  3.84 * exp(-0.55 * s) * sin(0.676)),
    t_domain: (0, 4.5), color: accent.success, stroke_width: 3, opacity: 0.0
  too_big: PlotCurve, kind: "parametric",
    func: (s) => (3.84 * exp(0.15 * s) * cos(0.676),
                  3.84 * exp(0.15 * s) * sin(0.676)),
    t_domain: (0, 2.5), color: accent.danger, stroke_width: 2, opacity: 0.0
}

// Labels for each curve
label_small: Text, text: "Too small → slow", font_size: 14,
  color: text.muted, at: (650, 200)
label_right: Text, text: "Just right → converges", font_size: 14,
  color: accent.success, at: (650, 230)
label_big: Text, text: "Too big → diverges", font_size: 14,
  color: accent.danger, at: (650, 260)

// Lesson text
lesson: Text,
  text: "Pick a learning rate that converges — not too small, not too large",
  font_size: 20, color: text.secondary, anchor: scene.center, offset: (0, 280)

#0.5s
fade-in step4_title [500ms, ease: ease-out]
fade-in contours_lr [600ms]

#1.0s
stagger [400ms] {
  fade-in too_small [600ms]
  fade-in just_right [600ms]
  fade-in too_big [600ms]
}

#3.5s
fade-in label_small [400ms]
fade-in label_right [400ms]
fade-in label_big [400ms]

#5.0s
fade-in lesson [600ms]

play Outro [fade, 400ms]

// =============================================================================
// Scene 6: Outro — the goal of gradient descent
// =============================================================================
# Outro
config { colorscheme: "editorial-dark" }

thanks: Typst, content: "$theta^* = min_(theta) L(theta)$",
  font_size: 40, color: text.primary, anchor: scene.center, offset: (0, -30)

tag: Text, text: "gradient descent  ·  animatix", font_size: 18,
  color: text.muted, anchor: scene.center, offset: (0, 50)

#0.5s
fade-in thanks [700ms, ease: ease-out]

#1.0s
fade-in tag [500ms, ease: ease-out]

#2.2s
fade-out thanks [300ms]
fade-out tag [300ms]
