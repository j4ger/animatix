// 14 — Multi-Scene Composition
// Refactored to house-style three-act template.

import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

# Setup
config { duration: 5 }
floor: StageFloor
head: ActHead, kicker: "ACT I · SETUP", title: "Intro"
caption: Caption, text: "Multi-Scene Composition.", tag: "intro"

#0s
fade-in floor [500ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.5s
title: Text, text: "Multi-Scene", font_size: 72, color: text.primary, anchor: scene.center, offset: (0, -30)
sub: Text, text: "Composition & Transitions", font_size: 24, color: text.secondary, anchor: scene.center, offset: (0, 30)
fade-in title [800ms, ease: ease-out]
fade-in sub [500ms, delay: 200ms]

#4.5s
play Develop [wipe-left, 500ms]

# Develop
config { duration: 6 }
floor: StageFloor
head: ActHead, kicker: "ACT II · DEVELOP", title: "Diagram"
caption: Caption, text: "The mechanism: multiple scenes linked.", tag: "diagram"

#0s
fade-in floor [500ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.8s
graph: Graph, x_domain: (-4, 4), y_domain: (-4, 4), size: (500, 500), anchor: scene.center {
  sine: PlotCurve, kind: "cartesian", func: (x) => sin(x) * 2, color: accent.primary, width: 3
  cosine: PlotCurve, kind: "cartesian", func: (x) => cos(x) * 2, color: accent.success, width: 2
}
fade-in graph [800ms]

#5.5s
play Payoff [fade, 500ms]

# Payoff
config { duration: 6 }
floor: StageFloor
head: ActHead, kicker: "ACT III · PAYOFF", title: "Transitions"
caption: Caption, text: "Demonstrating various transitions.", tag: "outro"

#0s
fade-in floor [500ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.5s
thanks: Text, text: "Transitions", font_size: 64, color: text.primary, anchor: scene.center
fade-in thanks [700ms]

#2.5s
// Demonstrate transitions
transition_label: Text, text: "Transition: cut", font_size: 40, color: accent.danger, anchor: scene.center, offset: (0, 100)
fade-in transition_label [300ms]
#3.5s
transition_label.text = "Transition: wipe-right" [300ms]
#4.5s
transition_label.text = "Transition: wipe-up" [300ms]
#5.5s
transition_label.text = "Transition: wipe-down" [300ms]
