// Reactive: always, time-driven behavior, if/else.

config { colorscheme: "editorial-dark" }

#0s
center: Ellipse, radius: 8, color: text.primary, at: (640, 390)
orbiter: Ellipse, radius: 32, color: accent.primary, at: (820, 390)
pulse: Rect, size: (120, 120), color: (0.88, 0.42, 0.84, 1.0), at: (280, 390)
echo: Ellipse, radius: 20, color: accent.warning, at: pulse.at

always {
  orbiter.at = (640 + 180 * cos(t), 390 + 120 * sin(t * 2))
  pulse.size = if (t % 1.0) < 0.5 { (120, 120) } else { (180, 180) }
  echo.radius = pulse.size.x / 6
  echo.at = orbiter.at
}

// Explicit repeated declarations (for loops are top-level only)
#0s
dots: Row, anchor: scene.bottom, offset: (0, -120), gap: 30, align: "center" {
  d0: Ellipse, radius: 12, color: accent.primary
  d1: Ellipse, radius: 16, color: accent.success
  d2: Ellipse, radius: 20, color: accent.warning
  d3: Ellipse, radius: 24, color: accent.danger
  d4: Ellipse, radius: 28, color: accent.primary
}
