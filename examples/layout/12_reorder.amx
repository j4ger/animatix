// 12 — Reorder & Swap: Polished Grid
// Dynamic container reordering with swap and reorder actions.

import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

title: Text, text: "Dynamic Reorder", font_size: 48, color: text.primary, anchor: scene.top, offset: (0, 60)
sub: Text, text: "swap and reorder actions with easing", font_size: 20, color: text.secondary, anchor: scene.top, offset: (0, 110)

grid: Row, anchor: scene.center, gap: 16, align: "center" {
  box1: Rect, size: (120, 100), color: accent.primary
  box2: Rect, size: (120, 180), color: accent.success
  box3: Rect, size: (120, 140), color: accent.warning
  box4: Rect, size: (120, 220), color: accent.danger
}

#0.5s
fade-in title [600ms, ease: ease-out]
fade-in sub [400ms, delay: 200ms]

#1.5s
fade-in grid [500ms]

#3s
swap box1, box4 [700ms, ease: ease-in-out]

#4.5s
swap box2, box3 [700ms, ease: ease-in-out]

#6s
reorder grid [order: {box4, box3, box2, box1}, 800ms, ease: ease-in-out]

#7.5s
reorder grid [order: {box1, box2, box3, box4}, 800ms, ease: ease-in-out]

#9s
stagger [80ms] {
  box1.color = accent.warning [500ms]
  box2.color = accent.danger [500ms]
  box3.color = accent.primary [500ms]
  box4.color = accent.success [500ms]
}