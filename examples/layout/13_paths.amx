// 13 — Paths & Transforms
// Path commands, polygon morphing, and affine transform matrices.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

title: Text, text: "Paths & Transforms", font_size: 48, color: text.primary, anchor: scene.top, offset: (0, 60)

star: Path, commands: {
  move_to(0, -50), line_to(14, -15), line_to(50, -15),
  line_to(22, 10), line_to(32, 48), line_to(0, 24),
  line_to(-32, 48), line_to(-22, 10), line_to(-50, -15),
  line_to(-14, -15), close()
}, color: accent.warning, at: (320, 400)

wave: Path, commands: {
  move_to(-120, 0), quad_to(-60, -50, 0, 0),
  quad_to(60, 50, 120, 0), quad_to(180, -50, 240, 0)
}, color: accent.primary, at: (640, 360), stroke_width: 3

morph: Polygon, points: {
  (0, -50), (48, -16), (30, 40), (-30, 40), (-48, -16)
}, color: accent.success, at: (960, 400)

note: Text, text: "Bezier curves . polygons . affine transform", font_size: 16, color: text.muted, anchor: scene.center, offset: (0, 220)

#0.5s
fade-in title [600ms, ease: ease-out]
fade-in note [400ms]

#1s
stagger [150ms] {
  fade-in star [600ms]
  fade-in wave [500ms]
  fade-in morph [500ms]
}

#2.5s
morph: Polygon, points: {
  (0, -60), (64, -24), (40, 54), (-40, 54), (-64, -24)
}, color: accent.warning, at: (960, 400) [1.5s, ease: ease-in-out]

#3.5s
star.transform = (1.3, 0, 0, 1.3, 0, 0) [1s, ease: ease-out]

#4s
morph.transform = (1.2, 0.3, -0.3, 1.2, 0, 0) [1s, ease: ease-out]

#5s
wave.color = accent.success [1s, ease: ease-in-out]
morph.color = accent.danger [1s, ease: ease-in-out]