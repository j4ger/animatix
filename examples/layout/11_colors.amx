// 11 — Color System: Scheme Tokens, Auto, Hex Colors, Dynamic RGB
import "../lib/theme.amx"

import "../lib/theme.amx" as theme

config { colorscheme: "forest", resolution: (1280, 720) }

heading: Text, text: "Color System", font_size: 40, color: text.primary, anchor: scene.top, offset: (0, 50)

subtitle: Text, text: "scheme tokens + auto + fixed and computed colors", font_size: 18, color: text.secondary, anchor: scene.top, offset: (0, 100)

pub let forest = Colorscheme { extends: "editorial-dark", auto: ((0.35, 0.82, 0.55, 1), (0.55, 0.75, 0.4, 1), (0.3, 0.72, 0.55, 1), (0.8, 0.7, 0.35, 1), (0.9, 0.5, 0.5, 1)) }

#0s
  tokens_row: Row, anchor: scene.center, offset: (0, -100), gap: 12, align: "center" {
  t1: Rect, size: (50, 50), color: accent.primary
  t2: Rect, size: (50, 50), color: accent.success
  t3: Rect, size: (50, 50), color: accent.warning
  t4: Rect, size: (50, 50), color: accent.danger
  t5: Rect, size: (50, 50), color: text.primary
  t6: Rect, size: (50, 50), color: surface.primary
    }
  auto_row: Row, anchor: scene.center, offset: (0, -20), gap: 12, align: "center" {
  a0: Rect, size: (50, 50), color: auto
  a1: Rect, size: (50, 50), color: auto
  a2: Rect, size: (50, 50), color: auto
  a3: Rect, size: (50, 50), color: auto
  a4: Rect, size: (50, 50), color: auto
    }
  const_row: Row, anchor: scene.center, offset: (0, 60), gap: 12, align: "center" {
  c0: Rect, size: (50, 50), color: red
  c1: Rect, size: (50, 50), color: green
  c2: Rect, size: (50, 50), color: blue
  c3: Rect, size: (50, 50), color: hex_color("fff1d6")
  c4: Rect, size: (50, 50), color: hex_color("356780cc")
    }

#0.5s
  fade_in(target: heading, duration: 0.6s, ease: ease_out)
  fade_in(target: subtitle, duration: 0.4s)

#1s
  stagger [0.05s] {
      fade_in(target: t1, duration: 0.3s)
      fade_in(target: t2, duration: 0.3s)
      fade_in(target: t3, duration: 0.3s)
      fade_in(target: t4, duration: 0.3s)
      fade_in(target: t5, duration: 0.3s)
      fade_in(target: t6, duration: 0.3s)
    }

#1.5s
  stagger [0.05s] {
      fade_in(target: a0, duration: 0.3s)
      fade_in(target: a1, duration: 0.3s)
      fade_in(target: a2, duration: 0.3s)
      fade_in(target: a3, duration: 0.3s)
      fade_in(target: a4, duration: 0.3s)
    }

#2s
  stagger [0.05s] {
      fade_in(target: c0, duration: 0.3s)
      fade_in(target: c1, duration: 0.3s)
      fade_in(target: c2, duration: 0.3s)
      fade_in(target: c3, duration: 0.3s)
      fade_in(target: c4, duration: 0.3s)
    }
  always {
      c4.color = rgba(0.21, 0.40 + 0.15 * sin(t * 2), 0.50, 0.8)
    }
