// 03 — Timing & Easing
// Absolute keyframes, relative keyframes, and the full easing vocabulary.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

#0s
a: Rect, size: (80, 80), color: accent.primary, at: (200, 360)
b: Rect, size: (80, 80), color: accent.success, at: (440, 360)
c: Rect, size: (80, 80), color: accent.warning, at: (680, 360)
d: Rect, size: (80, 80), color: accent.danger, at: (920, 360)
e: Rect, size: (80, 80), color: text.primary, at: (1160, 360)

#0.5s
fade-in a [400ms]

#+0.3s
fade-in b [400ms]

#+0.3s
fade-in c [400ms]

#+0.3s
fade-in d [400ms]

#+0.3s
fade-in e [400ms]

#2.5s
a.size = (120, 120) [1s, ease: linear]
b.size = (120, 120) [1s, ease: ease-in]
c.size = (120, 120) [1s, ease: ease-out]
d.size = (120, 120) [1s, ease: ease-in-out]
e.size = (120, 120) [1s, ease: bounce]

#4.5s
sequence {
  a.color = accent.danger [400ms]
  b.color = accent.warning [400ms]
  c.color = accent.primary [400ms]
  d.color = accent.success [400ms]
  e.color = accent.danger [400ms]
}
