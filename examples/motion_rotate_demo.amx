// Runnable example: local rotation ergonomics with `rotate`.

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Rotate motion demo", font_size: 42, color: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "rotate applies a relative local turn in radians around the current origin.", font_size: 20, color: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "Manual and layout-managed nodes still share the same verb, but the framing now keeps the comparison cleaner.", font_size: 16, color: text.secondary, anchor: scene.top, offset: (0, 136) }

manual_label: Text { text: "manual node", font_size: 22, color: accent.danger, anchor: scene.left, offset: (240, -128) }
layout_label: Text { text: "layout-managed node", font_size: 22, color: accent.success, anchor: scene.right, offset: (-246, -128) }

manual: Rect, size: (170, 80), color: accent.danger, stroke: stroke.default, stroke_width: 4, anchor: scene.left, offset: (240, 78)

row: Row, gap: 40, anchor: scene.right, offset: (-210, 78) {
  anchor: Rect, size: (110, 70), color: surface.primary, stroke: stroke.default, stroke_width: 4,
  spinning: Rect, size: (170, 80), color: accent.primary, stroke: stroke.default, stroke_width: 4,
}

#0s
rotate manual [by: 1.5708, 1200ms, ease: ease-in-out]
rotate spinning [by: -0.7854, 1200ms, delay: 200ms, ease: ease-in-out]
