// Runnable example: shared timing modifiers (`delay`, duration shorthand, and `ease`).

config { colorscheme: "editorial-dark" }

#0s
eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Modifier timing demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Duration shorthand, named delay, named ease, and delayed instant updates share one modifier vocabulary.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The three columns isolate the shipped timing cases so playback makes the modifier semantics easy to compare.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

label_a: Text { text: "Delayed fade-out", font_size: 24, color_role: accent.danger, at: (250, 190) }
label_b: Text { text: "Delayed appearance", font_size: 24, color_role: accent.success, at: (640, 190) }
label_c: Text { text: "Ease-only instant move", font_size: 24, color_role: accent.primary, at: (1030, 190) }

left: Circle, radius: 70, color_role: accent.danger, at: (250, 400)
middle: Rect, size: (150, 150), color_role: accent.success [delay: 1s]
right: Circle, radius: 60, color_role: accent.primary, at: (930, 400)

#1s
fade-out left [delay: 1s, 1s]
right.at = (1130, 400) [delay: 1s, ease: bounce]

#4s
middle.color = accent.warning [delay: 500ms, 0s]
