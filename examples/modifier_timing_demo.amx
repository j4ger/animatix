// Runnable example: shared timing modifiers (`delay`, duration shorthand, and `ease`).

config { colorscheme: "editorial-dark" }

#0s
eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Modifier timing demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Delay, duration shorthand, and ease on one stage.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 120) }
caption: Text { text: "Three columns keep timing cases comparable.", font_size: 14, color_role: text.secondary, anchor: scene.top, offset: (0, 148) }

label_a: Text { text: "Delayed fade-out", font_size: 22, color_role: accent.danger, at: (250, 206) }
label_b: Text { text: "Delayed appearance", font_size: 22, color_role: accent.success, at: (640, 206) }
label_c: Text { text: "Ease-only move", font_size: 22, color_role: accent.primary, at: (980, 206) }

left: Circle, radius: 70, color_role: accent.danger, at: (250, 400)
middle: Rect, size: (150, 150), color_role: accent.success [delay: 1s]
right: Circle, radius: 60, color_role: accent.primary, at: (930, 400)

#1s
fade-out left [delay: 1s, 1s]
right.at = (1130, 400) [delay: 1s, ease: bounce]

#4s
middle.color = accent.warning [delay: 500ms, 0s]
