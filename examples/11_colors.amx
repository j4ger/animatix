// 11 — Color System
// Colorschemes, auto-assignment, built-in constants, and custom schemes.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

// Auto colors: each primitive gets a distinct scheme color
auto_row: Row, anchor: scene.center, offset: (0, -80), gap: 24, align: "center" {
  a: Rect, size: (80, 80), color: auto
  b: Ellipse, size: (80, 80), color: auto
  c: Rect, size: (80, 80), color: auto
  d: Ellipse, size: (80, 80), color: auto
  e: Rect, size: (80, 80), color: auto
}

// Built-in constants
const_row: Row, anchor: scene.center, offset: (0, 40), gap: 24, align: "center" {
  r: Rect, size: (60, 60), color: RED
  g: Rect, size: (60, 60), color: GREEN
  b: Rect, size: (60, 60), color: BLUE
  w: Rect, size: (60, 60), color: WHITE
  k: Rect, size: (60, 60), color: BLACK
}

// Scheme tokens
scheme_row: Row, anchor: scene.center, offset: (0, 160), gap: 16, align: "center" {
  t1: Rect, size: (50, 50), color: accent.primary
  t2: Rect, size: (50, 50), color: accent.success
  t3: Rect, size: (50, 50), color: accent.warning
  t4: Rect, size: (50, 50), color: accent.danger
  t5: Rect, size: (50, 50), color: text.primary
  t6: Rect, size: (50, 50), color: surface.primary
}

#0s

#0.5s
stagger [60ms] {
  fade-in a [300ms]
  fade-in b [300ms]
  fade-in c [300ms]
  fade-in d [300ms]
  fade-in e [300ms]
}

#1.5s
stagger [60ms] {
  fade-in r [300ms]
  fade-in g [300ms]
  fade-in b [300ms]
  fade-in w [300ms]
  fade-in k [300ms]
}

#2.5s
stagger [60ms] {
  fade-in t1 [300ms]
  fade-in t2 [300ms]
  fade-in t3 [300ms]
  fade-in t4 [300ms]
  fade-in t5 [300ms]
  fade-in t6 [300ms]
}
