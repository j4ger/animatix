// Animatix Showcase
// A comprehensive 10-second demonstration of layout, primitives, plotting, and animation.

config { colorscheme: "editorial-dark" }

// ============================================================
// ACT 1: Title & Typography (0-2s)
// ============================================================

#0s
hero_col: Col, anchor: scene.center, offset: (0, -40), align: "center", gap: 20 {
  title: Text, text: "Animatix", font_size: 96, color: text.primary
  subtitle: Text, text: "Declarative Animation Engine", font_size: 28, color: text.secondary
  formula: Math, math: "e^{i\\pi} + 1 = 0", font_size: 42, color: accent.primary
}

#0.5s
stagger [200ms] {
  fade-in title [600ms, ease: ease-out]
  fade-in subtitle [600ms, ease: ease-out]
  fade-in formula [600ms, ease: ease-out]
}

#1.8s
shift hero_col [by: (0, -220), 800ms, ease: ease-in-out]
scale hero_col [by: 0.6, 800ms, ease: ease-in-out]

// ============================================================
// ACT 2: Layouts & Primitives (2.5-4.5s)
// ============================================================

#2.0s
shapes_grid: Grid, cols: 3, gap: 60, anchor: scene.center, offset: (0, 60) {
  c: Circle, radius: 45, color: accent.danger
  r: Rect, size: (90, 90), color: accent.warning
  p: RegularPolygon, sides: 6, radius: 50, color: accent.success
}

#2.5s
fade-in shapes_grid [500ms]

#3.0s
c.radius = 65 [600ms, ease: bounce]
r.color = accent.primary [600ms, ease: ease-in-out]
r.size = (120, 60) [600ms, ease: ease-in-out]
rotate p [by: 3.14, 600ms, ease: ease-in-out]

#4.0s
reveal-out shapes_grid [400ms]

// ============================================================
// ACT 3: Plotting & Mathematics (4.5-7s)
// ============================================================

#4.5s
plot_row: Row, gap: 40, anchor: scene.center, offset: (0, 60) {
  g1: Graph, x_domain: (-3, 3), y_domain: (-1, 9), size: (220, 220) {
    p1: CartesianPlot, func: (x) => x^2, color: accent.danger, width: 3
  }
  g2: Graph, x_domain: (-2, 2), y_domain: (-2, 2), size: (220, 220) {
    p2: ParametricPlot, func: (t) => (sin(3*t), cos(5*t)), t_domain: (0, 6.28), stroke: accent.warning, width: 3
  }
  g3: Graph, x_domain: (-4, 4), y_domain: (-4, 4), size: (220, 220) {
    p3: PolarPlot, func: (t) => 3 * sin(4*t), t_domain: (0, 6.28), stroke: accent.success, width: 3
  }
}

#4.8s
fade-in plot_row [600ms]

#5.5s
shift plot_row [by: (0, -20), 1s, ease: ease-in-out]

#6.5s
reveal-out plot_row [500ms]

// ============================================================
// ACT 4: Code & Vectors (7-9s)
// ============================================================

#7.0s
dev_stack: Stack, anchor: scene.center, offset: (0, 60) {
  panel: Rect, size: (480, 160), color: surface.secondary, stroke: stroke.default, stroke_width: 2
  code_snippet: Code, code: "fn render() -> Frame {\n    animate_all()\n}", font_size: 24, color: text.primary
}

#7.2s
fade-in dev_stack [500ms]

#8.0s
panel.size = (540, 200) [600ms, ease: bounce]
code_snippet.color = accent.primary [600ms]

#8.8s
reveal-out dev_stack [400ms]

// ============================================================
// FINALE (9s+)
// ============================================================

#9.2s
shift hero_col [by: (0, 220), 800ms, ease: ease-in-out]
scale hero_col [by: 1.66, 800ms, ease: ease-in-out]

#9.6s
title.color = accent.success [1s, ease: ease-in-out]
