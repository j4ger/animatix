// Runnable example: broad current-runtime overview with scene-relative placement and layout-first primitive composition.

config { colorscheme: "editorial-dark" }

#0s

header: Col, anchor: scene.top, offset: (0, 102), align: "center", gap: 12 {
  eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent.primary }
  title: Text { text: "Animatix", font_size: 72, color: text.primary }
  subtitle: Text { text: "Text, math, SVG, and vector primitives on one hero stage.", font_size: 18, color: text.secondary }
  caption: Text { text: "Anchored pockets and a bottom Row keep the scene legible.", font_size: 16, color: text.secondary }
}

// Math section: label above formula using Col for proper stacking
math_col: Col, anchor: scene.top, offset: (280, 200), align: "center", gap: 12 {
  math_label: Text { text: "Math", font_size: 18, color: accent.warning },
  formula: Math { math: "E = mc^2", font_size: 82, color: accent.primary }
}

// SVG section: label above logo using Col for proper stacking
svg_col: Col, anchor: scene.top, offset: (900, 200), align: "center", gap: 12 {
  svg_label: Text { text: "SVG", font_size: 18, color: accent.warning },
  logo: Svg { url: "examples/vector.svg", scale: 2.15 }
}

shape_label: Text { text: "Vector primitives in Row layout", font_size: 18, color: accent.warning, anchor: scene.bottom, offset: (0, -220) }
primitive_row: Row, anchor: scene.bottom, offset: (0, -116), gap: 144, align: "center" {
  orb: Circle, radius: 74, color: accent.danger,
  signal: Line, from: (-80, 0), to: (80, 0), stroke: accent.primary, stroke_width: 6,
  panel: Rect, size: (252, 132), color: accent.success
}

#1.2s
title.color = accent.warning [900ms, ease: ease-in-out]
formula.color = accent.success [900ms, ease: ease-in-out]
orb.radius = 114 [900ms, ease: ease-in-out]
orb.color = accent.success [900ms, ease: ease-in-out]
panel.size = (324, 154) [900ms, ease: ease-in-out]

#2.8s
logo.color = accent.danger [1s, ease: ease-in-out]
shift panel [by: (-16, -10), 1s, ease: ease-in-out]
signal.to = (132, -24) [1s, ease: ease-in-out]
