// Runnable example: broad current-runtime overview with scene-relative placement and layout-first primitive composition.

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 42) }
title: Text { text: "Animatix", font_size: 94, color_role: text.primary, anchor: scene.top, offset: (0, 98) }
subtitle: Text { text: "Scene-relative framing, shipped text/media primitives, and one layout-managed vector row share a single editorial-dark hero stage.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 148) }
caption: Text { text: "The left and right pockets stay anchored for readability while the bottom Row proves that layout ownership still keeps the primitive family aligned.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 178) }

math_label: Text { text: "Math", font_size: 18, color_role: accent.warning, at: (28%, 24%) }
formula: Math { math: "E = mc^2", font_size: 82, color: accent.primary, at: (30%, 34%) }

svg_label: Text { text: "SVG", font_size: 18, color_role: accent.warning, at: (72%, 24%) }
logo: Svg { url: "examples/vector.svg", scale: 2.15, at: (72%, 34%) }

shape_label: Text { text: "Vector primitives in Row layout", font_size: 18, color_role: accent.warning, anchor: scene.bottom, offset: (0, -248) }
primitive_row: Row, anchor: scene.bottom, offset: (0, -120), gap: 168, align: "center" {
  orb: Circle, radius: 74, color_role: accent.danger,
  signal: Line, from: (-80, 0), to: (80, 0), stroke: accent.primary, stroke_width: 6,
  panel: Rect, size: (252, 132), color_role: accent.success
}

#1.2s
title.color = accent.warning [900ms, ease: ease-in-out]
formula.at = (32%, 36%) [900ms, ease: ease-in-out]
orb.radius = 114 [900ms, ease: ease-in-out]
orb.color = accent.success [900ms, ease: ease-in-out]
panel.size = (324, 154) [900ms, ease: ease-in-out]

#2.8s
logo.at = (70%, 32%) [1s, ease: ease-in-out]
shift panel [by: (-16, -10), 1s, ease: ease-in-out]
signal.to = (132, -24) [1s, ease: ease-in-out]
