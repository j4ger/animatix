// Runnable example: broad current-runtime overview with scene-relative placement and layout-first primitive composition.

#0s
let ink = (0.04, 0.06, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.72, 0.79, 0.88, 1.0)
let caption_ink = (0.60, 0.69, 0.80, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let gold = (0.98, 0.82, 0.42, 1.0)
let green = (0.36, 0.87, 0.63, 1.0)
let coral = (1.0, 0.46, 0.56, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 42) }
title: Text { text: "Animatix", font_size: 94, color: title_ink, anchor: scene.top, offset: (0, 98) }
subtitle: Text { text: "Current shipped text, math, SVG, and vector primitives on one layout-first hero stage", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 148) }
caption: Text { text: "Scene-relative placement frames the text and media, while a bottom Row keeps the primitive family aligned by default.", font_size: 16, color: caption_ink, anchor: scene.top, offset: (0, 178) }

math_label: Text { text: "Math", font_size: 18, color: gold, at: (28%, 24%) }
formula: Math { math: "E = mc^2", font_size: 82, color: accent, at: (30%, 34%) }

svg_label: Text { text: "SVG", font_size: 18, color: gold, at: (72%, 24%) }
logo: Svg { url: "examples/vector.svg", scale: 2.15, at: (72%, 34%) }

shape_label: Text { text: "Vector primitives in Row layout", font_size: 18, color: gold, anchor: scene.bottom, offset: (0, -248) }
primitive_row: Row, anchor: scene.bottom, offset: (0, -120), gap: 168, align: "center" {
  orb: Circle, radius: 74, color: coral,
  signal: Line, from: (-80, 0), to: (80, 0), stroke: accent, stroke_width: 6,
  panel: Rect, size: (252, 132), color: green
}

#1.2s
title.color = gold [900ms, ease: ease-in-out]
formula.at = (32%, 36%) [900ms, ease: ease-in-out]
orb.radius = 114 [900ms, ease: ease-in-out]
orb.color = green [900ms, ease: ease-in-out]
panel.size = (324, 154) [900ms, ease: ease-in-out]

#2.8s
scene.background_color = (0.06, 0.08, 0.12, 1.0) [1s, ease: ease-in-out]
logo.at = (70%, 32%) [1s, ease: ease-in-out]
shift panel [by: (-16, -10), 1s, ease: ease-in-out]
signal.to = (132, -24) [1s, ease: ease-in-out]
