// Runnable example: imported pub component instantiation with isolated nested labels
// and multi-segment dotted assignment targets.

import "./modules/metric_card.amx"

#0s
let ink = (0.04, 0.06, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
heading: Text { text: "Imported component modules", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Public components, nested labels, dotted writes, and rhs property lookup on one polished stage", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "left.badge.color, right.badge.radius, and echo.radius = right.badge.radius stay visible on the same stage.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

left: MetricCard, title: "Latency"
right: MetricCard, title: "Throughput"
echo: Circle, radius: right.badge.radius, color: right.badge.color, at: (1110, 520)
connector: Line, from: left.badge.at, to: right.badge.at, stroke: title_ink, stroke_width: 3, at: (640, 392)
left.at = (420, 392)
right.at = (860, 392)

#1.5s
left.color = accent [0.8s, ease: ease-in-out]
right.color = green [0.8s, ease: ease-in-out]
left.badge.color = coral [0.8s, ease: ease-in-out]
right.badge.radius = 20 [0.8s, ease: ease-in-out]
echo.radius = right.badge.radius [0.8s, ease: ease-in-out]
echo.color = right.badge.color [0.8s, ease: ease-in-out]
