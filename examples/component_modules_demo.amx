// Runnable example: imported pub component instantiation with isolated nested labels
// and multi-segment dotted assignment targets.

import "./modules/metric_card.amx"

#0s
scene.background_color = (0.07, 0.08, 0.12, 1.0)

heading: Text { text: "Imported Component Modules", font_size: 58, color: (1.0, 1.0, 1.0, 1.0), at: (640, 140) }
left: MetricCard, title: "Latency"
right: MetricCard, title: "Throughput"
echo: Circle, radius: right.badge.radius, color: right.badge.color, at: (1110, 520)
connector: Line, from: left.badge.at, to: right.badge.at, stroke: white, stroke_width: 3, at: (640, 380)
left.at = (420, 380)
right.at = (860, 380)

#1.5s
left.color = (0.26, 0.52, 0.95, 1.0) [0.8s, ease: ease-in-out]
right.color = (0.20, 0.75, 0.45, 1.0) [0.8s, ease: ease-in-out]
left.badge.color = red [0.8s, ease: ease-in-out]
right.badge.radius = 20 [0.8s, ease: ease-in-out]
left.frame.color = (0.12, 0.28, 0.58, 1.0) [0.8s, ease: ease-in-out]
right.frame.color = (0.10, 0.45, 0.20, 1.0) [0.8s, ease: ease-in-out]
echo.radius = right.badge.radius [0.8s, ease: ease-in-out]
echo.color = right.badge.color [0.8s, ease: ease-in-out]
