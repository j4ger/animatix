// Runnable example: imported pub component instantiation with isolated nested labels
// and multi-segment dotted assignment targets.

import "./modules/metric_card.amx"

config { colorscheme: "editorial-dark" }

#0s

header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text, text: "Animatix example suite", font_size: 18, color: accent.primary }
  title: Text, text: "Imported component modules", font_size: 42, color: text.primary }
  subtitle: Text, text: "Public components, nested labels, dotted writes, and rhs property lookup share one focused stage.", font_size: 20, color: text.secondary }
  caption: Text, text: "left.badge.color, right.badge.radius, and echo.radius = right.badge.radius all stay visible without muddying the component boundary story.", font_size: 16, color: text.secondary }
}

left: MetricCard, title: "Latency"
right: MetricCard, title: "Throughput"
echo: Circle, radius: right.badge.radius, color: right.badge.color, at: (1110, 520)
connector: Line, from: left.badge.at, to: right.badge.at, stroke: stroke.default, stroke_width: 3, at: (640, 392)
left.at = (420, 392)
right.at = (860, 392)

#1.5s
left.color = accent.primary [0.8s, ease: ease-in-out]
right.color = accent.success [0.8s, ease: ease-in-out]
left.badge.color = accent.danger [0.8s, ease: ease-in-out]
right.badge.radius = 20 [0.8s, ease: ease-in-out]
echo.radius = right.badge.radius [0.8s, ease: ease-in-out]
echo.color = right.badge.color [0.8s, ease: ease-in-out]
