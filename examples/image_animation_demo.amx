// Runnable example: animated image placement and scaling through property tracks.

#0s
let ink = (0.05, 0.07, 0.10, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let gold = (0.98, 0.82, 0.42, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Animated image properties", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Image actors animate with at and size assignments just like the vector primitives", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The status text makes the before/after beat obvious in the first second of playback.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

photo: Image { url: "examples/checker.ppm", at: (260, 330), size: (64, 64) }
status: Text { text: "t = 0s", font_size: 18, color: gold, at: (260, 412) }
end_label: Text { text: "target placement + target size", font_size: 18, color: accent, at: (856, 248) }

#1s
photo.at = (760, 310) [1s, ease: ease-in-out]
photo.size = (220, 220) [1s, ease: ease-in-out]
status: Text { text: "t = 1s", font_size: 18, color: gold, at: (760, 450) }
