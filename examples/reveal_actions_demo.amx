// Runnable example: reveal and exit actions (`fade-in`, `draw-in`, `wipe-in`, `wipe-out`, `reveal-out`, and `draw-out`).

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Reveal actions demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "fade-in, draw-in, wipe-in, wipe-out, reveal-out, and draw-out each keep a dedicated readable target.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The layout is cleaner, but the reveal-action surface stays explicit, narrow, and easy to compare at a glance.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

headline: Text { text: "fade-in", font_size: 28, color_role: text.primary, at: (320, 250) }
orbit: Circle, radius: 84, color_role: accent.primary, stroke_role: stroke.default, stroke_width: 5, at: (320, 470)
panel_label: Text { text: "draw-in + wipe-in", font_size: 28, color_role: accent.warning, at: (640, 250) }
panel: Rect, size: (210, 130), color_role: accent.success, stroke_role: stroke.default, stroke_width: 4, at: (640, 470)
badge_label: Text { text: "wipe-out + reveal-out + draw-out", font_size: 24, color_role: accent.danger, at: (960, 250) }
badge: Polygon, points: {(-80, 0), (0, -78), (86, 0), (0, 92)}, color: accent.danger, stroke_role: stroke.default, stroke_width: 4, at: (860, 470)
crest: Circle, radius: 56, color_role: accent.warning, stroke_role: stroke.default, stroke_width: 5, at: (1000, 470)
spark: Rect, size: (110, 110), color_role: accent.primary, stroke_role: stroke.default, stroke_width: 5, at: (1140, 470)

#0s
fade-in headline [800ms]
draw-in orbit [1200ms, ease: ease-in-out]
wipe-in panel [1200ms, delay: 250ms]

#2.3s
wipe-out badge [900ms, ease: ease-in]
reveal-out crest [900ms, ease: ease-in-out]
draw-out spark [900ms, ease: ease-in-out]
