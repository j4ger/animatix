// Runnable example: reveal and exit actions (`fade-in`, `draw-in`, `wipe-in`, `wipe-out`, `reveal-out`, and `draw-out`).

config { colorscheme: "editorial-dark" 

#0s

header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text, text: "Animatix example suite", font_size: 18, color: accent.primary 
  title: Text, text: "Reveal actions demo", font_size: 42, color: text.primary 
  subtitle: Text, text: "Each reveal verb gets its own readable target.", font_size: 16, color: text.secondary 
  caption: Text, text: "The narrow stage keeps the verbs easy to compare.", font_size: 14, color: text.secondary 


headline: Text, text: "fade-in", font_size: 26, color: text.primary, at: (320, 266) 
orbit: Circle, radius: 84, color: accent.primary, stroke: stroke.default, stroke_width: 5, at: (320, 470)
panel_label: Text, text: "draw-in + wipe-in", font_size: 24, color: accent.warning, at: (640, 266) 
panel: Rect, size: (210, 130), color: accent.success, stroke: stroke.default, stroke_width: 4, at: (640, 470)
badge_label: Text, text: "wipe-out + reveal-out + draw-out", font_size: 18, color: accent.danger, at: (900, 266) 
badge: Polygon, points: {(-80, 0), (0, -78), (86, 0), (0, 92), color: accent.danger, stroke: stroke.default, stroke_width: 4, at: (860, 470)
crest: Circle, radius: 56, color: accent.warning, stroke: stroke.default, stroke_width: 5, at: (1000, 470)
spark: Rect, size: (110, 110), color: accent.primary, stroke: stroke.default, stroke_width: 5, at: (1140, 470)

#0s
fade-in headline [800ms]
draw-in orbit [1200ms, ease: ease-in-out]
wipe-in panel [1200ms, delay: 250ms]

#2.3s
wipe-out badge [900ms, ease: ease-in]
reveal-out crest [900ms, ease: ease-in-out]
draw-out spark [900ms, ease: ease-in-out]
