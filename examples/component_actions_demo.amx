// Custom Component Actions Demo
// Demonstrates defining and invoking custom actions inside components.

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

#0s
title: Text, text: "Custom Component Actions", font_size: 42, color: text.primary, anchor: scene.top, offset: (0, 50)
subtitle: Text, text: "User-defined action sequences inlined at expansion time", font_size: 18, color: text.secondary, anchor: scene.top, offset: (0, 110)

#0s
btns: Row, anchor: scene.center, gap: 24, align: "center" {
  primary: Button, text: "Primary"
  danger: Button, text: "Danger"
  success: Button, text: "Success"
}

#0.5s
fade-in title [800ms, ease: ease-out]
fade-in subtitle [600ms, delay: 200ms, ease: ease-out]

#1.0s
fade-in btns [600ms, ease: ease-out]

// Invoke custom actions on each button instance
#2.0s
pulse primary [400ms, ease: ease-in-out]

#2.6s
pulse danger [400ms, ease: ease-in-out]

#3.2s
pulse success [400ms, ease: ease-in-out]

// Sequence of custom actions
#4.0s
sequence {
  glow primary [300ms]
  glow danger [300ms]
  glow success [300ms]
}

// Staggered custom actions
#5.5s
stagger [150ms] {
  pulse primary [300ms]
  pulse danger [300ms]
  pulse success [300ms]
}

#7.0s
done: Text, text: "Done!", font_size: 32, color: accent.success, anchor: scene.bottom, offset: (0, -80)

#7.0s
fade-in done [400ms, ease: ease-out]

// Component definition with two custom actions
pub component Button(text: "OK") {
  action pulse {
    self.frame.scale = 1.15 [100ms]
    self.frame.scale = 1.0 [100ms]
  }

  action glow {
    self.frame.color = accent.warning [150ms]
    self.frame.color = accent.primary [150ms]
  }

  frame: Rect, size: (140, 48), color: accent.primary, radius: 8 {
    label: Text, text: text, font_size: 16, color: text.primary, anchor: self.center
  }
}
