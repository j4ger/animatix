// Runnable example: implicit contour plotting over the current Graph domain.

config { colorscheme: "editorial-dark" }

#0s
eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Implicit plot demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Marching-squares contour extraction samples f(x, y) = 0 across the parent graph domain.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "This stays visually spare so the contour itself carries the example.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

formula: Text { text: "(x^2 + y^2)^2 - 2(x^2 - y^2) = 0", font_size: 18, color_role: accent.primary, at: (640, 236) }
graph: Graph, x_domain: (-2, 2), y_domain: (-2, 2), size: (420, 420), at: (640, 410) {
  lemniscate: ImplicitPlot, func: (x, y) => (x * x + y * y) * (x * x + y * y) - 2 * (x * x - y * y), resolution: 120, stroke: accent.primary, width: 3
}
