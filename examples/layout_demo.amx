// Runnable example: layout-focused scene showing Grid, Col, Stack, anchors, percentages, and a narrow manual override.

#0s
let ink = (0.04, 0.06, 0.10, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let caption_ink = (0.60, 0.69, 0.79, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let gold = (0.98, 0.83, 0.44, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Layout demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Root defaults, anchors, percentages, and container-owned placement share one didactic stage", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "Most of the scene now stays layout-managed; the only explicit child override is isolated in the bottom comparison row.", font_size: 16, color: caption_ink, anchor: scene.top, offset: (0, 136) }

root_label: Text { text: "Root container default placement", font_size: 24, color: gold, anchor: scene.top, offset: (0, 184) }
root_caption: Text { text: "This Grid has no anchor or at, so the runtime places it at the default root position.", font_size: 16, color: subtitle_ink, anchor: scene.top, offset: (0, 212) }
grid_label: Text { text: "Grid with cols + gap", font_size: 20, color: accent, anchor: scene.top, offset: (0, 238) }
grid_caption: Text { text: "The centered panel uses cols: 2 and gap: 28 for a readable tiled composition.", font_size: 16, color: caption_ink, anchor: scene.top, offset: (0, 262) }

left_label: Text { text: "Scene anchor + offset", font_size: 24, color: gold, anchor: scene.left, offset: (210, -164) }
left_caption: Text { text: "This Col is anchored to scene.left, then shifted inward with offset.", font_size: 16, color: subtitle_ink, anchor: scene.left, offset: (228, -136) }

stack_label: Text { text: "Stack with percent placement", font_size: 24, color: gold, at: (79%, 56%) }
stack_caption: Text { text: "The whole Stack uses percent-based placement while layered children share one origin.", font_size: 16, color: subtitle_ink, at: (79%, 60%) }

manual_label: Text { text: "Manual child override inside layout container", font_size: 24, color: gold, anchor: scene.bottom, offset: (0, -210) }
manual_caption: Text { text: "Only one Row child opts out with its own at; neighboring children still follow container flow.", font_size: 16, color: subtitle_ink, anchor: scene.bottom, offset: (0, -182) }

dashboard: Grid, cols: 2, gap: 28 {
  p1: Rect, size: (214, 104), color: (0.14, 0.22, 0.36, 1.0),
  p2: Rect, size: (214, 104), color: (0.16, 0.19, 0.34, 1.0),
  p3: Rect, size: (214, 104), color: (0.13, 0.28, 0.28, 1.0),
  p4: Rect, size: (214, 104), color: (0.29, 0.18, 0.18, 1.0),
  orb1: Circle, radius: 24, color: gold,
  orb2: Circle, radius: 24, color: accent
}

legend: Col, anchor: scene.left, offset: (170, 12), gap: 22, align: "center" {
  top: Rect, size: (130, 52), color: (0.19, 0.22, 0.30, 1.0),
  mid: Rect, size: (170, 74), color: (0.22, 0.28, 0.38, 1.0),
  bot: Rect, size: (112, 112), color: (0.15, 0.19, 0.28, 1.0)
}

callout: Stack, at: (82%, 76%) {
  plate: Rect, size: (296, 112), color: (0.10, 0.14, 0.22, 1.0),
  glow: Circle, radius: 40, color: (0.22, 0.46, 0.84, 0.22),
  halo: Circle, radius: 54, color: (0.13, 0.20, 0.32, 0.55),
  ring: Circle, radius: 28, color: gold,
  core: Circle, radius: 16, color: title_ink
}

manual_row: Row, anchor: scene.bottom, offset: (0, -116), gap: 24, align: "center" {
  focus: Circle, radius: 18, color: title_ink, at: (-118, -18),
  a: Circle, radius: 28, color: (0.96, 0.47, 0.52, 1.0),
  b: Circle, radius: 22, color: (0.33, 0.84, 0.60, 1.0),
  c: Circle, radius: 36, color: accent,
  d: Circle, radius: 24, color: gold
}
