// 27_bars_race.amx — `data` keyframes: bars racing between datasets.
//
// Bars are matched by label, so each category's height travels to its own new
// value rather than to whatever slot it occupies in the new dataset. The slot
// itself is chosen at the start of the window — heights animate, positions do
// not — which is why the datasets below keep their labels in the same order.
// Two things the scene has to get right to show that:
//
//   - `max_value` is pinned. With the default `auto`, the tallest bar is
//     normalised to the full plot height every frame, so growing the maximum is
//     invisible — only the *relative* differences survive auto-scaling.
//   - The label set and its order never change. Bar captions are compiled at
//     build into the declaration's slots, so a dataset with new labels — or the
//     same labels re-ordered — would render new bars under old captions (and
//     `check` says so).

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 7.4 }

chart: BarChart, data: {("api", 34), ("web", 52), ("batch", 18), ("ml", 27)},
  max_value: 70, at: (640, 400), size: (820, 420), bar_width: 96, gap: 46,
  color: accent.primary, opacity: 1.0

title: Text, text: "requests by service, thousands", font_size: 26,
  color: text.primary, at: (640, 148)
cap: Text, text: "the labels stay; the heights race", font_size: 22,
  color: text.secondary, at: (640, 648), opacity: 0.0

#0s
fade-in title [400ms, ease: expo-out]
fade-in cap [400ms, ease: expo-out]
settle-in chart [520ms, ease: expo-out]

#1.6s
chart.data = {("api", 61), ("web", 24), ("batch", 45), ("ml", 12)}
  [900ms, ease: ease-in-out]

#3.4s
chart.data = {("api", 28), ("web", 66), ("batch", 33), ("ml", 54)}
  [900ms, ease: ease-in-out]

// Outro: everything leaves in the reverse order it arrived.
#5.6s
stagger [70ms] {
  fade-out cap [300ms, ease: ease-in]
  fade-out title [350ms, ease: ease-in]
  fade-out chart [400ms, ease: ease-in]
}
