// 07 — Data Viz: One Question, Three Views
// The scalar field sin(x)·cos(y) seen three ways: curve, gradient field, heatmap.

import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

title: Text, text: "One Question, Three Views", font_size: 36, color: text.primary, anchor: scene.top, offset: (0, 50)
sub: Text, text: "f(x, y) = sin(x)·cos(y) — curve · gradient field · heatmap", font_size: 18, color: text.secondary, anchor: scene.top, offset: (0, 95)

// View 1 — a cartesian cross-section of the same field (f(x, 0) = sin(x))
main: Graph, x_domain: (-6, 6), y_domain: (-3, 3), size: (520, 400), at: (640, 360) {
  sine: PlotCurve, kind: "cartesian", func: (x) => sin(x), color: accent.primary, stroke_width: 3
}

// View 2 — the gradient field ∇f = (cos x·cos y, −sin x·sin y)
field: VectorField, func: (x, y) => (cos(x) * cos(y), -sin(x) * sin(y)), density: 12, color: accent.success, x_domain: (-4, 4), y_domain: (-4, 4), at: (140, 160), size: (220, 220)

// View 3 — the scalar field itself as a heatmap
heat: Heatmap, func: (x, y) => sin(x) * cos(y), resolution: 28, color: accent.warning, x_domain: (-pi, pi), y_domain: (-pi, pi), at: (1140, 160), size: (220, 220)

// Staged reveals — one question, three views
#0.5s
fade-in title [600ms, ease: ease-out]
fade-in sub [400ms, delay: 200ms]

#1.2s
fade-in main [600ms, ease: ease-out]

#2.5s
fade-in field [500ms, delay: 100ms]

#3.5s
fade-in heat [500ms, delay: 100ms]
