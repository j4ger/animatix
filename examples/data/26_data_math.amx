// 26_data_math.amx — BarChart and Equation/Fragment demo
import "../lib/theme.amx"

import "../lib/theme.amx" as theme

// Top-level config: resolution is composition-scoped
config { resolution: (1280, 720) }

// =============================================================================
// Scene 1: Standalone BarChart with animated data and per-bar colors
// =============================================================================
# BarChartDemo
config { colorscheme: "editorial-dark" }
title: Text, text: "BarChart: Monthly Revenue", font_size: 36, color: text.primary, anchor: scene.top, offset: (0, 60)
// Standalone BarChart — coordinates are pixel-space
// data: list of (label, value) pairs; bar_colors: per-bar RGBA
chart: BarChart, data: {("Jan", 42), ("Feb", 65), ("Mar", 58), ("Apr", 80), ("May", 91), ("Jun", 74)}, bar_colors: {(0.35, 0.6, 1, 1), (0.35, 0.86, 0.63, 1), (0.98, 0.83, 0.44, 1), (1, 0.46, 0.54, 1), (0.65, 0.45, 0.95, 1), (0.35, 0.86, 0.63, 1)}, show_axis: true, show_labels: true, size: (800, 380), at: (640, 400)
#0.5s
  fade_in(target: title, duration: 0.5s, ease: ease_out)
#1s
  fade_in(target: chart, duration: 0.8s, ease: ease_out)
#3s
  pulse(target: chart, intensity: 1.05, duration: 0.6s)
play BarChartInGraph [fade, 400ms]

// =============================================================================
// Scene 2: BarChart inside a Graph (math coordinates)
// =============================================================================
# BarChartInGraph
config { colorscheme: "editorial-dark" }
title2: Text, text: "BarChart inside a Graph (math coords)", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 60)
// Graph maps math coordinates to screen; BarChart respects those coordinates
graph: Graph, at: (640, 400), size: (800, 360), x_domain: (0, 5), y_domain: (0, 10) {
bars: BarChart, data: {("A", 3.5), ("B", 7.2), ("C", 5), ("D", 8.8)}, bar_colors: {(1, 0.46, 0.54, 1), (0.35, 0.86, 0.63, 1), (0.98, 0.83, 0.44, 1), (0.35, 0.6, 1, 1)}, show_axis: true, show_labels: true
}
#0.5s
  fade_in(target: title2, duration: 0.5s, ease: ease_out)
#1s
  fade_in(target: graph, duration: 0.8s, ease: ease_out)
play EquationDemo [wipe_left, 400ms]

// =============================================================================
// Scene 3: Equation with Fragment highlighting
// =============================================================================
# EquationDemo
config { colorscheme: "editorial-dark" }
title3: Text, text: "Equation + Fragment highlighting", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 60)
// Equation is a container; each Fragment is an independently addressable segment
// Use highlight/unhighlight actions to animate the overlay per segment
eq: Equation, font_size: 48, color: text.primary, anchor: scene.center, offset: (0, -20) {
lhs: Fragment, text: "E"
eq_sign: Fragment, text: " = "
mass: Fragment, text: "m"
c2: Fragment, text: "c^2"
}
hint: Text, text: "← each Fragment highlighted independently", font_size: 18, color: text.muted, anchor: scene.center, offset: (0, 80)
#0.5s
  fade_in(target: title3, duration: 0.4s)
// Reveal fragment by fragment
#1s
  fade_in(target: eq.lhs, duration: 0.4s)
#1.5s
  fade_in(target: eq.eq_sign, duration: 0.3s)
#2s
  fade_in(target: eq.mass, duration: 0.4s)
#2.5s
  fade_in(target: eq.c2, duration: 0.4s)
#3.5s
  fade_in(target: hint, duration: 0.4s)
// Highlight each segment to explain the equation — uses color name + blend mode
#4s
  highlight(target: eq.lhs, color: accent.warning, blend: normal, duration: 0.6s)
#5s
  unhighlight(target: eq.lhs, duration: 0.4s)
  highlight(target: eq.mass, color: accent.success, blend: normal, duration: 0.6s)
#6.5s
  unhighlight(target: eq.mass, duration: 0.4s)
  highlight(target: eq.c2, color: accent.danger, blend: normal, duration: 0.6s)
#8s
  unhighlight(target: eq.c2, duration: 0.4s)
// Highlight all fragments simultaneously
#8.5s
  highlight(target: eq.lhs, color: accent.primary, blend: difference, duration: 0.4s)
  highlight(target: eq.eq_sign, color: accent.primary, blend: difference, duration: 0.4s)
  highlight(target: eq.mass, color: accent.primary, blend: difference, duration: 0.4s)
  highlight(target: eq.c2, color: accent.primary, blend: difference, duration: 0.4s)
#9.5s
  unhighlight(target: eq.lhs, duration: 0.3s)
  unhighlight(target: eq.eq_sign, duration: 0.3s)
  unhighlight(target: eq.mass, duration: 0.3s)
  unhighlight(target: eq.c2, duration: 0.3s)
