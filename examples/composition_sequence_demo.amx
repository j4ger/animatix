// Runnable example: composition v1a with build-time `sequence` blocks.

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Sequence composition demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Each statement starts only after the previous action or assignment has fully finished.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The composition stays editorially quiet so the ordered lowering behavior is the whole story.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

badge: Circle, radius: 54, color_role: accent.danger, stroke_role: stroke.default, stroke_width: 4, at: (320, 430)
panel: Rect, size: (170, 110), color_role: accent.success, stroke_role: stroke.default, stroke_width: 4, at: (640, 430)
caption_card: Text { text: "Sequence: fade → draw → move → color", font_size: 24, color_role: text.primary, at: (640, 610) }

#0s
sequence {
  fade-in caption_card [350ms]
  draw-in badge [700ms]
  move badge [to: (170, -30), 700ms, ease: ease-in-out]
  panel.color = accent.primary [250ms, delay: 100ms]
}
