// Runnable example: composition v1a with build-time `sequence` blocks.

#0s
let ink = (0.04, 0.05, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Sequence composition demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Each statement starts only after the previous action or assignment has fully finished", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The composition is cleaner, but the technical point stays the same: ordered lowering without playback state.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

badge: Circle, radius: 54, color: coral, stroke: title_ink, stroke_width: 4, at: (320, 430)
panel: Rect, size: (170, 110), color: green, stroke: title_ink, stroke_width: 4, at: (640, 430)
caption_card: Text { text: "Sequence: fade → draw → move → color", font_size: 24, color: title_ink, at: (640, 610) }

#0s
sequence {
  fade-in caption_card [350ms]
  draw-in badge [700ms]
  move badge [to: (170, -30), 700ms, ease: ease-in-out]
  panel.color = accent [250ms, delay: 100ms]
}
