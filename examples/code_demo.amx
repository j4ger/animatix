// Runnable example: minimal Code primitive rendered through the text pipeline.

#0s
scene.background_color = (0.07, 0.08, 0.12, 1.0)

snippet: Code {
  code: "let velocity = x + 1",
  font_size: 28,
  color: (0.85, 0.9, 1.0, 1.0),
  at: (640, 320)
}

#1s
snippet.color = (1.0, 0.8, 0.4, 1.0) [0.6s, ease: ease-in-out]
snippet.at = (640, 380) [0.6s, ease: ease-in-out]

#2s
snippet: Code {
  code: "let velocity = x + 2",
  font_size: 28,
  color: (0.6, 1.0, 0.75, 1.0),
  at: (640, 380)
} [0.6s, ease: ease-in-out]
