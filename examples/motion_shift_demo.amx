// Runnable example: local motion ergonomics with `move` and `shift`.
#0s
scene.background_color = (0.05, 0.06, 0.10, 1.0)

title: Text { text: "Motion Actions Demo", font_size: 34, color: WHITE, at: (640, 84) }
subtitle: Text { text: "Move sets a local offset; shift adds to the current one", font_size: 22, color: (0.78, 0.83, 0.92, 1.0), at: (640, 132) }

manual_label: Text { text: "Move on a manual node", font_size: 22, color: WHITE, at: (280, 220) }
layout_label: Text { text: "Shift on a layout-managed node", font_size: 22, color: WHITE, at: (930, 220) }

manual: Circle, radius: 60, color: (1.0, 0.42, 0.58, 1.0), stroke: WHITE, stroke_width: 4, at: (280, 430)

row: Row, gap: 40, at: (930, 430) {
  left: Rect, size: (130, 90), color: (0.26, 0.90, 0.64, 1.0), stroke: WHITE, stroke_width: 4,
  moving: Rect, size: (130, 90), color: (0.34, 0.68, 1.0, 1.0), stroke: WHITE, stroke_width: 4,
}

#0s
move manual [to: (140, -40), 1200ms, ease: ease-in-out]
shift moving [by: (0, -90), 1200ms, delay: 200ms, ease: ease-in-out]
