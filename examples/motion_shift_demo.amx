// Runnable example: local motion ergonomics with `move` and `shift`.

#0s
let ink = (0.04, 0.05, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Move vs shift", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "move sets a local target offset; shift adds relative local motion on top of current placement", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The left node is manually placed. The right node stays inside Row layout while only its local transform changes.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

manual_label: Text { text: "move on a manual node", font_size: 22, color: coral, at: (280, 232) }
layout_label: Text { text: "shift on a layout-managed node", font_size: 22, color: green, at: (930, 232) }

manual: Circle, radius: 60, color: coral, stroke: title_ink, stroke_width: 4, at: (280, 438)

row: Row, gap: 40, at: (930, 438) {
  left: Rect, size: (130, 90), color: (0.18, 0.24, 0.34, 1.0), stroke: title_ink, stroke_width: 4,
  moving: Rect, size: (130, 90), color: accent, stroke: title_ink, stroke_width: 4,
}

#0s
move manual [to: (140, -40), 1200ms, ease: ease-in-out]
shift moving [by: (0, -90), 1200ms, delay: 200ms, ease: ease-in-out]
