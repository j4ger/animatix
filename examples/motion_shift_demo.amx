// Runnable example: local motion ergonomics with `shift`.
#0s
scene.background_color = (0.05, 0.06, 0.10, 1.0)

title: Text { text: "Shift Motion Demo", font_size: 34, color: WHITE, at: (640, 84) }
subtitle: Text { text: "Shift layers on top of placement instead of replacing it", font_size: 22, color: (0.78, 0.83, 0.92, 1.0), at: (640, 132) }

manual_label: Text { text: "Manual node", font_size: 22, color: WHITE, at: (280, 220) }
layout_label: Text { text: "Layout-managed node", font_size: 22, color: WHITE, at: (930, 220) }

manual: Circle, radius: 60, color: (1.0, 0.42, 0.58, 1.0), stroke: WHITE, stroke_width: 4, at: (280, 430)

row: Row, gap: 40, at: (930, 430) {
  left: Rect, size: (130, 90), color: (0.26, 0.90, 0.64, 1.0), stroke: WHITE, stroke_width: 4,
  moving: Rect, size: (130, 90), color: (0.34, 0.68, 1.0, 1.0), stroke: WHITE, stroke_width: 4,
}

#0s
shift manual [by: (140, -40), 1200ms, ease: ease-in-out]
shift moving [by: (0, -90), 1200ms, delay: 200ms, ease: ease-in-out]
