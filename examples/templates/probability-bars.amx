// Give each class the same x and width so the bars share a zero and scale.
import "../lib/probability.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 4 }

let reveal = 0
always {
  reveal = linear_progress(t, 0.5, 2)
}

title: Text, text: "AlexNet predictions", at: (640, 156), font_size: 48, color: text.primary, opacity: 1
first: ProbabilityBar, label: "Egyptian cat", value: 0.7864, progress: reveal, x: 390, y: 296
second: ProbabilityBar, label: "Tiger cat", value: 0.1368, progress: reveal, x: 390, y: 384, tint: accent.info
third: ProbabilityBar, label: "Tabby", value: 0.0712, progress: reveal, x: 390, y: 472, tint: accent.info
