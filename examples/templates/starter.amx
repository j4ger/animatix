// starter.amx — 单幕模板：复制此文件开始一个新场景。
//
// 骨架 = house-style 三件套（StageFloor / ActHead / Caption）+ 一个主角 + rest 帧。
// 规则：场景必须有静止收尾（autoplay loop 的 hold 就是它）；改完跑
//   animatix storyboard <file>          先看图
//   animatix audit <file> --brief       硬事实与候选
//   animatix audit <file> --delta ...   只看新增
import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor
head: ActHead, kicker: "SECTION · TOPIC", title: "One claim per scene",
  sub: "Say the one thing this scene proves."

hero: Rect, size: (320, 200), corner_radius: 16, color: accent.primary, anchor: scene.center, offset: (0, 60)

caption: Caption, text: "Rest on this composition; the loop holds it.", tag: "starter.amx"

#0s
fade-in floor [600ms]
fade-in head [500ms]
pop-in hero [600ms, delay: 200ms, ease: expo-out]
fade-in caption [400ms, delay: 300ms]

#4.6s
hero.shift = (0, -12) [800ms, ease: ease-in-out]

// rest：最后 1.2s 所有动作结束，构图完整并保持到结束。
