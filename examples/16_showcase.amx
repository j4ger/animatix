// 16 — Showcase: Animatix Capstone
// Bold composition combining layout, morphing, paths, transforms, and always.

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

title: Text, text: "Animatix", font_size: 96, color: text.primary, anchor: scene.top, offset: (0, 100)
sub: Text, text: "Layout . Morph . Path . Always", font_size: 24, color: text.secondary, anchor: scene.top, offset: (0, 180)

deck: Row, anchor: scene.center, offset: (0, -20), gap: 40, align: "center" {
  orb: Ellipse, size: (80, 80), color: accent.danger
  box: Rect, size: (80, 80), color: accent.success
  gem: Polygon, points: {(0, -40), (40, 0), (0, 40), (-40, 0)}, color: accent.primary
}

#0.5s
fade-in title [700ms, ease: ease-out]
fade-in sub [500ms, delay: 200ms]

#1s
fade-in deck [500ms]

#1.5s
orb.size = (100, 100) [600ms, ease: bounce]
box.size = (100, 100) [500ms, ease: ease-out]

#2s
orb.color = accent.primary [600ms]
box.color = accent.warning [600ms]
gem.color = accent.danger [600ms]

#2.5s
gem: Polygon, points: {
  (0, -50), (48, -16), (30, 40), (-30, 40), (-48, -16)
}, color: accent.primary [1s, ease: ease-out]

#3s
rotate orb [by: tau, 2s, ease: linear]
rotate box [by: -pi, 2s, ease: ease-in-out]

#3.5s
star: Path, commands: {
  move_to(0, -100), line_to(28, -30), line_to(100, -30),
  line_to(44, 20), line_to(64, 90), line_to(0, 50),
  line_to(-64, 90), line_to(-44, 20), line_to(-100, -30),
  line_to(-28, -30), close()
}, color: accent.warning, at: (1060, 540)
fade-in star [500ms]
star.transform = (0.5, 0, 0, 0.5, 0, 0) [400ms]

#4.5s
pulse orb [400ms, intensity: 1.3]
pulse box [400ms, intensity: 1.3]

always {
  orb.scale = 1.0 + 0.06 * sin(t * 3.0)
  box.scale = 1.0 + 0.06 * sin(t * 3.0 + 2.094)
  gem.scale = 1.0 + 0.06 * sin(t * 3.0 + 4.189)
  star.scale = 0.5 + 0.04 * sin(t * 2.0)
}