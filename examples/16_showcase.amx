// 16 — Showcase
// A polished hero scene combining layout, animation, primitives, and composition.

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

backdrop: Rect, size: (1280, 720), color: scene.background, anchor: scene.center

// Title group
title: Text, text: "Animatix", font_size: 96, color: text.primary, anchor: scene.top, offset: (0, 120)
subtitle: Text, text: "Layout-first animation language", font_size: 24, color: text.secondary, anchor: scene.top, offset: (0, 200)

// Feature list
features: Col, anchor: scene.left, offset: (160, 0), align: "center", gap: 12 {
  heading: Text, text: "Features", font_size: 24, color: accent.warning
  f1: Text, text: "Keyframes & Easing", font_size: 16, color: text.secondary
  f2: Text, text: "Shape Morphing", font_size: 16, color: text.secondary
  f3: Text, text: "Reactive Blocks", font_size: 16, color: text.secondary
  f4: Text, text: "Components & Slots", font_size: 16, color: text.secondary
}

// Primitive gallery
prims: Row, anchor: scene.bottom, offset: (0, -140), gap: 60, align: "center" {
  orb: Ellipse, size: (0, 0), color: accent.danger
  wire: Line, from: (0, 0), to: (0, 0), stroke: accent.primary, stroke_width: 4
  box: Rect, size: (0, 0), color: accent.success
  eq: Math, math: "E = mc^2", font_size: 40, color: accent.primary
}

#0.2s
fade-in backdrop [600ms]

#0.4s
fade-in title [500ms, ease: ease-out]

#0.8s
fade-in subtitle [500ms, ease: ease-in-out]

#1.0s
shift features [by: (40, 0), 600ms, ease: ease-out]

#1.2s
stagger [80ms] {
  fade-in heading [300ms]
  fade-in f1 [300ms]
  fade-in f2 [300ms]
  fade-in f3 [300ms]
  fade-in f4 [300ms]
}

#2.2s
fade-in prims [400ms]

#2.4s
orb.size = (100, 100) [600ms, ease: bounce]

#2.5s
wire.from = (-40, 0) [400ms]
wire.to = (40, 0) [400ms]

#2.6s
box.size = (100, 70) [500ms, ease: ease-out]

#3.0s
orb.color = accent.success [600ms]
box.color = accent.warning [600ms]

// Side panel
#3.5s
panel: Rect, size: (360, 160), color: (0.15, 0.17, 0.22, 1.0), anchor: scene.right, offset: (-200, -20)
shift panel [by: (-30, 0), 500ms, ease: ease-out]
fade-in panel [400ms]

#3.6s
code: Code, code: "let pos = (x, y)", font_size: 18, color: text.primary, anchor: scene.right, offset: (-200, -20)
shift code [by: (-30, 0), 500ms, ease: ease-out]
fade-in code [600ms]

// Closing flourish
#4.5s
halo: Ellipse, size: (0, 0), color: accent.primary, at: (1040, 540)
beam1: Line, from: (1040, 540), to: (1040, 540), stroke: accent.success, stroke_width: 3
beam2: Line, from: (1040, 540), to: (1040, 540), stroke: accent.danger, stroke_width: 3
kicker: Text, text: "Scene → Story", font_size: 18, color: accent.warning, anchor: scene.right, offset: (-160, 70)

#4.5s
stagger [70ms] {
  fade-in halo [250ms]
  fade-in kicker [300ms]
}

#4.6s
halo.size = (100, 100) [500ms, ease: ease-out]

#4.7s
beam1.from = (1000, 500) [400ms]
beam1.to = (1080, 580) [400ms]
beam2.from = (1000, 580) [400ms]
beam2.to = (1080, 500) [400ms]

// Gentle ambient motion
#5.0s
shift prims [by: (0, -8), 2s, ease: ease-in-out]
shift halo [by: (0, -6), 2s, ease: ease-in-out]

#5.5s
pulse halo [500ms, intensity: 0.15]
