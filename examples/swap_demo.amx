// Bubble Sort Visualization
// Demonstrates the swap action with sequential animated reordering.

config { colorscheme: "editorial-dark", resolution: (1280, 720), dynamic_layout: true }

#0s
title: Text, text: "Bubble Sort", font_size: 48, color: text.primary, anchor: scene.top, offset: (0, 60)
subtitle: Text, text: "Visualizing element swapping", font_size: 20, color: text.secondary, anchor: scene.top, offset: (0, 120)

#0s
bars: Row, anchor: scene.center, gap: 8, align: "bottom" {
  bar1: Rect, size: (60, 80), color: accent.primary
  bar2: Rect, size: (60, 160), color: accent.primary
  bar3: Rect, size: (60, 120), color: accent.primary
  bar4: Rect, size: (60, 200), color: accent.primary
  bar5: Rect, size: (60, 40), color: accent.primary
}

#0.5s
fade-in title [800ms, ease: ease-out]
fade-in subtitle [600ms, delay: 200ms, ease: ease-out]

#1.0s
fade-in bars [600ms, ease: ease-out]

// Pass 1: bubble the largest element to the end
#2.0s
swap bar1 bar2 [500ms, ease: ease-in-out]

#3.0s
swap bar3 bar4 [500ms, ease: ease-in-out]

#4.0s
swap bar4 bar5 [500ms, ease: ease-in-out]

// Pass 2: bubble the second largest
#5.0s
swap bar1 bar3 [500ms, ease: ease-in-out]

#6.0s
swap bar3 bar5 [500ms, ease: ease-in-out]

// Pass 3: bubble the third largest
#7.0s
swap bar2 bar5 [500ms, ease: ease-in-out]

// Pass 4: final swap
#8.0s
swap bar1 bar2 [500ms, ease: ease-in-out]

// Highlight sorted state
#9.0s
bar1.color = accent.success [300ms]
bar2.color = accent.success [300ms]
bar3.color = accent.success [300ms]
bar4.color = accent.success [300ms]
bar5.color = accent.success [300ms]

#9.5s
done: Text, text: "Sorted!", font_size: 32, color: accent.success, anchor: scene.bottom, offset: (0, -80)

#9.5s
fade-in done [400ms, ease: ease-out]
