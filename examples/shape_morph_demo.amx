// Runnable example: vector-path morphing with scoped morph modifiers.

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Shape morph modifier demo", font_size: 42, color: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Timed re-declarations demonstrate strategy:auto, strategy:match, path_arc, and stretch.", font_size: 20, color: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The guide names the exact shipped modifier vocabulary without inventing any extra semantics.", font_size: 16, color: text.secondary, anchor: scene.top, offset: (0, 136) }

shape: Circle, radius: 100, color: accent.danger, at: (640, 390)
guide: Text { text: "2s: strategy:auto   ·   5s: strategy:match + path_arc   ·   8s: strategy:match + stretch", font_size: 18, color: accent.warning, anchor: scene.bottom, offset: (0, -64) }

#2s
shape: Rect, size: (220, 220), color: accent.success, at: (640, 390) [2s, ease: ease-in-out, strategy: auto]

#5s
shape: Path, commands: {
  move_to((-120, -120)),
  line_to((120, -120)),
  line_to((120, 120)),
  line_to((-120, 120)),
  close()
}, color: accent.primary, at: (640, 390) [2s, strategy: match, path_arc: 1.2]

#8s
shape: Ellipse, radius_x: 150, radius_y: 90, color: accent.warning, at: (640, 390) [2s, strategy: match, stretch: true]
