// Runnable example: vector-path morphing with scoped morph modifiers.

#0s
let ink = (0.04, 0.06, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let gold = (0.98, 0.82, 0.42, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Shape morph modifier demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Timed re-declarations demonstrate strategy:auto, strategy:match, path_arc, and stretch", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The bottom guide names the exact morph modifier vocabulary without introducing any unshipped semantics.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

shape: Circle, radius: 100, color: (1.0, 0.46, 0.54, 1.0), at: (640, 390)
guide: Text { text: "2s: strategy:auto   ·   5s: strategy:match + path_arc   ·   8s: strategy:match + stretch", font_size: 18, color: gold, anchor: scene.bottom, offset: (0, -58) }

#2s
shape: Rect, size: (220, 220), color: (0.35, 0.86, 0.63, 1.0), at: (640, 390) [2s, ease: ease-in-out, strategy: auto]

#5s
shape: Path, commands: {
  move_to((-120, -120)),
  line_to((120, -120)),
  line_to((120, 120)),
  line_to((-120, 120)),
  close()
}, color: accent, at: (640, 390) [2s, strategy: match, path_arc: 1.2]

#8s
shape: Ellipse, radius_x: 150, radius_y: 90, color: gold, at: (640, 390) [2s, strategy: match, stretch: true]
