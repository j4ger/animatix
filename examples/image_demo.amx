// Runnable example: raster image primitive with natural-size and explicit-size rendering.

config { colorscheme: "editorial-dark" }

#0s

header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent.primary }
  title: Text { text: "Image primitive demo", font_size: 42, color: text.primary }
  subtitle: Text { text: "The same raster source can render at natural size or with explicit width and height.", font_size: 20, color: text.secondary }
  caption: Text { text: "The stage stays restrained so the comparison reads instantly: left uses natural sizing, right uses explicit size scaling.", font_size: 16, color: text.secondary }
}

left_label: Text { text: "natural size", font_size: 18, color: accent.warning, at: (320, 246) }
right_label: Text { text: "size: (240, 240)", font_size: 18, color: accent.warning, at: (840, 246) }

natural: Image { url: "examples/checker.ppm", at: (280, 370) }
scaled: Image { url: "examples/checker.ppm", at: (760, 350), size: (240, 240) }
