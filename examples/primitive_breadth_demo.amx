// Runnable example: newer primitive breadth (`Dot`, `Square`, `RegularPolygon`).

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Primitive breadth demo", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Dot, Square, and RegularPolygon all ride on the same current vector primitive pipeline.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "Each primitive keeps a dedicated label and footprint, but the family now reads as one coherent stage.", font_size: 16, color_role: text.secondary, anchor: scene.top, offset: (0, 136) }

dot_label: Text { text: "Dot", font_size: 22, color_role: accent.danger, at: (260, 254) }
square_label: Text { text: "Square", font_size: 22, color_role: accent.primary, at: (640, 254) }
poly_label: Text { text: "RegularPolygon", font_size: 22, color_role: accent.success, at: (1020, 254) }

dot: Dot, color: accent.danger, stroke_role: stroke.default, stroke_width: 3, at: (260, 430)
square: Square, side: 120, color: accent.primary, stroke_role: stroke.default, stroke_width: 4, at: (640, 430)
hex: RegularPolygon, sides: 6, radius: 70, color: accent.success, stroke_role: stroke.default, stroke_width: 4, at: (1020, 430)
