// Runnable example: newer primitive breadth (`Dot`, `Square`, `RegularPolygon`).

#0s
let ink = (0.04, 0.05, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Primitive breadth demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Dot, Square, and RegularPolygon all ride on the same current vector primitive pipeline", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The family framing is standardized, but each primitive keeps its own dedicated label and footprint.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

dot_label: Text { text: "Dot", font_size: 22, color: coral, at: (260, 254) }
square_label: Text { text: "Square", font_size: 22, color: accent, at: (640, 254) }
poly_label: Text { text: "RegularPolygon", font_size: 22, color: green, at: (1020, 254) }

dot: Dot, color: coral, stroke: title_ink, stroke_width: 3, at: (260, 430)
square: Square, side: 120, color: accent, stroke: title_ink, stroke_width: 4, at: (640, 430)
hex: RegularPolygon, sides: 6, radius: 70, color: green, stroke: title_ink, stroke_width: 4, at: (1020, 430)
