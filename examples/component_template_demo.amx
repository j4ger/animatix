// Component templates: reusable parameterized actor groups.
//
// Use `pub component Name(param: default) { ... }` to define a reusable
// template, then instantiate it like any other actor.
//
// Note: Component parameters only support string literals or null as defaults.
// Pass actual values at instantiation time.

config { colorscheme: "editorial-dark" }

// Define a reusable card component with parameters
pub component MetricCard(title: "Untitled", value: "0", color: "primary") {
  frame: Rect, size: (240, 120), color: surface.primary, corner_radius: 8
  title_text: Text, text: title, font_size: 14, color: text.secondary, at: (0, -30)
  value_text: Text, text: value, font_size: 36, color: accent.primary, at: (0, 10)
  accent_bar: Rect, size: (240, 4), color: accent.primary, at: (0, -58)
}

// Another component: a labeled arrow annotation
pub component ArrowLabel(text: "", color: "warning") {
  arrow: Line, from: (0, 0), to: (100, 0), color: accent.warning, width: 2, size: (16, 12)
  label: Text, text: text, font_size: 12, color: accent.warning, at: (0, -20)
}

#0s
// Instantiate components with different parameters
card1: MetricCard, title: "Users", value: "12.4K", color: "success"
card2: MetricCard, title: "Latency", value: "24ms", color: "warning", at: (300, 0)
card3: MetricCard, title: "Errors", value: "0.1%", color: "danger", at: (600, 0)

anno1: ArrowLabel, text: "+23%", color: "success", at: (150, 150)

#1s
fade-in card1 [400ms]

#1.3s
fade-in card2 [400ms]

#1.6s
fade-in card3 [400ms]

#2s
fade-in anno1 [400ms]

#3s
anno1.position = (200, 120) [1s, ease: ease-out]

#4s
anno1.opacity = 0 [500ms]
