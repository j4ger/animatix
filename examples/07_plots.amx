// 07 — Data Viz: Graph, PlotCurve, VectorField, Heatmap

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

title: Text, text: "Data Visualization", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 60)

main: Graph, x_domain: (-6, 6), y_domain: (-3, 3), size: (520, 400), at: (640, 360) {
  sine: PlotCurve, kind: "cartesian", func: (x) => sin(x), color: accent.primary, stroke_width: 3
  damped: PlotCurve, kind: "cartesian", func: (x) => sin(x) * exp(-0.3 * x), color: accent.danger, stroke_width: 2
}

field: VectorField, func: (x, y) => (y * 0.4, -x * 0.4), density: 12, color: accent.success, x_domain: (-4, 4), y_domain: (-4, 4), at: (140, 160), size: (220, 220)

heat: Heatmap, func: (x, y) => sin(x) * cos(y), resolution: 28, color: accent.warning, x_domain: (-3.14, 3.14), y_domain: (-3.14, 3.14), at: (1140, 160), size: (220, 220)

#0.5s
fade-in title [600ms, ease: ease-out]

#+0.3s
stagger [100ms] {
  fade-in main [500ms]
  fade-in field [400ms]
  fade-in heat [400ms]
}

#3s
main.size = (570, 440) [1.2s, ease: ease-in-out]
field.size = (240, 240) [1.2s, ease: ease-in-out]
heat.size = (240, 240) [1.2s, ease: ease-in-out]