  orbit: ParametricPlot, x_func: (t) => cos(t), y_func: (t) => sin(2 * t), t_range: (0, 6.28318), color: (0.3, 1.0, 0.6, 1.0), width: 3,
  contour: ImplicitPlot, equation: (x, y) => x^2 + y^2 - 1, color: (1.0, 1.0, 1.0, 1.0), width: 2
}

