#0s
scene.background_color = (0.04, 0.05, 0.08, 1.0)

guide: Path, points: {(0, 0), (120, 90), (240, -20), (360, 120)}, closed: false, stroke: (1.0, 1.0, 1.0, 1.0), width: 4, at: (160, 200)
