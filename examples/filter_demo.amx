config {
  resolution: (1280, 720),
  colorscheme: "editorial-dark"
}

bg: Image, url: "examples/assets/photo.jpg", size: fill, anchor: scene.center

// Blurred darkened background
blur_bg: Filter, blur: 40, brightness: 0.4 {
  bg_copy: Image, url: "examples/assets/photo.jpg", size: fill, anchor: scene.center
}

// Foreground card — sharp, on top of blur
fg: Stack, anchor: scene.center {
  card: Rect, size: (400, 240), color: (0.1, 0.1, 0.12, 0.85), anchor: scene.center
  title: Text, text: "Filter Demo", font_size: 48, color: text.primary, anchor: scene.center
}

// Animate the blur in
#0s
blur_bg.blur = 0
blur_bg.brightness = 1.0

#1.5s
blur_bg.blur = 40 [1.5s, ease: ease-out]
blur_bg.brightness = 0.4 [1.5s]

// Sepia toggle on card
#3s
fg.sepia = 0

#4s
fg.sepia = 0.8 [1s]

#5.5s
fg.sepia = 0 [1s]
