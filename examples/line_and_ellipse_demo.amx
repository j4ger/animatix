// Runnable example: the Line and Ellipse primitives with animated endpoint and radius updates.

config { colorscheme: "editorial-dark" }

#0s
header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent.primary }
  title: Text { text: "Line + ellipse demo", font_size: 42, color: text.primary }
  subtitle: Text { text: "Line endpoints and ellipse radii animate independently on the same technical stage.", font_size: 20, color: text.secondary }
  caption: Text { text: "The axis line pivots while the ellipse changes proportion and fill, keeping the geometry easy to inspect while scrubbing.", font_size: 16, color: text.secondary }
}

ring: Ellipse, radius_x: 180, radius_y: 90, color: (0.20, 0.80, 1.0, 0.22), stroke: accent.primary, stroke_width: 4, at: (640, 390)
axis: Line, from: (-220, 0), to: (220, 0), stroke: accent.warning, stroke_width: 6, at: (640, 390)
axis_caption: Text { text: "Animated line endpoints", font_size: 18, color: accent.warning, anchor: scene.bottom, offset: (0, -64) }

#2s
ring.radius_x = 120 [1s, ease: ease-in-out]
ring.radius_y = 140 [1s, ease: ease-in-out]
axis.to = (220, 120) [1s, ease: ease-in-out]

#4s
axis.from = (-220, -120) [1s, ease: ease-in-out]
ring.color = (0.36, 0.88, 0.63, 0.26) [1s, ease: ease-in-out]
