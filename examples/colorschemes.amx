// Colorschemes: selection, auto colors, explicit overrides.

config { colorscheme: "editorial-dark" }

#0s
label: Text, text: "Auto colors (left) vs explicit override (right)", font_size: 20, color: text.primary, anchor: scene.top, offset: (0, 120)

row: Row, anchor: scene.center, offset: (0, -20), gap: 50, align: "center" {
  auto1: Circle, radius: 32
  auto2: Circle, radius: 32
  auto3: Circle, radius: 32
}

override: Circle, radius: 24, color: accent.warning, at: (640, 520)

#1.5s
auto1.radius = 48 [700ms, ease: ease-in-out]
auto2.color = accent.success [700ms, ease: ease-in-out]
auto3.color = accent.danger [700ms, ease: ease-in-out]
