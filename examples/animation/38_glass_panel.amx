import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6 }

floor: StageFloor
head: ActHead, kicker: "VISUAL · GLASS", title: "Glass panel",
  sub: "Backdrop blur."
caption: Caption, text: "The glass panel blurs the content behind it while keeping text sharp.", tag: "38_glass_panel"

stripes: Group, at: (640, 360) {
    s1: Rect, size: (1180, 26), at: (-560, -240), color: accent.primary, corner_radius: 6
    s2: Rect, size: (1180, 26), at: (-560, -160), color: accent.info, corner_radius: 6
    s3: Rect, size: (1180, 26), at: (-560, -80), color: accent.warning, corner_radius: 6
    s4: Rect, size: (1180, 26), at: (-560, 0), color: accent.primary, corner_radius: 6
    s5: Rect, size: (1180, 26), at: (-560, 80), color: accent.info, corner_radius: 6
    s6: Rect, size: (1180, 26), at: (-560, 160), color: accent.warning, corner_radius: 6
    s7: Rect, size: (1180, 26), at: (-560, 240), color: accent.primary, corner_radius: 6
}

dots: Group, at: (640, 360) {
    d1: Ellipse, size: (34, 34), at: (-420, -60), color: text.primary
    d2: Ellipse, size: (34, 34), at: (-280, 60), color: text.primary
    d3: Ellipse, size: (34, 34), at: (-140, -60), color: text.primary
    d4: Ellipse, size: (34, 34), at: (0, 60), color: text.primary
    d5: Ellipse, size: (34, 34), at: (140, -60), color: text.primary
    d6: Ellipse, size: (34, 34), at: (280, 60), color: text.primary
}

card: Glass, at: (640, 360), size: (560, 240), corner_radius: 24 {
    frost: Blur, radius: 0
    surface: Rect, size: (560, 240), corner_radius: 24,
      color: "#ffffff1a", stroke: "#ffffff40", stroke_width: 1.5
    heading: Text, text: "Backdrop blur", font_size: 40, at: (-180, -34), color: text.primary
    body: Text, text: "sharp text over a frosted plate", font_size: 20,
      at: (-150, 30), color: text.secondary
}

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms, delay: 300ms]
fade-in stripes [600ms, ease: expo-out]
fade-in dots [600ms, ease: expo-out, delay: 120ms]
settle-in card [520ms, ease: expo-out, delay: 240ms]

#1s
shift stripes [by: (240, 0), 2.4s, ease: ease-in-out]
shift dots [by: (-240, 0), 2.4s, ease: ease-in-out]

#1.2s
frost.radius = 18 [900ms, ease: ease-in-out]
surface.color = "#ffffff0f" [900ms, ease: ease-in-out]

#4s
frost.radius = 6 [900ms, ease: ease-in-out]
shift stripes [by: (-240, 0), 1.4s, ease: ease-in-out]
