import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"
import "../../web/demos/lib/ui.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

floor: StageFloor
head: ActHead, kicker: "ANIMATION · SCALE", title: "Grow & shrink",
  sub: "Pivot-anchored scale entrances and exits."
caption_band: Caption, text: "Bars grow from the bottom; the card collapses and returns.", tag: "42_grow_shrink"

// Bars are declared before the first keyframe: grow-in lifts their hidden
// opacity seed while the scale ramp rises from each bar's bottom edge.
bar1: Rect, size: (64, 160), at: (480, 540), corner_radius: 10, color: accent.primary
bar2: Rect, size: (64, 240), at: (580, 500), corner_radius: 10, color: accent.success
bar3: Rect, size: (64, 320), at: (680, 460), corner_radius: 10, color: accent.warning
bar4: Rect, size: (64, 400), at: (780, 420), corner_radius: 10, color: accent.danger

card: CardNode,
  title: "Scale, not opacity",
  eyebrow: "SHRINK-OUT",
  sub: "collapses to a point, then returns",
  width: 330,
  height: 190,
  focal: true,
  at: (1010, 430)

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption_band [400ms, delay: 300ms]

#0.4s
stagger [90ms] {
  grow-in bar1 [from: bottom, 800ms]
  grow-in bar2 [from: bottom, 800ms]
  grow-in bar3 [from: bottom, 800ms]
  grow-in bar4 [from: bottom, 800ms]
}

#1.8s
shrink-out card [700ms, ease: ease-in]

#2.8s
grow-in card [500ms, ease: expo-out]
