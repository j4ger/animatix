import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "neon-night", resolution: (1280, 720), duration: 6 }

let spark_indices = range(0, 18)
let mote_indices = range(0, 12)

floor: StageFloor

head: ActHead, kicker: "VISUAL · PARTICLES", title: "Analytic particles", sub: "Particle physics visualization."

caption: Caption, text: "Particles are driven by seeded noise and fbm.", tag: "34_particles_analytic"

glow: Ellipse, size: (620, 620), at: (640, 380), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, hex_color("ff9f0a55")), (55%, hex_color("ff2d5522")), (100%, hex_color("ff2d5500"))}), blend: "screen"

origin: Ellipse, size: (14, 14), at: (640, 380), color: hex_color("ffe9c7")

for i in spark_indices {
  spark[i]: Ellipse, size: (14, 14), at: (640, 380), color: hex_color("ffd60a"), opacity: 1
}

for j in mote_indices {
  mote[j]: Ellipse, size: (4, 4), at: (640, 360), color: hex_color("64d2ff"), opacity: 1
}

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s, delay: 0.3s)
  fade_in(target: glow, duration: 0.6s)
  pop_in(target: origin, duration: 0.3s)
  always {
      let age = clamp(t - 0.6, 0, 2.4)
      let life_fraction = linear_progress(t, 0.6, 3)
      for i in spark_indices {
            let dir = seeded_noise(i * 1.37, 0.5) * 6.28318
            let speed = 180 + seeded_noise(i * 2.11, 9) * 340
            let reach = speed * age
            spark[i].at = (640 + cos(dir) * reach, (380 + sin(dir) * reach) + (260 * age) * age)
            spark[i].size = (14 * (1 - age / 2.8), 14 * (1 - age / 2.8))
            spark[i].color = lerp_color_oklab(hex_color("ffe9c7"), hex_color("ff2d55"), life_fraction)
            spark[i].opacity = 1 - life_fraction
          }
      let period = 6
      let phase = ((t % period) / period) * 6.28318
      for j in mote_indices {
            let seed = j * 3.71
            let bx = 200 + seeded_noise(seed, 1) * 380
            let by = 140 + seeded_noise(seed, 2) * 440
            mote[j].at = (bx + fbm(cos(phase + seed) * 0.9 + 2, 3) * 90, by + fbm(sin(phase + seed) * 0.9 + 2, 3) * 90)
            mote[j].opacity = 0.35 + 0.45 * (0.5 + 0.5 * sin(phase * 2 + seed))
          }
    }
