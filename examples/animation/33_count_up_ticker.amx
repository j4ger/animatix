import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "paper", resolution: (1280, 720), duration: 4 }

floor: StageFloor
head: ActHead, kicker: "UI · TICKER", title: "Count up ticker",
  sub: "Counter 数字滚动演示。"
caption: Caption, text: "The counter interpolates values over time.", tag: "33_count_up_ticker"

label: Text, text: "ships this quarter", at: (640, 467), font_size: 26
kpi: Text, text: "0%", at: (640, 333), font_size: 132
rule: Rect, size: (320, 4), at: (640, 416), corner_radius: 2, fill_gradient: linear(90, {"#ff2d55", "#ff9f0a"})

always {
  let p = clamp((t - 0.4) / 1.8, 0, 1)
  let eased = (p * p) * (3 - 2 * p)
  kpi.text = format("{:.0}%", eased * 87)
}

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms, delay: 300ms]
fade-in label [400ms]
settle-in kpi [500ms]
fade-in rule [400ms]
