// 05 — Morph: Shape Transformation
// Re-declaration triggers automatic interpolation between shapes.
import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 11 }

floor: StageFloor

head: ActHead, kicker: "ANIMATION · MORPH", title: "Shape transformation", sub: "Automatic interpolation between primitives via re-declaration."

caption: Caption, text: "Morphing between geometric primitives across keyframes.", tag: "05_morph.amx"

circle: Ellipse, size: (140, 140), color: accent.primary, at: (320, 420)

rect: Rect, size: (140, 140), color: accent.success, at: (640, 420)

poly: Polygon, points: {(0, -70), (70, 0), (0, 70), (-70, 0)}, color: accent.warning, at: (960, 420)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s, delay: 0.3s)
  stagger [0.1s] {
      fade_in(target: circle, duration: 0.5s, delay: 0.2s, ease: ease_out)
      fade_in(target: rect, duration: 0.5s, delay: 0.2s, ease: ease_out)
      fade_in(target: poly, duration: 0.5s, delay: 0.2s, ease: ease_out)
    }

// Circle → Rect with auto strategy
#2s
  circle: Rect, size: (140, 140), color: accent.danger, at: (320, 420) [1s, strategy: auto]

// Rect → Ellipse with match strategy
#3.5s
  rect: Ellipse, size: (160, 120), color: accent.primary, at: (640, 420) [1s, strategy: match]

// Diamond → Star with path arc hint
#5s
  poly: Polygon, points: {(0, -80), (20, -25), (75, -25), (30, 10), (45, 65), (0, 35), (-45, 65), (-30, 10), (-75, -25), (-20, -25)}, color: accent.success, at: (960, 420) [1.5s, path_arc: 0.3]

// Circle (now Rect) → Diamond with fade strategy
#6.5s
  circle: Polygon, points: {(0, -75), (75, 0), (0, 75), (-75, 0)}, color: accent.primary, at: (320, 420) [1s, strategy: fade]

// Rect (now Ellipse) → Trapezoid with stretch normalization
#6.8s
  rect: Path, commands: {move_to(-80, -45), line_to(80, -45), line_to(55, 45), line_to(-55, 45), close()}, color: accent.danger, at: (640, 420) [1s, stretch: true]

// Unify colors as a finale
#8s
  circle.color = accent.warning[0.8s]
  rect.color = accent.warning[0.8s]
  poly.color = accent.warning[0.8s]
