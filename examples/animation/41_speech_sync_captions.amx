import "../lib/theme.amx"

import "../lib/stage.amx"

import "../lib/ui.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

floor: StageFloor

head: ActHead, kicker: "VOICEOVER · SYNC", title: "Speech synchronization", sub: "Speech-anchored kinetic timeline."

caption_band: Caption, text: "Captions synchronize perfectly with every spoken word.", tag: "41_speech_sync_captions"

// Audio track binding with accompanying speech transcript
voice: Audio, source: "../assets/narration.mp3", transcript: "../assets/narration.speech.json"

// Background canvas
bg: Rect, size: (1280, 720), color: surface.secondary, at: (640, 360)

// Hero Title
title: Text, text: "Speech-Anchored Kinetic Timeline", font_size: 42, font_weight: "bold", at: (640, 140), text_align: "center", color: text.primary

// Three synchronized story cards
card_intro: CardNode, title: "1. Speech Anchors", eyebrow: "SYNTAX", sub: "#voice@marker & #voice[\"word\"]", at: (300, 320)

card_feature: CardNode, title: "2. Zero Overhead", eyebrow: "COMPILER", sub: "Compile-time static lowering", at: (640, 320), focal: true

card_captions: CardNode, title: "3. Kinetic Captions", eyebrow: "RENDERING", sub: "Word pop & karaoke fill", at: (980, 320)

// First-class Subtitle / Caption container
subs: Captions, at: (640, 580), transcript: "../assets/narration.speech.json", caption_mode: "karaoke", active_color: accent.primary, inactive_color: text.muted, font_size: 28, backdrop: true, backdrop_color: (0.05, 0.08, 0.14, 0.92), backdrop_radius: 14, backdrop_padding: (28, 14), pop_scale: 1.15

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption_band, duration: 0.4s, delay: 0.3s)
  fade_in(target: bg, duration: 0.4s)
  fade_in(target: title, duration: 0.4s)

// Speech-Synchronized Cue Points
#voice@intro
  fade_in(target: card_intro, duration: 0.4s)
  fade_in(target: subs, duration: 0.4s)

#voice["Animatix"]
  title.color = accent.primary [0.3s]

// "The layout-first animation DSL for technical storytelling."
#voice@feature
  fade_in(target: card_feature, duration: 0.4s)

#voice["DSL"]
  card_feature.card_bg.stroke = accent.primary [0.2s]

// "Watch captions synchronize perfectly with every spoken word."
#voice@captions
  fade_in(target: card_captions, duration: 0.4s)

#voice["perfectly"]
  card_captions.card_bg.stroke = accent.secondary [0.2s]

#voice@outro
  title.color = text.primary [0.4s]
