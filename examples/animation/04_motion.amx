// 04 — Motion: Actions & Expressions
// Built-in motion actions and reactive expressions with always.
import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 11 }

floor: StageFloor

head: ActHead, kicker: "ANIMATION · MOTION", title: "Actions & expressions", sub: "Discrete keyframe transforms coupled with continuous reactive motion."

caption: Caption, text: "Keyframe shift, rotate, scale alongside continuous always block.", tag: "04_motion.amx"

actor: Rect, size: (100, 100), corner_radius: 16, color: accent.primary, at: (640, 420)

pulse: Rect, size: (50, 50), corner_radius: 12, color: accent.success

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s, delay: 0.3s)
  fade_in(target: actor, duration: 0.6s, delay: 0.2s, ease: ease_out)
  fade_in(target: pulse, duration: 0.6s, delay: 0.2s, ease: ease_out)

#1.5s
  shift(target: actor, by: (180, 0), duration: 0.8s, ease: ease_in_out)

#2.5s
  rotate(target: actor, by: deg(90), duration: 0.8s, ease: ease_in_out)

#3.5s
  scale(target: actor, by: 1.4, duration: 0.8s, ease: bounce_in)

#4.5s
  actor.color = accent.warning [0.6s, ease: ease_in_out]

#5.5s
  scale(target: actor, by: 0.714, duration: 0.8s, ease: ease_in_out)

#6.5s
  rotate(target: actor, by: deg(-90), duration: 0.8s, ease: ease_in_out)

#7.5s
  shift(target: actor, by: (-180, 0), duration: 0.8s, ease: ease_in_out)

#8.5s
  actor.color = accent.primary [0.6s, ease: ease_in_out]
  // Reactive expression: orbital motion and pulsing
  always {
      let cx = scene_width / 2
      let cy = 420
      pulse.at = (cx + 140 * cos(t * 2), cy + 90 * sin(t * 2))
      let s = 1 + 0.3 * sin(t * 3)
      pulse.size = (50 * s, 50 * s)
    }
