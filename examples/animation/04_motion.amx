// 04 — Motion: Actions & Expressions
// Built-in motion actions and reactive expressions with always.

import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

actor: Rect, size: (100, 100), color: accent.primary, at: (640, 360)
pulse: Rect, size: (60, 60), color: accent.success

#0.5s
fade-in actor [600ms, ease: ease-out]
fade-in pulse [600ms, ease: ease-out]

#1.5s
shift actor [by: (180, 0), 800ms, ease: ease-in-out]

#2.5s
rotate actor [by: deg(90), 800ms, ease: ease-in-out]

#3.5s
scale actor [by: 1.4, 800ms, ease: bounce]

#4.5s
actor.color = accent.warning [600ms, ease: ease-in-out]

#5.5s
scale actor [by: 0.714, 800ms, ease: ease-in-out]

#6.5s
rotate actor [by: deg(-90), 800ms, ease: ease-in-out]

#7.5s
shift actor [by: (-180, 0), 800ms, ease: ease-in-out]

#8.5s
fade-out actor [600ms, ease: ease-in]

// Reactive expression: orbital motion and pulsing
always {
  let cx = scene.center.x
  let cy = scene.center.y
  pulse.at = (cx + 130 * cos(t * 2.0), cy + 90 * sin(t * 2.0))
  let s = 1.0 + 0.4 * sin(t * 3.0)
  pulse.size = (60 * s, 60 * s)
}