// 04 — Motion: Actions & Expressions
// Built-in motion actions and reactive expressions with always.

import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 11 }

floor: StageFloor
head: ActHead, kicker: "ANIMATION · MOTION", title: "Actions & expressions",
  sub: "Discrete keyframe transforms coupled with continuous reactive motion."
caption: Caption, text: "Keyframe shift, rotate, scale alongside continuous always block.", tag: "04_motion.amx"

actor: Rect, size: (100, 100), corner_radius: 16, color: accent.primary, at: (640, 420)
pulse: Rect, size: (50, 50), corner_radius: 12, color: accent.success

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms, delay: 300ms]
fade-in actor [600ms, delay: 200ms, ease: ease-out]
fade-in pulse [600ms, delay: 200ms, ease: ease-out]

#1.5s
shift actor [by: (180, 0), 800ms, ease: ease-in-out]

#2.5s
rotate actor [by: deg(90), 800ms, ease: ease-in-out]

#3.5s
scale actor [by: 1.4, 800ms, ease: bounce]

#4.5s
actor.color = accent.warning [600ms, ease: ease-in-out]

#5.5s
scale actor [by: 0.714, 800ms, ease: ease-in-out]

#6.5s
rotate actor [by: deg(-90), 800ms, ease: ease-in-out]

#7.5s
shift actor [by: (-180, 0), 800ms, ease: ease-in-out]

#8.5s
actor.color = accent.primary [600ms, ease: ease-in-out]

// Reactive expression: orbital motion and pulsing
always {
  let cx = scene_width / 2.0
  let cy = 420.0
  pulse.at = (cx + 140 * cos(t * 2.0), cy + 90 * sin(t * 2.0))
  let s = 1.0 + 0.3 * sin(t * 3.0)
  pulse.size = (50 * s, 50 * s)
}
