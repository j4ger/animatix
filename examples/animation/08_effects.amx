// 08 — Filters & Effects Composition
// Filter scope + effect chain (Blur, ColorGrade) + effect actions (shake, pulse, bounce).
import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 12 }

floor: StageFloor

head: ActHead, kicker: "ANIMATION · EFFECTS", title: "Filters & effects", sub: "Demonstrating chained filter scopes and built-in procedural effects."

caption: Caption, text: "Chained filter effects with procedural animations.", tag: "08_effects.amx"

bg_mark: Svg, url: "../assets/animatix-mark.svg", size: (360, 360), at: (640, 430), opacity: 0.08

bg: Filter, at: (640, 430) {
bg_soft: Blur, radius: 0
bg_grade: ColorGrade, brightness: 0.6
bg_vignette: Vignette, amount: 0, radius: 0.5, softness: 0.75
bg_grain: Grain, amount: 0, monochrome: true
bg_levels: Levels, gamma: 1
grid: Image, url: "../assets/checker.png", size: (360, 360), at: (640, 430)
}

fg_filter: Filter, anchor: scene.center {
fg_sepia: ColorGrade, sepia: 0
fg_focus: Sharpen, amount: 0, radius: 2
fg: Stack, anchor: scene.center {
card: Rect, size: (280, 220), color: (0.1, 0.1, 0.12, 0.85), anchor: scene.center
label: Text, text: "Filter FX", font_size: 36, color: text.primary, anchor: scene.center
  }
}

chip: Filter, anchor: scene.center, offset: (-420, 120) {
chip_blur: MotionBlur, length: 0, angle: 0
plate: Rect, size: (130, 40), color: accent.danger
}

target: Rect, size: (50, 50), color: accent.danger, at: (640, 510)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s, delay: 0.3s)
  stagger [0.08s] {
      fade_in(target: bg_mark, duration: 0.5s, delay: 0.2s)
      fade_in(target: bg, duration: 0.4s, delay: 0.2s)
      fade_in(target: fg_filter, duration: 0.4s, delay: 0.2s)
      fade_in(target: target, duration: 0.4s, delay: 0.2s)
    }

#1.2s
  bg.bg_soft.radius = 12 [1.2s, ease: ease_out]
  bg.bg_grade.brightness = 0.3[1.2s]

#2.2s
  bg.bg_vignette.amount = 0.5 [1s, ease: ease_out]
  bg.bg_grain.amount = 0.22 [1s, ease: ease_out]

#3s
  bg.bg_soft.radius = 0 [0.8s, ease: ease_out]
  bg.bg_grade.brightness = 0.6[0.8s]

#3.5s
  fade_in(target: chip, duration: 0.3s)

#3.6s
  chip.chip_blur.length = 24 [0.3s, ease: ease_in]
  chip.offset = (0, 0) [0.6s, ease: ease_out]

#4.1s
  chip.chip_blur.length = 0 [0.4s, ease: ease_out]

#5s
  fg_filter.fg_sepia.sepia = 0.8[0.8s]

#6s
  fg_filter.fg_focus.amount = 2.2 [0.8s, ease: ease_in_out]

#7s
  fg_filter.fg_focus.amount = 0 [0.7s, ease: ease_in]

#7.5s
  fg_filter.fg_sepia.sepia = 0[0.8s]

#8.2s
  pulse(target: target, duration: 0.35s, intensity: 1.5)

#8.8s
  shake(target: target, duration: 0.4s, intensity: 2)

#9s
  // Night dip: lift the black point and pull the midtones down.
  bg.bg_levels.in_black = 0.05 [1s, ease: ease_in_out]
  bg.bg_levels.gamma = 0.85 [1s, ease: ease_in_out]
  bg.bg_grain.amount = 0.3[1s]

#9.6s
  bounce(target: target, duration: 0.8s, intensity: 20, restitution: 0.62)
