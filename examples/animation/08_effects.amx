// 08 — Filters & Effects Composition
// Filter scope + effect chain (Blur, ColorGrade) + effect actions (shake, pulse, bounce).

import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

bg_mark: Svg, url: "examples/assets/animatix-mark.svg", size: (500, 500), anchor: scene.center, opacity: 0.08

// Effects are declared as labelled children of a Filter scope, in application order.
bg: Filter, anchor: scene.center {
  bg_soft: Blur, radius: 0
  bg_grade: ColorGrade, brightness: 0.6
  grid: Image, url: "examples/assets/checker.png", size: (500, 500), anchor: scene.center
}

// Foreground card on top of blurred background (wrapped in Filter for sepia effect)
fg_filter: Filter, anchor: scene.center {
  fg_sepia: ColorGrade, sepia: 0
  fg: Stack, anchor: scene.center {
    card: Rect, size: (280, 220), color: (0.1, 0.1, 0.12, 0.85), anchor: scene.center
    label: Text, text: "Filter FX", font_size: 36, color: text.primary, anchor: scene.center
  }
}

target: Rect, size: (60, 60), color: accent.danger, anchor: scene.center, offset: (0, 100)

title: Text, text: "Filters & Effects", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 60)

#0s
bg.bg_soft.radius = 0
bg.bg_grade.brightness = 0.6

#1.5s
bg.bg_soft.radius = 12 [1.5s, ease: ease-out]
bg.bg_grade.brightness = 0.3 [1.5s]

#3.5s
bg.bg_soft.radius = 0 [1s, ease: ease-out]
bg.bg_grade.brightness = 0.6 [1s]

#5s
fg_filter.fg_sepia.sepia = 0

#5.5s
fg_filter.fg_sepia.sepia = 0.8 [1s]

#7s
fg_filter.fg_sepia.sepia = 0 [1s]

#8.5s
pulse target [400ms, intensity: 1.5]

#9.5s
shake target [500ms, intensity: 2]

#10.5s
bounce target [400ms, intensity: 2.5]

#0.5s
fade-in title [600ms, ease: ease-out]

#+0.3s
stagger [80ms] {
  fade-in bg_mark [500ms]
  fade-in bg [400ms]
  fade-in fg [400ms]
  fade-in target [400ms]
}
