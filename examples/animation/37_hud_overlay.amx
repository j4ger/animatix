// 37_hud_overlay.amx — `camera_follow: false`: the overlay that stays put.
//
// The scene pushes in and pans, and everything in the plate travels with it —
// except the two things pinned to the viewport, which declared
// `camera_follow: false`. That flag is read where the camera is applied (once, at
// each root subtree), so the opted-out actors keep their *authored* coordinates:
// they are outside the transform, not compensating for it.
//
// Two things worth noticing:
//
//   - The opt-out belongs on a root actor. On a child it would read as a HUD that
//     keeps moving with its parent, and `check` says so (`inapplicable-property`).
//   - It is a declaration, like `icon` — not a keyframed property. A scene that
//     wants the overlay to arrive *with* the camera can simply declare it after
//     the push instead.
//
// One rule to know: the frost is a copy of the frame taken after the whole frame
// is drawn, so *everything* under the panel's rect is inside it, whenever it was
// declared. What must stay sharp on top of the blur is a child of the scope.
config { colorscheme: "editorial-dark", resolution: (1280, 720), duration: 6.6 }

plate: Rect, size: (400, 220), at: (600, 450), color: surface.secondary, corner_radius: 20, stroke: text.muted, stroke_width: 2, opacity: 1

rows: Col, at: (600, 450), gap: 26 {
r1: Rect, size: (330, 16), color: accent.primary, opacity: 1
r2: Rect, size: (260, 16), color: accent.secondary, opacity: 1
r3: Rect, size: (390, 16), color: text.muted, opacity: 1
}

heading: Text, text: "the plate travels", font_size: 34, color: text.primary, at: (600, 320), opacity: 1

// Pinned to the viewport: a live badge and the rule it sits on.
hud: Text, text: "LIVE · 04 / 12", font_size: 24, color: accent.primary, at: (1088, 84), camera_follow: false, opacity: 1

tick: Rect, size: (150, 3), at: (1088, 112), color: text.secondary, camera_follow: false, opacity: 1

#0s
  fade_in(target: heading, duration: 0.42s, ease: expo_out)
  settle_in(target: plate, duration: 0.52s, ease: expo_out)
  // The rows arrive one after another so the card reads as content, not a block.
  stagger [0.09s] {
      fade_in(target: r1, duration: 0.26s, ease: ease_out)
      fade_in(target: r2, duration: 0.26s, ease: ease_out)
      fade_in(target: r3, duration: 0.26s, ease: ease_out)
    }
  pop_in(target: hud, duration: 0.42s, ease: expo_out, delay: 0.14s)
  fade_in(target: tick, duration: 0.3s, ease: expo_out, delay: 0.26s)

#1.1s
  camera.zoom = 1.45 [1.2s, ease: expo_out]
  camera.at = (-52, 26) [1.2s, ease: expo_out]

#4.2s
  camera.zoom = 1 [0.9s, ease: ease_in_out]
  camera.at = (0, 0) [0.9s, ease: ease_in_out]

// Outro: the plate leaves first and the pinned overlay last, so the overlay is
// the final thing on screen — which only reads as deliberate because it never
// moved.
#5.6s
  fade_out(target: heading, duration: 0.3s, ease: ease_in)
  fade_out(target: rows, duration: 0.3s, ease: ease_in, delay: 0.04s)
  fade_out(target: plate, duration: 0.3s, ease: ease_in, delay: 0.08s)
  fade_out(target: hud, duration: 0.32s, ease: ease_in, delay: 0.22s)
  fade_out(target: tick, duration: 0.32s, ease: ease_in, delay: 0.22s)
