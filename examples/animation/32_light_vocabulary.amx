import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "neon-night", resolution: (1280, 720), duration: 8 }

floor: StageFloor

head: ActHead, kicker: "VISUAL · LIGHT", title: "Light vocabulary", sub: "Compositional elements of light."

caption: Caption, text: "Elements combine to form a light-based composition.", tag: "32_light_vocabulary"

wash: Ellipse, size: (900, 900), at: (420, 300), fill_gradient: radial((0.5, 0.5), 0.5, {(0%, "#5e5ce6"), (60%, "#5e5ce633"), (100%, "#5e5ce600")}), blend: "screen"

bar: Rect, size: (760, 88), at: (640, 220), corner_radius: 22, fill_gradient: linear(120, {"#ff2d55", "#ff9f0a"})

arc: Path, commands: {move_to(320, 520), curve_to(480, 380, 800, 380, 960, 520)}, stroke_width: 10, fill_opacity: 0, stroke_gradient: sweep(0, {"#30d158", "#ffd60a", "#ff2d55", "#30d158"}), gradient_extend: "reflect"

wire: Path, commands: {move_to(240, 620), line_to(1040, 620)}, stroke: accent.info, stroke_width: 2, fill_opacity: 0, dash_pattern: {10, 7}

title: Text, text: "made of light", at: (640, 220), font_size: 54

mote: Ellipse, size: (14, 14), at: (640, 400), color: lerp_color_oklab("#30d158", "#ff2d55", 0.5)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s, delay: 0.3s)
  fade_in(target: wash, duration: 0.9s)
  settle_in(target: bar, duration: 0.7s)
  pop_in(target: title, duration: 0.6s)
  draw_in(target: arc, duration: 1.2s, ease: expo_out)
  fade_in(target: wire, duration: 0.4s)
  pop_in(target: mote, duration: 0.5s)
  wire.dash_offset = 0

#0.9s
  bar.shift = (0, 0)

#2.2s
  bar.shift = (0, -14) [1.3s, ease: ease_in_out]

#2.4s
  wire.dash_offset = 340[2.6s]
  always {
      let wobble = fbm(t * 0.5, 4)
      mote.at = (640 + wobble * 220, 400 + seeded_noise(7, t * 0.8) * 60)
    }

#5s
  move(target: bar, to: (0, 30), duration: 1.2s, anticipate: 0.09s)

#6.4s
  fade_out(target: wash, duration: 1.2s)
  fade_out(target: bar, duration: 0.9s)
  fade_out(target: title, duration: 0.9s)
  wipe_out(target: arc, duration: 0.9s)
