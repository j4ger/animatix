import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"
import "../../web/demos/lib/light.amx"

config { colorscheme: "vivid", resolution: (1280, 720), duration: 6.5 }

floor: StageFloor
head: ActHead, kicker: "LIGHT · PACK", title: "Light pack",
  sub: "Declarative light and motion components."
caption: Caption, text: "Complex lighting and motion using ready-made components.", tag: "36_light_pack"

key: KeyLight, radius: 400, at: (560, 300)
fill: CoolLight, radius: 300, at: (900, 470)

card: Rect, size: (300, 190), at: (560, 300), color: accent.primary, corner_radius: 18
kpi: Ticker, to: 1284, size: 64, suffix: "×", at: (560, 300)

beat: Breather, gain: 0.07, rate: 2.1, at: (940, 300)
rail: MarchingRail, length: 900, gap: 8, speed: 40, at: (640, 600)

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms, delay: 300ms]
fade-in card [500ms]
fade-in beat [500ms]
fade-in rail [700ms]
fade-in kpi [400ms]
