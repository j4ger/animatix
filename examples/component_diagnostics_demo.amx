// Runnable example: valid and invalid dotted component access patterns.
// This file is meant to render successfully while intentionally producing
// build diagnostics for the invalid paths documented in the captions below.

import "./modules/metric_card.amx"

config { colorscheme: "editorial-dark" }

#0s

eyebrow: Text { text: "Animatix example suite", font_size: 18, color_role: accent.primary, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Component diagnostics", font_size: 42, color_role: text.primary, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Valid dotted access stays live; invalid nested targets and rhs lookups still emit diagnostics without crashing the stage.", font_size: 20, color_role: text.secondary, anchor: scene.top, offset: (0, 108) }
caption_ok: Text { text: "Valid: left.badge.color, echo.radius = right.badge.radius, connector.from = left.badge.at", font_size: 15, color_role: accent.success, anchor: scene.top, offset: (0, 144) }
caption_bad: Text { text: "Invalid on purpose: left.nonexistent.color, ghost.radius = left.missing.radius, ghost.color = left.missing.color", font_size: 15, color_role: accent.danger, anchor: scene.top, offset: (0, 168) }

left: MetricCard, title: "Latency"
right: MetricCard, title: "Throughput"
left.at = (420, 392)
right.at = (860, 392)

echo: Circle, radius: right.badge.radius, color: right.badge.color, at: (1110, 480)
ghost: Circle, radius: left.missing.radius, color: left.missing.color, at: (1110, 560)
connector: Line, from: left.badge.at, to: right.badge.at, stroke_role: stroke.default, stroke_width: 3, at: (640, 392)

#0s
left.badge.color = accent.danger
right.badge.radius = 20
left.nonexistent.color = accent.warning

#1.4s
left.color = accent.primary [0.8s, ease: ease-in-out]
right.color = accent.success [0.8s, ease: ease-in-out]
echo.radius = right.badge.radius [0.8s, ease: ease-in-out]
echo.color = right.badge.color [0.8s, ease: ease-in-out]
