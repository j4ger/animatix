// Runnable example: Arc, Polygon, and Path primitives with arc property animation and path-based re-declarations.

config { colorscheme: "editorial-dark" }

#0s
header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text, text: "Animatix example suite", font_size: 18, color: accent.primary }
  title: Text, text: "Arc + polygon + path demo", font_size: 42, color: text.primary }
  subtitle: Text, text: "Arc properties animate directly while Polygon and Path change geometry by re-declaration.", font_size: 20, color: text.secondary }
  caption: Text, text: "Three sibling columns keep each primitive family readable while preserving the current morphing and angle-update behavior.", font_size: 16, color: text.secondary }
}

// Labels in a Row above shapes
labels_row: Row, anchor: scene.center, offset: (0, -70), gap: 80, align: "center" {
  arc_label: Text, text: "Arc", font_size: 20, color: accent.warning },
  poly_label: Text, text: "Polygon", font_size: 20, color: accent.success },
  path_label: Text, text: "Path", font_size: 20, color: accent.primary }
}

// Shapes in a Row
shapes_row: Row, anchor: scene.center, offset: (0, 50), gap: 80, align: "center" {
  ring: Arc, radius_x: 120, radius_y: 90, start_angle: -0.7, sweep_angle: 3.8, stroke: accent.warning, width: 6,
  badge: Polygon, points: {(-90, 0), (-20, -100), (90, -30), (60, 90), (-50, 110)}, color: (0.21, 0.80, 0.58, 0.84), stroke: (0.90, 0.98, 0.95, 1.0), width: 3,
  guide: Path, commands: {
    move_to(-120, 40),
    line_to(-60, -70),
    curve_to(-10, -130, 70, 10, 130, -40),
    line_to(80, 100),
    close()
  }, color: (0.28, 0.62, 1.0, 0.18), stroke: accent.primary, width: 4
}

#2s
ring.sweep_angle = 5.2 [1.5s, ease: ease-in-out]
ring.start_angle = -1.4 [1.5s, ease: ease-in-out]

badge: Polygon, points: {(-110, -20), (0, -120), (100, -10), (40, 120), (-80, 90)}, color: (0.26, 0.95, 0.70, 0.86), stroke: (0.97, 0.98, 1.0, 1.0), width: 3 [1.5s, ease: ease-in-out]

guide: Path, commands: {
  move_to(-130, 20),
  line_to(-50, -90),
  curve_to(0, -150, 90, -20, 130, 50),
  line_to(20, 120),
  close()
}, color: (0.35, 0.88, 1.0, 0.20), stroke: (0.70, 0.92, 1.0, 1.0), width: 4 [1.5s, ease: ease-in-out]
