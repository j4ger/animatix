// Runnable example: Arc, Polygon, and Path primitives with arc property animation and path-based re-declarations.
#0s
scene.background_color = (0.05, 0.06, 0.10, 1.0)

title: Text { text: "Arc + Polygon + Path", font_size: 32, color: WHITE, at: (640, 70) }
subtitle: Text { text: "Arc uses animated angles; Polygon and Path change geometry by re-declaration.", font_size: 18, color: (0.80, 0.86, 0.96, 1.0), at: (640, 108) }

arc_label: Text { text: "Arc", font_size: 20, color: (1.0, 0.85, 0.35, 1.0), at: (260, 170) }
poly_label: Text { text: "Polygon", font_size: 20, color: (0.30, 0.95, 0.70, 1.0), at: (640, 170) }
path_label: Text { text: "Path", font_size: 20, color: (0.45, 0.78, 1.0, 1.0), at: (1020, 170) }

ring: Arc, radius_x: 120, radius_y: 90, start_angle: -0.7, sweep_angle: 3.8, stroke: (1.0, 0.85, 0.35, 1.0), width: 6, at: (260, 380)

badge: Polygon, points: {(-90, 0), (-20, -100), (90, -30), (60, 90), (-50, 110)}, color: (0.22, 0.90, 0.62, 0.85), stroke: (0.95, 1.0, 0.98, 1.0), width: 3, at: (640, 390)

guide: Path, commands: {
  move_to(-120, 40),
  line_to(-60, -70),
  curve_to(-10, -130, 70, 10, 130, -40),
  line_to(80, 100),
  close()
}, color: (0.28, 0.62, 1.0, 0.20), stroke: (0.45, 0.78, 1.0, 1.0), width: 4, at: (1020, 390)

#2s
ring.sweep_angle = 5.2 [1.5s, ease: ease-in-out]
ring.start_angle = -1.4 [1.5s, ease: ease-in-out]

badge: Polygon, points: {(-110, -20), (0, -120), (100, -10), (40, 120), (-80, 90)}, color: (0.28, 1.0, 0.74, 0.88), stroke: (1.0, 1.0, 1.0, 1.0), width: 3, at: (640, 390) [1.5s, ease: ease-in-out]

guide: Path, commands: {
  move_to(-130, 20),
  line_to(-50, -90),
  curve_to(0, -150, 90, -20, 130, 50),
  line_to(20, 120),
  close()
}, color: (0.35, 0.88, 1.0, 0.22), stroke: (0.70, 0.92, 1.0, 1.0), width: 4, at: (1020, 390) [1.5s, ease: ease-in-out]
