// 04 — Motion Actions
// Every built-in action verb demonstrated in isolation.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

actor: Rect, size: (120, 120), color: accent.primary, at: (640, 360)

#0s

#0.5s
fade-in actor [600ms, ease: ease-out]

#1.5s
shift actor [by: (200, 0), 800ms, ease: ease-in-out]

#2.5s
rotate actor [by: 1.5708, 800ms, ease: ease-in-out]

#3.5s
scale actor [by: 1.5, 800ms, ease: bounce]

#4.5s
actor.color = accent.warning [600ms, ease: ease-in-out]

#5.5s
scale actor [by: 0.667, 800ms, ease: ease-in-out]

#6.5s
rotate actor [by: -1.5708, 800ms, ease: ease-in-out]

#7.5s
shift actor [by: (-200, 0), 800ms, ease: ease-in-out]

#8.5s
fade-out actor [600ms, ease: ease-in]

// Second actor: entry and exit
#9.5s
ghost: Ellipse, size: (100, 100), color: accent.success, at: (640, 360)

#9.5s
draw-in ghost [800ms, ease: ease-out]

#11s
wipe-out ghost [600ms, ease: ease-in]
