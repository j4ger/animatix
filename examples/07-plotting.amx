// 07-plotting.amx
// Graphs, curves, vector fields, and math visualization.

config { colorscheme: "editorial-dark", resolution: (900, 600) }

#0s
scene.background_color = "#1a1a2e"

header: Text, text: "Math & Graphs", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 30)

// Cartesian and polar curves in one graph
graph: Graph, x_domain: (-3, 3), y_domain: (-2, 8), size: (400, 300), at: (250, 320) {
  parabola: PlotCurve, kind: "cartesian", func: (x) => x^2, color: accent.primary, width: 2
  rose: PlotCurve, kind: "polar", func: (t) => 1 + sin(3*t), color: accent.danger, width: 2
}

// Parametric curves in a second graph
graph2: Graph, x_domain: (-1.5, 1.5), y_domain: (-1.5, 1.5), size: (300, 300), at: (680, 320) {
  lissajous: PlotCurve, kind: "parametric", func: (t) => (sin(3*t), cos(2*t)), color: accent.success, width: 2
}

label1: Text, text: "Cartesian + Polar", font_size: 14, color: text.secondary, at: (250, 120)
label2: Text, text: "Parametric", font_size: 14, color: text.secondary, at: (680, 120)

#0.5s
fade-in graph [600ms, ease: ease-out]
fade-in graph2 [600ms, delay: 200ms, ease: ease-out]

#1.5s
shift graph [by: (10, 0), 2s, ease: ease-in-out]
