// Runnable example: built-in colorscheme selection with automatic primitive defaults,
// semantic aliases, and deterministic automatic color assignment.
//
// When a colorscheme is selected, explicit color properties can be omitted:
// - Text/Math/Code defaults to text.primary
// - Shape fills (Circle, Rect, etc.) default to surface.primary
// - Shape strokes (Line, Arrow) default to stroke.default
// - Plot curves default to accent.primary
//
// Explicit colors still override, and color: auto cycles through the auto pool.

config { colorscheme: "editorial-dark" }

#0s
header: Col, anchor: scene.top, offset: (0, 86), align: "center", gap: 10 {
  eyebrow: Text, text: "Animatix example suite"
  title: Text, text: "Colorschemes", font_size: 42
  subtitle: Text, text: "Primitives receive scheme defaults automatically. Explicit colors still override when provided.", font_size: 20
  caption: Text, text: "The center panel demonstrates surface and stroke defaults, the three circles prove auto assignment, and the bottom badge shows explicit override behavior.", font_size: 16
}

// Shape fills default to surface.primary, strokes to stroke.default
panel: Rect, size: (420, 200), stroke_width: 2, at: (640, 378)
panel_label: Text, text: "surface.primary + stroke.default", font_size: 18, at: (640, 316)
cycle_label: Text, text: "auto colors", font_size: 18, at: (640, 356)

// Three circles with auto colors in a Row
auto_circles: Row, anchor: scene.center, offset: (0, -10), gap: 60 {
  alice: Circle, radius: 28
  bob: Circle, radius: 28
  carol: Circle, radius: 28
}

warning: Text, text: "Explicit overrides still win", font_size: 18, anchor: scene.bottom, offset: (0, -126) }
override_badge: Circle, radius: 18, color: (1.0, 0.9, 0.2, 1.0), at: (640, 494)

#1.4s
alice.radius = 42 [700ms, ease: ease-in-out]
bob.color = accent.success [700ms, ease: ease-in-out]
carol.color = accent.danger [700ms, ease: ease-in-out]
