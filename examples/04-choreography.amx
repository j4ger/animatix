// 04-choreography.amx
// Sequence, stagger, reorder, swap, and effects.

config { colorscheme: "editorial-dark", resolution: (800, 500) }

#0s
scene.background_color = "#1a1a2e"

header: Text, text: "Choreography", font_size: 32, color: text.primary, anchor: scene.top, offset: (0, 30)

// A row of boxes that will be animated in various ways
stage: Row, gap: 20, align: "center", anchor: scene.center, offset: (0, -40) {
  a: Rect, size: (60, 60), color: accent.primary
  b: Rect, size: (60, 60), color: accent.warning
  c: Rect, size: (60, 60), color: accent.success
  d: Rect, size: (60, 60), color: accent.danger
  e: Rect, size: (60, 60), color: surface.secondary
}

#0.5s
// Stagger: each child starts with a shared delay offset
stagger [100ms] {
  fade-in a [400ms, ease: ease-out]
  fade-in b [400ms, ease: ease-out]
  fade-in c [400ms, ease: ease-out]
  fade-in d [400ms, ease: ease-out]
  fade-in e [400ms, ease: ease-out]
}

#2.0s
// Sequence: actions execute one after another
sequence {
  shift a [by: (0, -30), 300ms, ease: ease-out]
  shift b [by: (0, -30), 300ms, ease: ease-out]
  shift c [by: (0, -30), 300ms, ease: ease-out]
  shift d [by: (0, -30), 300ms, ease: ease-out]
  shift e [by: (0, -30), 300ms, ease: ease-out]
}

#3.8s
// Effects: shake, pulse, bounce
pulse c [400ms, intensity: 0.15]

#4.3s
shake a [300ms, intensity: 0.12]

#4.8s
// Reorder: swap positions in the layout
reorder stage [order: (e, d, c, b, a), 600ms, ease: ease-in-out]

#6.0s
// Swap: exchange two specific items
swap a, e [500ms, ease: ease-in-out]

#7.0s
// Scale effect on the whole group
scale stage [by: 1.1, 400ms, ease: bounce]
