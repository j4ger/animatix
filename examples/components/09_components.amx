// 09 — Components: Slots, Custom Actions, Typed Params
// pub component, @slot markers, action blocks, typed params, dotted assignment.

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

pub component MetricCard(title: Str = "Metric", value: Str = "0") {
  frame: Rect, size: (240, 140), color: surface.secondary
  header: Col, gap: 6, anchor: scene.top, offset: (0, 14) {
    @slot
    fallback: Text, text: title, font_size: 16, color: text.primary
  }
  value_text: Text, text: value, font_size: 48, color: text.primary, anchor: scene.center

  fn pulse {
    self.scale = 1.05 [120ms]
    self.scale = 1.0 [120ms]
  }
}

heading: Text, text: "Dashboard", font_size: 40, color: text.primary, anchor: scene.top, offset: (0, 50)

#0s
row: Row, anchor: scene.center, gap: 32, align: "center" {
  card1: MetricCard, title: "Revenue", value: "$89K" {
    @header {
      a: Text, text: "Revenue", font_size: 14, color: accent.success
    }
  }
  card2: MetricCard, title: "Users", value: "12.4K" {
    @header {
      b: Text, text: "Users", font_size: 14, color: accent.primary
    }
  }
  card3: MetricCard, title: "Latency", value: "24ms" {
    @header {
      c: Text, text: "Latency", font_size: 14, color: accent.warning
    }
  }
}

#0.5s
fade-in heading [600ms, ease: ease-out]

#1s
stagger [100ms] {
  fade-in card1 [500ms]
  fade-in card2 [500ms]
  fade-in card3 [500ms]
}

#2.5s
card1.value_text.text = "$102K" [800ms]
card1.value_text.color = accent.success [800ms]

#3s
pulse card2 [300ms]
card2.value_text.text = "14.2K" [800ms]

#3.5s
pulse card3 [300ms]
card3.value_text.text = "18ms" [800ms]
card3.value_text.color = accent.success [800ms]