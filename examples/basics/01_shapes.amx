import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"
import "../../web/demos/lib/ui.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor
head: ActHead, kicker: "BASICS · SHAPES", title: "Primitive gallery"
caption: Caption, text: "01_shapes.amx", tag: "basics"

gallery: Grid, cols: 4, gap: 24, padding: 60, anchor: scene.center {
  text: Text, text: "Typography", font_size: 20, color: accent.primary
  math: Text, text: "∫ e^(-x) dx", font_size: 24, color: accent.success
  code: Code, code: "fn animate() { }", language: "rust", font_size: 20, color: accent.warning
  rect: Rect, size: (80, 80), color: accent.danger
  ellipse: Ellipse, size: (80, 80), color: accent.primary
  polygon: Polygon, points: {(0, -40), (40, 0), (0, 40), (-40, 0)}, color: accent.success
  path: Path, commands: {move_to(-30, 20), line_to(0, -30), line_to(30, 20), close()}, color: accent.warning
  line: Line, from: (-40, 0), to: (40, 0), stroke: accent.danger, stroke_width: 4
  image: Image, url: "../assets/checker.png", size: (80, 80)
  mark: Svg, url: "../assets/animatix-mark.svg", size: (80, 80)
  arrow: Arrow, from: (-40, 20), to: (40, -20), stroke: accent.primary, stroke_width: 4, head_size: 16
}

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.6s
stagger [80ms] {
  fade-in text [500ms, ease: ease-out]
  fade-in math [500ms, ease: ease-out]
  fade-in code [500ms, ease: ease-out]
  fade-in rect [500ms, ease: ease-out]
  fade-in ellipse [500ms, ease: ease-out]
  fade-in polygon [500ms, ease: ease-out]
  fade-in path [500ms, ease: ease-out]
  fade-in line [500ms, ease: ease-out]
  fade-in image [500ms, ease: ease-out]
  fade-in mark [500ms, ease: ease-out]
  fade-in arrow [500ms, ease: ease-out]
}

#3s
text.color = accent.danger [600ms]
math.color = accent.primary [600ms]
code.color = accent.success [600ms]
rect.color = accent.warning [600ms]
ellipse.color = accent.danger [600ms]
polygon.color = accent.primary [600ms]
path.color = accent.success [600ms]
line.stroke = accent.warning [600ms]
mark.color = accent.primary [600ms]
arrow.stroke = accent.success [600ms]
