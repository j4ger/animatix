// 00 — Hello: Bold Title Card
// A dramatic opening with editorial-dark elegance.

import "../lib/theme.amx"
import "../lib/theme.amx" as theme
import "../lib/ui.amx"

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

card_wrap: Group, anchor: scene.center {
  card: TitleCard,
    title: "ANIMATIX",
    kicker: "A DECLARATIVE DSL FOR MOTION DESIGN",
    sub: "Layout-First Animation"
}

#0.5s
fade-in card [1s, ease: ease-out]
