import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 1.5 }

floor: StageFloor
head: ActHead, kicker: "HELLO", title: "ANIMATIX", sub: "A declarative DSL for motion design"
