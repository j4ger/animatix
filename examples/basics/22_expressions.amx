// 22 — Expressions: Constructs, Colors & Math
// rgb/rgba, lerp, clamp, rand, percentages, index access.

import "../lib/theme.amx"
import "../lib/theme.amx" as theme

config { colorscheme: "editorial-dark", resolution: (1280, 720) }

let width = lerp(120.0, 260.0, clamp(seeded_rand(22), 0.0, 1.0))

title: Text, text: "Expressions", font_size: 42, color: rgb(0.38, 0.78, 1.0), at: (50%, 18%)
bar: Rect, size: (width, 56.0), color: rgba(0.35, 0.85, 0.55, 0.85), at: (50%, 46%)
dot: Ellipse, size: (48.0, 48.0), color: rgb(1.0, 0.75, 0.3), at: (50%, 70%)
note: Text, text: "lerp · clamp · rand · rgb · index", font_size: 18, color: text.secondary, at: (50%, 84%)

#0.5s
fade-in title [500ms]
fade-in bar [500ms, delay: 100ms]
fade-in dot [500ms, delay: 200ms]
fade-in note [500ms, delay: 300ms]
