import "../lib/theme.amx"

import "../lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor

head: ActHead, kicker: "BASICS · EXPRESSIONS", title: "Math & Methods"

caption: Caption, text: "22_expressions.amx", tag: "basics"

let width = lerp(120, 260, clamp(seeded_rand(22), 0, 1))

let padded = "  animatix DSL  "

let name = padded.trim()

let name_len = name.length()

title: Text, text: "Expressions", font_size: 42, color: accent.primary, anchor: scene.center, offset: (0, -200)

bar: Rect, size: (width, 56), color: accent.success, anchor: scene.center, offset: (0, -80)

dot: Ellipse, size: (48, 48), color: accent.warning, anchor: scene.center, offset: (0, 60)

note: Text, text: "lerp · clamp · rand · rgb · index", font_size: 18, color: text.secondary, anchor: scene.center, offset: (0, 150)

m1: Text, text: name, font_size: 18, color: text.primary, anchor: scene.center, offset: (0, 200)

m2: Rect, size: (name_len * 14, 20), color: accent.success, anchor: scene.center, offset: (0, 240)

m3: Text, text: "padded.trim() = label; .length() = 12 → bar width", font_size: 14, color: text.muted, anchor: scene.center, offset: (0, 260)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s)

#0.6s
  fade_in(target: title, duration: 0.5s)
  fade_in(target: bar, duration: 0.5s, delay: 0.1s)
  fade_in(target: dot, duration: 0.5s, delay: 0.2s)
  fade_in(target: note, duration: 0.5s, delay: 0.3s)
  fade_in(target: m1, duration: 0.5s, delay: 0.4s)
  fade_in(target: m2, duration: 0.5s, delay: 0.4s)
  fade_in(target: m3, duration: 0.5s, delay: 0.45s)
