import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor
head: ActHead, kicker: "BASICS · EXPRESSIONS", title: "Math & Methods"
caption: Caption, text: "22_expressions.amx", tag: "basics"

let width = lerp(120.0, 260.0, clamp(seeded_rand(22), 0.0, 1.0))

let padded = "  animatix DSL  "
let name = padded.trim()
let name_len = name.length()

title: Text, text: "Expressions", font_size: 42, color: accent.primary, anchor: scene.center, offset: (0, -200)
bar: Rect, size: (width, 56.0), color: accent.success, anchor: scene.center, offset: (0, -80)
dot: Ellipse, size: (48.0, 48.0), color: accent.warning, anchor: scene.center, offset: (0, 60)
note: Text, text: "lerp · clamp · rand · rgb · index", font_size: 18, color: text.secondary, anchor: scene.center, offset: (0, 150)
m1: Text, text: name, font_size: 18, color: text.primary, anchor: scene.center, offset: (0, 200)
m2: Rect, size: (name_len * 14.0, 20.0), color: accent.success, anchor: scene.center, offset: (0, 240)
m3: Text, text: "padded.trim() = label; .length() = 12 → bar width", font_size: 14, color: text.muted, anchor: scene.center, offset: (0, 260)

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.6s
fade-in title [500ms]
fade-in bar [500ms, delay: 100ms]
fade-in dot [500ms, delay: 200ms]
fade-in note [500ms, delay: 300ms]
fade-in m1 [500ms, delay: 400ms]
fade-in m2 [500ms, delay: 400ms]
fade-in m3 [500ms, delay: 450ms]
