import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { colorscheme: "ink", resolution: (1280, 720), duration: 6 }

floor: StageFloor
head: ActHead, kicker: "BASICS · TIMING", title: "Sequence, Stagger & Easing"
caption: Caption, text: "03_timing.amx", tag: "basics"

a: Rect, size: (70, 70), color: accent.primary, anchor: scene.center, offset: (-400, 0)
b: Rect, size: (70, 70), color: accent.success, anchor: scene.center, offset: (-200, 0)
c: Rect, size: (70, 70), color: accent.warning, anchor: scene.center, offset: (0, 0)
d: Rect, size: (70, 70), color: accent.danger, anchor: scene.center, offset: (200, 0)
e: Rect, size: (70, 70), color: text.primary, anchor: scene.center, offset: (400, 0)

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms]

#0.6s
stagger [120ms] {
  fade-in a [500ms, ease: ease-out]
  fade-in b [500ms, ease: ease-out]
  fade-in c [500ms, ease: ease-out]
  fade-in d [500ms, ease: ease-out]
  fade-in e [500ms, ease: ease-out]
}

#2.5s
sequence {
  a.size = (100, 100) [400ms, ease: ease-out]
  b.size = (100, 100) [400ms, ease: ease-out]
  c.size = (100, 100) [400ms, ease: ease-out]
  d.size = (100, 100) [400ms, ease: ease-out]
  e.size = (100, 100) [400ms, ease: ease-out]
}

#5s
a.color = accent.danger [600ms, ease: linear]
b.color = accent.warning [600ms, ease: ease-in]
c.color = accent.primary [600ms, ease: ease-out]
d.color = accent.success [600ms, ease: ease-in-out]
e.color = accent.danger [600ms, ease: bounce]
