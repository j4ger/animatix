import "../lib/theme.amx"

import "../lib/stage.amx"

config { resolution: (1280, 720), duration: 8 }

floor: StageFloor

head: ActHead, kicker: "BASICS · CODE", title: "Syntax Highlighting"

caption: Caption, text: "31_code.amx", tag: "basics"

config { colorscheme: "editorial-dark" }

r1: Code, code: "fn main() { let x = 42; }", language: "rust", font_size: 26, anchor: scene.center, offset: (0, -100)

p1: Code, code: "def greet(name): return 'hi ' + name", language: "python", font_size: 26, anchor: scene.center, offset: (0, 0)

c1: Code, code: "int main() { return 0; }", language: "cpp", font_size: 26, anchor: scene.center, offset: (0, 100)

#0s
  fade_in(target: floor, duration: 0.6s)
  fade_in(target: head, duration: 0.5s)
  fade_in(target: caption, duration: 0.4s)
  stagger [0.15s] {
      fade_in(target: r1, duration: 0.3s, ease: ease_out)
      fade_in(target: p1, duration: 0.3s, ease: ease_out)
      fade_in(target: c1, duration: 0.3s, ease: ease_out)
    }

#4s
  r1.color = accent.primary[0.3s]
  p1.color = accent.success[0.3s]
  c1.color = accent.danger[0.3s]
  caption.text = "Token colors follow the active colorscheme."[0s]
