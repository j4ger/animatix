import "../../web/demos/lib/theme.amx"
import "../../web/demos/lib/stage.amx"

config { resolution: (1280, 720), duration: 8 }

floor: StageFloor
head: ActHead, kicker: "BASICS · CODE", title: "Syntax Highlighting"
caption: Caption, text: "31_code.amx", tag: "basics"

config { colorscheme: "editorial-dark" }
r1: Code, code: "fn main() { let x = 42; }", language: "rust", font_size: 26, anchor: scene.center, offset: (0, -100)
p1: Code, code: "def greet(name): return 'hi ' + name", language: "python", font_size: 26, anchor: scene.center, offset: (0, 0)
c1: Code, code: "int main() { return 0; }", language: "cpp", font_size: 26, anchor: scene.center, offset: (0, 100)

#0s
fade-in floor [600ms]
fade-in head [500ms]
fade-in caption [400ms]
stagger [150ms] {
  fade-in r1 [300ms, ease: ease-out]
  fade-in p1 [300ms, ease: ease-out]
  fade-in c1 [300ms, ease: ease-out]
}

#4s
r1.color = accent.primary [300ms]
p1.color = accent.success [300ms]
c1.color = accent.danger [300ms]
caption.text = "Token colors follow the active colorscheme." [0ms]
