// brand_reel/finale.amx — scene ⑥: staggered regroup, Audio-beat-synced
// pulses, fade back to the logo. The reel closes where it opened.
import "../../lib/theme.amx" as theme

import "../../lib/theme.amx"

config { colorscheme: "ink", dynamic_layout: true, duration: 13 }

# Finale
// Audio bed: mixed during export; the pulses below are timed to its beats.
bed: Audio, source: "../../assets/pulse.wav", volume: 1 [delay: 0s, 4s]
beat_row: Row, gap: 26, anchor: scene.center, align: "center" {
beat0: Ellipse, size: (26, 26), color: accent.primary
beat1: Ellipse, size: (26, 26), color: accent.success
beat2: Ellipse, size: (26, 26), color: accent.warning
beat3: Ellipse, size: (26, 26), color: accent.danger
beat4: Ellipse, size: (26, 26), color: accent.secondary
}
// Audio-beat-synced pulses (track BPM ≈ 120 → one beat every 500ms).
always {
  beat0.scale = 1 + 0.35 * max(0, sin(((2 * pi) * t) / 1))
  beat1.scale = 1 + 0.35 * max(0, sin(((2 * pi) * t) / 1 - 0.6))
  beat2.scale = 1 + 0.35 * max(0, sin(((2 * pi) * t) / 1 - 1.2))
  beat3.scale = 1 + 0.35 * max(0, sin(((2 * pi) * t) / 1 - 1.8))
  beat4.scale = 1 + 0.35 * max(0, sin(((2 * pi) * t) / 1 - 2.4))
}
finale_word: Text, text: "animatix", font_size: 76, font_weight: "bold", color: text.primary, anchor: scene.center, offset: (0, 130)
#0.4s
  fade_in(target: beat_row, duration: 0.5s, ease: ease_out)
#1.2s
  fade_in(target: finale_word, duration: 0.8s, ease: ease_out)
// Staggered regroup: the beats march inward and hold.
#6s
  beat_row.at = (640, 430) [1.2s, ease: ease_in_out]
#8s
  beat_row.at = (640, 370) [1.2s, ease: ease_in_out]
#10.6s
  fade_out(target: beat_row, duration: 0.7s)
  fade_out(target: finale_word, duration: 0.7s)
