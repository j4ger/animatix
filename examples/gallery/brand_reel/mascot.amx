// brand_reel/mascot.amx — scene ⑤: the persisted mascot takes focus.
// Position/color continuity from the previous scenes; the feature closes
// with `remove mascot` so the finale starts clean.
import "../../lib/theme.amx" as theme

import "../../lib/theme.amx"

config { colorscheme: "ink", dynamic_layout: true, duration: 11 }

# Mascot
mascot_title: Text, text: "Meet the dot", font_size: 36, font_weight: "bold", color: text.primary, anchor: scene.top, offset: (0, 52)
// The mascot takes center stage: grows, shifts color, does a lap.
mascot.at = (640, 380) [1.2s, ease: ease_in_out]
mascot_caption: Text, text: "persisted across four scenes — position, color, identity", font_size: theme::text_sm, color: text.secondary, anchor: scene.center, offset: (0, 120)
mascot_note: Text, text: "`persist` carries it here; `remove` lets it go", font_size: theme::text_sm, color: text.muted, anchor: scene.center, offset: (0, 165)
#0.4s
  fade_in(target: mascot_title, duration: 0.5s)
#0.6s
  mascot.scale = 1.6 [0.9s, ease: ease_out]
  mascot.color = accent.success[0.9s]
  fade_in(target: mascot_caption, duration: 0.5s, delay: 0.4s)
#2.4s
  mascot.at = (420, 320) [0.8s, ease: ease_in_out]
#3.4s
  mascot.at = (860, 320) [0.8s, ease: ease_in_out]
#4.4s
  mascot.at = (640, 380) [0.8s, ease: ease_in_out]
  fade_in(target: mascot_note, duration: 0.5s, delay: 0.3s)
#6.2s
  pulse(target: mascot, duration: 0.5s, intensity: 1.4)
#8.4s
  remove(target: mascot, duration: 0.6s)
play finale::Finale [wipe_down, 500ms]
