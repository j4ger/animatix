// brand_reel/logo.amx — scene ①: logo draw-in + sheen sweep.
// Introduces the mascot dot (persisted across the whole reel).
config { colorscheme: "ink", dynamic_layout: true, duration: 8 }

# Logo
logo_text: Text, text: "animatix", font_size: 88, font_weight: "bold", color: text.primary, anchor: scene.center, offset: (0, -30)
tagline: Text, text: "layout-first animation", font_size: 22, letter_spacing: 6, color: text.secondary, anchor: scene.center, offset: (0, 60)
// Sheen sweep: a soft rotated band crossing the wordmark once.
sheen: Rect, size: (90, 320), color: (1, 1, 1, 0.1), rotation: -20, at: (-200, -30), opacity: 0
// The mascot: a small warning-colored dot in the top-right corner.
mascot: Ellipse, size: (44, 44), color: accent.warning, at: (1150, 110)
#0.3s
  fade_in(target: logo_text, duration: 0.4s)
  draw_in(target: logo_text, duration: 1.2s, ease: ease_out)
#1.6s
  fade_in(target: tagline, duration: 0.6s)
  fade_in(target: mascot, duration: 0.5s, ease: ease_out)
// Sheen sweep across the wordmark.
#2.2s
  sheen.opacity = 0.9[0.2s]
  sheen.at = (1280, -30) [1.4s, ease: ease_in_out]
#3.8s
  sheen.opacity = 0[0.3s]
#7.4s
  persist(target: mascot)
play slogan::Slogan [wipe_left, 500ms]
