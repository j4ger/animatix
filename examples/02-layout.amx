// 02-layout.amx
// Layout containers: Row, Col, Grid, Stack, gap, align.

config { colorscheme: "editorial-dark", resolution: (800, 600) }

#0s
scene.background_color = "#1a1a2e"

header: Text, text: "Layouts", font_size: 36, color: text.primary, anchor: scene.top, offset: (0, 40)

// Row arranges children horizontally with a gap
row_demo: Row, gap: 16, align: "center", anchor: scene.center, offset: (-180, -100) {
  a: Rect, size: (50, 80), color: accent.primary
  b: Rect, size: (50, 60), color: accent.warning
  c: Rect, size: (50, 100), color: accent.success
}

row_label: Text, text: "Row", font_size: 14, color: text.secondary, anchor: scene.center, offset: (-180, -40)

// Col arranges children vertically
col_demo: Col, gap: 12, align: "center", anchor: scene.center, offset: (0, -100) {
  d: Rect, size: (80, 35), color: accent.danger
  e: Rect, size: (60, 35), color: accent.warning
  f: Rect, size: (100, 35), color: accent.primary
}

col_label: Text, text: "Col", font_size: 14, color: text.secondary, anchor: scene.center, offset: (0, -40)

// Grid arranges children in rows and columns
grid_demo: Grid, columns: 2, gap: 10, anchor: scene.center, offset: (180, -100) {
  g: Rect, size: (40, 40), color: accent.primary
  h: Rect, size: (40, 40), color: accent.danger
  i: Rect, size: (40, 40), color: accent.success
  j: Rect, size: (40, 40), color: accent.warning
}

grid_label: Text, text: "Grid", font_size: 14, color: text.secondary, anchor: scene.center, offset: (180, -40)

// Stack overlays children at the same position
stack_demo: Stack, anchor: scene.center, offset: (0, 80) {
  base: Rect, size: (120, 120), color: surface.primary
  mid: Ellipse, size: (80, 80), color: accent.primary
  top: Rect, size: (40, 40), color: accent.warning
}

stack_label: Text, text: "Stack", font_size: 14, color: text.secondary, anchor: scene.center, offset: (0, 150)

#0.5s
// Stagger applies a shared interval offset between children
stagger [100ms] {
  fade-in a [400ms, ease: ease-out]
  fade-in b [400ms, ease: ease-out]
  fade-in c [400ms, ease: ease-out]
  fade-in d [400ms, ease: ease-out]
  fade-in e [400ms, ease: ease-out]
  fade-in f [400ms, ease: ease-out]
  fade-in g [400ms, ease: ease-out]
  fade-in h [400ms, ease: ease-out]
  fade-in i [400ms, ease: ease-out]
  fade-in j [400ms, ease: ease-out]
}

#1.0s
fade-in stack_demo [600ms, ease: ease-out]
