// Runnable example: composition v1b with build-time `stagger` blocks.

#0s
let ink = (0.04, 0.05, 0.09, 1.0)
let title_ink = (0.97, 0.98, 1.0, 1.0)
let subtitle_ink = (0.73, 0.80, 0.89, 1.0)
let accent = (0.38, 0.78, 1.0, 1.0)
let green = (0.35, 0.86, 0.63, 1.0)
let coral = (1.0, 0.46, 0.54, 1.0)

scene.background_color = ink

eyebrow: Text { text: "Animatix example suite", font_size: 18, color: accent, anchor: scene.top, offset: (0, 34) }
title: Text { text: "Stagger composition demo", font_size: 42, color: title_ink, anchor: scene.top, offset: (0, 74) }
subtitle: Text { text: "Each child statement starts with the same shared interval offset from the parent keyframe", font_size: 20, color: subtitle_ink, anchor: scene.top, offset: (0, 108) }
caption: Text { text: "The three siblings are evenly staged so the stagger rhythm is the first thing you notice in playback.", font_size: 16, color: (0.60, 0.69, 0.80, 1.0), anchor: scene.top, offset: (0, 136) }

a: Circle, radius: 42, color: coral, stroke: title_ink, stroke_width: 4, at: (340, 430)
b: Circle, radius: 42, color: accent, stroke: title_ink, stroke_width: 4, at: (640, 430)
c: Circle, radius: 42, color: green, stroke: title_ink, stroke_width: 4, at: (940, 430)

#0s
stagger [180ms] {
  fade-out a [320ms]
  fade-out b [320ms]
  fade-out c [320ms]
}
