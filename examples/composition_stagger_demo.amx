// Runnable example: composition v1b with build-time `stagger` blocks.
#0s
scene.background_color = (0.05, 0.06, 0.10, 1.0)

title: Text { text: "Stagger Composition Demo", font_size: 34, color: WHITE, at: (640, 84) }
subtitle: Text { text: "Each statement starts with a shared interval offset", font_size: 22, color: (0.78, 0.83, 0.92, 1.0), at: (640, 132) }

a: Circle, radius: 42, color: (1.0, 0.55, 0.62, 1.0), stroke: WHITE, stroke_width: 4, at: (340, 420)
b: Circle, radius: 42, color: (0.34, 0.68, 1.0, 1.0), stroke: WHITE, stroke_width: 4, at: (640, 420)
c: Circle, radius: 42, color: (0.26, 0.90, 0.64, 1.0), stroke: WHITE, stroke_width: 4, at: (940, 420)

#0s
stagger [180ms] {
  fade-out a [320ms]
  fade-out b [320ms]
  fade-out c [320ms]
}
