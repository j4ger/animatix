// Stage 3 Plotting Demo
// Demonstrates the new Graph, CartesianPlot, and PolarPlot primitives
// with closure syntax: (arg) => expression
// Note: Properties must be comma-separated BEFORE the {} block

#0s
scene.background_color = (0.1, 0.1, 0.15, 1.0)

// Create a Graph container with cartesian and polar plots
my_graph: Graph, x_domain: (-5, 5), y_domain: (-5, 25), size: (400, 400), at: (400, 300) {
    cartesian: CartesianPlot, func: (x) => x * x - 2, stroke: (0.0, 0.0, 1.0, 1.0), width: 2,

    asymptote: CartesianPlot, func: (x) => 1 / x, color: (1.0, 0.65, 0.0, 1.0), tolerance: 0.1, max_depth: 12,

    polar: PolarPlot, func: (t) => 3 * sin(4 * t), t_domain: (0, 6), stroke: (0.0, 1.0, 0.0, 1.0), width: 2
}

// Label for the graph
graph_label: Text { text: "Plotting Demo", font_size: 20, color: (1.0, 1.0, 1.0, 1.0), at: (400, 50) }

// Animate the graph size growing
#2s
my_graph.size = (600, 600) [2s]

// Animate the graph position
#4s
my_graph.at = (600, 300) [2s]

// Shrink back
#6s
my_graph.size = (400, 400) [2s]
