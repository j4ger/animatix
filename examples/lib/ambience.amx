// ambience.amx — Reactive dynamic background shading driven by scene statistics.
//
// Background:
// Scenes cannot traditionally see themselves without GPU readbacks or stateful
// accumulators. Animatix STAT-1 solves this by computing scene statistics at build time
// (scene.stats.motion, focus_x/y, spread_x/y, cast) as piecewise-linear curves, and
// evaluating smoothed responses analytically via `curve_smooth` with zero GPU readback
// and zero per-frame CPU allocation overhead.
//
// Ambience creates a fluid, amorphous, boundary-free atmospheric illumination
// using rotated anamorphic caustic ribbons and diffused atmospheric veils.
// Movement patterns are uniquely seeded per-scene using deterministic RNG.
//
// Usage as an imported component:
//   import "lib/ambience.amx" as amb
//   bg: amb.Ambience(tint: rgb(0.37, 0.36, 0.90), base_opacity: 0.15, tau: 0.7, seed: 42)

pub component Ambience(tint: Color = rgb(0.96, 0.72, 0.26), base_opacity: Num = 0.18, tau: Num = 0.7, seed: Num = 0) {
  plate: Rect, size: (fill, fill), color: scene.background, anchor: scene.center, opacity: 1.0, legend: false

  // 1. Broad atmospheric veil: seamless canvas-scale illumination with cubic inverse-square falloff
  veil: Ellipse, size: (2200, 1400), opacity: base_opacity * 0.65, blend: "screen",
    fill_gradient: radial((0.5, 0.5), 0.65, {(0%, tint * 0.26), (25%, tint * 0.18), (55%, tint * 0.08), (80%, tint * 0.02), (100%, (0, 0, 0, 0))}),
    anchor: scene.center, legend: false

  // 2. Primary diagonal caustic ribbon: elongated anamorphic light sweep (aspect ratio ~4:1)
  wash: Ellipse, size: (1800, 460), opacity: base_opacity * 0.85, blend: "screen",
    fill_gradient: radial((0.5, 0.5), 0.55, {(0%, tint * 0.36), (30%, tint * 0.24), (65%, tint * 0.08), (100%, (0, 0, 0, 0))}),
    anchor: scene.center, legend: false

  // 3. Counter-angled caustic ribbon: opposing diagonal creating an amorphous, morphing rhombus caustic
  aura: Ellipse, size: (1650, 420), opacity: base_opacity * 0.75, blend: "screen",
    fill_gradient: radial((0.5, 0.5), 0.55, {(0%, tint * 0.30), (30%, tint * 0.18), (65%, tint * 0.06), (100%, (0, 0, 0, 0))}),
    anchor: scene.center, legend: false

  // 4. Undulating amorphous focus cloud: gentle off-center organic density tracking active elements
  swathe: Ellipse, size: (1350, 680), opacity: base_opacity * 0.70, blend: "screen",
    fill_gradient: radial((0.46, 0.54), 0.55, {(0%, tint * 0.28), (28%, tint * 0.18), (60%, tint * 0.06), (100%, (0, 0, 0, 0))}),
    anchor: scene.center, legend: false

  always {
    let e = curve_smooth(scene.stats.motion, t, tau)
    let fx = curve_smooth(scene.stats.focus_x, t, tau * 1.5)
    let fy = curve_smooth(scene.stats.focus_y, t, tau * 1.5)
    let sx = curve_smooth(scene.stats.spread_x, t, tau * 1.2)
    let sy = curve_smooth(scene.stats.spread_y, t, tau * 1.2)

    // Automatic scene-hash seed derived lazily from the scene's unique initial geometry
    let s = if seed != 0 {
      seed
    } else {
      curve_at(scene.stats.focus_x, 0.0) * 1.731 + curve_at(scene.stats.focus_y, 0.0) * 2.317 + curve_at(scene.stats.spread_x, 0.0) * 3.179 + curve_at(scene.stats.spread_y, 0.0) * 4.123 + curve_at(scene.stats.cast, 0.0) * 23.41 + curve_at(scene.stats.ink, 0.0) * 11.19
    }

    // Seed-derived base random streams and decorrelated harmonic parameters
    let r1 = seeded_rand(s + 11.0)
    let r2 = seeded_rand(s + 29.0)
    let r3 = seeded_rand(s + 47.0)
    let r4 = seeded_rand(s + 71.0)

    let p1 = r1 * 6.283
    let p2 = r2 * 6.283
    let p3 = r3 * 6.283
    let p4 = r4 * 6.283

    let f1 = 0.20 + 0.22 * fract(r1 * 7.919)
    let f2 = 0.16 + 0.24 * fract(r2 * 11.273)
    let f3 = 0.14 + 0.20 * fract(r3 * 13.619)
    let f4 = 0.12 + 0.18 * fract(r4 * 17.851)

    let amp1_x = 55 + 45 * fract(r1 * 23.417)
    let amp1_y = 25 + 25 * fract(r2 * 31.907)
    let amp2_x = 65 + 50 * fract(r3 * 37.781)
    let amp2_y = 30 + 30 * fract(r4 * 41.519)
    let amp3_x = 50 + 40 * fract(r1 * 47.129)
    let amp3_y = 25 + 25 * fract(r2 * 53.681)

    let base_rot1 = -0.55 + 0.40 * fract(r3 * 59.917)
    let base_rot2 = 0.35 + 0.45 * fract(r4 * 67.231)
    let base_rot3 = -0.20 + 0.40 * fract(r1 * 71.509)

    // Dynamic fluid drift (decorrelated Lissajous orbits)
    let drift1_x = amp1_x * sin(t * f1 + p1)
    let drift1_y = amp1_y * cos(t * (f1 * 0.85) + p2)
    let drift2_x = -amp2_x * cos(t * f2 + p3)
    let drift2_y = amp2_y * sin(t * (f2 * 0.90) + p4)
    let drift3_x = amp3_x * sin(t * f3 + p2)
    let drift3_y = -amp3_y * cos(t * (f3 * 0.80) + p1)

    // Breathing and aspect morphing waves
    let morph_w1 = 1.0 + 0.14 * sin(t * f2 + p1)
    let morph_h1 = 1.0 - 0.12 * cos(t * f3 + p2)
    let morph_w2 = 1.0 - 0.15 * cos(t * f1 + p3)
    let morph_h2 = 1.0 + 0.13 * sin(t * f4 + p4)
    let morph_w3 = 1.0 + 0.16 * cos(t * f3 + p4)
    let morph_h3 = 1.0 - 0.14 * sin(t * f2 + p3)

    let breathe1 = 0.022 * sin(t * f1 + p2)
    let breathe2 = 0.018 * cos(t * f2 + p3)
    let breathe3 = 0.015 * sin(t * f3 + p4)

    // 1. Broad atmospheric veil: soft dispersed illumination bathing the stage
    self.veil.at = (fx * 0.25 + scene_width * 0.375 + 25 * sin(t * f4 + p1), fy * 0.25 + scene_height * 0.375 + 20 * cos(t * f4 + p2))
    self.veil.size = (1800 + 400 * sx + 50 * sin(t * f3 + p3), 1100 + 300 * sy + 35 * cos(t * f3 + p4))
    self.veil.rotation = 0.08 * sin(t * f4 + p1)
    self.veil.opacity = clamp(base_opacity * 0.70 * (0.75 + 0.85 * e) + 0.02 * sin(t * f4), 0.02, 0.45)

    // 2. Primary diagonal caustic ribbon: elongated anamorphic light sweep
    self.wash.at = (fx + drift1_x, fy + drift1_y)
    self.wash.size = ((1550 + 450 * sx) * morph_w1, (420 + 260 * sy) * morph_h1)
    self.wash.rotation = base_rot1 + 0.12 * sin(t * f1 + p1)
    self.wash.opacity = clamp(base_opacity * 1.10 * (0.65 + 1.35 * e) + breathe1, 0.02, 0.55)

    // 3. Counter-angled caustic ribbon: opposing diagonal creating morphing rhombus caustic
    self.aura.at = (fx + drift2_x, fy + drift2_y)
    self.aura.size = ((1450 + 400 * sx) * morph_w2, (380 + 240 * sy) * morph_h2)
    self.aura.rotation = base_rot2 + 0.14 * cos(t * f2 + p2)
    self.aura.opacity = clamp(base_opacity * 0.85 * (0.70 + 1.15 * e) + breathe2, 0.02, 0.48)

    // 4. Undulating amorphous focus cloud: gentle off-center organic density
    self.swathe.at = (fx + drift3_x, fy + drift3_y)
    self.swathe.size = ((1250 + 420 * sx) * morph_w3, (520 + 300 * sy) * morph_h3)
    self.swathe.rotation = base_rot3 + 0.18 * sin(t * f3 + p3)
    self.swathe.opacity = clamp(base_opacity * 0.75 * (0.70 + 1.10 * e) + breathe3, 0.02, 0.42)
  }
}
