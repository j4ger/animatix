// Slide layout component — reusable presentation slide with header and content slots.

pub component Slide(title: "Slide") {
  backdrop: Rect, size: fill, color: scene.background, anchor: scene.center

  header: Col, anchor: scene.top, offset: (0, 40), gap: 8 {
    @slot
    title_text: Text, text: title, font_size: 36, color: text.primary
  }

  body: Col, anchor: scene.center, gap: 16 {
    @slot
    placeholder: Text, text: "Content goes here", font_size: 18, color: text.secondary
  }
}
