// Card component — reusable panel with title and value.

pub component Card(title: "Title", value: "0", accent: accent.primary) {
  frame: Rect, size: (220, 130), color: surface.secondary
  header: Text, text: title, font_size: 14, color: text.secondary, anchor: scene.top, offset: (0, 12)
  body: Text, text: value, font_size: 42, color: accent, anchor: scene.center

  action highlight {
    self.frame.color = surface.primary [200ms]
    self.frame.color = surface.secondary [200ms]
  }
}
